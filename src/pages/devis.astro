---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChoixModele from "@/components/ChoixModele.astro";
import { pageTitle } from "@/config/site";
import {
  acceptFichiers,
  cleBrouillonDevis,
  devisConfig,
  fichiersDevis,
  messagesDevis,
  tailleTotaleMaxLisible,
} from "@/config/devis";
import { granits, granitsParTeinte, TEINTE_PASTILLE } from "@/data/granits";
import {
  FINITION_APERCU_DEFAUT,
  finitions,
  getFinition,
  getPolice,
  hauteurLabel,
  hauteursLettresMm,
  LIGNE_LONGUEUR_MAX,
  lignesInscription,
  MENTION_APERCU,
  MOTIF_DEFAUT,
  motifs,
  POLICE_DEFAUT,
  polices,
  STYLE_POLICE_LABELS,
} from "@/data/personnalisation";
import { getProducts } from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";

/* Page "Demander un devis".
   L ENVOI N EXISTE PAS ENCORE : il sera fait en E6 par une fonction Cloudflare
   Pages `/api/devis` (Resend, adresse en variable d environnement, decision de
   Thomas du 13.10.2026 : pas de n8n). D ici la, `devisConfig.envoiActif` vaut
   `false` et le JavaScript affiche un message au lieu de poster.
   Le contrat des champs est ecrit dans `docs/devis-contrat.md` : renommer un
   champ ici oblige a le renommer la-bas. Sans JavaScript, le formulaire poste
   nativement vers `action`, ce qui marchera des que la fonction existera.

   PUBLIC VISE : des familles en deuil, souvent agees, le plus souvent sur un
   telephone. D ou le peaufinage du 14.10.2026 (passe 2 de E5) : UNE SEULE page,
   complete sans JavaScript, un seul style d ecriture pour tout le monument,
   des tailles de lettres deja choisies, des pastilles de couleur a toucher
   plutot qu une liste deroulante, les sections inutiles repliees selon le type
   de demande, et un brouillon garde dans le navigateur.

   PARCOURS EN 4 ETAPES (passe 3, sous-passe B, `docs/SPEC-DEVIS-ETAPES.md`) :
   les champs sont ranges dans quatre `<section data-etape>` - votre demande,
   le monument, l inscription, vos coordonnees et envoi. Le decoupage est une
   COUCHE JAVASCRIPT par-dessus : sans JavaScript les quatre sections sont
   visibles a la suite, la barre de progression et les boutons "Continuer" et
   "Retour" n apparaissent pas, et le formulaire poste nativement. Tout ce qui
   se replie se replie EN JAVASCRIPT SEULEMENT. */

/* LES POLICES DE GRAVURE NE SE CHARGENT QUE SUR CETTE PAGE (regle de
   performance non negociable, E5). Ces imports sont volontairement ICI, dans la
   page, et PAS dans `BaseLayout.astro` ni dans `src/styles.css` : Astro n en
   met la feuille de style que sur `/devis/`, les 22 autres pages n en portent
   pas un octet. Sous-jeu latin seulement ; `font-display: swap` vient des
   paquets @fontsource. Ne jamais deplacer ces lignes ailleurs.
   Les familles CSS correspondantes sont dans `src/data/personnalisation.ts`. */
import "@fontsource/cinzel/latin-400.css";
import "@fontsource/marcellus/latin-400.css";
import "@fontsource/eb-garamond/latin-400.css";
import "@fontsource/jost/latin-400.css";
import "@fontsource/great-vibes/latin-400.css";
import "@fontsource/pinyon-script/latin-400.css";

const origin = Astro.site ?? new URL(Astro.url.origin);

const products = await getProducts();

/* Les quatre etapes. UNE SEULE source pour le titre de chaque section et pour
   l item correspondant de la barre de progression : `court` est le mot de la
   barre, `titre` celui du `h2`. */
const etapes = [
  { numero: 1, titre: "Votre demande", court: "Votre demande" },
  { numero: 2, titre: "Le monument", court: "Le monument" },
  { numero: 3, titre: "L'inscription", court: "L'inscription" },
  { numero: 4, titre: "Vos coordonnées et envoi", court: "Envoi" },
];

/** « 2. Le monument » : le numero aide la famille a se situer. */
const titreEtape = (numero: number) =>
  `${numero}. ${etapes.find((etape) => etape.numero === numero)?.titre ?? ""}`;

/* Les trois types de demande, en grandes cartes : chacune porte une phrase, car
   « Autre demande » seul n apprend rien a qui lit vite. Les valeurs sont celles
   du contrat (`nouveau`, `inscription`, `autre`). */
const typesDemande = [
  {
    valeur: "nouveau",
    label: "Un nouveau monument",
    phrase: "Une pierre tombale ou un monument cinéraire à créer.",
  },
  {
    valeur: "inscription",
    label: "Une inscription sur un monument existant",
    phrase: "Ajouter un nom, des dates, sur une tombe déjà posée.",
  },
  {
    valeur: "autre",
    label: "Autre demande",
    phrase: "Une remise en état, un nettoyage, une question : dites-nous.",
  },
];

/* Les trois onglets de famille. Leurs valeurs sont celles du contrat
   (`monument`, `cineraire`, ou vide) : seuls les libelles sont au singulier,
   comme les familles les disent. "Je ne sais pas" reste le choix par defaut et
   affiche tous les modeles. */
const ongletsFamille = [
  { valeur: "monument", label: "Monument funéraire" },
  { valeur: "cineraire", label: "Monument cinéraire" },
  { valeur: "", label: "Je ne sais pas" },
];

const groupesGranits = granitsParTeinte();

const policeParDefaut = getPolice(POLICE_DEFAUT) ?? polices[0];
const finitionApercuDefaut = getFinition(FINITION_APERCU_DEFAUT) ?? finitions[0];
/** Repere de teinte quand aucun granit n est choisi : le gris du catalogue. */
const COULEUR_GRANIT_DEFAUT = TEINTE_PASTILLE.gris;

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: "Demander un devis", path: "/devis/" },
  ],
  origin,
);

/* Tout ce que le script a besoin de savoir, pris dans src/config/devis.ts :
   aucune de ces valeurs n est ecrite deux fois. */
const reglages = {
  envoiActif: devisConfig.envoiActif,
  endpoint: devisConfig.endpoint,
  nombreMaxFichiers: fichiersDevis.nombreMax,
  tailleTotaleMaxOctets: fichiersDevis.tailleTotaleMaxOctets,
  typesAcceptes: [...fichiersDevis.typesAcceptes],
  tailleLisible: tailleTotaleMaxLisible,
  messages: messagesDevis,
  /** Cle du brouillon dans le localStorage du navigateur de la famille. */
  cleBrouillon: cleBrouillonDevis,
  /** Famille de chaque modele : sert a poser l onglet famille avec ?modele=. */
  famillesParModele: Object.fromEntries(products.map((product) => [product.slug, product.famille])),

  /* ---- Apercu de la gravure. Tout vient de src/data/personnalisation.ts et
     de src/data/granits.json : aucune valeur n est ecrite deux fois. ---- */
  /** id de police -> { nom affiche, pile CSS }. */
  polices: Object.fromEntries(polices.map((police) => [police.id, { nom: police.nom, famille: police.famille }])),
  /** id de finition -> couleur APPROXIMATIVE du texte grave. */
  couleurParFinition: Object.fromEntries(finitions.map((finition) => [finition.id, finition.couleurApercu])),
  couleurFinitionDefaut: finitionApercuDefaut.couleurApercu,
  /** id de granit -> couleur APPROXIMATIVE de sa teinte (pastille du catalogue). */
  couleurParGranit: Object.fromEntries(granits.map((granit) => [granit.id, TEINTE_PASTILLE[granit.teinte]])),
  couleurGranitDefaut: COULEUR_GRANIT_DEFAUT,
  /** Echelle de l apercu : une lettre de 50 mm s affiche a 30 px. */
  apercuPxParMm: 0.6,
  /** Numeros des lignes d inscription, dans l ordre. */
  lignes: lignesInscription.map((ligne) => ligne.numero),
  /** Motifs qui demandent une explication ou un fichier de la famille. */
  motifsAvecPrecision: motifs.filter((motif) => motif.demandePrecision).map((motif) => motif.id),

  /* ---- Noms lisibles, pour le recapitulatif de l etape 4. Le formulaire
     envoie des identifiants ; la famille doit relire des mots. ---- */
  labelsTypeDemande: Object.fromEntries(typesDemande.map((type) => [type.valeur, type.label])),
  labelsFamille: Object.fromEntries(ongletsFamille.map((onglet) => [onglet.valeur, onglet.label])),
  nomsParModele: Object.fromEntries(products.map((product) => [product.slug, product.name])),
  nomsParGranit: Object.fromEntries(granits.map((granit) => [granit.id, granit.nom])),
  nomsParFinition: Object.fromEntries(finitions.map((finition) => [finition.id, finition.nom])),

  /* ---- Sections affichees selon le type de demande. `monument` = famille,
     modele et granit (etape 2) ; `inscription` = texte grave, finition, motif
     et apercu (etape 3) ; `photo` = le rappel "une photo du monument existant
     nous aide beaucoup". Un type inconnu, ou aucun choix, montre tout.
     Ce meme tableau dit quelles ETAPES sont sautees. ---- */
  blocsParTypeDemande: {
    nouveau: { monument: true, inscription: true, photo: false },
    inscription: { monument: false, inscription: true, photo: true },
    autre: { monument: false, inscription: false, photo: false },
  },
};

/* Les classes des champs. Chacune commence par une classe `grav-*` ou `etape-*`
   habillee dans le `<style>` de la page ; les classes Tailwind qui suivent sont
   celles que la page portait deja. REGLE DE POIDS (passe 3, sous-passe C) : on
   n AJOUTE ni ne RETIRE aucune classe Tailwind, car la feuille Tailwind est
   unique et partagee par les 23 pages - la toucher ferait changer le poids de
   tout le site. Tout l habillage de la sous-passe C passe donc par du CSS de
   page, qui ne part qu avec /devis/. */
const classeChamp = "field mt-2";
const classeErreur = "grav-erreur type-body mt-2 hidden text-[0.8125rem] text-[#8d3c33]";
const classeRadio = "grav-radio mt-1 size-4 shrink-0 accent-[var(--ink)]";
const classeChoix = "grav-choix flex items-start gap-3 text-[0.9375rem]";
const classeAide = "grav-aide type-body mt-2 text-[0.8125rem] text-muted";
const classeTitreEtape = "label etape-titre";
---

<BaseLayout
  title={pageTitle("Demander un devis gratuit")}
  description="Demandez votre devis gratuit : modèle, granit, texte à graver et votre propre dessin si vous en avez un. Nous répondons avec une estimation détaillée."
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[20ch]">Demander un devis</h1>
      <p class="type-lead hero-in mt-8 max-w-[56ch]" style="--reveal-delay:120ms">
        Le devis est gratuit et sans engagement. Répondez seulement à ce que vous savez : nous reprenons
        contact pour le reste, et nous vérifions au besoin le règlement du cimetière concerné.
      </p>
      <p class="type-body hero-in mt-6 max-w-[56ch] text-muted" style="--reveal-delay:200ms">
        Les champs marqués d'une étoile sont nécessaires pour vous répondre. Vous pouvez joindre votre
        propre dessin à faire graver.
      </p>
    </section>

    <section class="shell">
      <div class="rule" data-reveal="line"></div>

      <form
        method="post"
        action={devisConfig.endpoint}
        enctype="multipart/form-data"
        class="mt-12 max-w-[62ch]"
        data-devis
      >
        {/* LA STELE COMPOSEE SUR /personnaliser/ (passe E) : deux champs qui
            s ajoutent au contrat sans rien remplacer (docs/devis-contrat.md,
            « Configurateur »). Hors de tout fieldset : un fieldset replie
            est desactive et ses champs ne partent pas. Remplis par
            src/scripts/devis/scene.ts, vides sinon. */}
        <input type="hidden" name="configurateur_scene" value="" />
        <input type="file" name="configurateur_apercu" accept="image/jpeg" hidden tabindex="-1" aria-hidden="true" />
        {/* Barre de progression. Posee par le script seulement : sans
            JavaScript les quatre sections sont visibles a la suite, et
            annoncer une "etape 1 sur 4" serait faux. */}
        <ol class="etapes" aria-label="Les étapes du formulaire" data-etapes hidden>
          {
            etapes.map((etape) => (
              <li class="etape-item" data-etape-item={String(etape.numero)}>
                <span class="etape-numero" aria-hidden="true">
                  {etape.numero}
                </span>
                <span>{etape.court}</span>
                {/* Une etape sautee se voit grisee et barree. Un texte barre se
                    lit a l oeil mais ne s entend pas : cette mention, montree
                    par le script en meme temps que le gris, le dit aux lecteurs
                    d ecran. Elle reste hors de l oeil (classe `sr`). */}
                <span class="sr" data-etape-sautee-dit hidden>(non concernée)</span>
              </li>
            ))
          }
        </ol>

        {/* Resume d erreurs, rempli par le script. role="alert" : annonce des qu il est rempli.
            Il reste hors des sections pour etre lu quelle que soit l etape. */}
        <p
          class="type-body mb-10 hidden border-l-2 border-[#8d3c33] pl-4 text-[0.9375rem] text-[#8d3c33]"
          data-devis-resume
          role="alert"
        >
        </p>

        {/* Brouillon retrouve. Pose par le script seulement : sans JavaScript il
            n y a pas de brouillon, donc rien a annoncer. */}
        <p class="type-body mb-10 text-[0.9375rem] text-muted" data-brouillon hidden>
          {messagesDevis.brouillonRetrouve}{" "}
          <button type="button" class="link" data-brouillon-effacer>Effacer</button>
        </p>

        {/* ============================================ 1. Votre demande ==== */}
        {/* `typeDemande` commande les etapes suivantes : il vient donc en
            premier, et les etapes 2 et 3 se sautent selon sa valeur. */}
        <section class="etape border-t border-line pt-8" data-etape="1" aria-labelledby="etape-1-titre">
          <h2 class={classeTitreEtape} id="etape-1-titre" data-etape-titre tabindex="-1">
            {titreEtape(1)}
          </h2>

          <fieldset class="mt-6" aria-describedby="typeDemande-erreur">
            <legend class="field-label">Type de demande <span aria-hidden="true">*</span></legend>
            <div class="grav-cartes">
              {
                typesDemande.map((type) => (
                  <label class="grav-carte">
                    <input class={classeRadio} type="radio" name="typeDemande" value={type.valeur} required />
                    <span>
                      <span class="grav-carte-nom">{type.label}</span>
                      <span class="grav-style type-body">{type.phrase}</span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p class={classeErreur} id="typeDemande-erreur" data-erreur="typeDemande"></p>
          </fieldset>

          <div class="mt-10 grid gap-8 md:grid-cols-2">
            <div>
              <label class="field-label" for="communeCimetiere">Commune du cimetière (facultatif)</label>
              <input
                class={classeChamp}
                id="communeCimetiere"
                name="communeCimetiere"
                type="text"
                autocomplete="off"
                aria-describedby="communeCimetiere-aide"
              />
              <p class={classeAide} id="communeCimetiere-aide">
                Chaque commune a son règlement : nous le vérifions pour vous.
              </p>
            </div>

            <div>
              <label class="field-label" for="cimetiere">Cimetière (facultatif)</label>
              <input class={classeChamp} id="cimetiere" name="cimetiere" type="text" autocomplete="off" />
            </div>

            <div>
              <label class="field-label" for="datePoseSouhaitee">Date de pose souhaitée (facultatif)</label>
              <input
                class={classeChamp}
                id="datePoseSouhaitee"
                name="datePoseSouhaitee"
                type="date"
                aria-describedby="datePoseSouhaitee-aide"
              />
              <p class={classeAide} id="datePoseSouhaitee-aide">
                Si vous avez une date en tête, par exemple avant une cérémonie.
              </p>
            </div>
          </div>

          <div class="etape-nav" data-etape-nav hidden>
            <button type="button" class="btn btn-primary" data-continuer>Continuer</button>
          </div>
        </section>

        {/* ============================================== 2. Le monument ==== */}
        {/* Etape sautee pour une inscription sur monument existant ou une autre
            demande : la famille n a alors pas de modele a choisir. Le fieldset
            `data-bloc` est aussi DESACTIVE dans ce cas, pour que ses valeurs
            par defaut ne partent pas avec la demande. */}
        <section
          class="etape mt-16 border-t border-line pt-8"
          data-etape="2"
          aria-labelledby="etape-2-titre"
        >
          <h2 class={classeTitreEtape} id="etape-2-titre" data-etape-titre tabindex="-1">
            {titreEtape(2)}
          </h2>

          {/* Votre stele composee : pose par src/scripts/devis/scene.ts quand
              une scene du configurateur attend dans le navigateur. */}
          <div class="scene mt-6" data-scene hidden>
            <p class="label">Votre stèle composée</p>
            <img class="scene-image mt-3" alt="" data-scene-image hidden />
            <p class="type-body mt-3 text-[0.9375rem]" data-scene-resume></p>
            <p class="type-body mt-3 text-[0.9375rem]">
              <a class="link" href="/personnaliser/" data-scene-modifier>Modifier la composition</a>
              {" · "}
              <button type="button" class="link" data-scene-retirer>Repartir du formulaire vide</button>
            </p>
          </div>

          <fieldset data-bloc="monument">
            {/* Famille et modele se choisissent a l oeil, plus dans deux listes
                deroulantes : trois onglets larges, puis une grille de cartes
                avec la vignette du catalogue. Les onglets filtrent la grille EN
                JAVASCRIPT SEULEMENT ; sans JavaScript, les cartes sont toutes
                la, groupees par famille sous leur sous-titre. */}
            <fieldset class="mt-6">
              <legend class="field-label">Famille de monument</legend>
              <div class="grav-onglets">
                {
                  ongletsFamille.map((onglet) => (
                    <label class="grav-onglet">
                      <input
                        class={classeRadio}
                        type="radio"
                        name="famille"
                        value={onglet.valeur}
                        checked={onglet.valeur === ""}
                      />
                      <span>{onglet.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="mt-10">
              <legend class="field-label">Modèle du catalogue (facultatif)</legend>
              <p class="grav-aide type-body mt-2 max-w-[56ch] text-[0.8125rem] text-muted">
                Pour nous donner une idée. Rien n'est définitif : nous en reparlons ensemble.
              </p>
              <ChoixModele modeleInitial="" />
            </fieldset>

            {/* Pastilles de couleur plutot qu une liste deroulante : une teinte
                se reconnait a l oeil, et une pastille se touche du pouce. Ce
                sont de vrais boutons radio, seulement habilles : ils restent
                utilisables au clavier et sans JavaScript. Les couleurs viennent
                de TEINTE_PASTILLE (src/data/granits.ts) : approximatives,
                jamais un echantillon, ce que dit l aide sous les groupes. */}
            <fieldset class="mt-12" aria-describedby="granit-aide">
              <legend class="field-label">Granit souhaité</legend>

              <label class={`${classeChoix} mt-4`}>
                <input class={classeRadio} type="radio" name="granit" value="" checked />
                <span>Je ne sais pas encore</span>
              </label>

              {
                groupesGranits.map((groupe) => (
                  <div class="grav-granit-groupe">
                    <p class="grav-granit-titre type-body">{groupe.titre}</p>
                    <div class="grav-pastilles">
                      {groupe.granits.map((granit) => (
                        <label class="grav-pastille">
                          <input type="radio" name="granit" value={granit.id} />
                          <span
                            class="grav-rond"
                            style={`background-color:${TEINTE_PASTILLE[granit.teinte]}`}
                            aria-hidden="true"
                          />
                          <span class="grav-pastille-nom">{granit.nom}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                ))
              }

              <p class={classeAide} id="granit-aide">
                Les couleurs ci-dessus sont approximatives. Une teinte se juge sur la pierre : le choix se
                confirme au rendez-vous.
              </p>
            </fieldset>
          </fieldset>

          <div class="etape-nav" data-etape-nav hidden>
            <button type="button" class="btn btn-outline" data-retour>Retour</button>
            <button type="button" class="btn btn-primary" data-continuer>Continuer</button>
          </div>
        </section>

        {/* ============================================ 3. L'inscription ==== */}
        {/* Etape sautee pour une autre demande. */}
        <section
          class="etape mt-16 border-t border-line pt-8"
          data-etape="3"
          aria-labelledby="etape-3-titre"
        >
          <h2 class={classeTitreEtape} id="etape-3-titre" data-etape-titre tabindex="-1">
            {titreEtape(3)}
          </h2>

          <fieldset data-bloc="inscription">
            <p class="type-body mt-6 max-w-[56ch] text-[0.9375rem] text-muted">
              Deux lignes suffisent pour commencer : le plus souvent le nom, puis les dates. Vous pouvez en
              ajouter. Rien n'est définitif, et rien ne part à la gravure sans votre accord sur un bon à
              tirer.
            </p>

            {/* UN SEUL style d ecriture pour tout le monument (pratique
                courante des marbriers) : chaque nom est ecrit dans sa propre
                police, donc l echantillon EST le choix. Statique : lisible et
                utilisable sans JavaScript. */}
            <fieldset class="mt-10">
              <legend class="field-label">Style d'écriture</legend>
              <p class="grav-aide type-body mt-2 max-w-[56ch] text-[0.8125rem] text-muted">
                Le même style pour toutes les lignes. Chaque nom est écrit dans son style.
              </p>
              <div class="grav-polices">
                {
                  polices.map((police) => (
                    <label>
                      <input
                        class={classeRadio}
                        type="radio"
                        name="police"
                        value={police.id}
                        checked={police.id === policeParDefaut.id}
                      />
                      <span>
                        <span class="grav-nom" style={`font-family:${police.famille}`}>
                          {police.nom}
                        </span>
                        <span class="grav-style type-body">{STYLE_POLICE_LABELS[police.style]}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            {/* Les tailles de lettres sont deja choisies : une famille n a rien
                a decider ici si elle ne le souhaite pas. Les valeurs envoyees
                restent en millimetres (contrat inchange), seul l affichage est
                en centimetres. */}
            {
              lignesInscription.map((ligne) => (
                <div data-ligne-sup={ligne.repliable ? String(ligne.numero) : undefined}>
                  <fieldset class="mt-10">
                    <legend class="field-label">{ligne.label}</legend>
                    <div class="grav-ligne mt-3">
                      <div>
                        <label class="grav-sous-label type-body" for={`ligne${ligne.numero}_texte`}>
                          Texte
                        </label>
                        <input
                          class={classeChamp}
                          id={`ligne${ligne.numero}_texte`}
                          name={`ligne${ligne.numero}_texte`}
                          type="text"
                          maxlength={LIGNE_LONGUEUR_MAX}
                          autocomplete="off"
                          aria-describedby={ligne.aide ? `ligne${ligne.numero}_texte-aide` : undefined}
                        />
                        {ligne.aide && (
                          <p class={classeAide} id={`ligne${ligne.numero}_texte-aide`}>
                            {ligne.aide}
                          </p>
                        )}
                      </div>

                      <div class="grav-reglages">
                        <label class="grav-sous-label type-body" for={`ligne${ligne.numero}_hauteur`}>
                          Taille des lettres
                        </label>
                        <select
                          class={classeChamp}
                          id={`ligne${ligne.numero}_hauteur`}
                          name={`ligne${ligne.numero}_hauteur`}
                        >
                          {hauteursLettresMm.map((hauteur) => (
                            <option value={String(hauteur)} selected={hauteur === ligne.hauteurParDefaut}>
                              {hauteurLabel(hauteur)}
                            </option>
                          ))}
                        </select>
                      </div>
                    </div>
                  </fieldset>
                </div>
              ))
            }

            {/* Pose par le script, qui replie d abord les lignes 3 et 4. Sans
                JavaScript, les quatre lignes sont la et ce bouton n apparait
                jamais. */}
            <button type="button" class="btn btn-outline mt-8" data-ajouter-ligne hidden>
              Ajouter une ligne
            </button>

            <div class="mt-12">
              <label class="field-label" for="gravure_precisions">
                Précisions sur la gravure (facultatif)
              </label>
              <textarea
                class={classeChamp}
                id="gravure_precisions"
                name="gravure_precisions"
                rows="5"
                aria-describedby="gravure_precisions-aide"></textarea>
              <p class={classeAide} id="gravure_precisions-aide">
                Épitaphe longue, disposition souhaitée, lignes supplémentaires, accents et orthographe
                exacte des noms.
              </p>
            </div>

            <fieldset class="mt-12">
              <legend class="field-label">Finition de la gravure</legend>
              <div class="mt-4 space-y-3">
                <label class={classeChoix}>
                  <input class={classeRadio} type="radio" name="finition" value="" checked />
                  <span>Je ne sais pas encore</span>
                </label>
                {
                  finitions.map((finition) => (
                    <label class={classeChoix}>
                      <input class={classeRadio} type="radio" name="finition" value={finition.id} />
                      <span>
                        {finition.nom}
                        <span class="grav-style type-body">{finition.aide}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div class="grav-motif mt-10">
              <label class="field-label" for="motif">Motif gravé</label>
              <select class={classeChamp} id="motif" name="motif" aria-describedby="motif-aide">
                {
                  motifs.map((motif) => (
                    <option value={motif.id} selected={motif.id === MOTIF_DEFAUT}>
                      {motif.nom}
                    </option>
                  ))
                }
              </select>
              <p class={classeAide} id="motif-aide">
                Pour « autre symbole » ou « dessin fourni par la famille », décrivez-le dans les précisions
                ci-dessus et joignez votre fichier à l'étape suivante.
              </p>
              {/* Rappel mis en avant par le script quand le choix le demande. */}
              <p class="grav-rappel type-body" data-motif-rappel hidden>
                Ce choix demande un document de votre part : ajoutez votre dessin ou votre croquis dans
                « Fichiers à joindre », à l'étape suivante.
              </p>
            </div>
          </fieldset>

          {/* Place de l apercu. Le script le DEPLACE dans le recapitulatif de
              l etape 4 quand une ligne est remplie, et le ramene ici des que la
              famille revient a cette etape : un seul noeud, une seule fonction
              `majApercu`. Sans JavaScript l apercu reste cache (un cadre vide
              n apprendrait rien) et le formulaire est complet. */}
          <div class="mt-16 border-t border-line pt-8" data-apercu-place data-bloc="inscription">
            <div data-apercu hidden>
              <p class="label">Aperçu de la gravure</p>
              <div class="grav-cadre" style={`background-color:${COULEUR_GRANIT_DEFAUT}`} data-apercu-cadre>
                <p class="grav-vide type-body" data-apercu-vide>
                  Saisissez votre texte ci-dessus pour le voir apparaître ici.
                </p>
                {lignesInscription.map((ligne) => <p data-apercu-ligne={String(ligne.numero)} hidden></p>)}
              </div>
              <p class="grav-aide type-body mt-3 max-w-[56ch] text-[0.8125rem] text-muted">
                {MENTION_APERCU}
              </p>
            </div>
          </div>

          <div class="etape-nav" data-etape-nav hidden>
            <button type="button" class="btn btn-outline" data-retour>Retour</button>
            <button type="button" class="btn btn-primary" data-continuer>Continuer</button>
          </div>
        </section>

        {/* ================================ 4. Vos coordonnées et envoi ==== */}
        {/* Les coordonnees viennent en DERNIER : la famille a d abord dit ce
            qu elle cherche, elle donne son adresse ensuite. */}
        <section
          class="etape mt-16 border-t border-line pt-8"
          data-etape="4"
          aria-labelledby="etape-4-titre"
        >
          <h2 class={classeTitreEtape} id="etape-4-titre" data-etape-titre tabindex="-1">
            {titreEtape(4)}
          </h2>

          <div class="mt-6 grid gap-8 md:grid-cols-2">
            <div>
              <label class="field-label" for="nom">Nom et prénom <span aria-hidden="true">*</span></label>
              <input
                class={classeChamp}
                id="nom"
                name="nom"
                type="text"
                required
                autocomplete="name"
                aria-describedby="nom-erreur"
              />
              <p class={classeErreur} id="nom-erreur" data-erreur="nom"></p>
            </div>

            <div>
              <label class="field-label" for="email">Adresse e-mail <span aria-hidden="true">*</span></label>
              <input
                class={classeChamp}
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-describedby="email-erreur"
              />
              <p class={classeErreur} id="email-erreur" data-erreur="email"></p>
            </div>

            <div>
              {/* L etoile apparait quand la famille demande un appel : c est
                  alors le seul moyen de la joindre. Le script seul la pose, en
                  meme temps que `required` ; sans JavaScript le telephone reste
                  facultatif, comme l annonce le libelle. */}
              <label class="field-label" for="telephone">
                Téléphone <span data-tel-facultatif>(facultatif)</span><span
                  data-tel-requis
                  aria-hidden="true"
                  hidden>*</span
                >
              </label>
              <input
                class={classeChamp}
                id="telephone"
                name="telephone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                aria-describedby="telephone-aide telephone-erreur"
              />
              {/* `inputmode="tel"` ouvre le pave numerique du telephone, et
                  l exemple evite d avoir a deviner le format attendu. */}
              <p class={classeAide} id="telephone-aide">
                Si vous préférez que nous vous appelions. Par exemple 079 123 45 67.
              </p>
              <p class={classeErreur} id="telephone-erreur" data-erreur="telephone"></p>
            </div>

            <div>
              <label class="field-label" for="localite">Localité <span aria-hidden="true">*</span></label>
              <input
                class={classeChamp}
                id="localite"
                name="localite"
                type="text"
                required
                autocomplete="address-level2"
                aria-describedby="localite-aide localite-erreur"
              />
              <p class={classeAide} id="localite-aide">Votre commune, pour situer le déplacement.</p>
              <p class={classeErreur} id="localite-erreur" data-erreur="localite"></p>
            </div>
          </div>

          <fieldset class="mt-10">
            <legend class="field-label">Comment vous recontacter</legend>
            <div class="mt-4 space-y-3">
              {
                [
                  { valeur: "telephone", label: "Par téléphone" },
                  { valeur: "email", label: "Par e-mail" },
                ].map((choix) => (
                  <label class={classeChoix}>
                    <input
                      class={classeRadio}
                      type="radio"
                      name="recontact"
                      value={choix.valeur}
                      checked={choix.valeur === "email"}
                    />
                    <span>{choix.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          {/* Visible sans JavaScript (facultatif de toute facon) ; le script le
              replie tant que la famille n a pas demandé un appel. */}
          <div class="grav-court mt-10" data-quand-appeler>
            <label class="field-label" for="quandAppeler">Quand vous appeler ? (facultatif)</label>
            <input
              class={classeChamp}
              id="quandAppeler"
              name="quandAppeler"
              type="text"
              autocomplete="off"
              aria-describedby="quandAppeler-aide"
            />
            <p class={classeAide} id="quandAppeler-aide">
              Par exemple : le matin, ou après 17 h.
            </p>
          </div>

          <div class="mt-12 border-t border-line pt-8">
            <p class="label">Fichiers à joindre</p>
            {/* Mis en avant par le script pour une inscription sur monument
                existant : c est le cas ou la photo nous sert le plus. Sans
                JavaScript le rappel reste affiche, comme tout le reste. */}
            <p class="grav-rappel type-body" data-aide-photo>
              Une photo du monument existant nous aide beaucoup.
            </p>

            <label class="field-label mt-6" for="fichiers">Fichiers à joindre (facultatif)</label>
            <input
              class="grav-fichier mt-3 block w-full text-[0.9375rem]"
              id="fichiers"
              name="fichiers"
              type="file"
              multiple
              accept={acceptFichiers}
              aria-describedby="fichiers-aide fichiers-erreur"
            />
            <p class="grav-aide type-body mt-3 text-[0.8125rem] text-muted" id="fichiers-aide">
              Un dessin à faire graver, une photo du monument existant, une esquisse. JPEG, PNG, WEBP ou
              PDF, {fichiersDevis.nombreMax} fichiers au maximum et {tailleTotaleMaxLisible} au total.
            </p>
            <p class={classeErreur} id="fichiers-erreur" data-erreur="fichiers"></p>
          </div>

          <div class="mt-12 border-t border-line pt-8">
            <label class="field-label" for="message">Message (facultatif)</label>
            <textarea
              class={classeChamp}
              id="message"
              name="message"
              rows="5"
              aria-describedby="message-aide"></textarea>
            <p class={classeAide} id="message-aide">
              Tout ce qui nous aiderait : délai souhaité, monument voisin, question particulière.
            </p>
          </div>

          <div class="mt-12 border-t border-line pt-8">
            <label class={classeChoix} for="consentement">
              <input
                class={classeRadio}
                id="consentement"
                name="consentement"
                type="checkbox"
                value="oui"
                required
                aria-describedby="consentement-erreur"
              />
              <span>
                J'accepte que mes données soient utilisées pour traiter ma demande
                <span aria-hidden="true">*</span>. Voir la{" "}
                <a href="/protection-des-donnees/" class="link">protection des données</a>.
              </span>
            </label>
            <p class={classeErreur} id="consentement-erreur" data-erreur="consentement"></p>
          </div>

          {/* Recapitulatif. Rempli par le script a chaque affichage de cette
              etape, en lecture seule : la famille relit ce qu elle a demandé
              avant d envoyer, et chaque bloc ramene a son etape. Sans
              JavaScript il n apparait pas : toutes les reponses sont alors
              visibles a la suite, juste au-dessus. */}
          <div class="recap mt-12" data-recap hidden>
            <p class="label">Votre demande en bref</p>
            <p class="type-body mt-3 max-w-[56ch] text-[0.9375rem]">
              Vérifiez les noms et les dates : c'est ce qui sera gravé.
            </p>
            <div data-recap-blocs></div>
            <div data-recap-apercu></div>
          </div>

          {/* Anti-spam. Le champ `societe` est un piege : invisible et hors du
              parcours au clavier, une famille ne le remplit jamais, un robot si.
              `horodatage` porte l heure d affichage, posee par le script (la page
              est statique, le serveur ne peut pas la fournir). Les deux ne font
              que voyager : c est la fonction E6 qui tranche. */}
          <div
            aria-hidden="true"
            style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"
          >
            <label for="societe">Société</label>
            <input id="societe" name="societe" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="horodatage" value="" />

          {/* Emplacement de Cloudflare Turnstile (etape E6) : le widget viendra
              ici, juste avant le bouton. Sa cle de site, meme publique, sera
              lue dans une variable d environnement Cloudflare : aucune cle,
              publique ou secrete, n entre dans le depot. */}

          <div class="etape-nav" data-etape-nav hidden>
            <button type="button" class="btn btn-outline" data-retour>Retour</button>
          </div>

          <div class="mt-12 flex flex-wrap items-center gap-6">
            <button type="submit" class="btn btn-primary" data-devis-envoyer>Envoyer ma demande</button>
            <p class="type-body hidden text-[0.9375rem]" data-devis-statut role="status" aria-live="polite">
            </p>
          </div>
          <p class="type-body mt-6 max-w-[56ch] text-[0.9375rem] text-muted">
            Nous vous recontactons pour affiner votre demande. Rien n'est engagé, et rien n'est gravé avant
            votre accord.
          </p>
        </section>
      </form>
    </section>

    {/* ------------------------------------------------------------- Reperes */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <div class="mt-8 grid gap-8 md:grid-cols-3" data-reveal>
        <p class="type-body max-w-[34ch] text-[0.9375rem]">
          Le devis est gratuit et sans engagement, et détaille ce qui est compris.
        </p>
        <p class="type-body max-w-[34ch] text-[0.9375rem]">
          <a href="/prix-pierre-tombale-suisse/" class="link">Comment est calculé le prix ?</a>
        </p>
        <p class="type-body max-w-[34ch] text-[0.9375rem]">
          <a href="/faq/" class="link">Questions fréquentes</a>
        </p>
      </div>
    </section>
  </main>

  {/* Habillage des sections de personnalisation. Ecrit en CSS plutot qu en
      utilitaires Tailwind POUR UNE RAISON DE POIDS : la feuille Tailwind est
      unique et partagee par les 23 pages, donc toute classe inedite utilisee
      ici alourdirait aussi l accueil et les fiches. Ce bloc, lui, reste sur
      /devis/. Les classes Tailwind gardees ci-dessus servaient deja ailleurs
      dans le site : elles ne coutent rien de plus. */}
  <style>
    /* La stele composee sur /personnaliser/ (passe E). */
    .scene {
      padding: 1rem 1.125rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
    }

    .scene-image {
      display: block;
      width: 100%;
      max-width: 28rem;
      border-radius: 3px;
    }

    .scene[hidden],
    .scene-image[hidden] {
      display: none;
    }

    .grav-court {
      max-width: 24rem;
    }

    /* L attribut `hidden` doit TOUJOURS l emporter sur un `display` du theme.
       Sans cette ligne, le bouton "Ajouter une ligne" (classe `btn`, donc
       `display: inline-flex`) apparaitrait quand JavaScript est absent, alors
       que les quatre lignes sont deja toutes la. Ce bloc n etant dans aucune
       couche CSS, il l emporte sur `@layer components` sans `!important`.
       Les regles plus precises `.etapes[hidden]` et `.etape-nav[hidden]`
       ci-dessous font le meme travail pour ces deux-la, quel que soit l ordre. */
    [hidden] {
      display: none;
    }

    /* Hors de l oeil, mais lu par les lecteurs d ecran. Meme recette que le
       piege anti-robot plus haut dans la page : jamais `display: none`, qui
       retirerait le texte de la lecture. */
    .sr {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    /* ------------------------------------------------- Lisibilite generale ---
       SOUS-PASSE C. Public vise : des familles agees, sur un telephone, souvent
       en plein jour. D ou : des libelles en minuscules a 16 px dans la couleur
       du texte (le mono gris de 10 px du theme ne reste QUE sur les titres
       d etape et de section), des aides a 15 px au moins, des champs en boites
       completes et des zones a toucher d au moins 48 px.
       Ces regles REMPLACENT ici celles de `src/styles.css` : ce bloc n est pas
       dans une couche CSS (`@layer`), il l emporte donc sur les composants et
       les utilitaires Tailwind sans avoir besoin d un selecteur plus precis. Et
       comme Astro le limite a cette page, les 22 autres ne changent pas. */

    /* Libelle de champ : une phrase, pas une etiquette technique. */
    .field-label {
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.4;
      letter-spacing: -0.006em;
      text-transform: none;
      color: var(--ink);
    }

    /* Texte d aide sous un champ. `--muted` donne 6,3:1 sur le fond : au-dela
       du minimum de 4,5:1, meme a cette taille. */
    .grav-aide {
      font-size: 0.9375rem;
    }

    /* Message d erreur. Le brun-rouge donne 6,4:1 sur le fond ; la taille le
       met au niveau du texte courant, car c est ce qu il faut lire en premier. */
    .grav-erreur {
      font-size: 0.9375rem;
    }

    /* Champs texte, listes deroulantes et zones de texte : une BOITE COMPLETE,
       pas un simple trait bas. Un trait seul se devine mal sur un telephone, et
       rien ne dit alors ou commence la zone a toucher. */
    .field {
      min-height: 3rem;
      padding: 0.6875rem 0.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background-color: var(--canvas);
      font-size: 1rem;
    }
    .field:focus,
    .field:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 1px;
      border-color: var(--ink);
    }
    .grav-fichier {
      min-height: 3rem;
      padding: 0.6875rem 0.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      font-size: 1rem;
    }

    /* Les boutons radio et les cases restent NATIFS et VISIBLES (sauf pastilles
       de granit et cartes modele, ou la couleur et la vignette font le travail) :
       une famille agee reconnait un rond coche. 20 px plutot que 16. */
    .grav-radio {
      width: 1.25rem;
      height: 1.25rem;
    }

    /* Un choix a cocher = une boite d au moins 48 px de haut, bordee, que l on
       touche n importe ou. Coche : bordure de 2 px, fond teinte, et le rond
       natif coche - jamais la couleur seule. */
    .grav-choix {
      padding: 0.875rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      min-height: 3rem;
      font-size: 1rem;
      line-height: 1.45;
      cursor: pointer;
    }
    .grav-choix:has(input:checked) {
      padding: calc(0.875rem - 1px);
      border-width: 2px;
      border-color: var(--ink);
      background-color: var(--surface);
    }
    .grav-choix:has(input:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    /* Les quatre etapes : barre de progression, boutons, titres. */
    .etapes {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      margin: 0 0 2.5rem;
      padding: 0;
      list-style: none;
      font-size: 0.875rem;
      color: var(--muted);
    }
    /* `display: flex` l emporterait sur le `display: none` que le navigateur
       applique a l attribut `hidden` : sans cette ligne, la barre et les boutons
       de navigation apparaitraient AUSSI quand JavaScript est absent, alors que
       les quatre etapes sont alors visibles a la suite et qu il n y a rien a
       numeroter. Meme precaution plus bas pour `.etape-nav`. */
    .etapes[hidden] {
      display: none;
    }
    .etape-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .etape-numero {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      font-size: 0.875rem;
    }
    .etape-item[aria-current="step"] {
      color: var(--ink);
      font-weight: 500;
    }
    /* L etape en cours est la seule pastille pleine : elle se repere sans lire. */
    .etape-item[aria-current="step"] .etape-numero {
      border-color: var(--ink);
      background-color: var(--ink);
      color: var(--canvas);
    }
    /* Une etape sautee reste visible, grisee et barree : la famille voit qu elle
       n a pas ete oubliee, mais qu elle ne la concerne pas. Pas d `opacity`, qui
       ferait tomber le contraste sous le minimum ; le gris du theme tient 6,3:1
       et le texte barre dit le reste a l oeil, la mention `.sr` au casque. */
    .etape-item[data-sautee] {
      color: var(--muted);
      text-decoration: line-through;
    }
    .etape-item[data-sautee] .etape-numero {
      text-decoration: none;
    }

    /* Navigation. Sur telephone les boutons prennent toute la largeur et
       "Continuer" passe AU-DESSUS de "Retour" (`column-reverse` : il est le
       dernier dans le HTML, donc le premier a l oeil) - le geste qui avance
       doit tomber sous le pouce, celui qui recule plus loin. */
    .etape-nav {
      display: flex;
      flex-direction: column-reverse;
      gap: 0.75rem;
      margin-top: 2.5rem;
    }
    .etape-nav[hidden] {
      display: none;
    }
    .etape-titre {
      font-size: 0.9375rem;
      color: var(--ink);
    }
    .etape-titre:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 4px;
    }
    /* Les titres de section mono majuscules du theme : gardes, mais un cran plus
       lisibles que les 11 px d origine. Selecteur sur `p` pour ne pas rattraper
       le `h2` de l etape, qui porte lui aussi la classe `label`. */
    .etape p.label {
      font-size: 0.8125rem;
    }

    /* Boutons du parcours : hauts de 52 px, en minuscules et a 16 px plutot que
       le petit mono majuscule du theme. "Continuer" et "Envoyer" en fond sombre,
       "Retour" en bordure (classes `btn-primary` et `btn-outline` du theme). */
    .etape-nav .btn,
    [data-devis-envoyer],
    [data-ajouter-ligne] {
      min-height: 3.25rem;
      padding: 0.875rem 1.5rem;
      font-family: var(--font-sans);
      font-size: 1rem;
      letter-spacing: -0.006em;
      text-transform: none;
      white-space: normal;
    }
    @media (max-width: 39.9375rem) {
      .etape-nav .btn,
      [data-devis-envoyer] {
        width: 100%;
      }
    }
    @media (min-width: 40rem) {
      .etape-nav {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 1rem;
      }
    }

    /* Les trois types de demande, en cartes : la phrase explique le choix.
       L etat coche se lit sur la bordure epaisse, pas sur une couleur seule ;
       le padding compense pour que rien ne bouge au clic. */
    .grav-cartes {
      display: grid;
      gap: 0.75rem;
      margin-top: 1rem;
    }
    .grav-carte {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      min-height: 3rem;
      padding: 1rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      cursor: pointer;
    }
    .grav-carte:has(input:checked) {
      padding: calc(1rem - 1px);
      border-width: 2px;
      border-color: var(--ink);
      background-color: var(--surface);
    }
    .grav-carte:has(input:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
    .grav-carte-nom {
      display: block;
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.35;
    }

    /* Le recapitulatif de l etape 4 : lecture seule, un bloc par etape. */
    .recap {
      border: 1px solid var(--line-strong);
      padding: 1.25rem;
    }
    .recap-bloc {
      margin-top: 1.5rem;
      border-top: 1px solid var(--line);
      padding-top: 1.25rem;
    }
    .recap-entete {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      margin: 0;
    }
    .recap-titre {
      font-size: 1rem;
      font-weight: 600;
    }
    /* Le lien "Modifier" est SOULIGNE en permanence : un mot cliquable qui
       n a l air cliquable qu au survol n existe pas sur un telephone. La
       hauteur de 44 px lui donne une zone a toucher. */
    .recap-modifier {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      font-size: 1rem;
      text-decoration: underline;
    }
    /* Chaque bloc est une liste de definitions : l intitule au-dessus, la
       reponse en dessous. Sur un telephone etroit, rien ne se tasse en colonnes
       et chaque reponse garde toute la largeur. */
    .recap-liste {
      margin: 0.75rem 0 0;
    }
    .recap-cle {
      font-size: 0.9375rem;
      color: var(--muted);
    }
    .recap-valeur {
      margin: 0.125rem 0 0.875rem;
      font-size: 1rem;
    }
    .recap-valeur:last-child {
      margin-bottom: 0;
    }

    /* Les 6 styles d ecriture. Chaque nom est ecrit dans sa police : la liste
       est a la fois l echantillon et le choix. */
    .grav-polices {
      display: grid;
      gap: 0.75rem;
      margin-top: 1rem;
    }
    /* Chaque echantillon est une boite a toucher, comme les autres choix. */
    .grav-polices label {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.875rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      cursor: pointer;
    }
    .grav-polices label:has(input:checked) {
      padding: calc(0.875rem - 1px);
      border-width: 2px;
      border-color: var(--ink);
      background-color: var(--surface);
    }
    .grav-polices label:has(input:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
    .grav-nom {
      display: block;
      font-size: 1.5rem;
      line-height: 1.1;
      color: var(--ink);
    }
    .grav-style {
      display: block;
      margin-top: 0.25rem;
      font-size: 0.875rem;
      color: var(--muted);
    }

    /* Les trois onglets de famille : de vrais boutons radio `famille`, habilles
       en grands paves d au moins 48 px. Le rond natif reste VISIBLE (il l etait
       masque en sous-passe A) : une famille agee reconnait un rond coche bien
       mieux qu une bordure. Un pave par ligne sur telephone, les trois cote a
       cote au-dela : trois paves serres sur 390 px ne se touchent pas. */
    .grav-onglets {
      display: grid;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
    .grav-onglet {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-height: 3rem;
      padding: 0.875rem 1rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      font-size: 1rem;
      cursor: pointer;
    }
    /* Le `mt-1` des autres ronds ne sert qu aux libelles sur plusieurs lignes :
       ici le pave est centre. */
    .grav-onglet input {
      margin-top: 0;
    }
    .grav-onglet:has(input:checked) {
      padding: calc(0.875rem - 1px) calc(1rem - 1px);
      border-width: 2px;
      border-color: var(--ink);
      background-color: var(--surface);
      font-weight: 500;
    }
    .grav-onglet:has(input:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    /* Pastilles de granit : de vrais boutons radio, masques a l oeil mais
       toujours la pour le clavier et les lecteurs d ecran. L etat coche et le
       focus se lisent sur l anneau de la pastille. */
    .grav-granit-groupe {
      margin-top: 1.75rem;
    }
    .grav-granit-titre {
      margin: 0;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--ink);
    }
    .grav-pastilles {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 1.25rem;
      margin-top: 0.75rem;
    }
    .grav-pastille {
      position: relative;
      display: flex;
      width: 5rem;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      text-align: center;
    }
    .grav-pastille input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }
    .grav-rond {
      display: block;
      width: 3rem;
      height: 3rem;
      border-radius: 999px;
      box-shadow: inset 0 0 0 1px var(--line-strong);
      transition: box-shadow 200ms ease;
    }
    .grav-pastille input:checked + .grav-rond,
    .grav-pastille input:focus-visible + .grav-rond {
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        0 0 0 2px var(--canvas),
        0 0 0 4px var(--ink);
    }
    .grav-pastille-nom {
      font-size: 0.875rem;
      line-height: 1.25;
      color: var(--muted);
    }
    .grav-pastille input:checked ~ .grav-pastille-nom {
      color: var(--ink);
    }

    /* Une ligne d inscription : son texte, et la taille de ses lettres. */
    .grav-ligne {
      display: grid;
      gap: 1.25rem;
    }
    /* « Texte » et « Taille des lettres » sont des libelles de champ comme les
       autres : meme taille, meme couleur. */
    .grav-sous-label {
      display: block;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink);
    }
    .grav-rappel {
      margin-top: 0.75rem;
      border-left: 2px solid var(--line);
      padding-left: 1rem;
      font-size: 0.9375rem;
    }
    .grav-motif {
      max-width: 32rem;
    }
    @media (min-width: 40rem) {
      .grav-polices {
        grid-template-columns: 1fr 1fr;
      }
      .grav-onglets {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (min-width: 48rem) {
      .grav-ligne {
        grid-template-columns: 1fr auto;
        align-items: start;
      }
      .grav-reglages {
        width: 11rem;
      }
    }

    /* L apercu. Le cadre prend la couleur approximative du granit choisi ;
       un granit clair sous une gravure blanche se lit mal, une ombre tres
       legere detache donc les lettres, comme le fait le creux de la gravure. */
    .grav-cadre {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.5rem;
      min-height: 12rem;
      padding: 2.5rem 1.5rem;
      text-align: center;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    }
    .grav-cadre p {
      margin: 0;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
    .grav-vide {
      font-size: 0.9375rem;
      color: #f4f1ea;
    }
  </style>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />

  <script>
    import "@/scripts/devis/scene";
  </script>
  <script is:inline define:vars={{ reglages }}>
    (() => {
      const form = document.querySelector("[data-devis]");
      if (!form) return;

      /* On prend la main sur la validation : les messages maison sont en
         francais, places sous le champ et annonces. Sans JavaScript, ce sont
         les messages du navigateur qui jouent, grace aux attributs `required`
         du HTML. */
      form.noValidate = true;

      const resume = form.querySelector("[data-devis-resume]");
      const statut = form.querySelector("[data-devis-statut]");
      const bouton = form.querySelector("[data-devis-envoyer]");

      const champ = (nom) => form.elements[nom];
      const zoneErreur = (nom) => form.querySelector(`[data-erreur="${nom}"]`);

      /* `form.elements.typeDemande` est la liste des trois boutons radio, pas
         un champ : on prend le premier pour poser l etat et le focus. */
      function premierControle(nom) {
        const controle = champ(nom);
        if (typeof RadioNodeList !== "undefined" && controle instanceof RadioNodeList) {
          return controle[0];
        }
        return controle;
      }

      function poseErreur(nom, texte) {
        const zone = zoneErreur(nom);
        if (!zone) return;
        zone.textContent = texte;
        zone.classList.remove("hidden");
        const controle = premierControle(nom);
        if (controle && controle.setAttribute) controle.setAttribute("aria-invalid", "true");
      }

      /** Vide les messages d erreur, de tout le formulaire ou d une seule etape. */
      function videErreurs(portee) {
        const racine = portee || form;
        racine.querySelectorAll("[data-erreur]").forEach((zone) => {
          zone.textContent = "";
          zone.classList.add("hidden");
          const controle = premierControle(zone.dataset.erreur);
          if (controle && controle.removeAttribute) controle.removeAttribute("aria-invalid");
        });
        resume.textContent = "";
        resume.classList.add("hidden");
      }

      function annonce(texte) {
        statut.textContent = texte;
        statut.classList.toggle("hidden", texte === "");
      }

      // Horodatage d affichage : un robot poste en quelques millisecondes.
      function poseHorodatage() {
        const horodatage = champ("horodatage");
        if (horodatage) horodatage.value = String(Date.now());
      }

      /* Date de pose : on ne peut pas poser quelque chose dans le passe. Le
         `min` est mis AU CHARGEMENT et non au build, sinon une page gardee en
         cache proposerait encore la date de sa generation.
         FUSEAU LOCAL, calcule champ par champ : `toISOString()` passe par UTC
         et donnerait la veille en Suisse avant une ou deux heures du matin. */
      function poseDateMinimale() {
        const date = champ("datePoseSouhaitee");
        if (!date) return;
        const jour = new Date();
        const mois = String(jour.getMonth() + 1).padStart(2, "0");
        const quantieme = String(jour.getDate()).padStart(2, "0");
        date.min = `${jour.getFullYear()}-${mois}-${quantieme}`;
      }

      /* ----------------------------------------- Comment vous recontacter ---
         Par defaut nous repondons par e-mail, et le telephone est facultatif.
         Si la famille prefere un appel, le numero devient NECESSAIRE (c est
         alors le seul moyen de la joindre) et nous lui demandons quand
         l appeler. Sans JavaScript, les deux champs restent visibles et
         facultatifs : aucun champ masque n est jamais `required`. */
      const telephone = champ("telephone");
      const blocQuandAppeler = form.querySelector("[data-quand-appeler]");
      const telFacultatif = form.querySelector("[data-tel-facultatif]");
      const telRequis = form.querySelector("[data-tel-requis]");

      function majRecontact() {
        const recontact = champ("recontact");
        const parTelephone = Boolean(recontact) && recontact.value === "telephone";
        if (blocQuandAppeler) blocQuandAppeler.hidden = !parTelephone;
        if (telephone) telephone.required = parTelephone;
        if (telFacultatif) telFacultatif.hidden = parTelephone;
        if (telRequis) telRequis.hidden = !parTelephone;
      }

      /* ------------------------------------------- Blocs conditionnels -------
         Une inscription sur un monument existant n a pas de modele a choisir ;
         une "autre demande" n a ni monument ni inscription. Les blocs replies
         sont aussi DESACTIVES (`fieldset.disabled`) : leurs valeurs par defaut
         ne partent donc pas avec la demande. Aucun ne contient de champ
         obligatoire, donc rien ne peut rester requis et invisible.
         Sans JavaScript, tout reste visible et actif. */
      const aidePhoto = form.querySelector("[data-aide-photo]");

      /** Les blocs demandes par le type de demande. Un type inconnu montre tout. */
      function choixBlocs() {
        const typeDemande = champ("typeDemande");
        return (
          reglages.blocsParTypeDemande[typeDemande ? typeDemande.value : ""] || {
            monument: true,
            inscription: true,
            photo: false,
          }
        );
      }

      function majSections() {
        const choix = choixBlocs();
        form.querySelectorAll("[data-bloc]").forEach((bloc) => {
          const visible = choix[bloc.dataset.bloc] !== false;
          bloc.hidden = !visible;
          if (bloc.tagName === "FIELDSET") bloc.disabled = !visible;
        });
        if (aidePhoto) aidePhoto.hidden = !choix.photo;
      }

      /* ----------------------------------------- Onglets de famille ----------
         Les trois boutons radio `famille` commandent la grille de cartes :
         l onglet choisi n affiche que les modeles de sa famille, "Je ne sais
         pas" les affiche tous avec leur sous-titre. Sans JavaScript rien ne se
         cache : toutes les cartes restent la, groupees par famille. */
      const cartesModele = Array.from(form.querySelectorAll("[data-famille]"));
      const titresModele = Array.from(form.querySelectorAll("[data-choix-titre]"));

      const radioDeCarte = (carte) => carte.querySelector("input[name='modele']");

      function majOngletFamille() {
        const famille = champ("famille");
        const choisie = famille ? famille.value : "";

        for (const titre of titresModele) titre.hidden = choisie !== "";
        for (const carte of cartesModele) {
          carte.hidden = choisie !== "" && carte.dataset.famille !== choisie;
        }

        /* Un modele coche mais devenu invisible repartirait avec la demande sans
           que la famille le voie : on revient alors sur la carte
           "conseillez-moi" de l onglet affiche (valeur vide, contrat inchange). */
        const coche = cartesModele.find((carte) => {
          const radio = radioDeCarte(carte);
          return radio && radio.checked;
        });
        if (coche && coche.hidden) {
          const repli = cartesModele.find((carte) => {
            const radio = radioDeCarte(carte);
            return !carte.hidden && radio && radio.value === "";
          });
          if (repli) radioDeCarte(repli).checked = true;
        }
      }

      /* ------------------------------------------------- Lignes 3 et 4 -------
         Deux lignes suffisent au depart. Les suivantes se depliant une a une,
         le formulaire tient dans un ecran de telephone. Sans JavaScript elles
         sont toutes la, et le bouton n apparait pas. */
      const lignesSup = Array.from(form.querySelectorAll("[data-ligne-sup]"));
      const boutonLigne = form.querySelector("[data-ajouter-ligne]");

      function majBoutonLigne() {
        if (boutonLigne) boutonLigne.hidden = !lignesSup.some((bloc) => bloc.hidden);
      }

      /** Deplie les lignes supplementaires qui portent deja du texte. */
      function ouvreLignesRemplies() {
        for (const bloc of lignesSup) {
          const texte = bloc.querySelector("input[type='text']");
          if (texte && String(texte.value || "").trim() !== "") bloc.hidden = false;
        }
        majBoutonLigne();
      }

      if (lignesSup.length > 0 && boutonLigne) {
        for (const bloc of lignesSup) bloc.hidden = true;
        boutonLigne.addEventListener("click", () => {
          const suivante = lignesSup.find((bloc) => bloc.hidden);
          if (!suivante) return;
          suivante.hidden = false;
          majBoutonLigne();
          const texte = suivante.querySelector("input[type='text']");
          if (texte && texte.focus) texte.focus();
        });
      }

      /* ------------------------------------------ Apercu de la gravure -------
         Progressive enhancement : sans ce script, les listes, les radios et les
         champs restent la, et seul l apercu manque. Aucune librairie, aucun
         canvas. Le style d ecriture est unique : toutes les lignes le portent.
         UN SEUL noeud d apercu : le script le deplace entre l etape 3 (ou la
         famille ecrit) et le recapitulatif de l etape 4 (ou elle relit). */
      const apercu = form.querySelector("[data-apercu]");
      const cadre = form.querySelector("[data-apercu-cadre]");
      const apercuVide = form.querySelector("[data-apercu-vide]");
      const apercuPlace = form.querySelector("[data-apercu-place]");
      const apercuPret = Boolean(apercu && cadre && apercuVide);

      function famillePoliceChoisie() {
        const choix = champ("police");
        const police = choix ? reglages.polices[choix.value] : null;
        return police ? police.famille : "inherit";
      }

      /** Texte d une ligne d inscription, vide si la famille n a rien ecrit. */
      function texteLigne(numero) {
        const controle = champ(`ligne${numero}_texte`);
        return controle ? String(controle.value || "").trim() : "";
      }

      function majApercu() {
        if (!apercuPret) return;

        const granit = champ("granit");
        cadre.style.backgroundColor =
          (granit && reglages.couleurParGranit[granit.value]) || reglages.couleurGranitDefaut;

        /* `form.elements.finition` est la liste des radios : sa `value` est
           celle du bouton coche, vide si c est "Je ne sais pas encore". */
        const finition = champ("finition");
        const couleur =
          reglages.couleurParFinition[finition ? finition.value : ""] || reglages.couleurFinitionDefaut;
        const famille = famillePoliceChoisie();

        let rempli = false;
        for (const numero of reglages.lignes) {
          const ligne = form.querySelector(`[data-apercu-ligne="${numero}"]`);
          if (!ligne) continue;
          const texte = texteLigne(numero);
          const hauteur = Number(champ(`ligne${numero}_hauteur`).value) || 40;
          ligne.textContent = texte;
          ligne.hidden = texte === "";
          ligne.style.fontFamily = famille;
          ligne.style.fontSize = (hauteur * reglages.apercuPxParMm).toFixed(1) + "px";
          ligne.style.color = couleur;
          if (texte !== "") rempli = true;
        }
        apercuVide.hidden = rempli;
      }

      // Motif qui demande un dessin ou une explication : on le rappelle.
      const motifRappel = form.querySelector("[data-motif-rappel]");

      function majMotif() {
        const motif = champ("motif");
        if (motif && motifRappel) {
          motifRappel.hidden = !reglages.motifsAvecPrecision.includes(motif.value);
        }
      }

      /* ---------------------------------------------------- Ce qui est requis */
      const REQUIS = [
        ["nom", "Merci d'indiquer votre nom et votre prénom."],
        ["email", "Merci d'indiquer une adresse e-mail : c'est par là que nous répondons."],
        ["localite", "Merci d'indiquer votre localité."],
        ["typeDemande", "Merci de choisir le type de demande."],
        ["consentement", "Merci de cocher cette case pour que nous puissions traiter votre demande."],
      ];

      function estVide(nom) {
        const controle = champ(nom);
        if (!controle) return false;
        if (controle.type === "checkbox") return !controle.checked;
        return String(controle.value || "").trim() === "";
      }

      /** Les fichiers joints : nombre, poids total et format. */
      function erreurFichiers() {
        const controle = champ("fichiers");
        if (!controle || !controle.files || controle.files.length === 0) return null;

        const fichiers = Array.from(controle.files);
        if (fichiers.length > reglages.nombreMaxFichiers) {
          return `${reglages.nombreMaxFichiers} fichiers au maximum (vous en avez choisi ${fichiers.length}).`;
        }

        const total = fichiers.reduce((somme, fichier) => somme + fichier.size, 0);
        if (total > reglages.tailleTotaleMaxOctets) {
          const poids = (total / (1024 * 1024)).toFixed(1).replace(".", ",");
          return `${reglages.tailleLisible} au total au maximum (vos fichiers pèsent ${poids} Mo).`;
        }

        const refuse = fichiers.find((fichier) => !reglages.typesAcceptes.includes(fichier.type));
        if (refuse) {
          return `Le fichier « ${refuse.name} » n'est pas dans un format accepté : JPEG, PNG, WEBP ou PDF.`;
        }

        return null;
      }

      /** Vrai si le champ se trouve dans la portee controlee (null : tout le formulaire). */
      function dansPortee(nom, portee) {
        if (!portee) return true;
        const controle = premierControle(nom);
        return Boolean(controle) && portee.contains(controle);
      }

      /** Les problemes de saisie, de tout le formulaire ou d une seule etape. */
      function valide(portee) {
        const problemes = [];

        for (const [nom, texte] of REQUIS) {
          if (dansPortee(nom, portee) && estVide(nom)) problemes.push([nom, texte]);
        }

        const email = champ("email");
        if (dansPortee("email", portee) && email && email.value.trim() !== "" && email.validity.typeMismatch) {
          problemes.push(["email", "Cette adresse e-mail semble incomplète (exemple : nom@exemple.ch)."]);
        }

        // Le numero n est necessaire que si la famille demande un appel.
        if (dansPortee("telephone", portee) && telephone && telephone.required && estVide("telephone")) {
          problemes.push([
            "telephone",
            "Merci d'indiquer un numéro de téléphone, pour que nous puissions vous appeler.",
          ]);
        }

        if (dansPortee("fichiers", portee)) {
          const fichiers = erreurFichiers();
          if (fichiers) problemes.push(["fichiers", fichiers]);
        }

        return problemes;
      }

      /** Affiche les problemes, le resume, et pose le focus sur le premier. */
      function montreProblemes(problemes) {
        for (const [nom, texte] of problemes) poseErreur(nom, texte);
        resume.textContent = reglages.messages.erreurSaisie;
        resume.classList.remove("hidden");
        annonce("");
        return premierControle(problemes[0][0]);
      }

      /* ------------------------------------------------- Les quatre etapes ---
         Le decoupage est une COUCHE JAVASCRIPT : une seule section sans
         `hidden` a la fois, les autres avec. Sans ce script les quatre sont
         visibles a la suite et l envoi est natif. Les etapes 2 et 3 se sautent
         selon le type de demande ; leurs champs sont alors desactives par
         `majSections`, donc rien d inutile ne part avec la demande. */
      const sections = Array.from(form.querySelectorAll("[data-etape]"));
      const itemsEtapes = Array.from(form.querySelectorAll("[data-etape-item]"));
      const barre = form.querySelector("[data-etapes]");
      const enEtapes = sections.length > 0;
      const DERNIERE = sections.length;
      let etapeCourante = 1;

      const numeroDe = (section) => Number(section.dataset.etape);
      const sectionDe = (numero) => sections.find((section) => numeroDe(section) === numero) || null;

      /** Etape 2 sautee sans monument, etape 3 sans inscription. */
      function etapeSautee(numero) {
        const choix = choixBlocs();
        if (numero === 2) return choix.monument === false;
        if (numero === 3) return choix.inscription === false;
        return false;
      }

      /** Etape suivante (sens 1) ou precedente (sens -1) qui ne soit pas sautee. */
      function etapeVoisine(depuis, sens) {
        for (let numero = depuis + sens; numero >= 1 && numero <= DERNIERE; numero += sens) {
          if (!etapeSautee(numero)) return numero;
        }
        return null;
      }

      function majBarre() {
        for (const item of itemsEtapes) {
          const numero = Number(item.dataset.etapeItem);
          const sautee = etapeSautee(numero);
          if (sautee) item.setAttribute("data-sautee", "");
          else item.removeAttribute("data-sautee");
          /* Le gris et le texte barre ne s entendent pas : la mention
             "(non concernée)" le dit aux lecteurs d ecran. */
          const dit = item.querySelector("[data-etape-sautee-dit]");
          if (dit) dit.hidden = !sautee;
          if (numero === etapeCourante) item.setAttribute("aria-current", "step");
          else item.removeAttribute("aria-current");
        }
      }

      /** Ramene l apercu a sa place, dans l etape de l inscription. */
      function rangeApercu() {
        if (apercu && apercuPlace && apercu.parentNode !== apercuPlace) apercuPlace.appendChild(apercu);
      }

      function montreEtape(numero, options) {
        const avecFocus = !options || options.focus !== false;
        etapeCourante = numero;
        for (const section of sections) section.hidden = numeroDe(section) !== numero;
        majBarre();
        if (numero === DERNIERE) remplitRecap();
        else rangeApercu();
        if (!avecFocus) return;
        const titre = sectionDe(numero) && sectionDe(numero).querySelector("[data-etape-titre]");
        if (titre && titre.focus) titre.focus({ preventScroll: true });
        /* On remonte en haut du formulaire, pas de la page : la barre de
           progression et le titre de l etape doivent etre les premiers visibles. */
        if (form.scrollIntoView) form.scrollIntoView({ block: "start" });
      }

      /** "Continuer" : on ne verifie que les champs de l etape affichee. */
      function continuer() {
        const section = sectionDe(etapeCourante);
        if (!section) return;
        videErreurs(section);
        const problemes = valide(section);
        if (problemes.length > 0) {
          const premier = montreProblemes(problemes);
          if (premier && premier.focus) premier.focus();
          return;
        }
        const suivante = etapeVoisine(etapeCourante, 1);
        if (suivante) montreEtape(suivante);
      }

      /** "Retour" : aucune verification, et les valeurs saisies restent la. */
      function retour() {
        const avant = etapeVoisine(etapeCourante, -1);
        if (avant) montreEtape(avant);
      }

      /** Remet la barre d accord avec le type de demande, et fuit une etape devenue sautee. */
      function majEtapes() {
        if (!enEtapes) return;
        if (etapeSautee(etapeCourante)) {
          const repli = etapeVoisine(etapeCourante, 1) || etapeVoisine(etapeCourante, -1) || 1;
          montreEtape(repli, { focus: false });
          return;
        }
        majBarre();
      }

      /* ------------------------------------------------- Recapitulatif -------
         Lecture seule, regenere a chaque affichage de la derniere etape : la
         famille relit en mots ce qu elle a choisi en cases, et chaque bloc
         ramene a son etape. Les noms lisibles viennent de `reglages` : le
         formulaire envoie des identifiants, jamais ces libelles. */
      const recap = form.querySelector("[data-recap]");
      const recapBlocs = form.querySelector("[data-recap-blocs]");
      const recapApercu = form.querySelector("[data-recap-apercu]");

      const valeurDe = (nom) => {
        const controle = champ(nom);
        return controle ? String(controle.value || "") : "";
      };

      /** Libelle de l option choisie dans une liste : "3 cm", "Croix". */
      function libelleOption(nom) {
        const liste = champ(nom);
        if (!liste || !liste.options || liste.selectedIndex < 0) return "";
        return liste.options[liste.selectedIndex].text;
      }

      /** "2026-12-24" devient "24.12.2026". */
      function dateLisible(valeur) {
        const morceaux = String(valeur || "").split("-");
        if (morceaux.length !== 3) return String(valeur || "");
        return `${morceaux[2]}.${morceaux[1]}.${morceaux[0]}`;
      }

      function ajouteBloc(titre, etape, cible, items) {
        const utiles = items.filter((item) => item[1] !== "");
        if (utiles.length === 0) return;

        const bloc = document.createElement("div");
        bloc.className = "recap-bloc";

        const entete = document.createElement("p");
        entete.className = "recap-entete";
        const nom = document.createElement("span");
        nom.className = "recap-titre";
        nom.textContent = titre;
        const modifier = document.createElement("button");
        modifier.type = "button";
        modifier.className = "link recap-modifier";
        modifier.textContent = "Modifier";
        modifier.setAttribute("aria-label", `Modifier : ${titre}`);
        modifier.addEventListener("click", () => {
          montreEtape(etape, { focus: false });
          const controle = premierControle(cible);
          if (controle && controle.focus) controle.focus();
          if (form.scrollIntoView) form.scrollIntoView({ block: "start" });
        });
        entete.appendChild(nom);
        entete.appendChild(modifier);
        bloc.appendChild(entete);

        /* Une liste de definitions : l intitule (`dt`) au-dessus, la reponse
           (`dd`) en dessous. C est la structure que les lecteurs d ecran
           annoncent par paires, et sur un telephone etroit chaque reponse garde
           toute la largeur au lieu d etre tassee dans une colonne. */
        const liste = document.createElement("dl");
        liste.className = "recap-liste";
        for (const [cle, valeur] of utiles) {
          const intitule = document.createElement("dt");
          intitule.className = "recap-cle";
          intitule.textContent = cle;
          const reponse = document.createElement("dd");
          reponse.className = "recap-valeur";
          reponse.textContent = valeur;
          liste.appendChild(intitule);
          liste.appendChild(reponse);
        }
        bloc.appendChild(liste);

        recapBlocs.appendChild(bloc);
      }

      function remplitRecap() {
        if (!recap || !recapBlocs) return;
        recapBlocs.textContent = "";

        const choix = choixBlocs();
        const date = valeurDe("datePoseSouhaitee");

        ajouteBloc("Votre demande", 1, "typeDemande", [
          ["Type de demande", reglages.labelsTypeDemande[valeurDe("typeDemande")] || ""],
          ["Date de pose souhaitée", date === "" ? "" : dateLisible(date)],
        ]);

        if (choix.monument !== false) {
          const modele = valeurDe("modele");
          const granit = valeurDe("granit");
          ajouteBloc("Le monument", 2, "famille", [
            ["Famille", reglages.labelsFamille[valeurDe("famille")] || "Je ne sais pas"],
            ["Modèle", reglages.nomsParModele[modele] || "Je ne sais pas encore, conseillez-moi"],
            ["Granit", reglages.nomsParGranit[granit] || "Je ne sais pas encore"],
          ]);
        }

        let gravureRemplie = false;
        if (choix.inscription !== false) {
          const items = [];
          for (const numero of reglages.lignes) {
            const texte = texteLigne(numero);
            if (texte === "") continue;
            gravureRemplie = true;
            items.push([`Ligne ${numero}`, `${texte} - ${libelleOption(`ligne${numero}_hauteur`)}`]);
          }
          const police = reglages.polices[valeurDe("police")];
          items.push(["Style d'écriture", police ? police.nom : ""]);
          items.push(["Finition", reglages.nomsParFinition[valeurDe("finition")] || "Je ne sais pas encore"]);
          items.push(["Motif gravé", libelleOption("motif")]);
          ajouteBloc("L'inscription", 3, "ligne1_texte", items);
        }

        const fichiers = champ("fichiers");
        const nombre = fichiers && fichiers.files ? fichiers.files.length : 0;
        ajouteBloc("Fichiers à joindre", DERNIERE, "fichiers", [
          ["Fichiers choisis", nombre === 0 ? "aucun" : String(nombre)],
        ]);

        /* L apercu de la gravure vient relire les lettres telles qu elles
           seront gravees. C est LE MEME noeud que celui de l etape 3, deplace :
           inutile de le dessiner deux fois. */
        if (gravureRemplie && apercu && recapApercu) recapApercu.appendChild(apercu);
        else rangeApercu();

        recap.hidden = false;
      }

      /* ------------------------------------------------------- Brouillon -----
         Une famille remplit ce formulaire en plusieurs fois, parfois en
         cherchant une date dans un papier. Les champs texte, les listes, les
         choix ET l etape en cours sont donc gardes dans le navigateur, sur sa
         machine et nulle part ailleurs. JAMAIS les fichiers joints (le
         navigateur ne le permet pas), jamais le consentement : il doit etre
         donne a chaque envoi.
         Tout passe par try/catch : navigation privee, stockage plein ou refuse,
         JSON abime - le brouillon est un confort, son echec ne doit jamais
         empecher une demande. */
      const brouillon = form.querySelector("[data-brouillon]");
      const boutonEffacer = form.querySelector("[data-brouillon-effacer]");
      const IGNORES = ["societe", "horodatage", "consentement", "fichiers"];
      /** Clef de l etape en cours. Aucun champ du formulaire ne porte ce nom. */
      const CLEF_ETAPE = "__etape";

      function champsBrouillon() {
        return Array.from(form.elements).filter(
          (element) =>
            element.name &&
            !IGNORES.includes(element.name) &&
            element.type !== "file" &&
            element.type !== "hidden" &&
            element.type !== "submit" &&
            element.type !== "button" &&
            element.type !== "checkbox",
        );
      }

      /** Vrai quand la famille a vraiment ecrit quelque chose. */
      function brouillonUtile(champs) {
        return champs.some(
          (element) =>
            (element.tagName === "TEXTAREA" || ["text", "tel", "email", "date"].includes(element.type)) &&
            String(element.value || "").trim() !== "",
        );
      }

      function oublieBrouillon() {
        try {
          window.localStorage.removeItem(reglages.cleBrouillon);
        } catch {
          /* Rien a faire : il n y avait deja peut-etre rien. */
        }
      }

      function sauveBrouillon() {
        try {
          const champs = champsBrouillon();
          if (!brouillonUtile(champs)) {
            oublieBrouillon();
            return;
          }
          const donnees = {};
          for (const element of champs) {
            if (element.type === "radio") {
              if (element.checked) donnees[element.name] = element.value;
            } else {
              donnees[element.name] = element.value;
            }
          }
          donnees[CLEF_ETAPE] = etapeCourante;
          window.localStorage.setItem(reglages.cleBrouillon, JSON.stringify(donnees));
        } catch {
          /* Stockage indisponible : on continue sans brouillon. */
        }
      }

      /** Rend le brouillon restaure, ou `null` : l appelant y lit l etape. */
      function restaureBrouillon() {
        let donnees = null;
        try {
          const brut = window.localStorage.getItem(reglages.cleBrouillon);
          donnees = brut ? JSON.parse(brut) : null;
        } catch {
          donnees = null;
        }
        if (!donnees || typeof donnees !== "object") return null;

        /* Deux cartes "conseillez-moi" portent la meme valeur vide : sans ce
           garde-fou, les deux seraient cochees a la suite et c est la derniere
           qui resterait allumee. On ne coche donc que le premier bouton qui
           corresponde, pour chaque groupe. */
        const posees = new Set();
        for (const element of champsBrouillon()) {
          const valeur = donnees[element.name];
          if (typeof valeur !== "string") continue;
          if (element.type === "radio") {
            if (element.value === valeur && !posees.has(element.name)) {
              element.checked = true;
              posees.add(element.name);
            }
          } else {
            element.value = valeur;
          }
        }
        return donnees;
      }

      let minuteurBrouillon = 0;
      function planifieSauvegarde() {
        window.clearTimeout(minuteurBrouillon);
        minuteurBrouillon = window.setTimeout(sauveBrouillon, 500);
      }

      /** Remet toutes les parties mobiles d accord avec les champs. */
      function majTout() {
        majRecontact();
        majSections();
        majOngletFamille();
        majMotif();
        majApercu();
        majEtapes();
      }

      /* =============================================== Mise en route ======= */
      poseHorodatage();
      poseDateMinimale();

      const repris = restaureBrouillon();
      if (repris && brouillon) brouillon.hidden = false;
      ouvreLignesRemplies();

      /* Pre-selection du modele depuis /devis/?modele=<slug>, pose par les
         fiches. Elle passe APRES le brouillon : venir d une fiche est une
         intention plus recente que le brouillon de la veille. Un slug inconnu
         est ignore : la carte "conseillez-moi" reste cochee plutot que
         d afficher un choix qui n existe pas. */
      const demande = new URLSearchParams(window.location.search).get("modele");
      const modeleDemande = champ("modele");
      const familleDemandee = demande ? reglages.famillesParModele[demande] : undefined;
      if (demande && modeleDemande && familleDemandee) {
        /* `form.elements.modele` est la liste des boutons radio des cartes :
           lui affecter une valeur coche le bouton qui la porte. */
        modeleDemande.value = demande;
        /* L onglet suit le modele demande, meme si le brouillon en avait choisi
           un autre : sinon la carte cochee resterait cachee. `majTout`, juste
           apres, met la grille d accord. */
        const familleDesCartes = champ("famille");
        if (familleDesCartes) familleDesCartes.value = familleDemandee;
      }

      // L apercu n est cache que pour le cas sans JavaScript.
      if (apercuPret) apercu.hidden = false;

      if (enEtapes) {
        form.classList.add("etapes-actives");
        if (barre) barre.hidden = false;
        form.querySelectorAll("[data-etape-nav]").forEach((nav) => {
          nav.hidden = false;
        });
        form.querySelectorAll("[data-continuer]").forEach((element) => {
          element.addEventListener("click", continuer);
        });
        form.querySelectorAll("[data-retour]").forEach((element) => {
          element.addEventListener("click", retour);
        });
      }

      majTout();

      if (enEtapes) {
        /* On reprend a l etape ou la famille s etait arretee. Pas quand elle
           arrive d une fiche modele (?modele=) : elle vient alors de choisir,
           et le parcours recommence au debut. Une etape sautee ou inconnue
           ramene a la premiere. */
        const voulue = demande ? 0 : Number(repris ? repris[CLEF_ETAPE] : 0);
        const depart = voulue >= 1 && voulue <= DERNIERE && !etapeSautee(voulue) ? voulue : 1;
        montreEtape(depart, { focus: false });
      }

      /* La page est prete : brouillon restaure, ?modele= pose. Les scripts
         qui remplissent le formulaire APRES (la stele composee,
         src/scripts/devis/scene.ts) attendent ce signal. */
      form.dataset.pret = "true";
      form.dispatchEvent(new CustomEvent("pt-devis-pret"));

      form.addEventListener("input", () => {
        majTout();
        planifieSauvegarde();
      });
      /* Cocher un modele coche sa famille : le recapitulatif et l onglet
         restent coherents, et "Je ne sais pas" ne survit pas a un choix precis. */
      form.addEventListener("change", (evenement) => {
        const cible = evenement.target;
        if (cible && cible.name === "modele" && cible.checked) {
          const carte = cible.closest("[data-famille]");
          const radioFamille = carte && form.querySelector(`input[name="famille"][value="${carte.dataset.famille}"]`);
          if (radioFamille && !radioFamille.checked) radioFamille.checked = true;
        }
        majTout();
        planifieSauvegarde();
        // Le recapitulatif doit suivre : un fichier ajoute s y compte aussitot.
        if (enEtapes && etapeCourante === DERNIERE) remplitRecap();
      });

      /* Entree dans un champ texte ne doit pas envoyer la demande : elle fait
         "Continuer". A la derniere etape, ou "Continuer" n existe plus, elle ne
         fait rien : le bouton d envoi est juste la, et une demande ne part pas
         par megarde. */
      const TYPES_TEXTE = ["text", "tel", "email", "date", "number", "search", "url"];
      form.addEventListener("keydown", (evenement) => {
        if (evenement.key !== "Enter") return;
        const cible = evenement.target;
        if (!cible || cible.tagName !== "INPUT" || !TYPES_TEXTE.includes(cible.type)) return;
        evenement.preventDefault();
        if (enEtapes && etapeCourante < DERNIERE) continuer();
      });

      if (boutonEffacer) {
        boutonEffacer.addEventListener("click", () => {
          oublieBrouillon();
          form.reset();
          poseHorodatage();
          if (brouillon) brouillon.hidden = true;
          videErreurs();
          for (const bloc of lignesSup) bloc.hidden = true;
          majBoutonLigne();
          majTout();
          if (enEtapes) montreEtape(1, { focus: false });
        });
      }

      champ("fichiers").addEventListener("change", () => {
        const zone = zoneErreur("fichiers");
        const texte = erreurFichiers();
        zone.textContent = texte || "";
        zone.classList.toggle("hidden", !texte);
      });

      async function envoie() {
        bouton.disabled = true;
        annonce(reglages.messages.envoiEnCours);

        try {
          const reponse = await fetch(reglages.endpoint, { method: "POST", body: new FormData(form) });
          let charge = null;
          try {
            charge = await reponse.json();
          } catch {
            charge = null;
          }

          if (reponse.ok && charge && charge.ok === true) {
            // La demande est partie : le brouillon n a plus de raison d etre.
            oublieBrouillon();
            window.location.href = "/devis/merci/";
            return;
          }

          if (charge && charge.erreurs) {
            for (const [nom, texte] of Object.entries(charge.erreurs)) poseErreur(nom, String(texte));
            resume.textContent = reglages.messages.erreurSaisie;
            resume.classList.remove("hidden");
            annonce("");
          } else {
            annonce(reglages.messages.erreurReseau);
          }
        } catch {
          annonce(reglages.messages.erreurReseau);
        }

        bouton.disabled = false;
      }

      form.addEventListener("submit", (evenement) => {
        evenement.preventDefault();
        videErreurs();

        /* A l envoi, tout le formulaire est verifie, y compris les etapes
           deja passees : si une erreur s y cache, on y retourne et on la
           montre. */
        const problemes = valide(null);
        if (problemes.length > 0) {
          const premier = montreProblemes(problemes);
          const section = premier && premier.closest ? premier.closest("[data-etape]") : null;
          if (enEtapes && section && numeroDe(section) !== etapeCourante) {
            montreEtape(numeroDe(section), { focus: false });
          }
          if (premier && premier.focus) premier.focus();
          return;
        }

        // Tant que la fonction /api/devis n existe pas, on ne poste rien.
        if (!reglages.envoiActif) {
          annonce(reglages.messages.envoiInactif);
          return;
        }

        envoie();
      });
    })();
  </script>
</BaseLayout>
