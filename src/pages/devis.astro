---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageTitle } from "@/config/site";
import {
  acceptFichiers,
  cleBrouillonDevis,
  devisConfig,
  fichiersDevis,
  messagesDevis,
  tailleTotaleMaxLisible,
} from "@/config/devis";
import { granits, granitsParTeinte, TEINTE_PASTILLE } from "@/data/granits";
import {
  FINITION_APERCU_DEFAUT,
  finitions,
  getFinition,
  getPolice,
  hauteurLabel,
  hauteursLettresMm,
  LIGNE_LONGUEUR_MAX,
  lignesInscription,
  MENTION_APERCU,
  MOTIF_DEFAUT,
  motifs,
  POLICE_DEFAUT,
  polices,
  STYLE_POLICE_LABELS,
} from "@/data/personnalisation";
import { FAMILLE_LABELS, FAMILLES, getProducts } from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";

/* Page "Demander un devis".
   L ENVOI N EXISTE PAS ENCORE : il sera fait en E6 par une fonction Cloudflare
   Pages `/api/devis` (Resend, adresse en variable d environnement, decision de
   Thomas du 13.10.2026 : pas de n8n). D ici la, `devisConfig.envoiActif` vaut
   `false` et le JavaScript affiche un message au lieu de poster.
   Le contrat des champs est ecrit dans `docs/devis-contrat.md` : renommer un
   champ ici oblige a le renommer la-bas. Sans JavaScript, le formulaire poste
   nativement vers `action`, ce qui marchera des que la fonction existera.

   PUBLIC VISE : des familles en deuil, souvent agees, le plus souvent sur un
   telephone. D ou le peaufinage du 14.10.2026 (passe 2 de E5) : UNE SEULE page,
   complete sans JavaScript, un seul style d ecriture pour tout le monument,
   des tailles de lettres deja choisies, des pastilles de couleur a toucher
   plutot qu une liste deroulante, les sections inutiles repliees selon le type
   de demande, et un brouillon garde dans le navigateur. Tout ce qui se replie
   se replie EN JAVASCRIPT SEULEMENT : sans JavaScript, tout reste visible. */

/* LES POLICES DE GRAVURE NE SE CHARGENT QUE SUR CETTE PAGE (regle de
   performance non negociable, E5). Ces imports sont volontairement ICI, dans la
   page, et PAS dans `BaseLayout.astro` ni dans `src/styles.css` : Astro n en
   met la feuille de style que sur `/devis/`, les 22 autres pages n en portent
   pas un octet. Sous-jeu latin seulement ; `font-display: swap` vient des
   paquets @fontsource. Ne jamais deplacer ces lignes ailleurs.
   Les familles CSS correspondantes sont dans `src/data/personnalisation.ts`. */
import "@fontsource/cinzel/latin-400.css";
import "@fontsource/marcellus/latin-400.css";
import "@fontsource/eb-garamond/latin-400.css";
import "@fontsource/jost/latin-400.css";
import "@fontsource/great-vibes/latin-400.css";
import "@fontsource/pinyon-script/latin-400.css";

const origin = Astro.site ?? new URL(Astro.url.origin);

const products = await getProducts();
const modelesParFamille = FAMILLES.map((famille) => ({
  famille,
  label: FAMILLE_LABELS[famille],
  modeles: products.filter((product) => product.famille === famille),
}));

const groupesGranits = granitsParTeinte();

const policeParDefaut = getPolice(POLICE_DEFAUT) ?? polices[0];
const finitionApercuDefaut = getFinition(FINITION_APERCU_DEFAUT) ?? finitions[0];
/** Repere de teinte quand aucun granit n est choisi : le gris du catalogue. */
const COULEUR_GRANIT_DEFAUT = TEINTE_PASTILLE.gris;

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: "Demander un devis", path: "/devis/" },
  ],
  origin,
);

/* Tout ce que le script a besoin de savoir, pris dans src/config/devis.ts :
   aucune de ces valeurs n est ecrite deux fois. */
const reglages = {
  envoiActif: devisConfig.envoiActif,
  endpoint: devisConfig.endpoint,
  nombreMaxFichiers: fichiersDevis.nombreMax,
  tailleTotaleMaxOctets: fichiersDevis.tailleTotaleMaxOctets,
  typesAcceptes: [...fichiersDevis.typesAcceptes],
  tailleLisible: tailleTotaleMaxLisible,
  messages: messagesDevis,
  /** Cle du brouillon dans le localStorage du navigateur de la famille. */
  cleBrouillon: cleBrouillonDevis,
  /** Famille de chaque modele : sert a remplir le select "famille" avec ?modele=. */
  famillesParModele: Object.fromEntries(products.map((product) => [product.slug, product.famille])),

  /* ---- Apercu de la gravure. Tout vient de src/data/personnalisation.ts et
     de src/data/granits.json : aucune valeur n est ecrite deux fois. ---- */
  /** id de police -> { nom affiche, pile CSS }. */
  polices: Object.fromEntries(polices.map((police) => [police.id, { nom: police.nom, famille: police.famille }])),
  /** id de finition -> couleur APPROXIMATIVE du texte grave. */
  couleurParFinition: Object.fromEntries(finitions.map((finition) => [finition.id, finition.couleurApercu])),
  couleurFinitionDefaut: finitionApercuDefaut.couleurApercu,
  /** id de granit -> couleur APPROXIMATIVE de sa teinte (pastille du catalogue). */
  couleurParGranit: Object.fromEntries(granits.map((granit) => [granit.id, TEINTE_PASTILLE[granit.teinte]])),
  couleurGranitDefaut: COULEUR_GRANIT_DEFAUT,
  /** Echelle de l apercu : une lettre de 50 mm s affiche a 30 px. */
  apercuPxParMm: 0.6,
  /** Numeros des lignes d inscription, dans l ordre. */
  lignes: lignesInscription.map((ligne) => ligne.numero),
  /** Motifs qui demandent une explication ou un fichier de la famille. */
  motifsAvecPrecision: motifs.filter((motif) => motif.demandePrecision).map((motif) => motif.id),

  /* ---- Sections affichees selon le type de demande. `monument` = famille,
     modele et granit ; `inscription` = texte grave, finition, motif et apercu ;
     `photo` = le rappel "une photo du monument existant nous aide beaucoup".
     Un type inconnu, ou aucun choix, montre tout. ---- */
  blocsParTypeDemande: {
    nouveau: { monument: true, inscription: true, photo: false },
    inscription: { monument: false, inscription: true, photo: true },
    autre: { monument: false, inscription: false, photo: false },
  },
};

const classeChamp = "field mt-2";
const classeErreur = "type-body mt-2 hidden text-[0.8125rem] text-[#8d3c33]";
const classeRadio = "mt-1 size-4 shrink-0 accent-[var(--ink)]";
const classeChoix = "flex items-start gap-3 text-[0.9375rem]";
const classeAide = "type-body mt-2 text-[0.8125rem] text-muted";
---

<BaseLayout
  title={pageTitle("Demander un devis gratuit")}
  description="Demandez votre devis gratuit : modèle, granit, texte à graver et votre propre dessin si vous en avez un. Nous répondons avec une estimation détaillée."
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[20ch]">Demander un devis</h1>
      <p class="type-lead hero-in mt-8 max-w-[56ch]" style="--reveal-delay:120ms">
        Le devis est gratuit et sans engagement. Répondez seulement à ce que vous savez : nous reprenons
        contact pour le reste, et nous vérifions au besoin le règlement du cimetière concerné.
      </p>
      <p class="type-body hero-in mt-6 max-w-[56ch] text-muted" style="--reveal-delay:200ms">
        Les champs marqués d'une étoile sont nécessaires pour vous répondre. Vous pouvez joindre votre
        propre dessin à faire graver.
      </p>
    </section>

    <section class="shell">
      <div class="rule" data-reveal="line"></div>

      <form
        method="post"
        action={devisConfig.endpoint}
        enctype="multipart/form-data"
        class="mt-12 max-w-[62ch]"
        data-devis
      >
        {/* Resume d erreurs, rempli par le script. role="alert" : annonce des qu il est rempli. */}
        <p
          class="type-body mb-10 hidden border-l-2 border-[#8d3c33] pl-4 text-[0.9375rem] text-[#8d3c33]"
          data-devis-resume
          role="alert"
        >
        </p>

        {/* Brouillon retrouve. Pose par le script seulement : sans JavaScript il
            n y a pas de brouillon, donc rien a annoncer. */}
        <p class="type-body mb-10 text-[0.9375rem] text-muted" data-brouillon hidden>
          {messagesDevis.brouillonRetrouve}{" "}
          <button type="button" class="link" data-brouillon-effacer>Effacer</button>
        </p>

        {/* ------------------------------------------------- Vos coordonnees */}
        <fieldset class="border-t border-line pt-8">
          <legend class="label">Vos coordonnées</legend>

          <div class="mt-6 grid gap-8 md:grid-cols-2">
            <div>
              <label class="field-label" for="nom">Nom et prénom <span aria-hidden="true">*</span></label>
              <input
                class={classeChamp}
                id="nom"
                name="nom"
                type="text"
                required
                autocomplete="name"
                aria-describedby="nom-erreur"
              />
              <p class={classeErreur} id="nom-erreur" data-erreur="nom"></p>
            </div>

            <div>
              <label class="field-label" for="email">Adresse e-mail <span aria-hidden="true">*</span></label>
              <input
                class={classeChamp}
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-describedby="email-erreur"
              />
              <p class={classeErreur} id="email-erreur" data-erreur="email"></p>
            </div>

            <div>
              {/* L etoile apparait quand la famille demande un appel : c est
                  alors le seul moyen de la joindre. Le script seul la pose, en
                  meme temps que `required` ; sans JavaScript le telephone reste
                  facultatif, comme l annonce le libelle. */}
              <label class="field-label" for="telephone">
                Téléphone <span data-tel-facultatif>(facultatif)</span><span
                  data-tel-requis
                  aria-hidden="true"
                  hidden>*</span
                >
              </label>
              <input
                class={classeChamp}
                id="telephone"
                name="telephone"
                type="tel"
                autocomplete="tel"
                aria-describedby="telephone-aide telephone-erreur"
              />
              <p class={classeAide} id="telephone-aide">Si vous préférez que nous vous appelions.</p>
              <p class={classeErreur} id="telephone-erreur" data-erreur="telephone"></p>
            </div>

            <div>
              <label class="field-label" for="localite">Localité <span aria-hidden="true">*</span></label>
              <input
                class={classeChamp}
                id="localite"
                name="localite"
                type="text"
                required
                autocomplete="address-level2"
                aria-describedby="localite-aide localite-erreur"
              />
              <p class={classeAide} id="localite-aide">Votre commune, pour situer le déplacement.</p>
              <p class={classeErreur} id="localite-erreur" data-erreur="localite"></p>
            </div>
          </div>

          <fieldset class="mt-10">
            <legend class="field-label">Comment vous recontacter</legend>
            <div class="mt-4 space-y-3">
              {
                [
                  { valeur: "telephone", label: "Par téléphone" },
                  { valeur: "email", label: "Par e-mail" },
                ].map((choix) => (
                  <label class={classeChoix}>
                    <input
                      class={classeRadio}
                      type="radio"
                      name="recontact"
                      value={choix.valeur}
                      checked={choix.valeur === "email"}
                    />
                    <span>{choix.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          {/* Visible sans JavaScript (facultatif de toute facon) ; le script le
              replie tant que la famille n a pas demandé un appel. */}
          <div class="grav-court mt-10" data-quand-appeler>
            <label class="field-label" for="quandAppeler">Quand vous appeler ? (facultatif)</label>
            <input
              class={classeChamp}
              id="quandAppeler"
              name="quandAppeler"
              type="text"
              autocomplete="off"
              aria-describedby="quandAppeler-aide"
            />
            <p class={classeAide} id="quandAppeler-aide">
              Par exemple : le matin, ou après 17 h.
            </p>
          </div>
        </fieldset>

        {/* ------------------------------------------------- Votre demande */}
        {/* `typeDemande` commande l affichage des sections suivantes : il reste
            donc en dehors d elles, et toujours visible. */}
        <fieldset class="mt-16 border-t border-line pt-8">
          <legend class="label">Votre demande</legend>

          <fieldset class="mt-6" aria-describedby="typeDemande-erreur">
            <legend class="field-label">Type de demande <span aria-hidden="true">*</span></legend>
            <div class="mt-4 space-y-3">
              {
                [
                  { valeur: "nouveau", label: "Un nouveau monument" },
                  { valeur: "inscription", label: "Une inscription sur un monument existant" },
                  { valeur: "autre", label: "Autre demande" },
                ].map((choix) => (
                  <label class={classeChoix}>
                    <input class={classeRadio} type="radio" name="typeDemande" value={choix.valeur} required />
                    <span>{choix.label}</span>
                  </label>
                ))
              }
            </div>
            <p class={classeErreur} id="typeDemande-erreur" data-erreur="typeDemande"></p>
          </fieldset>

          <div class="mt-10 grid gap-8 md:grid-cols-2">
            <div>
              <label class="field-label" for="cimetiere">Cimetière (facultatif)</label>
              <input class={classeChamp} id="cimetiere" name="cimetiere" type="text" autocomplete="off" />
            </div>

            <div>
              <label class="field-label" for="communeCimetiere">Commune du cimetière (facultatif)</label>
              <input
                class={classeChamp}
                id="communeCimetiere"
                name="communeCimetiere"
                type="text"
                autocomplete="off"
                aria-describedby="communeCimetiere-aide"
              />
              <p class={classeAide} id="communeCimetiere-aide">
                Chaque commune a son règlement : nous le vérifions pour vous.
              </p>
            </div>

            <div>
              <label class="field-label" for="datePoseSouhaitee">Date de pose souhaitée (facultatif)</label>
              <input
                class={classeChamp}
                id="datePoseSouhaitee"
                name="datePoseSouhaitee"
                type="date"
                aria-describedby="datePoseSouhaitee-aide"
              />
              <p class={classeAide} id="datePoseSouhaitee-aide">
                Si vous avez une date en tête, par exemple avant une cérémonie.
              </p>
            </div>
          </div>
        </fieldset>

        {/* ----------------------------------------------------- Le monument */}
        {/* Replie par le script pour une inscription sur monument existant ou
            une autre demande : la famille n a alors pas de modele a choisir. */}
        <fieldset class="mt-16 border-t border-line pt-8" data-bloc="monument">
          <legend class="label">Le monument</legend>

          <div class="mt-6 grid gap-8 md:grid-cols-2">
            <div>
              <label class="field-label" for="famille">Famille de monument</label>
              <select class={classeChamp} id="famille" name="famille">
                <option value="">Je ne sais pas</option>
                <option value="monument">Monument funéraire</option>
                <option value="cineraire">Monument cinéraire</option>
              </select>
            </div>

            <div>
              <label class="field-label" for="modele">Modèle du catalogue</label>
              <select class={classeChamp} id="modele" name="modele">
                <option value="">Je ne sais pas encore</option>
                {
                  modelesParFamille.map((groupe) => (
                    <optgroup label={groupe.label}>
                      {groupe.modeles.map((modele) => (
                        <option value={modele.slug}>{modele.name}</option>
                      ))}
                    </optgroup>
                  ))
                }
              </select>
            </div>
          </div>

          {/* Pastilles de couleur plutot qu une liste deroulante : une teinte se
              reconnait a l oeil, et une pastille se touche du pouce. Ce sont de
              vrais boutons radio, seulement habilles : ils restent utilisables
              au clavier et sans JavaScript. Les couleurs viennent de
              TEINTE_PASTILLE (src/data/granits.ts) : approximatives, jamais un
              echantillon, ce que dit l aide sous les groupes. */}
          <fieldset class="mt-12" aria-describedby="granit-aide">
            <legend class="field-label">Granit souhaité</legend>

            <label class={`${classeChoix} mt-4`}>
              <input class={classeRadio} type="radio" name="granit" value="" checked />
              <span>Je ne sais pas encore</span>
            </label>

            {
              groupesGranits.map((groupe) => (
                <div class="grav-granit-groupe">
                  <p class="grav-granit-titre type-body">{groupe.titre}</p>
                  <div class="grav-pastilles">
                    {groupe.granits.map((granit) => (
                      <label class="grav-pastille">
                        <input type="radio" name="granit" value={granit.id} />
                        <span
                          class="grav-rond"
                          style={`background-color:${TEINTE_PASTILLE[granit.teinte]}`}
                          aria-hidden="true"
                        />
                        <span class="grav-pastille-nom">{granit.nom}</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))
            }

            <p class={classeAide} id="granit-aide">
              Les couleurs ci-dessus sont approximatives. Une teinte se juge sur la pierre : le choix se
              confirme au rendez-vous.
            </p>
          </fieldset>
        </fieldset>

        {/* ----------------------------------------------------- L inscription */}
        <fieldset class="mt-16 border-t border-line pt-8" data-bloc="inscription">
          <legend class="label">L'inscription</legend>

          <p class="type-body mt-6 max-w-[56ch] text-[0.9375rem] text-muted">
            Deux lignes suffisent pour commencer : le plus souvent le nom, puis les dates. Vous pouvez en
            ajouter. Rien n'est définitif, et rien ne part à la gravure sans votre accord sur un bon à
            tirer.
          </p>

          {/* UN SEUL style d ecriture pour tout le monument (pratique courante
              des marbriers) : chaque nom est ecrit dans sa propre police, donc
              l echantillon EST le choix. Statique : lisible et utilisable sans
              JavaScript. */}
          <fieldset class="mt-10">
            <legend class="field-label">Style d'écriture</legend>
            <p class="type-body mt-2 max-w-[56ch] text-[0.8125rem] text-muted">
              Le même style pour toutes les lignes. Chaque nom est écrit dans son style.
            </p>
            <div class="grav-polices">
              {
                polices.map((police) => (
                  <label>
                    <input
                      class={classeRadio}
                      type="radio"
                      name="police"
                      value={police.id}
                      checked={police.id === policeParDefaut.id}
                    />
                    <span>
                      <span class="grav-nom" style={`font-family:${police.famille}`}>
                        {police.nom}
                      </span>
                      <span class="grav-style type-body">{STYLE_POLICE_LABELS[police.style]}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          {/* Les tailles de lettres sont deja choisies : une famille n a rien a
              decider ici si elle ne le souhaite pas. Les valeurs envoyees
              restent en millimetres (contrat inchange), seul l affichage est en
              centimetres. */}
          {
            lignesInscription.map((ligne) => (
              <div data-ligne-sup={ligne.repliable ? String(ligne.numero) : undefined}>
                <fieldset class="mt-10">
                  <legend class="field-label">{ligne.label}</legend>
                  <div class="grav-ligne mt-3">
                    <div>
                      <label class="grav-sous-label type-body" for={`ligne${ligne.numero}_texte`}>
                        Texte
                      </label>
                      <input
                        class={classeChamp}
                        id={`ligne${ligne.numero}_texte`}
                        name={`ligne${ligne.numero}_texte`}
                        type="text"
                        maxlength={LIGNE_LONGUEUR_MAX}
                        autocomplete="off"
                        aria-describedby={ligne.aide ? `ligne${ligne.numero}_texte-aide` : undefined}
                      />
                      {ligne.aide && (
                        <p class={classeAide} id={`ligne${ligne.numero}_texte-aide`}>
                          {ligne.aide}
                        </p>
                      )}
                    </div>

                    <div class="grav-reglages">
                      <label class="grav-sous-label type-body" for={`ligne${ligne.numero}_hauteur`}>
                        Taille des lettres
                      </label>
                      <select
                        class={classeChamp}
                        id={`ligne${ligne.numero}_hauteur`}
                        name={`ligne${ligne.numero}_hauteur`}
                      >
                        {hauteursLettresMm.map((hauteur) => (
                          <option value={String(hauteur)} selected={hauteur === ligne.hauteurParDefaut}>
                            {hauteurLabel(hauteur)}
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>
                </fieldset>
              </div>
            ))
          }

          {/* Pose par le script, qui replie d abord les lignes 3 et 4. Sans
              JavaScript, les quatre lignes sont la et ce bouton n apparait
              jamais. */}
          <button type="button" class="btn btn-outline mt-8" data-ajouter-ligne hidden>
            Ajouter une ligne
          </button>

          <div class="mt-12">
            <label class="field-label" for="gravure_precisions">
              Précisions sur la gravure (facultatif)
            </label>
            <textarea
              class={classeChamp}
              id="gravure_precisions"
              name="gravure_precisions"
              rows="5"
              aria-describedby="gravure_precisions-aide"></textarea>
            <p class={classeAide} id="gravure_precisions-aide">
              Épitaphe longue, disposition souhaitée, lignes supplémentaires, accents et orthographe
              exacte des noms.
            </p>
          </div>
        </fieldset>

        {/* ------------------------------------------------ Finition et motif */}
        <fieldset class="mt-16 border-t border-line pt-8" data-bloc="inscription">
          <legend class="label">Finition et motif</legend>

          <fieldset class="mt-6">
            <legend class="field-label">Finition de la gravure</legend>
            <div class="mt-4 space-y-3">
              <label class={classeChoix}>
                <input class={classeRadio} type="radio" name="finition" value="" checked />
                <span>Je ne sais pas encore</span>
              </label>
              {
                finitions.map((finition) => (
                  <label class={classeChoix}>
                    <input class={classeRadio} type="radio" name="finition" value={finition.id} />
                    <span>
                      {finition.nom}
                      <span class="grav-style type-body">{finition.aide}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="grav-motif mt-10">
            <label class="field-label" for="motif">Motif gravé</label>
            <select class={classeChamp} id="motif" name="motif" aria-describedby="motif-aide">
              {
                motifs.map((motif) => (
                  <option value={motif.id} selected={motif.id === MOTIF_DEFAUT}>
                    {motif.nom}
                  </option>
                ))
              }
            </select>
            <p class={classeAide} id="motif-aide">
              Pour « autre symbole » ou « dessin fourni par la famille », décrivez-le dans les précisions
              ci-dessus et joignez votre fichier plus bas.
            </p>
            {/* Rappel mis en avant par le script quand le choix le demande. */}
            <p class="grav-rappel type-body" data-motif-rappel hidden>
              Ce choix demande un document de votre part : ajoutez votre dessin ou votre croquis dans
              « Fichiers à joindre », ci-dessous.
            </p>
          </div>
        </fieldset>

        {/* -------------------------------------------------- Apercu en direct */}
        {/* Reste cache sans JavaScript : un cadre vide n apprendrait rien. Le
            formulaire, lui, est complet dans tous les cas. */}
        <div class="mt-16 border-t border-line pt-8" data-bloc="inscription" data-apercu hidden>
          <p class="label">Aperçu de la gravure</p>
          <div
            class="grav-cadre"
            style={`background-color:${COULEUR_GRANIT_DEFAUT}`}
            data-apercu-cadre
          >
            <p class="grav-vide type-body" data-apercu-vide>
              Saisissez votre texte ci-dessus pour le voir apparaître ici.
            </p>
            {lignesInscription.map((ligne) => <p data-apercu-ligne={String(ligne.numero)} hidden></p>)}
          </div>
          <p class="type-body mt-3 max-w-[56ch] text-[0.8125rem] text-muted">{MENTION_APERCU}</p>
        </div>

        {/* -------------------------------------------------- Fichiers a joindre */}
        <fieldset class="mt-16 border-t border-line pt-8">
          <legend class="label">Fichiers à joindre</legend>

          <div class="mt-6">
            {/* Mis en avant par le script pour une inscription sur monument
                existant : c est le cas ou la photo nous sert le plus. Sans
                JavaScript le rappel reste affiche, comme tout le reste. */}
            <p class="grav-rappel type-body" data-aide-photo>
              Une photo du monument existant nous aide beaucoup.
            </p>

            <label class="field-label mt-6" for="fichiers">Fichiers à joindre (facultatif)</label>
            <input
              class="mt-3 block w-full text-[0.9375rem]"
              id="fichiers"
              name="fichiers"
              type="file"
              multiple
              accept={acceptFichiers}
              aria-describedby="fichiers-aide fichiers-erreur"
            />
            <p class="type-body mt-3 text-[0.8125rem] text-muted" id="fichiers-aide">
              Un dessin à faire graver, une photo du monument existant, une esquisse. JPEG, PNG, WEBP ou
              PDF, {fichiersDevis.nombreMax} fichiers au maximum et {tailleTotaleMaxLisible} au total.
            </p>
            <p class={classeErreur} id="fichiers-erreur" data-erreur="fichiers"></p>
          </div>
        </fieldset>

        {/* -------------------------------------------------------- Message */}
        <fieldset class="mt-16 border-t border-line pt-8">
          <legend class="label">Votre message</legend>
          <div class="mt-6">
            <label class="field-label" for="message">Message (facultatif)</label>
            <textarea
              class={classeChamp}
              id="message"
              name="message"
              rows="5"
              aria-describedby="message-aide"></textarea>
            <p class={classeAide} id="message-aide">
              Tout ce qui nous aiderait : délai souhaité, monument voisin, question particulière.
            </p>
          </div>
        </fieldset>

        {/* ----------------------------------------------------- Consentement */}
        <div class="mt-16 border-t border-line pt-8">
          <label class={classeChoix} for="consentement">
            <input
              class={classeRadio}
              id="consentement"
              name="consentement"
              type="checkbox"
              value="oui"
              required
              aria-describedby="consentement-erreur"
            />
            <span>
              J'accepte que mes données soient utilisées pour traiter ma demande
              <span aria-hidden="true">*</span>. Voir la{" "}
              <a href="/protection-des-donnees/" class="link">protection des données</a>.
            </span>
          </label>
          <p class={classeErreur} id="consentement-erreur" data-erreur="consentement"></p>
        </div>

        {/* Anti-spam. Le champ `societe` est un piege : invisible et hors du
            parcours au clavier, une famille ne le remplit jamais, un robot si.
            `horodatage` porte l heure d affichage, posee par le script (la page
            est statique, le serveur ne peut pas la fournir). Les deux ne font
            que voyager : c est la fonction E6 qui tranche. */}
        <div
          aria-hidden="true"
          style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"
        >
          <label for="societe">Société</label>
          <input id="societe" name="societe" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="horodatage" value="" />

        {/* Emplacement de Cloudflare Turnstile (etape E6) : le widget viendra
            ici, juste avant le bouton. Sa cle de site, meme publique, sera
            lue dans une variable d environnement Cloudflare : aucune cle,
            publique ou secrete, n entre dans le depot. */}

        <div class="mt-12 flex flex-wrap items-center gap-6">
          <button type="submit" class="btn btn-primary" data-devis-envoyer>Envoyer ma demande</button>
          <p class="type-body hidden text-[0.9375rem]" data-devis-statut role="status" aria-live="polite"></p>
        </div>
        <p class="type-body mt-6 max-w-[56ch] text-[0.9375rem] text-muted">
          Nous vous recontactons pour affiner votre demande. Rien n'est engagé, et rien n'est gravé avant
          votre accord.
        </p>
      </form>
    </section>

    {/* ------------------------------------------------------------- Reperes */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <div class="mt-8 grid gap-8 md:grid-cols-3" data-reveal>
        <p class="type-body max-w-[34ch] text-[0.9375rem]">
          Le devis est gratuit et sans engagement, et détaille ce qui est compris.
        </p>
        <p class="type-body max-w-[34ch] text-[0.9375rem]">
          <a href="/prix-pierre-tombale-suisse/" class="link">Comment est calculé le prix ?</a>
        </p>
        <p class="type-body max-w-[34ch] text-[0.9375rem]">
          <a href="/faq/" class="link">Questions fréquentes</a>
        </p>
      </div>
    </section>
  </main>

  {/* Habillage des sections de personnalisation. Ecrit en CSS plutot qu en
      utilitaires Tailwind POUR UNE RAISON DE POIDS : la feuille Tailwind est
      unique et partagee par les 23 pages, donc toute classe inedite utilisee
      ici alourdirait aussi l accueil et les fiches. Ce bloc, lui, reste sur
      /devis/. Les classes Tailwind gardees ci-dessus servaient deja ailleurs
      dans le site : elles ne coutent rien de plus. */}
  <style>
    .grav-court {
      max-width: 24rem;
    }

    /* Les 6 styles d ecriture. Chaque nom est ecrit dans sa police : la liste
       est a la fois l echantillon et le choix. */
    .grav-polices {
      display: grid;
      gap: 1.25rem;
      margin-top: 1rem;
    }
    .grav-polices label {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .grav-nom {
      display: block;
      font-size: 1.5rem;
      line-height: 1;
    }
    .grav-style {
      display: block;
      margin-top: 0.25rem;
      font-size: 0.75rem;
      color: var(--muted);
    }

    /* Pastilles de granit : de vrais boutons radio, masques a l oeil mais
       toujours la pour le clavier et les lecteurs d ecran. L etat coche et le
       focus se lisent sur l anneau de la pastille. */
    .grav-granit-groupe {
      margin-top: 1.75rem;
    }
    .grav-granit-titre {
      margin: 0;
      font-size: 0.8125rem;
      color: var(--muted);
    }
    .grav-pastilles {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 1.25rem;
      margin-top: 0.75rem;
    }
    .grav-pastille {
      position: relative;
      display: flex;
      width: 5rem;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      text-align: center;
    }
    .grav-pastille input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }
    .grav-rond {
      display: block;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 999px;
      box-shadow: inset 0 0 0 1px var(--line-strong);
      transition: box-shadow 200ms ease;
    }
    .grav-pastille input:checked + .grav-rond,
    .grav-pastille input:focus-visible + .grav-rond {
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        0 0 0 2px var(--canvas),
        0 0 0 4px var(--ink);
    }
    .grav-pastille-nom {
      font-size: 0.75rem;
      line-height: 1.25;
      color: var(--muted);
    }
    .grav-pastille input:checked ~ .grav-pastille-nom {
      color: var(--ink);
    }

    /* Une ligne d inscription : son texte, et la taille de ses lettres. */
    .grav-ligne {
      display: grid;
      gap: 1.25rem;
    }
    .grav-sous-label {
      display: block;
      font-size: 0.8125rem;
      color: var(--muted);
    }
    .grav-rappel {
      margin-top: 0.75rem;
      border-left: 2px solid var(--line);
      padding-left: 1rem;
      font-size: 0.8125rem;
    }
    .grav-motif {
      max-width: 32rem;
    }
    @media (min-width: 40rem) {
      .grav-polices {
        grid-template-columns: 1fr 1fr;
      }
    }
    @media (min-width: 48rem) {
      .grav-ligne {
        grid-template-columns: 1fr auto;
        align-items: start;
      }
      .grav-reglages {
        width: 11rem;
      }
    }

    /* L apercu. Le cadre prend la couleur approximative du granit choisi ;
       un granit clair sous une gravure blanche se lit mal, une ombre tres
       legere detache donc les lettres, comme le fait le creux de la gravure. */
    .grav-cadre {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.5rem;
      min-height: 12rem;
      padding: 2.5rem 1.5rem;
      text-align: center;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    }
    .grav-cadre p {
      margin: 0;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
    .grav-vide {
      font-size: 0.8125rem;
      color: #f4f1ea;
    }
  </style>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />

  <script is:inline define:vars={{ reglages }}>
    (() => {
      const form = document.querySelector("[data-devis]");
      if (!form) return;

      /* On prend la main sur la validation : les messages maison sont en
         francais, places sous le champ et annonces. Sans JavaScript, ce sont
         les messages du navigateur qui jouent, grace aux attributs `required`
         du HTML. */
      form.noValidate = true;

      const resume = form.querySelector("[data-devis-resume]");
      const statut = form.querySelector("[data-devis-statut]");
      const bouton = form.querySelector("[data-devis-envoyer]");

      const champ = (nom) => form.elements[nom];
      const zoneErreur = (nom) => form.querySelector(`[data-erreur="${nom}"]`);

      /* `form.elements.typeDemande` est la liste des trois boutons radio, pas
         un champ : on prend le premier pour poser l etat et le focus. */
      function premierControle(nom) {
        const controle = champ(nom);
        if (typeof RadioNodeList !== "undefined" && controle instanceof RadioNodeList) {
          return controle[0];
        }
        return controle;
      }

      function poseErreur(nom, texte) {
        const zone = zoneErreur(nom);
        if (!zone) return;
        zone.textContent = texte;
        zone.classList.remove("hidden");
        const controle = premierControle(nom);
        if (controle && controle.setAttribute) controle.setAttribute("aria-invalid", "true");
      }

      function videErreurs() {
        form.querySelectorAll("[data-erreur]").forEach((zone) => {
          zone.textContent = "";
          zone.classList.add("hidden");
          const controle = premierControle(zone.dataset.erreur);
          if (controle && controle.removeAttribute) controle.removeAttribute("aria-invalid");
        });
        resume.textContent = "";
        resume.classList.add("hidden");
      }

      function annonce(texte) {
        statut.textContent = texte;
        statut.classList.toggle("hidden", texte === "");
      }

      // Horodatage d affichage : un robot poste en quelques millisecondes.
      function poseHorodatage() {
        const horodatage = champ("horodatage");
        if (horodatage) horodatage.value = String(Date.now());
      }
      poseHorodatage();

      /* ----------------------------------------- Comment vous recontacter ---
         Par defaut nous repondons par e-mail, et le telephone est facultatif.
         Si la famille prefere un appel, le numero devient NECESSAIRE (c est
         alors le seul moyen de la joindre) et nous lui demandons quand
         l appeler. Sans JavaScript, les deux champs restent visibles et
         facultatifs : aucun champ masque n est jamais `required`. */
      const telephone = champ("telephone");
      const blocQuandAppeler = form.querySelector("[data-quand-appeler]");
      const telFacultatif = form.querySelector("[data-tel-facultatif]");
      const telRequis = form.querySelector("[data-tel-requis]");

      function majRecontact() {
        const recontact = champ("recontact");
        const parTelephone = Boolean(recontact) && recontact.value === "telephone";
        if (blocQuandAppeler) blocQuandAppeler.hidden = !parTelephone;
        if (telephone) telephone.required = parTelephone;
        if (telFacultatif) telFacultatif.hidden = parTelephone;
        if (telRequis) telRequis.hidden = !parTelephone;
      }

      /* ------------------------------------------- Sections conditionnelles --
         Une inscription sur un monument existant n a pas de modele a choisir ;
         une "autre demande" n a ni monument ni inscription. Les sections
         repliees sont aussi DESACTIVEES (`fieldset.disabled`) : leurs valeurs
         par defaut ne partent donc pas avec la demande. Aucune ne contient de
         champ obligatoire, donc rien ne peut rester requis et invisible.
         Sans JavaScript, tout reste visible et actif. */
      const aidePhoto = form.querySelector("[data-aide-photo]");

      function majSections() {
        const typeDemande = champ("typeDemande");
        const choix =
          reglages.blocsParTypeDemande[typeDemande ? typeDemande.value : ""] || {
            monument: true,
            inscription: true,
            photo: false,
          };
        form.querySelectorAll("[data-bloc]").forEach((bloc) => {
          const visible = choix[bloc.dataset.bloc] !== false;
          bloc.hidden = !visible;
          if (bloc.tagName === "FIELDSET") bloc.disabled = !visible;
        });
        if (aidePhoto) aidePhoto.hidden = !choix.photo;
      }

      /* ------------------------------------------------- Lignes 3 et 4 -------
         Deux lignes suffisent au depart. Les suivantes se depliant une a une,
         le formulaire tient dans un ecran de telephone. Sans JavaScript elles
         sont toutes la, et le bouton n apparait pas. */
      const lignesSup = Array.from(form.querySelectorAll("[data-ligne-sup]"));
      const boutonLigne = form.querySelector("[data-ajouter-ligne]");

      function majBoutonLigne() {
        if (boutonLigne) boutonLigne.hidden = !lignesSup.some((bloc) => bloc.hidden);
      }

      /** Deplie les lignes supplementaires qui portent deja du texte. */
      function ouvreLignesRemplies() {
        for (const bloc of lignesSup) {
          const texte = bloc.querySelector("input[type='text']");
          if (texte && String(texte.value || "").trim() !== "") bloc.hidden = false;
        }
        majBoutonLigne();
      }

      if (lignesSup.length > 0 && boutonLigne) {
        for (const bloc of lignesSup) bloc.hidden = true;
        boutonLigne.addEventListener("click", () => {
          const suivante = lignesSup.find((bloc) => bloc.hidden);
          if (!suivante) return;
          suivante.hidden = false;
          majBoutonLigne();
          const texte = suivante.querySelector("input[type='text']");
          if (texte && texte.focus) texte.focus();
        });
      }

      /* ------------------------------------------ Apercu de la gravure -------
         Progressive enhancement : sans ce script, les listes, les radios et les
         champs restent la, et seul l apercu manque. Aucune librairie, aucun
         canvas. Le style d ecriture est unique : toutes les lignes le portent. */
      const apercu = form.querySelector("[data-apercu]");
      const cadre = form.querySelector("[data-apercu-cadre]");
      const apercuVide = form.querySelector("[data-apercu-vide]");
      const apercuPret = Boolean(apercu && cadre && apercuVide);

      function famillePoliceChoisie() {
        const choix = champ("police");
        const police = choix ? reglages.polices[choix.value] : null;
        return police ? police.famille : "inherit";
      }

      function majApercu() {
        if (!apercuPret) return;

        const granit = champ("granit");
        cadre.style.backgroundColor =
          (granit && reglages.couleurParGranit[granit.value]) || reglages.couleurGranitDefaut;

        /* `form.elements.finition` est la liste des radios : sa `value` est
           celle du bouton coche, vide si c est "Je ne sais pas encore". */
        const finition = champ("finition");
        const couleur =
          reglages.couleurParFinition[finition ? finition.value : ""] || reglages.couleurFinitionDefaut;
        const famille = famillePoliceChoisie();

        let rempli = false;
        for (const numero of reglages.lignes) {
          const ligne = form.querySelector(`[data-apercu-ligne="${numero}"]`);
          if (!ligne) continue;
          const texte = String(champ(`ligne${numero}_texte`).value || "").trim();
          const hauteur = Number(champ(`ligne${numero}_hauteur`).value) || 40;
          ligne.textContent = texte;
          ligne.hidden = texte === "";
          ligne.style.fontFamily = famille;
          ligne.style.fontSize = (hauteur * reglages.apercuPxParMm).toFixed(1) + "px";
          ligne.style.color = couleur;
          if (texte !== "") rempli = true;
        }
        apercuVide.hidden = rempli;
      }

      // Motif qui demande un dessin ou une explication : on le rappelle.
      const motifRappel = form.querySelector("[data-motif-rappel]");

      function majMotif() {
        const motif = champ("motif");
        if (motif && motifRappel) {
          motifRappel.hidden = !reglages.motifsAvecPrecision.includes(motif.value);
        }
      }

      /* ------------------------------------------------------- Brouillon -----
         Une famille remplit ce formulaire en plusieurs fois, parfois en
         cherchant une date dans un papier. Les champs texte, les listes et les
         choix sont donc gardes dans le navigateur, sur sa machine et nulle part
         ailleurs. JAMAIS les fichiers joints (le navigateur ne le permet pas),
         jamais le consentement : il doit etre donne a chaque envoi.
         Tout passe par try/catch : navigation privee, stockage plein ou refuse,
         JSON abime — le brouillon est un confort, son echec ne doit jamais
         empecher une demande. */
      const brouillon = form.querySelector("[data-brouillon]");
      const boutonEffacer = form.querySelector("[data-brouillon-effacer]");
      const IGNORES = ["societe", "horodatage", "consentement", "fichiers"];

      function champsBrouillon() {
        return Array.from(form.elements).filter(
          (element) =>
            element.name &&
            !IGNORES.includes(element.name) &&
            element.type !== "file" &&
            element.type !== "hidden" &&
            element.type !== "submit" &&
            element.type !== "button" &&
            element.type !== "checkbox",
        );
      }

      /** Vrai quand la famille a vraiment ecrit quelque chose. */
      function brouillonUtile(champs) {
        return champs.some(
          (element) =>
            (element.tagName === "TEXTAREA" || ["text", "tel", "email", "date"].includes(element.type)) &&
            String(element.value || "").trim() !== "",
        );
      }

      function oublieBrouillon() {
        try {
          window.localStorage.removeItem(reglages.cleBrouillon);
        } catch {
          /* Rien a faire : il n y avait deja peut-etre rien. */
        }
      }

      function sauveBrouillon() {
        try {
          const champs = champsBrouillon();
          if (!brouillonUtile(champs)) {
            oublieBrouillon();
            return;
          }
          const donnees = {};
          for (const element of champs) {
            if (element.type === "radio") {
              if (element.checked) donnees[element.name] = element.value;
            } else {
              donnees[element.name] = element.value;
            }
          }
          window.localStorage.setItem(reglages.cleBrouillon, JSON.stringify(donnees));
        } catch {
          /* Stockage indisponible : on continue sans brouillon. */
        }
      }

      function restaureBrouillon() {
        let donnees = null;
        try {
          const brut = window.localStorage.getItem(reglages.cleBrouillon);
          donnees = brut ? JSON.parse(brut) : null;
        } catch {
          donnees = null;
        }
        if (!donnees || typeof donnees !== "object") return false;

        for (const element of champsBrouillon()) {
          const valeur = donnees[element.name];
          if (typeof valeur !== "string") continue;
          if (element.type === "radio") {
            if (element.value === valeur) element.checked = true;
          } else {
            element.value = valeur;
          }
        }
        return true;
      }

      let minuteurBrouillon = 0;
      function planifieSauvegarde() {
        window.clearTimeout(minuteurBrouillon);
        minuteurBrouillon = window.setTimeout(sauveBrouillon, 500);
      }

      /** Remet toutes les parties mobiles d accord avec les champs. */
      function majTout() {
        majRecontact();
        majSections();
        majMotif();
        majApercu();
      }

      if (restaureBrouillon() && brouillon) brouillon.hidden = false;
      ouvreLignesRemplies();

      /* Pre-selection du modele depuis /devis/?modele=<slug>, pose par les
         fiches. Elle passe APRES le brouillon : venir d une fiche est une
         intention plus recente que le brouillon de la veille. Un slug inconnu
         est ignore : le select reste sur "Je ne sais pas encore" plutot que
         d afficher un choix qui n existe pas. */
      const demande = new URLSearchParams(window.location.search).get("modele");
      const selectModele = champ("modele");
      if (demande && selectModele && reglages.famillesParModele[demande]) {
        selectModele.value = demande;
        const selectFamille = champ("famille");
        if (selectFamille && selectFamille.value === "") {
          selectFamille.value = reglages.famillesParModele[demande];
        }
      }

      majTout();

      form.addEventListener("input", () => {
        majTout();
        planifieSauvegarde();
      });
      form.addEventListener("change", () => {
        majTout();
        planifieSauvegarde();
      });

      if (boutonEffacer) {
        boutonEffacer.addEventListener("click", () => {
          oublieBrouillon();
          form.reset();
          poseHorodatage();
          if (brouillon) brouillon.hidden = true;
          videErreurs();
          for (const bloc of lignesSup) bloc.hidden = true;
          majBoutonLigne();
          majTout();
        });
      }

      const REQUIS = [
        ["nom", "Merci d'indiquer votre nom et votre prénom."],
        ["email", "Merci d'indiquer une adresse e-mail : c'est par là que nous répondons."],
        ["localite", "Merci d'indiquer votre localité."],
        ["typeDemande", "Merci de choisir le type de demande."],
        ["consentement", "Merci de cocher cette case pour que nous puissions traiter votre demande."],
      ];

      function estVide(nom) {
        const controle = champ(nom);
        if (!controle) return false;
        if (controle.type === "checkbox") return !controle.checked;
        return String(controle.value || "").trim() === "";
      }

      /** Les fichiers joints : nombre, poids total et format. */
      function erreurFichiers() {
        const controle = champ("fichiers");
        if (!controle || !controle.files || controle.files.length === 0) return null;

        const fichiers = Array.from(controle.files);
        if (fichiers.length > reglages.nombreMaxFichiers) {
          return `${reglages.nombreMaxFichiers} fichiers au maximum (vous en avez choisi ${fichiers.length}).`;
        }

        const total = fichiers.reduce((somme, fichier) => somme + fichier.size, 0);
        if (total > reglages.tailleTotaleMaxOctets) {
          const poids = (total / (1024 * 1024)).toFixed(1).replace(".", ",");
          return `${reglages.tailleLisible} au total au maximum (vos fichiers pèsent ${poids} Mo).`;
        }

        const refuse = fichiers.find((fichier) => !reglages.typesAcceptes.includes(fichier.type));
        if (refuse) {
          return `Le fichier « ${refuse.name} » n'est pas dans un format accepté : JPEG, PNG, WEBP ou PDF.`;
        }

        return null;
      }

      function valide() {
        const problemes = [];

        for (const [nom, texte] of REQUIS) {
          if (estVide(nom)) problemes.push([nom, texte]);
        }

        const email = champ("email");
        if (email && email.value.trim() !== "" && email.validity.typeMismatch) {
          problemes.push(["email", "Cette adresse e-mail semble incomplète (exemple : nom@exemple.ch)."]);
        }

        // Le numero n est necessaire que si la famille demande un appel.
        if (telephone && telephone.required && estVide("telephone")) {
          problemes.push([
            "telephone",
            "Merci d'indiquer un numéro de téléphone, pour que nous puissions vous appeler.",
          ]);
        }

        const fichiers = erreurFichiers();
        if (fichiers) problemes.push(["fichiers", fichiers]);

        return problemes;
      }

      champ("fichiers").addEventListener("change", () => {
        const zone = zoneErreur("fichiers");
        const texte = erreurFichiers();
        zone.textContent = texte || "";
        zone.classList.toggle("hidden", !texte);
      });

      async function envoie() {
        bouton.disabled = true;
        annonce(reglages.messages.envoiEnCours);

        try {
          const reponse = await fetch(reglages.endpoint, { method: "POST", body: new FormData(form) });
          let charge = null;
          try {
            charge = await reponse.json();
          } catch {
            charge = null;
          }

          if (reponse.ok && charge && charge.ok === true) {
            // La demande est partie : le brouillon n a plus de raison d etre.
            oublieBrouillon();
            window.location.href = "/devis/merci/";
            return;
          }

          if (charge && charge.erreurs) {
            for (const [nom, texte] of Object.entries(charge.erreurs)) poseErreur(nom, String(texte));
            resume.textContent = reglages.messages.erreurSaisie;
            resume.classList.remove("hidden");
            annonce("");
          } else {
            annonce(reglages.messages.erreurReseau);
          }
        } catch {
          annonce(reglages.messages.erreurReseau);
        }

        bouton.disabled = false;
      }

      form.addEventListener("submit", (evenement) => {
        evenement.preventDefault();
        videErreurs();

        const problemes = valide();
        if (problemes.length > 0) {
          for (const [nom, texte] of problemes) poseErreur(nom, texte);
          resume.textContent = reglages.messages.erreurSaisie;
          resume.classList.remove("hidden");
          annonce("");
          const premier = premierControle(problemes[0][0]);
          if (premier && premier.focus) premier.focus();
          return;
        }

        // Tant que la fonction /api/devis n existe pas, on ne poste rien.
        if (!reglages.envoiActif) {
          annonce(reglages.messages.envoiInactif);
          return;
        }

        envoie();
      });
    })();
  </script>
</BaseLayout>
