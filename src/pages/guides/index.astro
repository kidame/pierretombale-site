---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MentionVerification from "@/components/MentionVerification.astro";
import { pageTitle } from "@/config/site";
import { GUIDES, GUIDES_URL, guideUrl } from "@/data/guides";
import { breadcrumbSchema } from "@/data/seo";

/* Index des guides. La liste vient de src/data/guides.ts : un guide ajoute
   la-bas apparait ici et dans le pied de page sans rien recopier.
   Regle de contenu : voir l en-tete de src/data/guides.ts. */

const origin = Astro.site ?? new URL(Astro.url.origin);

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: "Guides", path: GUIDES_URL },
  ],
  origin,
);
---

<BaseLayout
  title={pageTitle("Guides : cimetières et monuments dans le canton de Neuchâtel")}
  description="Nos guides pour les familles : quand poser une pierre tombale, que faire des cendres (columbarium, cavurne, jardin du souvenir) et quelle épitaphe faire graver."
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 max-w-[22ch]">Guides</h1>
      <p class="type-lead mt-8 max-w-[58ch]">
        Les réponses que les familles cherchent avant de commander un monument, avec les règles réellement
        en vigueur dans les cimetières du canton de Neuchâtel : chaque affirmation cite la commune,
        l'article du règlement et le document officiel.
      </p>
      <div class="mt-8">
        <MentionVerification />
      </div>
    </section>

    <section class="shell mt-8 md:mt-12">
      <div class="rule"></div>
      <ul class="mt-8 border-t border-line">
        {
          GUIDES.map((guide) => (
            <li class="grid gap-x-8 gap-y-3 border-b border-line py-8 md:grid-cols-12">
              <h2 class="type-h3 max-w-[26ch] md:col-span-5">
                <a href={guideUrl(guide.slug)} class="link">
                  {guide.titreCourt}
                </a>
              </h2>
              <div class="md:col-span-7">
                <p class="type-body max-w-[56ch] text-[0.9375rem]">{guide.resume}</p>
                <p class="mt-4">
                  <a href={guideUrl(guide.slug)} class="link link-mono text-muted">
                    Lire le guide
                  </a>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ------------------------------------------------------------- Appel */}
    <section class="shell mt-24 md:mt-36">
      <div class="grid items-end gap-8 md:grid-cols-12">
        <div class="md:col-span-7">
          <h2 class="type-h2 max-w-[20ch]">Une question sur votre cimetière ?</h2>
          <p class="type-body mt-6 max-w-[52ch]">
            Dites-nous la commune et le type de sépulture : nous vérifions le règlement du cimetière
            concerné, nous adaptons le monument à ce qu'il autorise et nous établissons un devis gratuit.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href="/devis/" class="btn btn-primary">Demander un devis</a>
          <a href="/faq/" class="btn btn-outline">Questions fréquentes</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />
</BaseLayout>
