---
import FicheModele from "@/components/FicheModele.astro";
import { getProductsByFamille, getRelated } from "@/data/products";

/* Un modele n existe qu a l adresse de sa famille : seuls les modeles de la
   famille cineraire sont generes ici. Les props sont typees par getStaticPaths. */
export async function getStaticPaths() {
  const products = await getProductsByFamille("cineraire");
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, related: getRelated(products, product.slug) },
  }));
}

const { product, related } = Astro.props;
---

<FicheModele product={product} related={related} />
