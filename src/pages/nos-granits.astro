---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageTitle } from "@/config/site";
import { granitsParTeinte } from "@/data/granits";
import { familleUrl } from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";

/* Page "Nos granits", construite entierement depuis src/data/granits.json
   (groupes par teinte via `granitsParTeinte`) : aucun nom de granit n est
   ecrit ici. Deux choses a ne jamais ajouter : une origine geographique (cf.
   "Regles de communication du site" dans docs/DECISIONS-ET-ETAT.md) et une
   pastille presentee comme un echantillon fidele : ce sont des reperes. */

const origin = Astro.site ?? new URL(Astro.url.origin);

const groupes = granitsParTeinte();
const nombre = groupes.reduce((total, groupe) => total + groupe.granits.length, 0);

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: "Nos granits", path: "/nos-granits/" },
  ],
  origin,
);
---

<BaseLayout
  title={pageTitle("Nos granits")}
  description="Les granits proposés pour nos monuments funéraires et cinéraires, par teinte. Chaque modèle du catalogue se réalise dans les granits disponibles."
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[16ch]">Nos granits</h1>
      <p class="type-lead hero-in mt-8 max-w-[58ch]" style="--reveal-delay:120ms">
        Le granit montré sur une fiche n'est qu'un exemple : chaque modèle du catalogue se réalise dans les
        granits disponibles. La liste ci-dessous est susceptible d'évoluer.
      </p>
    </section>

    <section class="shell mt-8 md:mt-12">
      <div class="rule" data-reveal="line"></div>
      <p class="label mt-8" data-reveal>
        {nombre === 1 ? "1 granit" : `${nombre} granits`} · {groupes.length === 1 ? "1 teinte" : `${groupes.length} teintes`}
      </p>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:mt-14 md:grid-cols-3">
        {
          groupes.map((groupe, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <div class="flex items-center gap-3">
                <span
                  class="inline-block size-5 rounded-full border border-line"
                  style={`background:${groupe.pastille}`}
                  aria-hidden="true"
                ></span>
                <h2 class="type-h3">{groupe.titre}</h2>
              </div>
              <p class="label mt-3">
                {groupe.granits.length === 1 ? "1 granit" : `${groupe.granits.length} granits`}
              </p>
              <ul class="type-body mt-4 text-[0.9375rem]">
                {groupe.granits.map((granit) => (
                  <li>{granit.nom}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="type-body mt-14 max-w-[52ch] text-[0.9375rem] text-muted" data-reveal>
        Les pastilles de couleur sont des repères approximatifs. Une teinte se juge sur la pierre : nous vous
        montrons les granits retenus avant de commander.
      </p>
    </section>

    {/* ------------------------------------------------------------- Appel */}
    <section class="shell mt-24 md:mt-36">
      <div class="grid items-end gap-8 md:grid-cols-12" data-reveal>
        <div class="md:col-span-7">
          <h2 class="type-h2 max-w-[20ch]">Choisir un modèle, puis son granit</h2>
          <p class="type-body mt-6 max-w-[52ch]">
            Le choix du granit se fait au rendez-vous, avec le modèle et la gravure. Il entre dans
            l'estimation du monument.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href="/devis/" class="btn btn-primary">Demander un devis</a>
          <a href={familleUrl("monument")} class="btn btn-outline">Monuments funéraires</a>
          <a href={familleUrl("cineraire")} class="btn btn-outline">Monuments cinéraires</a>
        </div>
      </div>
      <p class="mt-8" data-reveal>
        <a href="/prix-pierre-tombale-suisse/" class="link link-mono text-muted">Comment est calculé le prix ?</a>
      </p>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />
</BaseLayout>
