---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { adressePostaleJsonLd, entreprise, renseigne } from "@/config/entreprise";
import { pageTitle, siteConfig } from "@/config/site";
import { familleUrl } from "@/data/products";

/* ACCUEIL, selon la maquette du 26.10.2026 (docs/DESIGN.md).
   Sections : hero sombre, collection (2 familles), matiere, personnalisation,
   parcours en 4 etapes, appel final. Les cinq visuels sont dans
   public/images/accueil/ (images d illustration provisoires, a remplacer par
   des photos des vraies realisations quand elles existent). */

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;

/* Le parcours d une famille, en quatre etapes. Les mots comptent : rien n est
   grave sans bon a tirer valide, et la pose est faite par l entreprise
   elle-meme (cf. "Regles de communication du site" dans
   docs/DECISIONS-ET-ETAT.md). Le detail complet vit sur /a-propos/. */
const etapes = [
  {
    titre: "Conseil et choix",
    texte:
      "Un rendez-vous pour parler de la sépulture et du règlement du cimetière, puis choisir le modèle, le granit et la gravure.",
  },
  {
    titre: "Devis détaillé",
    texte:
      "Un devis écrit, poste par poste : le monument, le granit, la gravure, les accessoires et la pose.",
  },
  {
    titre: "Bon à tirer de la gravure",
    texte: "Le texte, les dates et les motifs vous sont soumis en épreuve. Rien n'est gravé avant votre accord.",
  },
  {
    titre: "Pose et suivi",
    texte:
      "Nous posons le monument au cimetière, et nous restons joignables ensuite pour l'entretien.",
  },
];

/* Organization : seules les coordonnees connues sont publiees. Tant que
   src/config/entreprise.ts est a `null`, la fiche se limite au nom et a
   l adresse du site. Une adresse ou un telephone inventes dans les donnees
   structurees se retrouveraient dans la fiche Google de l entreprise. */
const adressePostale = adressePostaleJsonLd();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteUrl,
  ...(renseigne(entreprise.email) ? { email: entreprise.email } : {}),
  ...(renseigne(entreprise.telephone) ? { telephone: entreprise.telephone } : {}),
  ...(adressePostale ? { address: adressePostale } : {}),
};
---

<BaseLayout
  title={pageTitle("Monuments funéraires et cinéraires")}
  description="Monuments funéraires et monuments cinéraires en granit massif, réalisés sur mesure pour la Suisse romande. Conseil, gravure et pose compris dans le devis."
  footerJoint
>
  <main id="main-content">
    {/* ---------------------------------------------------------------- Hero */}
    <section class="nuit hero" aria-labelledby="hero-titre">
      <div class="hero-fond">
        <video
          data-hero-video
          poster="/images/accueil/hero-video-poster-1200.webp"
          width="1280"
          height="720"
          autoplay
          muted
          playsinline
          preload="auto"
          disablepictureinpicture
          disableRemotePlayback
          role="img"
          aria-label="Un monument funéraire en granit sombre sort peu à peu de l'ombre"
        >
          <source src="/videos/accueil/hero.mp4" type="video/mp4" />
        </video>
      </div>
      <button type="button" class="hero-pause" data-hero-pause aria-label="Mettre l'animation en pause" hidden>
        <svg class="hero-pause-ico" data-ico-pause viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg class="hero-pause-ico" data-ico-lire viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style="display:none">
          <path d="M8 5l11 7-11 7z" fill="currentColor" />
        </svg>
      </button>
      <div class="shell hero-grille">
        <div class="hero-texte">
          <p class="label">L'art du souvenir</p>
          <h1 id="hero-titre" class="type-hero">Ce qui demeure.</h1>
          <p class="type-lead">Un hommage façonné pour traverser le temps.</p>
          <p class="hero-precision">
            Monuments funéraires et cinéraires en granit, pour les familles de Suisse romande.
          </p>
        </div>
        <div class="hero-cta">
          <a href={familleUrl("monument")} class="btn btn-outline">Découvrir les monuments</a>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------- Collection */}
    <section class="collection" aria-labelledby="collection-titre">
      <div class="shell">
        <header class="titre-centre">
          <p class="label">La collection</p>
          <h2 id="collection-titre" class="type-h2">La justesse des lignes.</h2>
        </header>

        <div class="collection-grille">
          <a href={familleUrl("monument")} class="carte">
            <div class="carte-image">
              <img
                src="/images/accueil/collection-funeraire-720.webp"
                width="720"
                height="360"
                alt="Illustration d'un monument funéraire en granit"
                class="carte-img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="type-h3">Monuments funéraires</h3>
            <span class="lien-trait">Découvrir<span class="trait" aria-hidden="true"></span></span>
          </a>

          <a href={familleUrl("cineraire")} class="carte">
            <div class="carte-image">
              <img
                src="/images/accueil/collection-cineraire-720.webp"
                width="720"
                height="360"
                alt="Illustration d'un monument cinéraire en granit"
                class="carte-img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="type-h3">Monuments cinéraires</h3>
            <span class="lien-trait">Découvrir<span class="trait" aria-hidden="true"></span></span>
          </a>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- Matiere */}
    <section class="nuit bande matiere" aria-labelledby="matiere-titre">
      <div class="bande-visuel matiere-visuel">
        <img
          src="/images/accueil/matiere-768.webp"
          sizes="(min-width: 1024px) 50vw, 100vw"
          width="768"
          height="512"
          alt="Surface de granit poli, vue de près"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="bande-texte">
        <p class="label">La matière, dans son essence</p>
        <h2 id="matiere-titre" class="type-h2">La noblesse du granit.</h2>
        <p class="type-lead">Des nuances singulières. Des finitions choisies avec soin.</p>
        <a href="/nos-granits/" class="btn btn-outline">Explorer les matières</a>
      </div>
    </section>

    {/* ------------------------------------------------------ Personnalisation */}
    <section class="nuit bande detail" aria-labelledby="detail-titre">
      <div class="bande-texte">
        <p class="label">Un hommage personnel</p>
        <h2 id="detail-titre" class="type-h2">Chaque détail compte.</h2>
        <p class="type-lead">La matière, les mots, le dessin. Composez un monument à son image.</p>
        <a href={familleUrl("monument")} class="btn btn-outline">Personnaliser un monument</a>
      </div>
      <div class="bande-visuel detail-visuel">
        <img
          src="/images/accueil/gravure-900.webp"
          sizes="(min-width: 1024px) 50vw, 100vw"
          width="900"
          height="450"
          alt="Illustration d'une gravure sur granit"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    {/* ------------------------------------------------------- Comment ca se passe */}
    <section class="etapes" aria-labelledby="etapes-titre">
      <div class="shell">
        <header class="titre-centre">
          <p class="label">Notre accompagnement</p>
          <h2 id="etapes-titre" class="type-h2">Comment ça se passe</h2>
        </header>
        <ol class="etapes-liste">
          {
            etapes.map((etape, index) => (
              <li>
                <p class="label">Étape {index + 1}</p>
                <h3 class="type-h3">{etape.titre}</h3>
                <p class="type-body">{etape.texte}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* --------------------------------------------------------- Appel final */}
    <section class="nuit appel" aria-labelledby="appel-titre">
      <div class="shell">
        <h2 id="appel-titre" class="type-h2">Votre histoire mérite notre attention.</h2>
        <a href="/devis/" class="lien-trait">Parlons de votre projet<span class="trait" aria-hidden="true"></span></a>
        <p class="appel-zone">
          Au Val-de-Travers, dans le canton de Neuchâtel et en Suisse romande. Pour un cimetière plus éloigné,
          demandez-nous.
        </p>
      </div>
    </section>
  </main>

  <script>
    /* Hero : la video joue une fois (pas de boucle) puis reste sur l'image finale.
       Mouvement reduit ou economie de donnees : pas de lecture automatique.
       Bouton pause/lecture pour toute animation de plus de 5 secondes. */
    const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
    const bouton = document.querySelector<HTMLButtonElement>("[data-hero-pause]");
    if (video && bouton) {
      const icoPause = bouton.querySelector<SVGElement>("[data-ico-pause]")!;
      const icoLire = bouton.querySelector<SVGElement>("[data-ico-lire]")!;
      const majBouton = () => {
        const enPause = video.paused;
        icoPause.style.display = enPause ? "none" : "";
        icoLire.style.display = enPause ? "" : "none";
        bouton.setAttribute("aria-label", enPause ? "Lire l'animation" : "Mettre l'animation en pause");
      };
      const connexion = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
      const sobre = window.matchMedia("(prefers-reduced-motion: reduce)").matches || connexion?.saveData === true;
      if (sobre) {
        video.removeAttribute("autoplay");
        video.pause();
      }
      bouton.hidden = false;
      majBouton();
      bouton.addEventListener("click", () => {
        if (video.paused) void video.play();
        else video.pause();
      });
      video.addEventListener("play", majBouton);
      video.addEventListener("pause", majBouton);
      video.addEventListener("ended", () => {
        bouton.hidden = true;
      });
    }
  </script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
</BaseLayout>

<style>
  /* Rythme vertical commun des sections claires. */
  .collection,
  .etapes {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .titre-centre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  /* ---- Hero ---------------------------------------------------------------
     Maquette : le monument entier, jamais recadre (object-fit: contain), pose
     a droite ; les bords de l'image (fond un peu plus noir que --canvas) sont
     fondus par des degrades ; le texte a gauche, le bouton en bas. Telephone :
     meme principe, l'image deborde a droite. */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-fond {
    position: absolute;
    inset: 0;
  }

  .hero-fond video {
    position: absolute;
    right: 0;
    bottom: 0;
    display: block;
    width: 150%;
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    /* Le bord haut de l'image (fond plus noir que --canvas) est fondu. */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%);
    mask-image: linear-gradient(to bottom, transparent, #000 22%);
  }

  .hero-pause {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    right: var(--gutter, 1.5rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in oklab, var(--canvas) 55%, transparent);
    color: var(--ink);
    cursor: pointer;
  }

  .hero-pause:hover {
    border-color: var(--ink);
  }

  .hero-pause:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .hero-pause[hidden],
  .hero-pause-ico[hidden] {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-pause {
      top: auto;
      bottom: 1.5rem;
    }
  }

  .hero-fond::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, transparent 78%, var(--canvas) 100%),
      linear-gradient(to right, var(--canvas) 8%, transparent 45%);
  }

  .hero-grille {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: min(40rem, calc(100svh - 4.5rem));
    padding-block: 1.5rem 2rem;
  }

  .hero-texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 15rem;
  }

  .hero-texte .type-lead {
    max-width: 18ch;
    color: var(--ink);
  }

  .hero-precision {
    max-width: 24ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero-cta .btn {
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero-cta .btn {
      width: auto;
    }

    .hero-fond video {
      width: 120%;
    }

    .hero-texte {
      max-width: 24rem;
    }

    .hero-texte .type-lead {
      max-width: 26ch;
    }

    .hero-precision {
      max-width: 34ch;
    }
  }

  @media (min-width: 1024px) {
    .hero-fond video {
      position: static;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: contain;
      object-position: right 55%;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero-fond::after {
      background:
        linear-gradient(to bottom, var(--canvas) 0%, transparent 16%, transparent 78%, var(--canvas) 100%),
        linear-gradient(to right, var(--canvas) 32%, transparent 62%);
    }

    .hero-grille {
      justify-content: center;
      gap: 2.5rem;
      min-height: clamp(34rem, 40vw, calc(100vh - 9.75rem));
      padding-block: 4rem;
      padding-inline: clamp(2.5rem, 6vw, 7rem);
    }

    .hero-texte {
      max-width: 30rem;
    }

    .hero-texte .type-lead {
      max-width: 30ch;
    }

    .hero-precision {
      max-width: 38ch;
    }

    .hero-cta {
      max-width: 34rem;
    }
  }

  /* ---- Collection -------------------------------------------------------- */
  .collection-grille {
    display: grid;
    gap: 3rem;
    max-width: 72rem;
    margin: 3rem auto 0;
  }

  @media (min-width: 768px) {
    .collection-grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
      margin-top: 4rem;
    }
  }

  .carte {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .carte-image {
    width: 100%;
    overflow: hidden;
    background: var(--surface);
  }

  .carte-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-expo);
  }

  .carte:hover .carte-img,
  .carte:focus-visible .carte-img {
    transform: scale(1.03);
  }

  .carte .type-h3 {
    margin-top: 0.75rem;
  }

  /* "Decouvrir ----" : zone de clic de 48 px, filet bronze. */
  .lien-trait {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    transition: color 240ms ease;
  }

  .lien-trait:hover,
  .lien-trait:focus-visible {
    color: var(--accent);
  }

  .trait {
    display: inline-block;
    width: 2.75rem;
    height: 1px;
    background: currentColor;
    transition: width 420ms var(--ease-out-expo);
  }

  .carte:hover .trait,
  .lien-trait:hover .trait {
    width: 4rem;
  }

  /* ---- Bandes sombres : image d un cote, texte de l autre ------------------ */
  .bande {
    display: grid;
  }

  .bande-visuel {
    position: relative;
    min-height: 16rem;
    overflow: hidden;
  }

  .bande-texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.25rem;
    padding: 3.5rem var(--gutter) 4rem;
  }

  .bande-texte .type-lead {
    max-width: 32ch;
    color: var(--ink);
  }

  .bande-texte .btn {
    margin-top: 0.75rem;
  }

  @media (max-width: 639px) {
    .bande-texte .btn {
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .bande {
      grid-template-columns: 1fr 1fr;
      min-height: 30rem;
    }

    .bande-texte {
      padding: 5rem clamp(3rem, 7vw, 7rem);
    }
  }

  .matiere-visuel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Le granit se fond dans le fond sombre du texte. */
  @media (min-width: 1024px) {
    .matiere-visuel::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, transparent 55%, var(--canvas));
    }
  }

  /* Personnalisation : sur telephone l'image passe au-dessus du texte comme sur
     la maquette mobile ; sur ordinateur le texte est a gauche. */
  .detail {
    background-color: var(--surface);
  }

  .detail-visuel {
    order: -1;
  }

  .detail-visuel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .detail-visuel {
      order: 2;
    }

    .detail-visuel::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, var(--surface), transparent 40%);
    }
  }

  /* ---- Parcours ----------------------------------------------------------- */
  .etapes-liste {
    display: grid;
    gap: 2.5rem;
    max-width: 72rem;
    margin: 3.5rem auto 0;
  }

  .etapes-liste li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--accent);
  }

  @media (min-width: 768px) {
    .etapes-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 2.5rem;
    }
  }

  @media (min-width: 1280px) {
    .etapes-liste {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ---- Appel final --------------------------------------------------------- */
  .appel {
    padding-block: clamp(4rem, 9vw, 6.5rem);
    text-align: center;
  }

  .appel .shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .appel .lien-trait {
    border-bottom: 0;
  }

  .appel-zone {
    max-width: 44ch;
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
