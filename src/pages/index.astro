---
import ProductCard from "@/components/ProductCard.astro";
import ProductImage from "@/components/ProductImage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import visuelProvisoire from "@/assets/visuel-provisoire.svg";
import { adressePostaleJsonLd, entreprise, renseigne } from "@/config/entreprise";
import { pageTitle, siteConfig } from "@/config/site";
import { granitsDisponibles, nomGranit } from "@/data/granits";
import {
  FAMILLE_LABELS,
  GAMMES,
  GAMME_LABELS,
  altVisuel,
  familleUrl,
  getProducts,
  productUrl,
  requireProduct,
} from "@/data/products";
import { MENTION_PRIX_PROVISOIRE, prixAffiche, prixEstProvisoire } from "@/data/tarifs";

const products = await getProducts();
const featured = siteConfig.featured.homepageGrid.map((slug) => requireProduct(products, slug));
const solo = requireProduct(products, siteConfig.featured.homepageSolo);

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;

const granits = granitsDisponibles();

const facts = [
  { value: String(products.length).padStart(2, "0"), label: "Modèles au catalogue" },
  { value: String(granits.length).padStart(2, "0"), label: "Granits proposés" },
  { value: String(GAMMES.length).padStart(2, "0"), label: "Gammes" },
  { value: "Suisse romande", label: "Zone d'intervention" },
];

/* Le parcours d une famille, en quatre etapes. Les mots comptent : rien n est
   grave sans bon a tirer valide, et la pose est faite par l entreprise
   elle-meme (cf. "Regles de communication du site" dans
   docs/DECISIONS-ET-ETAT.md). Le detail complet vit sur /a-propos/. */
const etapes = [
  {
    titre: "Conseil et choix",
    texte:
      "Un rendez-vous pour parler de la sépulture et du règlement du cimetière, puis choisir le modèle, le granit et la gravure.",
  },
  {
    titre: "Devis détaillé",
    texte:
      "Un devis écrit, poste par poste : le monument, le granit, la gravure, les accessoires et la pose.",
  },
  {
    titre: "Bon à tirer de la gravure",
    texte: "Le texte, les dates et les motifs vous sont soumis en épreuve. Rien n'est gravé avant votre accord.",
  },
  {
    titre: "Pose et suivi",
    texte:
      "Nous posons le monument au cimetière, et nous restons joignables ensuite : inscription complémentaire, entretien.",
  },
];

/* La liste des granits ne s affiche plus ici : elle a sa page, /nos-granits/,
   construite depuis src/data/granits.json. L accueil n en garde que le nombre
   (dans les reperes) et le lien. */

const soloSpecs: Array<[string, string]> = [
  ["Dimensions", solo.dimensions],
  ["Famille", FAMILLE_LABELS[solo.famille]],
  ["Granit présenté", nomGranit(solo.granitPresente)],
  ["Prix", prixAffiche(solo.slug)],
];

/* La grille de modeles et le modele mis en avant affichent des prix : la
   mention n apparait qu une fois par section, pas sur chaque carte. */
const mentionGrille = featured.some((product) => prixEstProvisoire(product.slug));
const mentionSolo = prixEstProvisoire(solo.slug);

/* Organization : seules les coordonnées connues sont publiées. Tant que
   src/config/entreprise.ts est à `null`, la fiche se limite au nom et à
   l'adresse du site. Une adresse ou un téléphone inventés dans les données
   structurées se retrouveraient dans la fiche Google de l'entreprise. */
const adressePostale = adressePostaleJsonLd();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteUrl,
  ...(renseigne(entreprise.email) ? { email: entreprise.email } : {}),
  ...(renseigne(entreprise.telephone) ? { telephone: entreprise.telephone } : {}),
  ...(adressePostale ? { address: adressePostale } : {}),
};
---

<BaseLayout
  title={pageTitle("Monuments funéraires et cinéraires")}
  description="Monuments funéraires et monuments cinéraires en granit massif, réalisés sur mesure pour la Suisse romande. Conseil, gravure et pose compris dans le devis."
>
  <main id="main-content">
    {/* ---------------------------------------------------------------- Hero */}
    <section class="shell grid items-center gap-x-12 gap-y-10 pb-4 pt-8 md:grid-cols-12 md:pb-10 md:pt-12">
      <div class="hero-in md:col-span-5">
        <h1 class="type-hero">Monuments funéraires et cinéraires en granit</h1>
        <p class="type-lead mt-7 max-w-[42ch]">
          Monuments funéraires et monuments cinéraires en granit massif, réalisés sur mesure et posés par nos
          soins. Le conseil, la gravure et la pose sont compris dans le devis.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/devis/" class="btn btn-primary">Demander un devis</a>
          <a href={familleUrl("monument")} class="btn btn-outline">Monuments funéraires</a>
          <a href={familleUrl("cineraire")} class="btn btn-outline">Monuments cinéraires</a>
        </div>
      </div>

      <figure class="hero-in md:col-span-7" style="--reveal-delay:120ms">
        <div class="overflow-hidden bg-surface">
          <img
            src={visuelProvisoire.src}
            alt=""
            width={1600}
            height={1400}
            loading="eager"
            decoding="sync"
            class="aspect-[4/3] w-full object-cover md:aspect-[8/7]"
          />
        </div>
        <figcaption class="mono mt-3 flex justify-between gap-4 text-[0.625rem] uppercase tracking-[0.05em] text-muted">
          <span>Visuel provisoire</span>
          <span>Photographies de nos réalisations à venir</span>
        </figcaption>
      </figure>
    </section>

    {/* Spec band */}
    <div class="mt-14 border-y border-line md:mt-20">
      <dl class="shell grid grid-cols-2 md:grid-cols-4">
        {
          facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* ----------------------------------------------- Comment ca se passe */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[18ch]" data-reveal>Comment ça se passe</h2>
      <p class="type-body mt-6 max-w-[52ch]" data-reveal>
        Nous accompagnons les familles de A à Z, avec un seul interlocuteur du premier rendez-vous au suivi
        après la pose.
      </p>

      <ol class="mt-12 grid gap-x-8 gap-y-12 md:mt-14 md:grid-cols-4">
        {
          etapes.map((etape, index) => (
            <li class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <p class="label">Étape {index + 1}</p>
              <h3 class="type-h3 mt-3">{etape.titre}</h3>
              <p class="type-body mt-4 text-[0.9375rem]">{etape.texte}</p>
            </li>
          ))
        }
      </ol>

      <p class="mt-10" data-reveal>
        <a href="/a-propos/" class="link link-mono text-muted">Qui sommes-nous</a>
      </p>
    </section>

    {/* ------------------------------------------------------ Quelques modeles */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <div class="mt-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-4" data-reveal>
        <h2 class="type-h2 max-w-[14ch]">Quelques modèles du catalogue</h2>
        <div class="flex flex-wrap items-end gap-x-7 gap-y-2">
          <a href={familleUrl("monument")} class="link link-mono pb-1.5 text-muted">
            {FAMILLE_LABELS.monument}
          </a>
          <a href={familleUrl("cineraire")} class="link link-mono pb-1.5 text-muted">
            {FAMILLE_LABELS.cineraire}
          </a>
          <a href="/prix-pierre-tombale-suisse/" class="link link-mono pb-1.5 text-muted">Prix</a>
        </div>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 md:mt-14 md:grid-cols-3">
        {
          featured.map((product, index) => (
            <ProductCard product={product} index={index} revealDelay={index * 110} />
          ))
        }
      </div>

      {
        mentionGrille && (
          <p class="mono mt-8 text-[0.6875rem] uppercase tracking-[0.05em] text-muted" data-reveal>
            {MENTION_PRIX_PROVISOIRE}
          </p>
        )
      }
    </section>

    {/* ------------------------------------------------ Le modele mis en avant */}
    <section class="mt-24 md:mt-36">
      <div class="shell grid items-center gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-7 lg:col-span-8">
          <a
            href={productUrl(solo)}
            class="group block overflow-hidden bg-surface"
            data-reveal="mask"
            aria-label={`${solo.name} — ${solo.shortDescription}`}
          >
            {/* L enveloppe porte le decoupage du devoilement, pour que l image
                garde sa propre transition au survol (cf. les notes sur les
                masques dans src/styles.css). */}
            <div>
              <ProductImage
                product={solo}
                sizes="(min-width: 768px) 58vw, 100vw"
                alt={altVisuel(solo, solo.granitPresente)}
                class="aspect-square w-full object-contain transition-transform duration-[1100ms] ease-out group-hover:scale-[1.04] md:aspect-[16/11]"
              />
            </div>
          </a>
        </div>

        <div class="md:col-span-5 lg:col-span-4" data-reveal style="--reveal-delay:140ms">
          <p class="label">{FAMILLE_LABELS[solo.famille]} · {GAMME_LABELS[solo.gamme]}</p>
          <h2 class="type-h2 mt-5">{solo.name}</h2>
          <p class="type-body mt-6 max-w-[44ch]">{solo.description}</p>

          <dl class="mono mt-9 border-t border-line text-[0.8125rem]">
            {
              soloSpecs.map(([term, value]) => (
                <div class="flex justify-between gap-6 border-b border-line py-3">
                  <dt class="text-muted">{term}</dt>
                  <dd class="text-right">{value}</dd>
                </div>
              ))
            }
          </dl>

          {
            mentionSolo && (
              <p class="mono mt-4 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
                {MENTION_PRIX_PROVISOIRE}
              </p>
            )
          }

          <a href={productUrl(solo)} class="btn btn-primary mt-9">Voir ce modèle</a>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- Granits */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[18ch]" data-reveal>Chaque modèle se décline dans nos granits</h2>
      <p class="type-body mt-6 max-w-[52ch]" data-reveal>
        Le granit présenté sur un visuel n'est qu'un exemple : le même modèle se taille dans les autres teintes.
        La liste évolue selon les granits disponibles.
      </p>
      <p class="mt-8" data-reveal>
        <a href="/nos-granits/" class="link link-mono text-muted">Nos granits, par teinte</a>
      </p>
    </section>

    {/* --------------------------------------------- Zone d intervention */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <div class="mt-8 grid gap-8 md:grid-cols-12">
        <div class="md:col-span-5" data-reveal>
          <h2 class="type-h2 max-w-[14ch]">Où nous intervenons</h2>
        </div>
        <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:120ms">
          <p class="type-body">
            Au Val-de-Travers d'abord, puis dans tout le canton de Neuchâtel, et plus largement en Suisse
            romande. Pour un cimetière plus éloigné, demandez-nous.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/devis/" class="btn btn-primary">Demander un devis</a>
            <a href={familleUrl("monument")} class="btn btn-outline">Monuments funéraires</a>
            <a href={familleUrl("cineraire")} class="btn btn-outline">Monuments cinéraires</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
</BaseLayout>
