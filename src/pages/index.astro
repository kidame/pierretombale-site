---
import ProductImage from "@/components/ProductImage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { adressePostaleJsonLd, entreprise, renseigne } from "@/config/entreprise";
import { pageTitle, siteConfig } from "@/config/site";
import { nomGranit } from "@/data/granits";
import { familleUrl, getProducts, requireProduct } from "@/data/products";

/* ACCUEIL, selon la maquette du 26.10.2026 (docs/DESIGN.md).
   Sections : hero sombre, collection (2 familles), matiere, personnalisation,
   parcours en 4 etapes, appel final. Les modeles montres viennent de
   siteConfig.featured.homepageVitrine : changer un modele = changer un slug
   dans src/config/site.ts. */

const products = await getProducts();
const vitrine = siteConfig.featured.homepageVitrine;
const modeleHero = requireProduct(products, vitrine.hero);
const modeleFuneraire = requireProduct(products, vitrine.monument);
const modeleCineraire = requireProduct(products, vitrine.cineraire);

/* Matieres montrees : une sombre pour le hero et la famille funeraire, une
   claire pour la famille cineraire. Identifiants de src/data/granits.json. */
const matiereSombre = "bengal";
const matiereClaire = "egipat";

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;

/* Le parcours d une famille, en quatre etapes. Les mots comptent : rien n est
   grave sans bon a tirer valide, et la pose est faite par l entreprise
   elle-meme (cf. "Regles de communication du site" dans
   docs/DECISIONS-ET-ETAT.md). Le detail complet vit sur /a-propos/. */
const etapes = [
  {
    titre: "Conseil et choix",
    texte:
      "Un rendez-vous pour parler de la sépulture et du règlement du cimetière, puis choisir le modèle, le granit et la gravure.",
  },
  {
    titre: "Devis détaillé",
    texte:
      "Un devis écrit, poste par poste : le monument, le granit, la gravure, les accessoires et la pose.",
  },
  {
    titre: "Bon à tirer de la gravure",
    texte: "Le texte, les dates et les motifs vous sont soumis en épreuve. Rien n'est gravé avant votre accord.",
  },
  {
    titre: "Pose et suivi",
    texte:
      "Nous posons le monument au cimetière, et nous restons joignables ensuite : inscription complémentaire, entretien.",
  },
];

/* Organization : seules les coordonnees connues sont publiees. Tant que
   src/config/entreprise.ts est a `null`, la fiche se limite au nom et a
   l adresse du site. Une adresse ou un telephone inventes dans les donnees
   structurees se retrouveraient dans la fiche Google de l entreprise. */
const adressePostale = adressePostaleJsonLd();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteUrl,
  ...(renseigne(entreprise.email) ? { email: entreprise.email } : {}),
  ...(renseigne(entreprise.telephone) ? { telephone: entreprise.telephone } : {}),
  ...(adressePostale ? { address: adressePostale } : {}),
};
---

<BaseLayout
  title={pageTitle("Monuments funéraires et cinéraires")}
  description="Monuments funéraires et monuments cinéraires en granit massif, réalisés sur mesure pour la Suisse romande. Conseil, gravure et pose compris dans le devis."
  footerJoint
>
  <main id="main-content">
    {/* ---------------------------------------------------------------- Hero */}
    <section class="nuit hero" aria-labelledby="hero-titre">
      <div class="shell hero-grille">
        <div class="hero-texte">
          <p class="label">L'art du souvenir</p>
          <h1 id="hero-titre" class="type-hero">Ce qui demeure.</h1>
          <p class="type-lead">Un hommage façonné pour traverser le temps.</p>
          <p class="hero-precision">
            Monuments funéraires et cinéraires en granit, pour les familles de Suisse romande.
          </p>
        </div>
        <figure class="hero-visuel">
          <ProductImage
            product={modeleHero}
            matiere={matiereSombre}
            sizes="(min-width: 1024px) 40rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="hero-img"
          />
        </figure>
        <div class="hero-cta">
          <a href={familleUrl("monument")} class="btn btn-outline">Découvrir les monuments</a>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------- Collection */}
    <section class="collection" aria-labelledby="collection-titre">
      <div class="shell">
        <header class="titre-centre">
          <p class="label">La collection</p>
          <h2 id="collection-titre" class="type-h2">La justesse des lignes.</h2>
        </header>

        <div class="collection-grille">
          <a href={familleUrl("monument")} class="carte">
            <div class="carte-image">
              <ProductImage
                product={modeleFuneraire}
                matiere={matiereSombre}
                sizes="(min-width: 768px) 40vw, 100vw"
                class="carte-img"
              />
            </div>
            <h3 class="type-h3">Monuments funéraires</h3>
            <span class="lien-trait">Découvrir<span class="trait" aria-hidden="true"></span></span>
          </a>

          <a href={familleUrl("cineraire")} class="carte">
            <div class="carte-image">
              <ProductImage
                product={modeleCineraire}
                matiere={matiereClaire}
                sizes="(min-width: 768px) 40vw, 100vw"
                class="carte-img"
              />
            </div>
            <h3 class="type-h3">Monuments cinéraires</h3>
            <span class="lien-trait">Découvrir<span class="trait" aria-hidden="true"></span></span>
          </a>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- Matiere */}
    <section class="nuit bande matiere" aria-labelledby="matiere-titre">
      <div class="bande-visuel matiere-visuel">
        <img
          src="/images/matieres/bengal-480.webp"
          srcset="/images/matieres/bengal-160.webp 160w, /images/matieres/bengal-480.webp 480w"
          sizes="(min-width: 1024px) 50vw, 100vw"
          width="480"
          height="480"
          alt={`Granit ${nomGranit("bengal")}, surface polie vue de près`}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="bande-texte">
        <p class="label">La matière, dans son essence</p>
        <h2 id="matiere-titre" class="type-h2">La noblesse du granit.</h2>
        <p class="type-lead">Des nuances singulières. Des finitions choisies avec soin.</p>
        <a href="/nos-granits/" class="btn btn-outline">Explorer les matières</a>
      </div>
    </section>

    {/* ------------------------------------------------------ Personnalisation */}
    <section class="nuit bande detail" aria-labelledby="detail-titre">
      <div class="bande-texte">
        <p class="label">Un hommage personnel</p>
        <h2 id="detail-titre" class="type-h2">Chaque détail compte.</h2>
        <p class="type-lead">La matière, les mots, le dessin. Composez un monument à son image.</p>
        <a href={familleUrl("monument")} class="btn btn-outline">Personnaliser un monument</a>
      </div>
      <div
        class="bande-visuel detail-visuel"
        role="img"
        aria-label="Branche d'olivier gravée dans le granit : exemple de motif"
      >
        <span class="detail-motif" aria-hidden="true"></span>
      </div>
    </section>

    {/* ------------------------------------------------------- Comment ca se passe */}
    <section class="etapes" aria-labelledby="etapes-titre">
      <div class="shell">
        <header class="titre-centre">
          <p class="label">Notre accompagnement</p>
          <h2 id="etapes-titre" class="type-h2">Comment ça se passe</h2>
        </header>
        <ol class="etapes-liste">
          {
            etapes.map((etape, index) => (
              <li>
                <p class="label">Étape {index + 1}</p>
                <h3 class="type-h3">{etape.titre}</h3>
                <p class="type-body">{etape.texte}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* --------------------------------------------------------- Appel final */}
    <section class="nuit appel" aria-labelledby="appel-titre">
      <div class="shell">
        <h2 id="appel-titre" class="type-h2">Votre histoire mérite notre attention.</h2>
        <a href="/devis/" class="lien-trait">Parlons de votre projet<span class="trait" aria-hidden="true"></span></a>
        <p class="appel-zone">
          Au Val-de-Travers, dans le canton de Neuchâtel et en Suisse romande. Pour un cimetière plus éloigné,
          demandez-nous.
        </p>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
</BaseLayout>

<style>
  /* Rythme vertical commun des sections claires. */
  .collection,
  .etapes {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .titre-centre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  /* ---- Hero ---------------------------------------------------------------
     Telephone : texte, visuel, puis bouton. Ordinateur : texte et bouton a
     gauche, visuel a droite sur deux rangees. */
  .hero-grille {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem 3.5rem;
  }

  .hero-texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .hero-texte .type-lead {
    max-width: 30ch;
    color: var(--ink);
  }

  .hero-precision {
    max-width: 38ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .hero-cta .btn {
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero-cta .btn {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-grille {
      grid-template-columns: 5fr 7fr;
      grid-template-areas:
        "texte visuel"
        "cta visuel";
      grid-template-rows: auto auto;
      align-content: center;
      column-gap: 4rem;
      row-gap: 2.5rem;
      padding-block: 3rem 5rem;
    }

    .hero-texte {
      grid-area: texte;
      align-self: end;
    }

    .hero-visuel {
      grid-area: visuel;
      justify-self: end;
      width: 100%;
      max-width: 40rem;
    }

    .hero-cta {
      grid-area: cta;
      align-self: start;
    }
  }

  /* ---- Collection -------------------------------------------------------- */
  .collection-grille {
    display: grid;
    gap: 3rem;
    max-width: 72rem;
    margin: 3rem auto 0;
  }

  @media (min-width: 768px) {
    .collection-grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
      margin-top: 4rem;
    }
  }

  .carte {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .carte-image {
    width: 100%;
    overflow: hidden;
    background: var(--surface);
  }

  .carte-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-expo);
  }

  .carte:hover .carte-img,
  .carte:focus-visible .carte-img {
    transform: scale(1.03);
  }

  .carte .type-h3 {
    margin-top: 0.75rem;
  }

  /* "Decouvrir ----" : zone de clic de 48 px, filet bronze. */
  .lien-trait {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    transition: color 240ms ease;
  }

  .lien-trait:hover,
  .lien-trait:focus-visible {
    color: var(--accent);
  }

  .trait {
    display: inline-block;
    width: 2.75rem;
    height: 1px;
    background: currentColor;
    transition: width 420ms var(--ease-out-expo);
  }

  .carte:hover .trait,
  .lien-trait:hover .trait {
    width: 4rem;
  }

  /* ---- Bandes sombres : image d un cote, texte de l autre ------------------ */
  .bande {
    display: grid;
  }

  .bande-visuel {
    position: relative;
    min-height: 16rem;
    overflow: hidden;
  }

  .bande-texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.25rem;
    padding: 3.5rem var(--gutter) 4rem;
  }

  .bande-texte .type-lead {
    max-width: 32ch;
    color: var(--ink);
  }

  .bande-texte .btn {
    margin-top: 0.75rem;
  }

  @media (max-width: 639px) {
    .bande-texte .btn {
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .bande {
      grid-template-columns: 1fr 1fr;
      min-height: 30rem;
    }

    .bande-texte {
      padding: 5rem clamp(3rem, 7vw, 7rem);
    }
  }

  .matiere-visuel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
  }

  /* Le granit se fond dans le fond sombre du texte. */
  @media (min-width: 1024px) {
    .matiere-visuel::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, transparent 55%, var(--canvas));
    }
  }

  /* Personnalisation : sur telephone le visuel passe sous le texte comme sur la
     maquette mobile ; sur ordinateur le texte est a gauche. */
  .detail {
    background-color: var(--surface);
  }

  .detail-visuel {
    background-color: #2a2724;
    background-image:
      linear-gradient(135deg, rgb(0 0 0 / 0.1), rgb(0 0 0 / 0.5)), url("/images/matieres/royal-480.webp");
    background-size: cover;
    background-position: center;
  }

  /* Motif en masque : le trace de public/motifs, vu comme une gravure. */
  .detail-motif {
    position: absolute;
    inset: 10%;
    background-color: rgb(244 240 232 / 0.78);
    -webkit-mask: url("/motifs/fleurs-olivier.svg") center / contain no-repeat;
    mask: url("/motifs/fleurs-olivier.svg") center / contain no-repeat;
    transform: rotate(-28deg);
  }

  @media (min-width: 1024px) {
    .detail-visuel {
      order: 2;
    }
  }

  /* ---- Parcours ----------------------------------------------------------- */
  .etapes-liste {
    display: grid;
    gap: 2.5rem;
    max-width: 72rem;
    margin: 3.5rem auto 0;
  }

  .etapes-liste li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--accent);
  }

  @media (min-width: 768px) {
    .etapes-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 2.5rem;
    }
  }

  @media (min-width: 1280px) {
    .etapes-liste {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ---- Appel final --------------------------------------------------------- */
  .appel {
    padding-block: clamp(4rem, 9vw, 6.5rem);
    text-align: center;
  }

  .appel .shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .appel .lien-trait {
    border-bottom: 0;
  }

  .appel-zone {
    max-width: 44ch;
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
