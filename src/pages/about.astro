---
import BaseLayout from "@/layouts/BaseLayout.astro";
import visuelProvisoire from "@/assets/visuel-provisoire.svg";
import { pageTitle } from "@/config/site";
import { familleUrl } from "@/data/products";

/* Textes traduits de l anglais du theme en E4 passe 1. Le vrai contenu de la
   page (service complet : conseil, commande, pose, apres-vente) s ecrit en
   E4 passe 2. Ce qui a ete retire en E3 et ne doit jamais revenir ici : le
   courriel invente, le siege, le nom du fondateur. Les coordonnees viennent
   de src/config/entreprise.ts, et de nulle part ailleurs. */

const principes = [
  {
    titre: "Granit massif, toujours",
    texte:
      "Pas de pierre reconstituée, pas de placage. Le monument est taillé dans le bloc, la même pierre de part en part.",
  },
  {
    titre: "Sur mesure, modèle par modèle",
    texte:
      "Le catalogue donne un point de départ : dimensions, granit, gravure et motifs se décident avec la famille.",
  },
  {
    titre: "Rien n'est gravé sans votre accord",
    texte:
      "Aucune pierre ne part à la gravure avant que la famille ait validé le bon à tirer. Le texte, les dates et les motifs se relisent à froid.",
  },
];

const chiffres = [
  { valeur: "03", label: "Associés" },
  { valeur: "02", label: "Familles de monument" },
  { valeur: "Suisse romande", label: "Zone d'intervention" },
];
---

<BaseLayout
  title={pageTitle("L'atelier")}
  description="Un atelier de marbrerie funéraire en Suisse romande : monuments en granit massif, taillés sur mesure, gravure et pose comprises."
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[14ch]">Un atelier, un catalogue court</h1>
      <p class="type-lead hero-in mt-8 max-w-[58ch]" style="--reveal-delay:120ms">
        Nous dessinons et réalisons un petit catalogue de monuments funéraires et cinéraires, en granit massif,
        sur mesure. Pas de pierre d'imitation, pas de précipitation.
      </p>
    </section>

    <figure class="hero-in" style="--reveal-delay:260ms">
      <div class="overflow-hidden bg-surface">
        <img
          src={visuelProvisoire.src}
          alt=""
          width={1920}
          height={1080}
          loading="eager"
          decoding="sync"
          class="h-[40vh] w-full object-cover md:h-[56vh]"
        />
      </div>
      <figcaption
        class="shell mono mt-3 flex justify-between gap-4 text-[0.625rem] uppercase tracking-[0.05em] text-muted"
      >
        <span>Visuel provisoire</span>
        <span>Visuels de l'atelier à venir</span>
      </figcaption>
    </figure>

    {/* -------------------------------------------------------------- Origine */}
    <section class="shell mt-24 grid gap-8 md:mt-36 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <h2 class="type-h2 max-w-[14ch]">Un catalogue court, travaillé pièce par pièce</h2>
      </div>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:120ms">
        <p class="type-body">
          Nous travaillons le granit massif uniquement, nous réalisons sur commande, et aucune pierre ne part à la
          gravure avant que la famille ait validé le bon à tirer.
        </p>
        <p class="type-body mt-5">
          Le catalogue est volontairement court : nous préférons bien connaître quelques modèles que d'en proposer
          cent.
        </p>
      </div>
    </section>

    {/* ------------------------------------------------------------ Principes */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[18ch]" data-reveal>Notre façon de travailler</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          principes.map((principe, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <h3 class="type-h3">{principe.titre}</h3>
              <p class="type-body mt-4 text-[0.9375rem]">{principe.texte}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ------------------------------------------------------------- Matières */}
    <section class="shell mt-24 grid items-center gap-10 md:mt-36 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <div class="overflow-hidden bg-surface" data-reveal="mask">
          <div>
            <img
              src={visuelProvisoire.src}
              alt=""
              width={1080}
              height={1440}
              loading="lazy"
              decoding="async"
              class="aspect-[3/4] w-full object-cover"
            />
          </div>
        </div>
        <p class="mono mt-3 text-[0.625rem] uppercase tracking-[0.05em] text-muted">Visuel provisoire</p>
      </div>

      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:140ms">
        <p class="type-h3 max-w-[26ch] text-[clamp(1.5rem,2.8vw,2.25rem)] leading-[1.15]">
          Chaque bloc est choisi pour le monument qu'il deviendra.
        </p>
        <p class="type-body mt-8 max-w-[48ch] border-t border-line pt-6 text-[0.9375rem]">
          Du granit, dans les teintes de notre gamme. La liste des pierres vit dans un seul fichier, et suit ce que
          l'atelier peut réellement fournir.
        </p>
      </div>
    </section>

    {/* ------------------------------------------------------------- Chiffres */}
    <section class="mt-24 border-y border-line md:mt-36" aria-label="L'atelier en bref">
      <dl class="shell grid grid-cols-2 md:grid-cols-3">
        {
          chiffres.map((chiffre, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{chiffre.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{chiffre.valeur}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ------------------------------------------------------------- Appel */}
    <section class="shell mt-24 md:mt-36">
      <div class="grid items-end gap-8 md:grid-cols-12" data-reveal>
        <div class="md:col-span-7">
          <h2 class="type-h2 max-w-[18ch]">Commencer par un modèle, ou par vos questions</h2>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href={familleUrl("monument")} class="btn btn-primary">Monuments funéraires</a>
          <a href="/devis" class="btn btn-outline">Demander un devis</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
