---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/atelier-workshop.jpg";
import { pageTitle } from "@/config/site";
import { familleUrl } from "@/data/products";

/* Page encore en anglais, héritée d'Atelier Kō : le texte français est à
   écrire à l'étape E4. Ce qui a été retiré en E3 : le courriel inventé, le
   siège (Småland, Växjö), le fondateur (Erik Lindgren) et les provenances de
   bois. Aucune coordonnée ni aucun nom de personne inventés ne doivent
   revenir ici : ils viendront de src/config/entreprise.ts. */

const principles = [
  {
    heading: "Solid wood, always",
    copy: "No MDF, no veneer, no engineered cores. Every surface you see and touch is the same piece of wood, all the way through.",
  },
  {
    heading: "By hand, mostly",
    copy: "Machines mill and rough-cut. The joints, the surfaces and the finish are all worked by hand. It's slower. It shows.",
  },
  {
    heading: "Made to be repaired",
    copy: "Hard-wax oils and natural soap finishes can be re-applied at home. Joints are mechanical, not glued shut. Nothing is disposable.",
  },
];

const facts = [
  { value: "03", label: "Makers" },
  { value: "02", label: "Families of monument" },
  { value: "Suisse romande", label: "Service area" },
];
---

<BaseLayout
  title={pageTitle("The Studio")}
  description="A small workshop building monuments by hand from solid granite. Slow, signed, and made to last."
  image={workshopImg}
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[11ch]">A small workshop, made slowly</h1>
      <p class="type-lead hero-in mt-8 max-w-[58ch]" style="--reveal-delay:120ms">
        We design and build a small catalogue of funerary and cinerary monuments — by hand, to order, in solid
        granite. No factory, no imitation stone, no rush.
      </p>
    </section>

    <figure class="hero-in overflow-hidden bg-surface" style="--reveal-delay:260ms">
      <Image
        src={workshopImg}
        alt="Sunlit Scandinavian woodworking atelier with hand tools and a half-finished chair"
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        decoding="sync"
        class="parallax h-[50vh] w-full object-cover md:h-[72vh]"
      />
    </figure>

    {/* -------------------------------------------------------------- Origin */}
    <section class="shell mt-24 grid gap-8 md:mt-36 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <h2 class="type-h2 max-w-[12ch]">A short catalogue, worked by hand</h2>
      </div>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:120ms">
        <p class="type-body">
          We work in solid granite only, build to order, and never send a stone to engraving before the family has
          approved the proof.
        </p>
        <p class="type-body mt-5">
          The catalogue is intentionally small. We'd rather know a few models well than offer a hundred we don't.
        </p>
      </div>
    </section>

    {/* ---------------------------------------------------------- Principles */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[16ch]" data-reveal>How we work</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          principles.map((principle, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <h3 class="type-h3">{principle.heading}</h3>
              <p class="type-body mt-4 text-[0.9375rem]">{principle.copy}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ----------------------------------------------------------- Materials */}
    <section class="shell mt-24 grid items-center gap-10 md:mt-36 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <div class="overflow-hidden bg-surface" data-reveal="mask">
          <div>
            <Image
              src={handsImg}
              alt="Close-up of a craftsman's hands planing a piece of pale oak"
              width={1080}
              height={1440}
              format="webp"
              loading="lazy"
              class="aspect-[3/4] w-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:140ms">
        <p class="type-h3 max-w-[26ch] text-[clamp(1.5rem,2.8vw,2.25rem)] leading-[1.15]">
          Every block is chosen for the monument it will become.
        </p>
        <p class="type-body mt-8 max-w-[48ch] border-t border-line pt-6 text-[0.9375rem]">
          Granite only, in the colours of our range. The list of stones lives in one file, and grows with what the
          workshop can actually supply.
        </p>
      </div>
    </section>

    {/* --------------------------------------------------------------- Facts */}
    <section class="mt-24 border-y border-line md:mt-36" aria-label="Studio at a glance">
      <dl class="shell grid grid-cols-2 md:grid-cols-3">
        {
          facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ----------------------------------------------------------------- CTA */}
    <section id="studio" class="shell mt-24 md:mt-36">
      <div class="grid items-end gap-8 md:grid-cols-12" data-reveal>
        <div class="md:col-span-7">
          <h2 class="type-h2 max-w-[16ch]">Visit the workshop, or begin with a piece</h2>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href={familleUrl("monument")} class="btn btn-primary">Monuments funéraires</a>
          <a href="/devis" class="btn btn-outline">Demander un devis</a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
