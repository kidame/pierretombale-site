---
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageTitle } from "@/config/site";
import {
  FAMILLES,
  FAMILLE_LABELS,
  GAMMES,
  GAMME_LABELS,
  getProducts,
} from "@/data/products";

const products = await getProducts();
---

<BaseLayout
  title={pageTitle("Catalogue")}
  description="Tous nos modèles de monuments funéraires et de monuments cinéraires, par famille et par gamme. Granit massif, réalisation sur mesure, prix sur demande."
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[14ch]">Nos modèles de monuments</h1>
      <p class="type-lead hero-in mt-8 max-w-[52ch]" style="--reveal-delay:120ms">
        {products.length} modèles, deux familles : les monuments de sépulture et les monuments cinéraires.
        Filtrez par famille et par gamme ; le dessin retenu se taille ensuite dans le granit de votre choix.
      </p>
    </section>

    <div class="shell pb-32">
      <section class="border-t border-line pb-10 pt-7" aria-label="Filtrer et trier le catalogue">
        <div class="flex flex-col gap-7 lg:flex-row lg:items-start lg:justify-between">
          <div class="space-y-5">
            <div data-filter-group="famille">
              <p class="label mb-2.5" id="filter-famille">Famille</p>
              <div class="flex flex-wrap items-center gap-2" role="group" aria-labelledby="filter-famille">
                <button class="chip" type="button" data-filter-value="all" aria-pressed="true">
                  Toutes les familles
                </button>
                {
                  FAMILLES.map((famille) => (
                    <button class="chip" type="button" data-filter-value={famille} aria-pressed="false">
                      {FAMILLE_LABELS[famille]}
                    </button>
                  ))
                }
              </div>
            </div>

            <div data-filter-group="gamme">
              <p class="label mb-2.5" id="filter-gamme">Gamme</p>
              <div class="flex flex-wrap items-center gap-2" role="group" aria-labelledby="filter-gamme">
                <button class="chip" type="button" data-filter-value="all" aria-pressed="true">
                  Toutes les gammes
                </button>
                {
                  GAMMES.map((gamme) => (
                    <button class="chip" type="button" data-filter-value={gamme} aria-pressed="false">
                      {GAMME_LABELS[gamme]}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="shrink-0">
            <label class="label mb-2.5 block" for="catalog-sort">Trier par</label>
            <select id="catalog-sort" class="field mono w-full text-[0.8125rem] lg:w-52" data-catalog-sort>
              <option value="ordre">Ordre du catalogue</option>
              <option value="nom">Nom (A à Z)</option>
            </select>
          </div>
        </div>
      </section>

      <p class="mono border-t border-line py-4 text-[0.6875rem] uppercase tracking-[0.05em] text-muted" aria-live="polite">
        <span data-catalog-count>{String(products.length).padStart(2, "0")}</span>&#32;<span
          data-catalog-count-label>modèles affichés</span
        >
      </p>

      <p class="type-h3 hidden py-32 text-center text-muted" data-catalog-empty>
        Aucun modèle ne correspond à ces filtres.
      </p>

      <ul class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3" data-catalog-grid>
        {
          products.map((product, index) => (
            <li
              data-catalog-item
              data-famille={product.famille}
              data-gamme={product.gamme}
              data-name={product.name}
              data-index={index}
            >
              <ProductCard
                product={product}
                eager={index < 3}
                index={index}
                revealDelay={(index % 3) * 110}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <script is:inline>
    (() => {
      const grid = document.querySelector("[data-catalog-grid]");
      const items = Array.from(document.querySelectorAll("[data-catalog-item]"));
      const countNode = document.querySelector("[data-catalog-count]");
      const countLabel = document.querySelector("[data-catalog-count-label]");
      const empty = document.querySelector("[data-catalog-empty]");
      const sort = document.querySelector("[data-catalog-sort]");
      const filters = { famille: "all", gamme: "all" };

      if (!grid || !sort) return;

      function applyFilters() {
        const visible = items.filter(
          (item) =>
            (filters.famille === "all" || item.dataset.famille === filters.famille) &&
            (filters.gamme === "all" || item.dataset.gamme === filters.gamme),
        );

        visible.sort((a, b) => {
          if (sort.value === "nom") return a.dataset.name.localeCompare(b.dataset.name, "fr");
          return Number(a.dataset.index) - Number(b.dataset.index);
        });

        items.forEach((item) => (item.hidden = true));
        visible.forEach((item) => {
          item.hidden = false;
          grid.appendChild(item);
        });

        countNode.textContent = String(visible.length).padStart(2, "0");
        countLabel.textContent = visible.length === 1 ? "modèle affiché" : "modèles affichés";
        empty.classList.toggle("hidden", visible.length > 0);
        grid.classList.toggle("hidden", visible.length === 0);
      }

      document.querySelectorAll("[data-filter-group]").forEach((group) => {
        group.addEventListener("click", (event) => {
          const button = event.target.closest("button[data-filter-value]");
          if (!button) return;

          filters[group.dataset.filterGroup] = button.dataset.filterValue;
          group.querySelectorAll("button").forEach((chip) => {
            chip.setAttribute("aria-pressed", String(chip === button));
          });
          applyFilters();
        });
      });

      sort.addEventListener("change", applyFilters);
    })();
  </script>
</BaseLayout>
