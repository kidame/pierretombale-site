---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageTitle } from "@/config/site";
import { getCalibration } from "@/data/calibrations";
/* Les bornes des zones de texte : 3 zones, 120 caracteres, 4 lignes. */
import { ZONE_LIGNES_MAX, ZONE_LONGUEUR_MAX, ZONES_MAX } from "@/data/configurateur";
import {
  MISE_EN_PAGE_DEFAUT,
  misesEnPage,
  PHRASE_LONGUEUR_MAX,
  phrasesSuggerees,
} from "@/data/inscription";
import { vignetteMatiere } from "@/data/granits";
import { motifsParFamille } from "@/data/motifs";
import { motifsConfigurateur } from "@/data/motifs-svg";
import {
  FINITION_APERCU_DEFAUT,
  finitions,
  hauteurLabel,
  hauteursLettresMm,
  hauteursParDefaut,
  MENTION_APERCU,
  POLICE_DEFAUT,
  polices,
} from "@/data/personnalisation";
import {
  altVisuel,
  FAMILLE_LABELS,
  familleUrl,
  getProducts,
  imagesDuModele,
  productUrl,
  visuelModele,
  type Product,
} from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";
/* Le nombre maximal de motifs, la longueur de la description et les extensions
   de fichier acceptees sont decides par le script (une seule constante
   chacun) : la page les lit, elle ne les redeclare pas. */
import {
  DESCRIPTION_MAX,
  FICHIER_EXTENSIONS,
  MAX_MOTIFS,
} from "@/scripts/configurateur/motifs";
import { MENTION_PRIX_PROVISOIRE, prixAffiche, prixEstProvisoire } from "@/data/tarifs";

/* Le configurateur visuel d un modele : /personnaliser/<slug>/.

   DESIGN DES MAQUETTES (28.10.2026) : un parcours en QUATRE ETAPES (matiere,
   inscription, motifs, recapitulatif), ecran partage : apercu sur fond sombre
   a gauche, choix sur fond clair a droite. Sur telephone l apercu est en haut,
   repliable, et un mode plein ecran sert a placer le motif au doigt.

   SANS JAVASCRIPT, les quatre etapes sont visibles les unes sous les autres et
   les boutons « Continuer » sont des ancres : la page reste une presentation
   du modele avec un lien vers le devis (regle de `docs/CONFIGURATEUR-FUTUR.md` :
   « une page dont le contenu n existe qu en JavaScript n existe pas »).
   `src/scripts/configurateur/etapes.ts` n en montre qu une a la fois.

   L ILOT KONVA (passe B) remplace l apercu statique et branche les controles
   (voir `src/scripts/configurateur/`). Les motifs (C1), les zones de texte
   (C2), le brouillon (F) et l export vers /devis/ (E) sont en place.

   UNE PAGE PAR MODELE CALIBRE : deposer un JSON dans `src/data/calibrations/`
   suffit a en creer une autre.

   NOINDEX, FOLLOW : la page est une interface, pas un contenu. Le canonique
   renvoie vers la fiche du modele (description, caracteristiques, JSON-LD
   Product), et le sitemap l exclut (astro.config.mjs). */

/* LES POLICES DE GRAVURE NE SE CHARGENT QUE SUR LES PAGES QUI LES MONTRENT.
   Ces six imports sont les memes que ceux de `src/pages/devis.astro`, et ils
   sont ICI, dans la page : jamais dans `BaseLayout.astro` ni dans
   `src/styles.css`, sinon les autres pages telechargeraient 140 Ko de polices
   pour rien. Les familles CSS correspondantes vivent dans
   `src/data/personnalisation.ts`. */
import "@fontsource/cinzel/latin-400.css";
import "@fontsource/marcellus/latin-400.css";
import "@fontsource/eb-garamond/latin-400.css";
import "@fontsource/jost/latin-400.css";
import "@fontsource/great-vibes/latin-400.css";
import "@fontsource/pinyon-script/latin-400.css";

export async function getStaticPaths() {
  const products = await getProducts();

  /* Un modele sans calibration n a pas de page : l apercu serait un cadrage
     invente. La liste grandit toute seule avec les fichiers de
     `src/data/calibrations/`. */
  return products
    .filter((product) => getCalibration(product.modeleId) !== undefined)
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

/* `getStaticPaths` ne garde que les modeles calibres : la calibration existe
   forcement ici. */
const calibration = getCalibration(product.modeleId)!;

const origin = Astro.site ?? new URL(Astro.url.origin);
const urlFiche = productUrl(product);

const visuel = visuelModele(product);

/* Les matieres qui ont un visuel pour ce modele, comme sur la fiche : une
   matiere sans photo d echantillon n aurait qu une tuile vide. */
const matieres = imagesDuModele(product)
  .map((granit) => ({ granit, vignette: vignetteMatiere(granit) }))
  .filter((entree): entree is { granit: (typeof entree)["granit"]; vignette: string } =>
    Boolean(entree.vignette),
  );

/* Racine des chemins de visuel, comme sur la fiche : le script recompose
   `-1200.webp` au lieu de porter un chemin par tuile. */
const racineVisuel = `/images/modeles/${product.modeleId}/${product.modeleId}`;

/* CADRAGE DE L APERCU, SANS UNE LIGNE DE JAVASCRIPT.
   Le conteneur prend le rapport de `vueStelePx` ; l image, agrandie et
   decalee, place exactement cette zone dans le conteneur. Les pourcentages
   suffisent, donc le cadrage tient a n importe quelle largeur :
   - largeur de l image = largeur de l image source / largeur de la vue ;
   - decalage = position de la vue dans l image, en part de l image (le
     `translate` d un element se compte sur SA propre taille).
   Le facteur 1200/1254 n apparait pas : il se simplifie dans les deux
   rapports. Il sert en revanche au canvas (voir echelle.ts). */
const vue = calibration.vueStelePx;
const largeurImagePct = (calibration.imagePx.largeur / vue.largeur) * 100;
const decalageXPct = (vue.x / calibration.imagePx.largeur) * 100;
const decalageYPct = (vue.y / calibration.imagePx.hauteur) * 100;

/* `--cfg-ratio` sert a plafonner la HAUTEUR de l apercu sans jamais entrer en
   conflit avec `aspect-ratio` : on borne la largeur, et la hauteur suit. */
const styleCadre =
  `aspect-ratio: ${vue.largeur} / ${vue.hauteur}; ` +
  `--cfg-ratio: ${(vue.largeur / vue.hauteur).toFixed(4)};`;
const styleImage =
  `width: ${largeurImagePct.toFixed(3)}%; ` +
  `transform: translate(-${decalageXPct.toFixed(3)}%, -${decalageYPct.toFixed(3)}%);`;

const prix = prixAffiche(product.slug);
const prixProvisoire = prixEstProvisoire(product.slug);

const typeModele = product.famille === "cineraire" ? "Monument cinéraire" : "Monument funéraire";

const titre = pageTitle(`Personnaliser ${product.name}`);
const metaDescription =
  `Composez l'inscription sur le modèle ${product.name} : matière, texte, ` +
  `style d'écriture, taille des lettres. Aperçu indicatif, devis gratuit.`;

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: FAMILLE_LABELS[product.famille], path: familleUrl(product.famille) },
    { name: product.name, path: urlFiche },
    { name: "Personnaliser", path: `/personnaliser/${product.slug}/` },
  ],
  origin,
);

/* LES QUATRE ETAPES. La barre, les titres et les boutons « Continuer » en
   sont tires : un seul endroit a changer pour renommer une etape. */
const etapes = [
  { numero: 1, nom: "Matière", court: "Matière", suivante: "inscription" },
  { numero: 2, nom: "Inscription", court: "Texte", suivante: "motifs" },
  { numero: 3, nom: "Motifs", court: "Motifs", suivante: "récapitulatif" },
  { numero: 4, nom: "Votre devis", court: "Devis", suivante: "" },
] as const;
const numeroEtape = (n: number) => `0${n}`;

/* UNE HAUTEUR DE LETTRES SUGGEREE PAR ZONE, en millimetres : le nom en grand,
   les dates plus petites, l epitaphe plus discrete encore. Ce sont les memes
   defauts que /devis/ (`hauteursParDefaut`). Si ZONES_MAX grandit, les zones
   suivantes reprennent la derniere hauteur de la liste. */
const hauteursSuggerees = [
  hauteursParDefaut.nom,
  hauteursParDefaut.dates,
  hauteursParDefaut.epitaphe,
];
const hauteursMmParZone = Array.from(
  { length: ZONES_MAX },
  (_, rang) => hauteursSuggerees[Math.min(rang, hauteursSuggerees.length - 1)],
);

/* La zone 1 est celle d un nom (5 cm) : c est ce que les familles saisissent
   en premier, et c est la hauteur que montre le select au chargement. */
const hauteurDefaut = hauteursMmParZone[0];

/* Les motifs, groupes par famille (familles vides exclues). */
const groupesMotifs = motifsParFamille();

/* LA CONFIGURATION DU CANVAS, INLINEE EN JSON AU BUILD (passe B).
   Le script du configurateur ne lit que ce bloc : il n importe ni les donnees
   d Astro, ni le contenu Markdown, et ne refait aucun calcul de cadrage. Tout
   vient des sources existantes (calibration, images, polices, finitions), donc
   corriger une donnee suffit a corriger l apercu. Les noms (matiere, police,
   finition) servent au recapitulatif de l etape 4. */
const donneesConfigurateur = {
  calibration,
  modele: { modeleId: product.modeleId, slug: product.slug, nom: product.name },
  matieres: matieres.map(({ granit, vignette }) => ({
    id: granit.id,
    nom: granit.nom,
    image: `${racineVisuel}-${granit.id}-1200.webp`,
    vignette,
  })),
  polices: polices.map((police) => ({
    id: police.id,
    nom: police.nom,
    famille: police.famille,
    capitale: police.capitale,
  })),
  finitions: finitions.map((finition) => ({
    id: finition.id,
    nom: finition.nom,
    couleur: finition.couleurApercu,
    aide: finition.aide,
  })),
  /* La bibliotheque de motifs : donnees et viewBox en mm. Le trace lui-meme
     est lu dans le SVG public au chargement du canvas (voir index.ts). */
  motifs: motifsConfigurateur(),
  defauts: {
    matiere: visuel.matiere,
    policeId: POLICE_DEFAUT,
    finitionId: FINITION_APERCU_DEFAUT,
    hauteursMmParZone,
  },
};

const finitionDefaut = finitions.find((finition) => finition.id === FINITION_APERCU_DEFAUT);
---

<BaseLayout
  title={titre}
  description={metaDescription}
  image={`${racineVisuel}-${visuel.matiere}-1200.webp`}
  robots="noindex,follow"
  canonical={urlFiche}
  includeFooter={false}
>
  <main id="main-content" class="cfg">
    {/* ---------------------------------------------------- La barre 01-04 */}
    <nav class="cfg-barre" aria-label="Étapes de la personnalisation">
      <ol class="cfg-barre-liste">
        {
          etapes.map((etape) => (
            <li class="cfg-barre-item" data-etape-barre={etape.numero}>
              <a href={`#etape-${etape.numero}`} class="cfg-barre-lien" data-etape-vers={etape.numero}>
                <span class="cfg-barre-numero mono">{numeroEtape(etape.numero)}</span>
                <span class="cfg-barre-nom">{etape.nom}</span>
                <span class="cfg-barre-court">{etape.court}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="cfg-ecran">
      {/* ------------------------------------------------------------ Apercu */}
      <aside class="nuit cfg-apercu" data-apercu-panneau aria-label="Aperçu de la stèle">
        <a href={urlFiche} class="cfg-retour-modele">
          <svg viewBox="0 0 10 16" width="8" height="13" aria-hidden="true">
            <path d="M8 1L2 8l6 7" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          Retour au modèle
        </a>
        <button type="button" class="cfg-apercu-fermer" data-apercu-fermer hidden>
          Fermer l'aperçu
        </button>

        <div class="cfg-apercu-corps">
          <div class="cfg-apercu-entete">
            <p class="label">Votre monument</p>
            <h1 class="cfg-titre">{product.name}</h1>
          </div>

          <div class="cfg-cadre" style={styleCadre} data-apercu>
            {/* L apercu statique de la passe A. Le script le masque des que le
                canvas est pret, pour ne pas afficher deux fois la stele. */}
            <div class="cfg-statique" data-apercu-statique>
              <img
                src={`${racineVisuel}-${visuel.matiere}-1200.webp`}
                alt={`Stèle du modèle ${altVisuel(product, visuel.matiere)}`}
                width="1200"
                height="1200"
                style={styleImage}
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                data-apercu-image
              />
            </div>
            <div class="cfg-canvas" data-apercu-canvas></div>
          </div>

          <p class="cfg-legende">
            <span class="cfg-legende-mobile">{product.name}</span>
            <span class="cfg-legende-ordi">Aperçu de la stèle</span> · <span data-matiere-nom>{visuel.nomMatiere}</span>
          </p>
          <p class="cfg-mention">{MENTION_APERCU}</p>
        </div>

        {/* Telephone : replier l apercu pour saisir a l aise. Pose par le
            script (sans lui, l apercu reste simplement affiche). */}
        <button type="button" class="cfg-replier" data-apercu-replier aria-expanded="true" hidden>
          <svg class="cfg-replier-chevron" viewBox="0 0 16 10" width="14" height="9" aria-hidden="true">
            <path d="M1 1l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span data-replier-texte>Replier l'aperçu</span>
        </button>
      </aside>

      {/* ------------------------------------------------------------- Choix */}
      <div class="cfg-panneau">
        {/* LE BROUILLON (passe F, `brouillon.ts`) : pose par le script seulement.
            Sans JavaScript, rien n est garde, donc rien a annoncer. */}
        <div class="cfg-brouillon" data-brouillon hidden>
          <p class="cfg-brouillon-texte" data-brouillon-texte></p>
          <button type="button" class="cfg-bouton" data-brouillon-effacer hidden>
            Tout effacer et recommencer
          </button>
        </div>

        {/* ===================================================== 1 La matiere */}
        <section class="cfg-etape" id="etape-1" data-etape="1" aria-labelledby="etape-matiere-titre">
          <header class="cfg-etape-tete">
            <h2 class="cfg-etape-titre" id="etape-matiere-titre" tabindex="-1" data-etape-titre>
              Choisissez votre granit.
            </h2>
            <p class="cfg-etape-sous">Touchez une matière pour voir le résultat.</p>
          </header>

          <div class="cfg-tuiles" role="group" aria-label="Choisir la matière">
            {
              matieres.map(({ granit, vignette }) => (
                <button
                  type="button"
                  class="cfg-tuile"
                  data-matiere={granit.id}
                  data-nom={granit.nom}
                  data-alt={`Stèle du modèle ${altVisuel(product, granit.id)}`}
                  aria-pressed={granit.id === visuel.matiere ? "true" : "false"}
                >
                  <span class="cfg-tuile-image">
                    <img src={vignette} alt="" width="160" height="160" loading="lazy" decoding="async" />
                    <span class="cfg-coche" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14">
                        <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" />
                      </svg>
                    </span>
                  </span>
                  <span class="cfg-tuile-nom">{granit.nom}</span>
                  <span class="cfg-tuile-etat">Sélectionné</span>
                </button>
              ))
            }
          </div>

          <p class="cfg-aide cfg-aide-echantillon">
            Les teintes de l'écran sont approximatives : la pierre se juge sur un échantillon.
            <a href="/nos-granits/" class="cfg-lien">Voir toutes nos matières</a>
          </p>

          <div class="cfg-nav cfg-nav-choix">
            <div class="cfg-choix-ligne">
              <span class="cfg-choix-label">Votre choix :</span>
              <span class="cfg-choix-valeur" data-matiere-nom>{visuel.nomMatiere}</span>
            </div>
            <a href="#etape-2" class="btn btn-primary cfg-continuer" data-etape-vers="2">
              <span class="cfg-continuer-court">Continuer</span>
              <span class="cfg-continuer-long">Continuer vers l'inscription</span>
              <svg class="cfg-fleche" viewBox="0 0 20 10" width="20" height="10" aria-hidden="true">
                <path d="M0 5h18M14 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </a>
            <p class="cfg-nav-note">Étape suivante : inscription · <a href="/faq/" class="cfg-lien cfg-lien-aide">Besoin d'aide ?</a></p>
          </div>
        </section>

        {/* ================================================= 2 L inscription */}
        <section class="cfg-etape" id="etape-2" data-etape="2" aria-labelledby="etape-inscription-titre">
          <header class="cfg-etape-tete">
            <h2 class="cfg-etape-titre" id="etape-inscription-titre" tabindex="-1" data-etape-titre>
              Les mots du souvenir.
            </h2>
            <p class="cfg-etape-sous">Écrivez votre texte. Il apparaît sur la stèle.</p>
          </header>

          {/* L INSCRIPTION GUIDEE (23.10.2026) : des champs, une mise en page, et
              `composition.ts` compose les zones de texte. La mise en page libre
              (les zones de la passe C2) reste derriere le bouton
              « Placer le texte moi-même ». Sans JavaScript, ces champs restent
              inertes, comme le reste des controles. */}
          <div class="cfg-guide" data-guide>
            <fieldset class="cfg-champ cfg-groupe-champs">
              <legend class="cfg-label">Disposition du texte</legend>
              <div class="cfg-dispositions">
                {
                  misesEnPage.map((miseEnPage) => (
                    <label class="cfg-disposition" title={miseEnPage.description}>
                      <input
                        type="radio"
                        name="mise-en-page"
                        value={miseEnPage.id}
                        checked={miseEnPage.id === MISE_EN_PAGE_DEFAUT}
                        data-mise-en-page
                      />
                      <span class="cfg-disposition-vue" aria-hidden="true">
                        {/* Une silhouette de stele et des traits : la place du
                            nom et de la phrase, rien de plus. */}
                        <svg viewBox="0 0 80 64">
                          <path
                            d="M8 62V18C8 10 20 6 40 6s32 4 32 12v44z"
                            fill="var(--cfg-silhouette)"
                          />
                          {miseEnPage.id === "classique" && (
                            <g stroke="var(--cfg-trait)" stroke-width="2" stroke-linecap="round">
                              <path d="M26 26h28M30 33h20" />
                              <path d="M28 46h24M31 52h18" opacity="0.55" />
                            </g>
                          )}
                          {miseEnPage.id === "dedicace" && (
                            <g stroke="var(--cfg-trait)" stroke-width="2" stroke-linecap="round">
                              <path d="M28 24h24M31 30h18" opacity="0.55" />
                              <path d="M26 44h28M30 51h20" />
                            </g>
                          )}
                          {miseEnPage.id === "couple" && (
                            <g stroke="var(--cfg-trait)" stroke-width="2" stroke-linecap="round">
                              <path d="M26 24h28M30 31h20" />
                              <path d="M26 42h28M30 49h20" />
                            </g>
                          )}
                        </svg>
                        <span class="cfg-coche">
                          <svg viewBox="0 0 16 16" width="12" height="12">
                            <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" />
                          </svg>
                        </span>
                      </span>
                      <span class="cfg-disposition-nom">{miseEnPage.nom}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            {
              [0, 1].map((rang) => (
                <fieldset
                  class="cfg-champ cfg-groupe-champs cfg-personne"
                  data-personne={rang}
                  hidden={rang === 1}
                >
                  <legend class="cfg-label cfg-personne-titre" data-personne-titre>
                    {rang === 0 ? "La personne" : "La deuxième personne"}
                  </legend>
                  <div class="cfg-champs-personne">
                    <label class="cfg-sous-champ">
                      <span>Prénom</span>
                      <input class="cfg-input" type="text" autocomplete="off" data-p="prenom" />
                    </label>
                    <label class="cfg-sous-champ">
                      <span>Nom</span>
                      <input class="cfg-input" type="text" autocomplete="off" data-p="nom" />
                    </label>
                    <label class="cfg-sous-champ cfg-sous-champ-large">
                      <span>
                        Nom de jeune fille <span class="cfg-facultatif">(facultatif)</span>
                      </span>
                      <input
                        class="cfg-input"
                        type="text"
                        autocomplete="off"
                        placeholder="Ex. Martin"
                        data-p="nomJeuneFille"
                      />
                    </label>
                    <label class="cfg-sous-champ">
                      <span>Naissance</span>
                      <input
                        class="cfg-input"
                        type="text"
                        autocomplete="off"
                        placeholder="1948 ou 12.03.1948"
                        data-p="naissance"
                      />
                    </label>
                    <label class="cfg-sous-champ">
                      <span>Décès</span>
                      <input
                        class="cfg-input"
                        type="text"
                        autocomplete="off"
                        placeholder="2026 ou 05.01.2026"
                        data-p="deces"
                      />
                    </label>
                  </div>
                </fieldset>
              ))
            }

            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-phrase">
                Une phrase <span class="cfg-facultatif">(facultatif)</span>
              </label>
              <textarea
                class="cfg-textarea cfg-textarea-phrase"
                id="cfg-phrase"
                rows="1"
                maxlength={PHRASE_LONGUEUR_MAX}
                placeholder="À jamais dans nos cœurs"
                aria-describedby="cfg-phrase-compteur"
                data-phrase></textarea>
              <div class="cfg-phrase-pied">
                <p class="cfg-compteur mono" id="cfg-phrase-compteur">
                  <span data-phrase-compteur>0</span> / {PHRASE_LONGUEUR_MAX}
                </p>
                <details class="cfg-idees">
                  <summary class="cfg-idees-titre cfg-lien">Des idées de phrases</summary>
                  {
                    phrasesSuggerees.map((groupe) => (
                      <div class="cfg-idees-groupe">
                        <p class="cfg-idees-theme">{groupe.theme}</p>
                        <div class="cfg-idees-liste">
                          {groupe.phrases.map((phrase) => (
                            <button type="button" class="cfg-idee" data-idee={phrase}>
                              {phrase}
                            </button>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </details>
              </div>
            </div>

            <div class="cfg-deux-colonnes">
              <div class="cfg-champ">
                <label class="cfg-label" for="cfg-g-police">Style d'écriture</label>
                <select class="cfg-select" id="cfg-g-police" data-g-police>
                  {
                    polices.map((police) => (
                      <option value={police.id} selected={police.id === POLICE_DEFAUT}>
                        {police.nom}
                      </option>
                    ))
                  }
                </select>
              </div>

              <div class="cfg-champ">
                <p class="cfg-label" id="cfg-g-finition-label">Finition des lettres</p>
                <div class="cfg-finitions" role="group" aria-labelledby="cfg-g-finition-label">
                  {
                    finitions.map((finition) => (
                      <button
                        type="button"
                        class="cfg-finition"
                        data-g-finition={finition.id}
                        aria-pressed={finition.id === FINITION_APERCU_DEFAUT ? "true" : "false"}
                      >
                        <span
                          class="cfg-finition-echantillon"
                          style={`--cfg-finition: ${finition.couleurApercu};`}
                          aria-hidden="true"
                        >
                          Aa
                          <span class="cfg-coche">
                            <svg viewBox="0 0 16 16" width="12" height="12">
                              <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" />
                            </svg>
                          </span>
                        </span>
                        <span class="cfg-finition-nom">{finition.nom}</span>
                      </button>
                    ))
                  }
                </div>
              </div>
            </div>
            <p class="cfg-aide" data-g-finition-aide>{finitionDefaut?.aide}</p>

            <p class="cfg-aide" role="status" data-guide-tailles></p>
            <p class="cfg-erreur" role="status" data-guide-tient></p>
            <p class="cfg-vers-libre">
              <button type="button" class="cfg-lien cfg-lien-bouton" data-vers-libre hidden>
                Placer le texte moi-même
              </button>
            </p>
          </div>

          <div class="cfg-libre" data-libre hidden>
            <p class="cfg-aide">
              Mise en page libre : chaque zone a sa police, sa taille et sa finition, et se
              déplace sur l'aperçu.
            </p>
            <button type="button" class="cfg-bouton" data-vers-guide>
              Revenir à la mise en page automatique
            </button>

            {/* LES ONGLETS DE ZONES N EXISTENT QU AVEC LE JAVASCRIPT. Sans lui,
                aucune zone ne s ajoute ni ne se supprime : la page garde un seul
                bloc de controles, celui de la zone 1. Le script leve `hidden`,
                pose `role="tabpanel"` sur le bloc de controles et montre les
                onglets des zones qui existent. */}
            <div class="cfg-zones" data-zones hidden>
              <div class="cfg-onglets" role="tablist" aria-label="Zones de texte">
                {
                  Array.from({ length: ZONES_MAX }, (_, rang) => rang + 1).map((numero) => (
                    <button
                      type="button"
                      class="cfg-onglet"
                      role="tab"
                      id={`cfg-zone-onglet-${numero}`}
                      aria-controls="cfg-zone-panneau"
                      aria-selected={numero === 1 ? "true" : "false"}
                      tabindex={numero === 1 ? 0 : -1}
                      hidden={numero !== 1}
                      data-zone-onglet={numero}
                    >
                      Zone {numero}
                    </button>
                  ))
                }
              </div>

              <div class="cfg-zones-actions">
                <button type="button" class="cfg-bouton" data-zone-ajouter>
                  + Ajouter une zone
                </button>
                <button type="button" class="cfg-bouton" data-zone-supprimer hidden>
                  Supprimer cette zone
                </button>
              </div>
            </div>

            <div id="cfg-zone-panneau" data-zone-panneau>
              <div class="cfg-champ">
                <label class="cfg-label" for="cfg-texte">Texte à graver</label>
                <p class="cfg-aide" id="cfg-texte-aide">
                  Le nom, les dates, quelques mots. Passez à la ligne pour séparer les lignes ({
                    ZONE_LIGNES_MAX
                  } au plus) ; le texte est centré sur la stèle.
                </p>
                <textarea
                  class="cfg-textarea"
                  id="cfg-texte"
                  name="texte"
                  rows={ZONE_LIGNES_MAX}
                  maxlength={ZONE_LONGUEUR_MAX}
                  aria-describedby="cfg-texte-aide cfg-compteur"
                  data-texte></textarea>
                <p class="cfg-compteur mono" id="cfg-compteur">
                  <span data-compteur>0</span> / {ZONE_LONGUEUR_MAX} caractères
                </p>
                <p class="cfg-aide" role="status" data-zone-lignes></p>
                <p class="cfg-erreur" role="status" data-zone-depasse></p>
              </div>

              <div class="cfg-deux-colonnes">
                <div class="cfg-champ">
                  <label class="cfg-label" for="cfg-police">Style d'écriture</label>
                  <select class="cfg-select" id="cfg-police" name="police" data-police>
                    {
                      polices.map((police) => (
                        <option value={police.id} selected={police.id === POLICE_DEFAUT}>
                          {police.nom}
                        </option>
                      ))
                    }
                  </select>
                </div>

                <div class="cfg-champ">
                  <label class="cfg-label" for="cfg-hauteur">Taille des lettres</label>
                  <select class="cfg-select" id="cfg-hauteur" name="hauteur" data-hauteur>
                    {
                      hauteursLettresMm.map((mm) => (
                        <option value={mm} selected={mm === hauteurDefaut}>
                          {hauteurLabel(mm)}
                        </option>
                      ))
                    }
                  </select>
                </div>
              </div>

              <div class="cfg-champ">
                <p class="cfg-label" id="cfg-finition-label">Finition des lettres</p>
                <div class="cfg-finitions" role="group" aria-labelledby="cfg-finition-label">
                  {
                    finitions.map((finition) => (
                      <button
                        type="button"
                        class="cfg-finition"
                        data-finition={finition.id}
                        data-couleur={finition.couleurApercu}
                        aria-pressed={finition.id === FINITION_APERCU_DEFAUT ? "true" : "false"}
                      >
                        <span
                          class="cfg-finition-echantillon"
                          style={`--cfg-finition: ${finition.couleurApercu};`}
                          aria-hidden="true"
                        >
                          Aa
                          <span class="cfg-coche">
                            <svg viewBox="0 0 16 16" width="12" height="12">
                              <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" />
                            </svg>
                          </span>
                        </span>
                        <span class="cfg-finition-nom">{finition.nom}</span>
                      </button>
                    ))
                  }
                </div>
                <p class="cfg-aide" data-finition-aide>{finitionDefaut?.aide}</p>
              </div>

              {/* Recentrer n a de sens qu avec le canvas : sans JavaScript, le
                  bouton reste cache. Il recentre la zone active horizontalement. */}
              <button type="button" class="cfg-bouton" data-recentrer hidden>
                Recentrer le texte
              </button>
            </div>
          </div>

          <div class="cfg-nav">
            <a href="#etape-1" class="cfg-retour" data-etape-vers="1">
              <svg class="cfg-fleche cfg-fleche-retour" viewBox="0 0 20 10" width="20" height="10" aria-hidden="true">
                <path d="M20 5H2M6 1L2 5l4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
              Retour
            </a>
            <a href="#etape-3" class="btn btn-primary cfg-continuer" data-etape-vers="3">
              <span class="cfg-continuer-court">Continuer</span>
              <span class="cfg-continuer-long">Continuer vers les motifs</span>
              <svg class="cfg-fleche" viewBox="0 0 20 10" width="20" height="10" aria-hidden="true">
                <path d="M0 5h18M14 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </a>
            <p class="cfg-nav-note">Étape suivante : motifs · <a href="/faq/" class="cfg-lien cfg-lien-aide">Besoin d'aide ?</a></p>
          </div>
        </section>

        {/* ====================================================== 3 Les motifs */}
        <section class="cfg-etape" id="etape-3" data-etape="3" aria-labelledby="etape-motifs-titre">
          <header class="cfg-etape-tete">
            <h2 class="cfg-etape-titre" id="etape-motifs-titre" tabindex="-1" data-etape-titre>
              Un symbole qui lui ressemble.
            </h2>
            <p class="cfg-etape-sous">Un détail personnel, si vous le souhaitez. Cette étape est facultative.</p>
          </header>

          {/* Sans JavaScript, aucun onglet n est allume et les familles restent
              affichees a la suite, chacune sous son titre : la liste des motifs
              se lit en entier. Le script allume la premiere famille et n en
              affiche plus qu une a la fois. */}
          <div class="cfg-familles" role="group" aria-label="Familles de motifs">
            {
              groupesMotifs.map(({ famille }) => (
                <button type="button" class="cfg-famille" data-famille-motifs={famille.id} aria-pressed="false">
                  {famille.nom}
                </button>
              ))
            }
          </div>

          {
            groupesMotifs.map(({ famille, motifs }) => (
              <div class="cfg-groupe" data-groupe-motifs={famille.id}>
                <h3 class="cfg-groupe-titre" data-groupe-titre>
                  {famille.nom}
                </h3>

                <div class="cfg-motifs">
                  {motifs.map((motif) => (
                    <button type="button" class="cfg-motif" data-motif={motif.id} data-nom={motif.nom}>
                      <span class="cfg-motif-vue" aria-hidden="true">
                        <span class="cfg-motif-masque" style={`--motif: url(${motif.fichier})`} />
                      </span>
                      <span class="cfg-motif-nom">{motif.nom}</span>
                      <span class="cfg-coche" aria-hidden="true">
                        <svg viewBox="0 0 16 16" width="12" height="12">
                          <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" />
                        </svg>
                      </span>
                    </button>
                  ))}
                </div>

                {/* Le sur demande, sous chaque famille : la reponse a tout ce que
                    la base ne contient pas (docs/MOTIFS-BIBLIOTHEQUE.md, section 5). */}
                <button type="button" class="cfg-motif-demande" aria-pressed="false" data-motif-demande>
                  <span class="cfg-motif-demande-icone" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 20l4.2-1.1L20.2 6.9a1.6 1.6 0 0 0 0-2.3l-1.8-1.8a1.6 1.6 0 0 0-2.3 0L4.1 14.8 3 19l1 1z" />
                      <path d="M14.8 4.6l4.6 4.6" />
                    </svg>
                  </span>
                  <span class="cfg-motif-demande-texte">
                    <span class="cfg-motif-demande-nom">Un motif à vous</span>
                    <span class="cfg-motif-demande-sous">Décrivez votre idée ou joignez une image.</span>
                  </span>
                  <span class="cfg-coche" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="12" height="12">
                      <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" />
                    </svg>
                  </span>
                </button>
              </div>
            ))
          }

          {/* LE MOTIF SUR DEMANDE. Le bloc n apparait qu une fois le cadre pose
              sur la stele (le script leve `hidden`) : sans cadre, il n y a rien
              a decrire. Rien n est envoye ici (l envoi suit docs/devis-contrat.md). */}
          <div class="cfg-demande" data-bloc-demande hidden>
            <p class="cfg-label">Votre motif à créer</p>
            <p class="cfg-aide">
              Le cadre en pointillés sur la stèle montre où il sera gravé, et à quelle taille.
            </p>

            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-demande-texte">Décrivez votre idée</label>
              <p class="cfg-aide" id="cfg-demande-aide">
                Par exemple : « une branche de sapin penchée, comme ceux du jardin », ou le dessin
                d'une passion.
              </p>
              <textarea
                class="cfg-textarea"
                id="cfg-demande-texte"
                rows="3"
                maxlength={DESCRIPTION_MAX}
                aria-describedby="cfg-demande-aide cfg-demande-compteur"
                data-demande-description></textarea>
              <p class="cfg-compteur mono" id="cfg-demande-compteur">
                <span data-demande-compteur>0</span> / {DESCRIPTION_MAX} caractères
              </p>
            </div>

            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-demande-fichier">
                Une photo, un dessin, un logo (facultatif)
              </label>
              <input
                class="cfg-fichier"
                id="cfg-demande-fichier"
                type="file"
                accept={FICHIER_EXTENSIONS}
                aria-describedby="cfg-demande-fichier-aide"
                data-demande-fichier
              />
              <p class="cfg-aide" id="cfg-demande-fichier-aide">JPEG, PNG, PDF ou SVG, 8 Mo au maximum.</p>
              <p class="cfg-aide cfg-demande-nom" data-demande-fichier-nom></p>
              <p class="cfg-erreur" role="alert" data-demande-fichier-erreur></p>
            </div>

            <p class="cfg-aide">
              Nous vous proposons un dessin avec le devis ; rien n'est gravé sans votre accord.
            </p>

            <button type="button" class="cfg-bouton" data-demande-retirer>Retirer ce motif</button>
          </div>

          {/* Les motifs poses. Les lignes sont ecrites par le script : sans
              JavaScript rien ne se pose, donc la liste reste vide. */}
          <div class="cfg-poses">
            <p class="cfg-label" id="cfg-poses-label">Sur votre stèle</p>
            <ul class="cfg-poses-liste" aria-labelledby="cfg-poses-label" data-liste-motifs></ul>
            <p class="cfg-aide" data-motifs-vide>Aucun motif pour l'instant, c'est facultatif.</p>
            <p class="cfg-aide" data-motifs-plein hidden>
              {MAX_MOTIFS} motifs au maximum sur une stèle. Retirez-en un pour en ajouter un autre.
            </p>
          </div>

          <p class="cfg-aide cfg-aide-placer">
            Déplacez le motif sur la stèle ; tirez les coins pour ajuster sa taille.
          </p>
          {/* Telephone : l apercu est petit, le plein ecran sert a placer le
              motif au doigt. Pose par le script. */}
          <button type="button" class="cfg-agrandir" data-apercu-agrandir hidden>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M9.5 1.5h5v5M14.5 1.5L9 7M6.5 14.5h-5v-5M1.5 14.5L7 9" fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
            Agrandissez l'aperçu pour placer votre motif.
          </button>

          <div class="cfg-nav">
            <a href="#etape-2" class="cfg-retour" data-etape-vers="2">
              <svg class="cfg-fleche cfg-fleche-retour" viewBox="0 0 20 10" width="20" height="10" aria-hidden="true">
                <path d="M20 5H2M6 1L2 5l4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
              Retour
            </a>
            <a href="#etape-4" class="btn btn-primary cfg-continuer" data-etape-vers="4">
              <span class="cfg-continuer-court">Continuer</span>
              <span class="cfg-continuer-long">Continuer vers le récapitulatif</span>
              <svg class="cfg-fleche" viewBox="0 0 20 10" width="20" height="10" aria-hidden="true">
                <path d="M0 5h18M14 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </a>
            <p class="cfg-nav-note">
              Étape suivante : récapitulatif ·
              <a href="#etape-4" class="cfg-lien" data-etape-vers="4">Continuer sans motif</a>
            </p>
          </div>
        </section>

        {/* ============================================ 4 Le recapitulatif */}
        <section class="cfg-etape" id="etape-4" data-etape="4" aria-labelledby="etape-devis-titre">
          <header class="cfg-etape-tete">
            <h2 class="cfg-etape-titre" id="etape-devis-titre" tabindex="-1" data-etape-titre>
              Votre hommage, en détail.
            </h2>
            <p class="cfg-etape-sous">Prenez un instant pour vérifier votre composition.</p>
          </header>

          {/* Le recapitulatif est ecrit par le script (etapes.ts) a partir de
              l etat. Sans JavaScript, chaque ligne renvoie a son etape. */}
          <dl class="cfg-recap">
            <div class="cfg-recap-ligne-bloc">
              <dt class="cfg-recap-titre"><span class="cfg-recap-numero mono">01</span> La matière</dt>
              <dd class="cfg-recap-valeur">
                <img class="cfg-recap-vignette" src={matieres[0]?.vignette ?? ""} alt="" width="160" height="160" loading="lazy" data-recap-matiere-img />
                <span class="cfg-recap-texte" data-recap-matiere>{visuel.nomMatiere}</span>
              </dd>
              <a href="#etape-1" class="cfg-lien cfg-recap-modifier" data-etape-vers="1">Modifier</a>
            </div>
            <div class="cfg-recap-ligne-bloc">
              <dt class="cfg-recap-titre"><span class="cfg-recap-numero mono">02</span> L'inscription</dt>
              <dd class="cfg-recap-valeur">
                <span class="cfg-recap-vignette cfg-recap-aa" aria-hidden="true">Aa</span>
                <span class="cfg-recap-texte">
                  <span class="cfg-recap-lignes" data-recap-inscription>
                    <span class="cfg-recap-vide">Aucune inscription pour l'instant.</span>
                  </span>
                  <span class="cfg-recap-sous" data-recap-ecriture></span>
                </span>
              </dd>
              <a href="#etape-2" class="cfg-lien cfg-recap-modifier" data-etape-vers="2">Modifier</a>
            </div>
            <div class="cfg-recap-ligne-bloc">
              <dt class="cfg-recap-titre"><span class="cfg-recap-numero mono">03</span> Le motif</dt>
              <dd class="cfg-recap-valeur">
                <span class="cfg-recap-vignette cfg-recap-motif" aria-hidden="true">
                  <span class="cfg-motif-masque" data-recap-motif-vue hidden></span>
                </span>
                <span class="cfg-recap-texte" data-recap-motif>Aucun motif</span>
              </dd>
              <a href="#etape-3" class="cfg-lien cfg-recap-modifier" data-etape-vers="3">Modifier</a>
            </div>
          </dl>

          <p class="cfg-prix">
            <span class="cfg-prix-label">Prix indicatif</span>
            <span class="mono">{prix}</span>
          </p>
          {prixProvisoire && <p class="cfg-aide">{MENTION_PRIX_PROVISOIRE}</p>}

          <h3 class="cfg-suite-titre">Et maintenant ?</h3>
          <p class="cfg-aide">
            Votre composition sera jointe à votre demande. Vous pourrez renseigner vos coordonnées à
            l'étape suivante. La gravure, la pose au cimetière et les démarches sont comprises dans le devis.
          </p>

          <div class="cfg-encadre">
            <span class="cfg-encadre-icone" aria-hidden="true">i</span>
            <span>
              <strong>Avant toute gravure</strong><br />
              Vous recevrez une maquette définitive à valider.
            </span>
          </div>

          <div class="cfg-nav cfg-nav-finale">
            <a href="#etape-3" class="cfg-retour" data-etape-vers="3">
              <svg class="cfg-fleche cfg-fleche-retour" viewBox="0 0 20 10" width="20" height="10" aria-hidden="true">
                <path d="M20 5H2M6 1L2 5l4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
              Retour
            </a>
            <a href={`/devis/?modele=${product.slug}`} class="btn btn-primary cfg-continuer" data-vers-devis>
              Poursuivre vers le devis
              <svg class="cfg-fleche" viewBox="0 0 20 10" width="20" height="10" aria-hidden="true">
                <path d="M0 5h18M14 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </a>
            <p class="cfg-nav-note">Gratuit et sans engagement.</p>
          </div>
        </section>
      </div>
    </div>

    {/* ------------------------------------------------ Le bandeau du bas */}
    <footer class="nuit cfg-bandeau">
      <p class="cfg-bandeau-item">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <rect x="3.5" y="8.5" width="13" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path d="M6.5 8.5V6a3.5 3.5 0 0 1 7 0v2.5" fill="none" stroke="currentColor" stroke-width="1.3" />
        </svg>
        Votre projet est conservé sur cet appareil.
      </p>
      <p class="cfg-bandeau-item">Devis gratuit, sans engagement.</p>
      <p class="cfg-bandeau-marque">
        <span class="cfg-bandeau-logo">PierreTombale.ch</span>
        <span class="cfg-bandeau-sous">Suisse romande</span>
      </p>
    </footer>
  </main>

  {/* Tout l habillage de cette page est ICI, en CSS de page, et non en classes
      utilitaires Tailwind : la feuille Tailwind est UNIQUE et partagee par
      toutes les pages du site. Les couleurs sont les jetons du theme
      (`src/styles.css`, et `.nuit` pour le panneau sombre) ; `--cfg-accent`
      est le bronze local au configurateur (poignees, reperes du canvas). */}
  <style>
    .cfg {
      --cfg-accent: #8a6a3c;
      --cfg-silhouette: #2a2724;
      --cfg-trait: #f4f0e8;
      --cfg-entete: 4.5rem;
      --cfg-pierre: radial-gradient(circle at 30% 30%, #3a3632, #1d1b19 70%);
    }

    /* Toute classe de ce bloc qui declare `display` est couverte : `hidden`
       gagne toujours. */
    .cfg [hidden] {
      display: none !important;
    }

    /* ---------------------------------------------------- La barre 01-04 */
    .cfg-barre {
      border-bottom: 1px solid var(--line);
      background: var(--canvas);
    }

    @media (min-width: 64rem) {
      .cfg {
        --cfg-entete: 3.3rem;
      }

      .cfg-barre {
        position: sticky;
        top: 0;
        z-index: 6;
      }
    }

    .cfg-barre-liste {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.5rem;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 var(--gutter);
      list-style: none;
    }

    .cfg-barre-lien {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 0.5rem;
      min-height: 3.25rem;
      border-bottom: 2px solid transparent;
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--muted);
      text-decoration: none;
      white-space: nowrap;
    }

    .cfg-barre-numero {
      font-size: 0.8125rem;
    }

    .cfg-barre-court {
      display: none;
    }


    .cfg-barre-item.est-courante .cfg-barre-lien {
      border-bottom-color: var(--ink);
      color: var(--ink);
      font-weight: 500;
    }

    .cfg-barre-item.est-faite .cfg-barre-lien {
      color: var(--ink);
    }

    .cfg-barre-lien:hover,
    .cfg-barre-lien:focus-visible {
      color: var(--ink);
    }

    .cfg-barre-lien:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: -2px;
    }

    @media (max-width: 39.999rem) {
      .cfg-barre-lien {
        gap: 0.375rem;
        font-size: 1rem;
      }

      .cfg-barre-nom {
        display: none;
      }

      .cfg-barre-court {
        display: inline;
      }
    }

    /* ------------------------------------------------ L ecran partage */
    .cfg-ecran {
      display: grid;
    }

    @media (min-width: 64rem) {
      .cfg {
        --cfg-bandeau: 4.25rem;
      }

      /* VUE APPLICATION (maquette) : barre + ecran + bandeau = une fenetre.
         L en-tete du site defile au-dessus ; des qu il est passe, tout tient. */
      .cfg-ecran {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        height: calc(100vh - var(--cfg-entete) - var(--cfg-bandeau));
        min-height: 34rem;
      }
    }

    /* ---------------------------------------------------------- L apercu */
    .cfg-apercu {
      position: sticky;
      top: var(--cfg-entete);
      z-index: 5;
      display: flex;
      flex-direction: column;
      background: var(--canvas);
      color: var(--ink);
    }

    .cfg-retour-modele {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-height: 2.5rem;
      padding-inline: var(--gutter);
      font-family: var(--font-serif);
      font-size: 1rem;
      color: var(--ink);
      text-decoration: underline;
      text-decoration-color: var(--line-strong);
      text-underline-offset: 0.3em;
    }

    .cfg-apercu-fermer {
      align-self: flex-end;
      min-height: 3rem;
      margin: 0.5rem var(--gutter) 0;
      padding: 0.5rem 1rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: transparent;
      font: inherit;
      font-size: 0.9375rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-apercu-corps {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
      padding: 0.5rem var(--gutter) 1rem;
    }

    .cfg-apercu-entete {
      display: none;
      text-align: center;
    }

    .cfg-titre {
      margin-top: 0.5rem;
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: clamp(2.25rem, 3.5vw, 3rem);
      line-height: 1;
    }

    .cfg-cadre {
      position: relative;
      overflow: hidden;
      width: 100%;
      max-width: calc(26vh * var(--cfg-ratio));
      margin: 0.25rem auto 0;
      background: var(--surface);
    }

    .cfg-statique,
    .cfg-canvas {
      position: absolute;
      inset: 0;
    }

    .cfg-statique img {
      position: absolute;
      top: 0;
      left: 0;
      height: auto;
      max-width: none;
      transform-origin: top left;
    }

    .cfg-legende {
      margin-top: 0.5rem;
      font-family: var(--font-serif);
      font-size: 1.125rem;
      text-align: center;
    }

    .cfg-legende-ordi {
      display: none;
    }

    @media (min-width: 64rem) {
      .cfg-legende-mobile {
        display: none;
      }

      .cfg-legende-ordi {
        display: inline;
      }
    }

    .cfg-mention {
      display: none;
      max-width: 44ch;
      margin-top: 0.375rem;
      font-size: 0.875rem;
      line-height: 1.5;
      text-align: center;
      color: var(--muted);
    }

    .cfg-replier {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      min-height: 2.75rem;
      border: 0;
      border-top: 1px solid var(--line);
      background: transparent;
      font: inherit;
      font-size: 0.9375rem;
      color: var(--muted);
      cursor: pointer;
    }

    .cfg-replier-chevron {
      transition: transform 240ms ease;
    }

    .cfg-apercu.est-replie .cfg-replier-chevron {
      transform: rotate(180deg);
    }

    .cfg-apercu.est-replie .cfg-cadre,
    .cfg-apercu.est-replie .cfg-mention {
      display: none;
    }

    /* Le plein ecran du telephone : l apercu prend toute la fenetre, le
       canvas se redessine a cette largeur (etapes.ts signale `resize`). */
    :global(html.cfg-plein-ecran) {
      overflow: hidden;
    }

    :global(html.cfg-plein-ecran) .cfg-apercu {
      position: fixed;
      inset: 0;
      z-index: 60;
      overflow: auto;
      justify-content: center;
    }

    :global(html.cfg-plein-ecran) .cfg-apercu .cfg-cadre {
      max-width: min(100%, calc(70vh * var(--cfg-ratio)));
    }

    :global(html.cfg-plein-ecran) .cfg-apercu-corps {
      justify-content: center;
    }

    :global(html.cfg-plein-ecran) .cfg-replier,
    :global(html.cfg-plein-ecran) .cfg-retour-modele {
      display: none;
    }

    :global(html.cfg-plein-ecran) .cfg-mention {
      display: block;
    }

    @media (min-width: 64rem) {
      .cfg-apercu {
        position: static;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        padding-bottom: 1rem;
      }

      .cfg-retour-modele {
        margin: 0.75rem 0 0 0.5rem;
      }

      .cfg-apercu-corps {
        justify-content: center;
        min-height: 0;
        padding: 0.5rem clamp(1.5rem, 4vw, 4rem) 1rem;
      }

      .cfg-apercu-entete {
        display: block;
      }

      /* La stele prend la hauteur qui reste : fenetre moins l en-tete, le
         bandeau, le titre et la legende (environ 28 rem). */
      .cfg-cadre {
        max-width: min(100%, calc((100vh - 28rem) * var(--cfg-ratio)));
        margin-top: 1.25rem;
      }

      .cfg-panneau {
        height: 100%;
        overflow-y: auto;
        overscroll-behavior: contain;
      }

      .cfg-mention {
        display: block;
      }

      .cfg-replier {
        display: none;
      }
    }

    /* ---------------------------------------------------- Le panneau clair */
    .cfg-panneau {
      padding: 1.5rem var(--gutter) 2rem;
    }

    @media (min-width: 64rem) {
      .cfg-panneau {
        padding: 2rem clamp(2rem, 4.5vw, 4.5rem) 0;
      }
    }

    .cfg-etape {
      scroll-margin-top: calc(var(--cfg-entete) + 1rem);
    }

    .cfg-etape + .cfg-etape {
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 1px solid var(--line);
    }

    /* Une seule etape visible (le script cache les autres) : pas de filet ni
       de marge heritee des etapes cachees. Sans JavaScript, tout reste separe. */
    .cfg-etape[hidden] + .cfg-etape {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .cfg-etape-titre {
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: clamp(2.125rem, 3.6vw, 2.875rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
    }

    .cfg-etape-titre:focus {
      outline: none;
    }

    .cfg-etape-sous {
      margin-top: 0.625rem;
      font-family: var(--font-serif);
      font-size: 1.25rem;
      line-height: 1.35;
      color: var(--ink);
    }

    /* ------------------------------------------------------ Communs */
    .cfg-aide {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--muted);
    }

    .cfg-aide:empty {
      display: none;
    }

    .cfg-champ {
      margin-top: 1.5rem;
    }

    .cfg-label {
      display: block;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink);
    }

    .cfg-lien {
      display: inline;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      font-family: var(--font-serif);
      font-size: 1.0625rem;
      color: var(--ink);
      text-decoration: underline;
      text-decoration-color: var(--line-strong);
      text-underline-offset: 0.3em;
      cursor: pointer;
    }

    .cfg-lien:hover,
    .cfg-lien:focus-visible {
      text-decoration-color: var(--ink);
    }

    .cfg-lien:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 3px;
    }

    .cfg-lien-bouton {
      min-height: 2.75rem;
    }

    /* La coche, commune aux tuiles, dispositions, finitions et motifs : cachee
       tant que rien n est choisi (jamais la couleur seule : la bordure change aussi). */
    .cfg-coche {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      display: none;
      width: 1.5rem;
      height: 1.5rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--canvas);
      color: var(--ink);
      box-shadow: 0 0 0 1px var(--line-strong);
    }

    [aria-pressed="true"] > .cfg-coche,
    [aria-pressed="true"] > * > .cfg-coche,
    :checked ~ .cfg-disposition-vue .cfg-coche {
      display: flex;
    }

    /* ------------------------------------------------ 1 Les tuiles */
    .cfg-tuiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1rem;
      margin-top: 1.5rem;
    }

    @media (min-width: 40rem) {
      .cfg-tuiles {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .cfg-tuile {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      cursor: pointer;
    }

    .cfg-tuile-image {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 7 / 3;
      overflow: hidden;
      border: 1px solid var(--line-strong);
      background: var(--surface);
    }

    .cfg-tuile-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cfg-tuile-nom {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--ink);
    }

    .cfg-tuile:hover .cfg-tuile-image {
      border-color: var(--ink);
    }

    .cfg-tuile:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 3px;
    }

    .cfg-tuile[aria-pressed="true"] .cfg-tuile-image {
      border: 2px solid var(--ink);
      box-shadow: inset 0 0 0 2px var(--canvas);
    }

    .cfg-tuile[aria-pressed="true"] .cfg-tuile-nom {
      font-weight: 500;
    }

    .cfg-tuile-etat {
      display: none;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .cfg-tuile[aria-pressed="true"] .cfg-tuile-etat {
      display: block;
    }

    .cfg-aide-echantillon {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin-top: 1.5rem;
    }

    .cfg-choix-ligne {
      grid-area: choix;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 0.75rem;
    }


    .cfg-choix-label {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--muted);
    }

    .cfg-choix-valeur {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      line-height: 1;
      color: var(--ink);
    }

    /* ------------------------------------------ 2 L inscription guidee */
    .cfg-groupe-champs {
      min-width: 0;
      margin-inline: 0;
      padding: 0;
      border: 0;
    }

    .cfg-groupe-champs > legend {
      padding: 0;
    }

    .cfg-dispositions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    .cfg-disposition {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    .cfg-disposition input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    .cfg-disposition-vue {
      position: relative;
      display: block;
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid var(--line-strong);
      background: var(--canvas);
    }

    .cfg-disposition-vue svg {
      display: block;
      width: 100%;
      height: auto;
    }

    .cfg-disposition-nom {
      font-family: var(--font-serif);
      font-size: 1.0625rem;
      text-align: center;
      color: var(--ink);
    }

    .cfg-disposition:hover .cfg-disposition-vue {
      border-color: var(--ink);
    }

    .cfg-disposition:has(input:focus-visible) .cfg-disposition-vue {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-disposition:has(input:checked) .cfg-disposition-vue {
      border: 2px solid var(--ink);
      padding: calc(0.75rem - 1px) calc(1rem - 1px);
    }

    .cfg-disposition:has(input:checked) .cfg-disposition-nom {
      font-weight: 500;
    }

    .cfg-personne-titre {
      margin-bottom: 0.25rem;
    }

    .cfg-champs-personne {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.875rem 1rem;
      margin-top: 0.5rem;
    }

    .cfg-sous-champ {
      display: grid;
      gap: 0.375rem;
      font-size: 0.9375rem;
      color: var(--ink);
    }

    .cfg-sous-champ-large {
      grid-column: 1 / -1;
    }

    .cfg-input,
    .cfg-select,
    .cfg-textarea,
    .cfg-fichier {
      display: block;
      width: 100%;
      min-height: 3rem;
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--ink);
    }

    .cfg-select,
    .cfg-textarea,
    .cfg-fichier {
      margin-top: 0.625rem;
    }

    .cfg-textarea {
      line-height: 1.5;
      resize: vertical;
    }

    .cfg-textarea-phrase {
      resize: none;
      overflow: hidden;
    }

    .cfg-input::placeholder,
    .cfg-textarea::placeholder {
      color: var(--muted);
      opacity: 0.8;
    }

    .cfg-input:focus-visible,
    .cfg-select:focus-visible,
    .cfg-textarea:focus-visible,
    .cfg-fichier:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 1px;
      border-color: var(--ink);
    }

    .cfg-facultatif {
      font-weight: 400;
      color: var(--muted);
    }

    .cfg-phrase-pied {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.25rem 1rem;
      margin-top: 0.5rem;
    }

    .cfg-compteur {
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .cfg-idees {
      flex: 1;
      min-width: 12rem;
      text-align: right;
    }

    .cfg-idees-titre {
      display: inline;
      list-style: none;
    }

    .cfg-idees-titre::-webkit-details-marker {
      display: none;
    }

    .cfg-idees-theme {
      margin-top: 0.75rem;
      font-size: 0.875rem;
      text-align: left;
      color: var(--muted);
    }

    .cfg-idees-liste {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .cfg-idee {
      min-height: 2.75rem;
      padding: 0.5rem 0.875rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: var(--canvas);
      font: inherit;
      font-size: 0.9375rem;
      text-align: left;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-idee:hover {
      border-color: var(--ink);
    }

    .cfg-idee:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-deux-colonnes {
      display: grid;
      gap: 0 1.25rem;
    }

    @media (min-width: 36rem) {
      .cfg-deux-colonnes {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      }
    }

    .cfg-finitions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.625rem;
      margin-top: 0.625rem;
    }

    .cfg-finition {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      cursor: pointer;
    }

    /* L echantillon : « Aa » dans la couleur de la finition, sur une pierre
       sombre. Contour et ombre comme sur l apercu, pour que le dore se lise. */
    .cfg-finition-echantillon {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      aspect-ratio: 8 / 5;
      border: 1px solid var(--line-strong);
      background: var(--cfg-pierre);
      font-family: var(--font-serif);
      font-size: 1.75rem;
      line-height: 1;
      color: var(--cfg-finition);
      text-shadow: 0 1px 1px rgb(0 0 0 / 0.6);
    }

    .cfg-finition-nom {
      font-size: 0.875rem;
      line-height: 1.3;
      text-align: center;
      color: var(--ink);
    }

    .cfg-finition:hover .cfg-finition-echantillon {
      border-color: var(--ink);
    }

    .cfg-finition:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 3px;
    }

    .cfg-finition[aria-pressed="true"] .cfg-finition-echantillon {
      border: 2px solid var(--ink);
      box-shadow: inset 0 0 0 2px var(--canvas);
    }

    .cfg-finition[aria-pressed="true"] .cfg-finition-nom {
      font-weight: 500;
    }

    .cfg-vers-libre {
      margin-top: 1rem;
      text-align: right;
    }

    .cfg-erreur {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.55;
      /* Le meme brun d erreur que /devis/ (6,4:1 sur le fond du site). */
      color: #8d3c33;
    }

    .cfg-erreur:empty,
    .cfg-demande-nom:empty {
      display: none;
    }

    .cfg-demande-nom {
      color: var(--ink);
    }

    .cfg-bouton {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      margin-top: 1.25rem;
      padding: 0.625rem 1.25rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-size: 1rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-bouton:hover {
      border-color: var(--ink);
    }

    .cfg-bouton:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-bouton:disabled {
      border-color: var(--line);
      color: var(--muted);
      cursor: default;
    }

    /* ------------------------------------------ Les zones (mode libre) */
    .cfg-libre {
      margin-top: 1rem;
    }

    .cfg-zones {
      margin-top: 1.25rem;
    }

    .cfg-onglets {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .cfg-onglet {
      min-height: 3rem;
      padding: 0.5rem 1.125rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-size: 0.9375rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-onglet:hover {
      border-color: var(--ink);
    }

    .cfg-onglet:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-onglet[aria-selected="true"] {
      border-width: 2px;
      border-color: var(--ink);
      background: var(--surface);
      font-weight: 500;
    }

    .cfg-zones-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    .cfg-zones-actions .cfg-bouton {
      margin-top: 0;
      font-size: 0.9375rem;
    }

    /* ------------------------------------------------- 3 Les motifs */
    .cfg-familles {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.5rem;
    }

    .cfg-famille {
      flex: 1 1 auto;
      min-height: 3rem;
      padding: 0.5rem 1.25rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-famille:hover {
      border-color: var(--ink);
    }

    .cfg-famille:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-famille[aria-pressed="true"] {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--canvas);
    }

    .cfg-groupe {
      margin-top: 1.25rem;
    }

    .cfg-groupe-titre {
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .cfg-motifs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    @media (min-width: 48rem) {
      .cfg-motifs {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .cfg-motif {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 0.75rem 0.875rem;
      border: 1px solid var(--line-strong);
      background: var(--canvas);
      font: inherit;
      cursor: pointer;
    }

    .cfg-motif-vue {
      display: grid;
      place-items: center;
      width: 60%;
      aspect-ratio: 1;
      color: var(--ink);
    }

    /* La vignette : le SVG public sert de MASQUE sur un aplat de la couleur du
       texte ; le fichier se met en cache, la page ne porte pas les traces. */
    .cfg-motif-masque {
      display: block;
      width: 100%;
      height: 100%;
      background: currentColor;
      -webkit-mask: var(--motif) center / contain no-repeat;
      mask: var(--motif) center / contain no-repeat;
    }

    .cfg-motif-nom {
      font-family: var(--font-serif);
      font-size: 1.0625rem;
      line-height: 1.25;
      text-align: center;
      color: var(--ink);
    }

    .cfg-motif:hover,
    .cfg-motif-demande:hover {
      border-color: var(--ink);
    }

    .cfg-motif:focus-visible,
    .cfg-motif-demande:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-motif[aria-pressed="true"],
    .cfg-motif-demande[aria-pressed="true"] {
      border: 2px solid var(--ink);
      background: var(--surface);
    }

    .cfg-motif-demande {
      position: relative;
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
      margin-top: 0.75rem;
      padding: 0.875rem 3rem 0.875rem 1rem;
      border: 1px solid var(--line-strong);
      background: var(--canvas);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .cfg-motif-demande-icone {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      flex: none;
      border: 1px solid var(--line-strong);
      color: var(--ink);
    }

    .cfg-motif-demande-texte {
      display: grid;
      gap: 0.125rem;
    }

    .cfg-motif-demande-nom {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--ink);
    }

    .cfg-motif-demande-sous {
      font-size: 0.9375rem;
      color: var(--muted);
    }

    .cfg-motif-demande .cfg-coche {
      top: 50%;
      transform: translateY(-50%);
    }

    .cfg-demande {
      margin-top: 1.5rem;
      padding: 1rem 1rem 1.25rem;
      border: 1px dashed var(--cfg-accent);
      border-radius: 3px;
      background: var(--surface);
    }

    .cfg-demande .cfg-champ:first-of-type {
      margin-top: 1rem;
    }

    .cfg-poses {
      margin-top: 1.75rem;
    }

    .cfg-poses-liste {
      display: grid;
      gap: 0.625rem;
      margin: 0.75rem 0 0;
      padding: 0;
      list-style: none;
    }

    .cfg-poses-liste:empty {
      display: none;
    }

    :global(.cfg-pose) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
    }

    :global(.cfg-pose-choisir) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      min-height: 3rem;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      text-align: left;
      color: inherit;
      cursor: pointer;
    }

    :global(.cfg-pose-choisir:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    :global(.cfg-pose[aria-current="true"]) {
      border-width: 2px;
      border-color: var(--ink);
      background: var(--surface);
    }

    :global(.cfg-pose-nom) {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--ink);
    }

    :global(.cfg-pose-taille) {
      font-size: 0.875rem;
      color: var(--muted);
    }

    :global(.cfg-pose-actions) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-left: auto;
    }

    :global(.cfg-pose-bouton) {
      min-height: 3rem;
      padding: 0.375rem 0.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-size: 0.875rem;
      color: var(--ink);
      cursor: pointer;
    }

    :global(.cfg-pose-bouton:hover:not(:disabled)) {
      border-color: var(--ink);
    }

    :global(.cfg-pose-bouton:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    :global(.cfg-pose-bouton:disabled) {
      color: var(--muted);
      cursor: default;
    }

    :global(.cfg-pose-bouton[aria-pressed="true"]) {
      border-width: 2px;
      border-color: var(--ink);
      background: var(--surface);
    }

    .cfg-aide-placer {
      margin-top: 1.25rem;
    }

    .cfg-agrandir {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      min-height: 3.25rem;
      margin-top: 0.75rem;
      padding: 0.75rem 1rem;
      border: 1px solid var(--line-strong);
      background: var(--surface);
      font: inherit;
      font-size: 1rem;
      text-align: left;
      color: var(--ink);
      cursor: pointer;
    }

    @media (min-width: 64rem) {
      .cfg-agrandir {
        display: none;
      }
    }

    /* --------------------------------------------- 4 Le recapitulatif */
    .cfg-recap {
      margin-top: 1.5rem;
      border-top: 1px solid var(--line);
    }

    .cfg-recap-ligne-bloc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "titre modifier"
        "valeur modifier";
      gap: 0.5rem 1rem;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--line);
    }

    @media (min-width: 48rem) {
      .cfg-recap-ligne-bloc {
        grid-template-columns: 10rem minmax(0, 1fr) auto;
        grid-template-areas: "titre valeur modifier";
        align-items: start;
        gap: 1.5rem;
      }
    }

    .cfg-recap-titre {
      grid-area: titre;
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      font-family: var(--font-serif);
      font-size: 1.25rem;
      color: var(--ink);
    }

    .cfg-recap-numero {
      font-size: 0.875rem;
      color: var(--muted);
    }

    .cfg-recap-valeur {
      grid-area: valeur;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin: 0;
    }

    .cfg-recap-vignette {
      display: grid;
      place-items: center;
      width: 4.25rem;
      height: 4.25rem;
      flex: none;
      overflow: hidden;
      border: 1px solid var(--line);
      background: var(--surface);
      object-fit: cover;
      color: var(--ink);
    }

    .cfg-recap-aa {
      font-family: var(--font-serif);
      font-size: 1.75rem;
    }

    .cfg-recap-motif .cfg-motif-masque {
      width: 70%;
      height: 70%;
    }

    .cfg-recap-texte {
      display: grid;
      gap: 0.25rem;
      font-family: var(--font-serif);
      font-size: 1.375rem;
      line-height: 1.25;
      color: var(--ink);
    }

    .cfg-recap-lignes {
      display: grid;
    }

    .cfg-recap-vide {
      font-size: 1.0625rem;
      color: var(--muted);
    }

    .cfg-recap-sous {
      font-family: var(--font-sans);
      font-size: 0.9375rem;
      color: var(--muted);
    }

    .cfg-recap-sous:empty {
      display: none;
    }

    .cfg-recap-modifier {
      grid-area: modifier;
      align-self: start;
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
    }

    .cfg-prix {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      margin-top: 1.5rem;
      font-size: 1.125rem;
      color: var(--ink);
    }

    .cfg-prix-label {
      font-size: 0.9375rem;
      color: var(--muted);
    }

    .cfg-suite-titre {
      margin-top: 2rem;
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: 1.5rem;
    }

    .cfg-encadre {
      display: flex;
      gap: 0.875rem;
      margin-top: 1.25rem;
      padding: 1rem 1.125rem;
      border: 1px solid var(--line-strong);
      background: var(--surface);
      font-size: 0.9375rem;
      line-height: 1.5;
      color: var(--muted);
    }

    .cfg-encadre strong {
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: 1.125rem;
      color: var(--ink);
    }

    .cfg-encadre-icone {
      display: grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      flex: none;
      border: 1px solid var(--ink);
      border-radius: 999px;
      font-family: var(--font-serif);
      font-size: 0.875rem;
      color: var(--ink);
    }

    /* ----------------------------------------------------- Retour / Continuer */
    .cfg-nav {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "retour continuer"
        "note note";
      align-items: center;
      gap: 0.625rem 1rem;
      margin-top: 2rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
    }

    .cfg-retour {
      grid-area: retour;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.625rem;
      min-height: 3.25rem;
      padding: 0 1.25rem;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--ink);
      text-decoration: none;
    }

    .cfg-retour:hover,
    .cfg-retour:focus-visible {
      border-color: var(--ink);
    }

    .cfg-continuer {
      grid-area: continuer;
      width: 100%;
    }

    .cfg-continuer-long {
      display: none;
    }

    @media (min-width: 64rem) {
      .cfg-continuer-court {
        display: none;
      }

      .cfg-continuer-long {
        display: inline;
      }
    }

    /* Telephone : la barre collee en bas reste basse ; le choix se lit deja
       sur la tuile ("Selectionne") et dans la legende de l'apercu. */
    .cfg-nav-choix {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "continuer"
        "note";
    }

    .cfg-nav-choix .cfg-choix-ligne {
      display: none;
    }

    @media (min-width: 64rem) {
      .cfg-nav-choix {
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-areas:
          "choix continuer"
          "note note";
      }

      .cfg-nav-choix .cfg-choix-ligne {
        display: flex;
      }
    }

    .cfg-nav-note {
      grid-area: note;
      font-size: 0.875rem;
      text-align: center;
      color: var(--muted);
    }

    .cfg-lien-aide {
      font-size: 0.9375rem;
    }

    .cfg-fleche {
      flex: none;
      transition: transform 300ms var(--ease-out-expo);
    }

    .cfg-continuer:hover .cfg-fleche,
    .cfg-continuer:focus-visible .cfg-fleche {
      transform: translateX(4px);
    }

    .cfg-retour:hover .cfg-fleche-retour {
      transform: translateX(-4px);
    }

    /* Telephone : la barre d action reste au bas de l ecran pendant que la
       famille defile dans l etape. */
    @media (max-width: 63.999rem) {
      .cfg-nav {
        position: sticky;
        bottom: 0;
        z-index: 4;
        margin-inline: calc(-1 * var(--gutter));
        padding: 0.75rem var(--gutter) 0.625rem;
        border-top: 1px solid var(--line-strong);
        background: var(--canvas);
      }

      .cfg-nav .cfg-retour:only-of-type {
        display: none;
      }

      .cfg-nav:not(:has(.cfg-retour)):not(.cfg-nav-choix) {
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas:
          "continuer"
          "note";
      }

      .cfg-nav:has(.cfg-retour) {
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      }

      /* La derniere etape : le bouton du devis sur toute la largeur, le
         retour en simple lien dessous. */
      .cfg-nav-finale:has(.cfg-retour) {
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas:
          "continuer"
          "note"
          "retour";
        row-gap: 0.375rem;
      }

      .cfg-nav-finale .cfg-retour {
        min-height: 2.75rem;
        border: 0;
        justify-self: center;
        font-size: 1rem;
      }
    }

    @media (min-width: 64rem) {
      .cfg-nav {
        position: sticky;
        bottom: 0;
        z-index: 2;
        grid-template-columns: auto minmax(0, 1fr);
        padding-bottom: 1.25rem;
        background: var(--canvas);
      }

      .cfg-continuer {
        justify-self: end;
        width: auto;
        min-width: 18rem;
      }

      .cfg-nav-note {
        text-align: right;
      }

      .cfg-nav:not(:has(.cfg-retour)):not(.cfg-nav-choix) .cfg-continuer {
        grid-column: 1 / -1;
      }
    }

    /* ----------------------------------------------------- Le brouillon */
    .cfg-brouillon {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      margin-bottom: 1.25rem;
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--line);
      border-radius: 3px;
      background: var(--surface);
    }

    .cfg-brouillon-texte {
      flex: 1 1 20rem;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--muted);
    }

    .cfg-brouillon .cfg-bouton {
      min-height: 2.5rem;
      margin-top: 0;
      padding: 0.375rem 0.875rem;
      font-size: 0.875rem;
    }

    /* ------------------------------------------------------ Le bandeau */
    .cfg-bandeau {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 2rem;
      padding: 1rem var(--gutter);
      background: var(--canvas);
      color: var(--ink);
    }

    .cfg-bandeau-item {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      font-family: var(--font-serif);
      font-size: 1.0625rem;
    }

    .cfg-bandeau-item + .cfg-bandeau-item {
      padding-left: 2rem;
      border-left: 1px solid var(--line-strong);
    }

    .cfg-bandeau-marque {
      display: grid;
      margin-left: auto;
      text-align: right;
    }

    .cfg-bandeau-logo {
      font-family: var(--font-serif);
      font-size: 1rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .cfg-bandeau-sous {
      font-size: 0.625rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (min-width: 64rem) {
      .cfg-bandeau {
        height: var(--cfg-bandeau);
        flex-wrap: nowrap;
        padding-block: 0;
      }
    }

    @media (max-width: 39.999rem) {
      .cfg-bandeau-item + .cfg-bandeau-item {
        padding-left: 0;
        border-left: 0;
      }

      .cfg-bandeau-marque {
        margin-left: 0;
        text-align: left;
      }
    }

    @media (max-width: 30rem) {
      .cfg-champs-personne,
      .cfg-finitions {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .cfg-finitions {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  </style>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />

  {/* La configuration du canvas, lue par `src/scripts/configurateur/index.ts`.
      Un bloc de donnees, pas du code : `type="application/json"`. */}
  <script
    is:inline
    type="application/json"
    data-donnees-configurateur
    set:html={JSON.stringify(donneesConfigurateur)}
  />

  {/* L ILOT KONVA. Ce `<script>` est compile et minifie par Astro, et Konva
      arrive par IMPORT DYNAMIQUE depuis `index.ts` : il part dans son propre
      fichier, demande par cette page seulement. Si quoi que ce soit echoue,
      l apercu statique reste affiche. */}
  <script>
    import { demarre } from "@/scripts/configurateur";

    demarre().catch((erreur) => {
      console.error("Configurateur indisponible, apercu statique conserve :", erreur);
    });
  </script>
