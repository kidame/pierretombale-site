---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageTitle } from "@/config/site";
import { getCalibration } from "@/data/calibrations";
/* Les bornes des zones de texte : 3 zones, 120 caracteres, 4 lignes. */
import { ZONE_LIGNES_MAX, ZONE_LONGUEUR_MAX, ZONES_MAX } from "@/data/configurateur";
import { vignetteMatiere } from "@/data/granits";
import { motifsParFamille } from "@/data/motifs";
import { motifsConfigurateur, svgMotif } from "@/data/motifs-svg";
import {
  FINITION_APERCU_DEFAUT,
  finitions,
  hauteurLabel,
  hauteursLettresMm,
  hauteursParDefaut,
  MENTION_APERCU,
  POLICE_DEFAUT,
  polices,
} from "@/data/personnalisation";
import {
  altVisuel,
  FAMILLE_LABELS,
  familleUrl,
  getProducts,
  imagesDuModele,
  productUrl,
  visuelModele,
  type Product,
} from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";
/* Le nombre maximal de motifs, la longueur de la description et les extensions
   de fichier acceptees sont decides par le script (une seule constante
   chacun) : la page les lit, elle ne les redeclare pas. */
import {
  DESCRIPTION_MAX,
  FICHIER_EXTENSIONS,
  MAX_MOTIFS,
} from "@/scripts/configurateur/motifs";
import { MENTION_PRIX_PROVISOIRE, prixAffiche, prixEstProvisoire } from "@/data/tarifs";

/* Le configurateur visuel d un modele : /personnaliser/<slug>/.

   PASSE A (22.10.2026) : tout ce que cette page montre est STATIQUE et lisible
   sans JavaScript. L apercu est une vraie <img>, cadree sur la stele par les
   coordonnees de `src/data/calibrations/<modeleId>.json` et un simple
   `overflow: hidden` ; les choix (matiere, texte, police, hauteur, finition)
   sont de vrais controles HTML. Sans JavaScript ils ne font rien : la page
   reste une presentation du modele avec un lien vers le devis, et c est
   volontaire (regle de `docs/CONFIGURATEUR-FUTUR.md` : « une page dont le
   contenu n existe qu en JavaScript n existe pas »).

   PASSE B : un ilot Konva remplace l apercu statique et branche les controles
   (voir `src/scripts/configurateur/`). Le script est charge par cette page
   SEULEMENT, en import dynamique ; Konva n entre dans aucune autre page.

   PASSE C1 : les motifs. Les cartes de selection montrent le SVG INLINE (lu
   au build par `src/data/motifs-svg.ts`), colore par le CSS ; la geometrie des
   dessins part dans le meme JSON de configuration que la calibration, donc le
   canvas ne telecharge aucun SVG a l execution.

   CE QUI N Y EST PAS ENCORE : les 3 zones de texte (passe C2), le prix
   calcule, l export PNG et le branchement sur /devis/ (passes D et E du
   backlog).

   UNE PAGE PAR MODELE CALIBRE. Tant qu il n y a qu un fichier dans
   `src/data/calibrations/`, cette page n existe que pour Douceur. Deposer un
   JSON de plus suffit a en creer une autre.

   NOINDEX, FOLLOW : la page est mince en v1 (peu de texte propre, beaucoup
   d interface). Le canonique renvoie vers la fiche du modele, qui porte la
   description, les caracteristiques et le JSON-LD Product. */

/* LES POLICES DE GRAVURE NE SE CHARGENT QUE SUR LES PAGES QUI LES MONTRENT.
   Ces six imports sont les memes que ceux de `src/pages/devis.astro`, et ils
   sont ICI, dans la page : jamais dans `BaseLayout.astro` ni dans
   `src/styles.css`, sinon les 23 autres pages telechargeraient 140 Ko de
   polices pour rien. Les familles CSS correspondantes vivent dans
   `src/data/personnalisation.ts`. */
import "@fontsource/cinzel/latin-400.css";
import "@fontsource/marcellus/latin-400.css";
import "@fontsource/eb-garamond/latin-400.css";
import "@fontsource/jost/latin-400.css";
import "@fontsource/great-vibes/latin-400.css";
import "@fontsource/pinyon-script/latin-400.css";

export async function getStaticPaths() {
  const products = await getProducts();

  /* Un modele sans calibration n a pas de page : l apercu serait un cadrage
     invente. La liste grandit toute seule avec les fichiers de
     `src/data/calibrations/`. */
  return products
    .filter((product) => getCalibration(product.modeleId) !== undefined)
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

/* `getStaticPaths` ne garde que les modeles calibres : la calibration existe
   forcement ici. */
const calibration = getCalibration(product.modeleId)!;

const origin = Astro.site ?? new URL(Astro.url.origin);
const urlFiche = productUrl(product);

const visuel = visuelModele(product);

/* Les matieres qui ont un visuel pour ce modele, comme sur la fiche : une
   matiere sans photo d echantillon n aurait qu une pastille vide. */
const matieres = imagesDuModele(product)
  .map((granit) => ({ granit, vignette: vignetteMatiere(granit) }))
  .filter((entree): entree is { granit: (typeof entree)["granit"]; vignette: string } =>
    Boolean(entree.vignette),
  );

/* Racine des chemins de visuel, comme sur la fiche : le script recompose
   `-1200.webp` au lieu de porter un chemin par pastille. */
const racineVisuel = `/images/modeles/${product.modeleId}/${product.modeleId}`;

/* CADRAGE DE L APERCU, SANS UNE LIGNE DE JAVASCRIPT.
   Le conteneur prend le rapport de `vueStelePx` ; l image, agrandie et
   decalee, place exactement cette zone dans le conteneur. Les pourcentages
   suffisent, donc le cadrage tient a n importe quelle largeur :
   - largeur de l image = largeur de l image source / largeur de la vue ;
   - decalage = position de la vue dans l image, en part de l image (le
     `translate` d un element se compte sur SA propre taille).
   Le facteur 1200/1254 n apparait pas : il se simplifie dans les deux
   rapports. Il sert en revanche au canvas (voir echelle.ts). */
const vue = calibration.vueStelePx;
const largeurImagePct = (calibration.imagePx.largeur / vue.largeur) * 100;
const decalageXPct = (vue.x / calibration.imagePx.largeur) * 100;
const decalageYPct = (vue.y / calibration.imagePx.hauteur) * 100;

/* `--cfg-ratio` sert a plafonner la HAUTEUR de l apercu sur telephone sans
   jamais entrer en conflit avec `aspect-ratio` : on borne la largeur, et la
   hauteur suit (voir `.cfg-cadre` dans le style de la page). */
const styleCadre =
  `aspect-ratio: ${vue.largeur} / ${vue.hauteur}; ` +
  `--cfg-ratio: ${(vue.largeur / vue.hauteur).toFixed(4)};`;
const styleImage =
  `width: ${largeurImagePct.toFixed(3)}%; ` +
  `transform: translate(-${decalageXPct.toFixed(3)}%, -${decalageYPct.toFixed(3)}%);`;

const prix = prixAffiche(product.slug);
const prixProvisoire = prixEstProvisoire(product.slug);

const titre = pageTitle(`Personnaliser ${product.name}`);
const metaDescription =
  `Composez l'inscription sur le modèle ${product.name} : matière, texte, ` +
  `style d'écriture, taille des lettres. Aperçu indicatif, devis gratuit.`;

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: FAMILLE_LABELS[product.famille], path: familleUrl(product.famille) },
    { name: product.name, path: urlFiche },
    { name: "Personnaliser", path: `/personnaliser/${product.slug}/` },
  ],
  origin,
);

/* UNE HAUTEUR DE LETTRES SUGGEREE PAR ZONE, en millimetres : le nom en grand,
   les dates plus petites, l epitaphe plus discrete encore. Ce sont les memes
   defauts que /devis/ (`hauteursParDefaut`). Si ZONES_MAX grandit, les zones
   suivantes reprennent la derniere hauteur de la liste. */
const hauteursSuggerees = [
  hauteursParDefaut.nom,
  hauteursParDefaut.dates,
  hauteursParDefaut.epitaphe,
];
const hauteursMmParZone = Array.from(
  { length: ZONES_MAX },
  (_, rang) => hauteursSuggerees[Math.min(rang, hauteursSuggerees.length - 1)],
);

/* La zone 1 est celle d un nom (5 cm) : c est ce que les familles saisissent
   en premier, et c est la hauteur que montre le select au chargement. */
const hauteurDefaut = hauteursMmParZone[0];

/* Les motifs, groupes par famille (familles vides exclues). Les SVG sont lus
   au build : la page les ecrit en clair dans les cartes, et leur geometrie
   part dans le JSON du canvas. */
const groupesMotifs = motifsParFamille();

/* LA CONFIGURATION DU CANVAS, INLINEE EN JSON AU BUILD (passe B).
   Le script du configurateur ne lit que ce bloc : il n importe ni les donnees
   d Astro, ni le contenu Markdown, et ne refait aucun calcul de cadrage. Tout
   vient des sources existantes (calibration, images, polices, finitions), donc
   corriger une donnee suffit a corriger l apercu. */
const donneesConfigurateur = {
  calibration,
  matieres: matieres.map(({ granit }) => ({
    id: granit.id,
    image: `${racineVisuel}-${granit.id}-1200.webp`,
  })),
  polices: polices.map((police) => ({ id: police.id, famille: police.famille })),
  finitions: finitions.map((finition) => ({
    id: finition.id,
    couleur: finition.couleurApercu,
    aide: finition.aide,
  })),
  /* La bibliotheque de motifs, geometrie comprise (`d` et viewBox en mm) : le
     canvas pose un `Konva.Path` sans rien telecharger. */
  motifs: motifsConfigurateur(),
  defauts: {
    matiere: visuel.matiere,
    policeId: POLICE_DEFAUT,
    finitionId: FINITION_APERCU_DEFAUT,
    hauteursMmParZone,
  },
};
---

<BaseLayout
  title={titre}
  description={metaDescription}
  image={`${racineVisuel}-${visuel.matiere}-1200.webp`}
  robots="noindex,follow"
  canonical={urlFiche}
>
  <main id="main-content" class="shell cfg">
    <nav class="cfg-fil mono" aria-label="Fil d'Ariane">
      <a href="/" class="link">Accueil</a>
      <span aria-hidden="true">/</span>
      <a href={familleUrl(product.famille)} class="link">{FAMILLE_LABELS[product.famille]}</a>
      <span aria-hidden="true">/</span>
      <a href={urlFiche} class="link">{product.name}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Personnaliser</span>
    </nav>

    <p class="label">Personnalisation</p>
    <h1 class="type-h2 cfg-titre">Personnaliser {product.name}</h1>
    <p class="type-lead cfg-chapeau">
      Choisissez la matière, écrivez l'inscription et voyez l'effet sur la stèle. Rien n'est
      engagé : vous terminez par une demande de devis, gratuite et sans engagement.
    </p>

    <div class="cfg-grille">
      {/* ------------------------------------------------------------ Apercu */}
      <div class="cfg-apercu-col">
        <div class="cfg-colle">
          <div class="cfg-cadre" style={styleCadre} data-apercu>
            {/* L apercu statique de la passe A. La passe B le masque des que
                le canvas est pret, pour ne pas afficher deux fois la stele. */}
            <div class="cfg-statique" data-apercu-statique>
              <img
                src={`${racineVisuel}-${visuel.matiere}-1200.webp`}
                alt={`Stèle du modèle ${altVisuel(product, visuel.matiere)}`}
                width="1200"
                height="1200"
                style={styleImage}
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                data-apercu-image
              />
            </div>
            <div class="cfg-canvas" data-apercu-canvas></div>
          </div>

          <p class="cfg-legende mono">
            Aperçu de la stèle · <span data-matiere-nom>{visuel.nomMatiere}</span>
          </p>
        </div>

        <p class="cfg-mention">{MENTION_APERCU}</p>
      </div>

      {/* ------------------------------------------------------------ Choix */}
      <div class="cfg-choix">
        {/* ---------------------------------------------------- 1 La matiere */}
        <section class="cfg-etape" aria-labelledby="etape-matiere">
          <h2 class="cfg-etape-titre" id="etape-matiere">
            <span class="cfg-numero mono" aria-hidden="true">1</span> La matière
          </h2>
          <p class="cfg-aide">
            Les teintes de l'écran sont approximatives : la pierre se juge sur un échantillon.
          </p>

          <div class="cfg-pastilles" role="group" aria-label="Choisir la matière">
            {
              matieres.map(({ granit, vignette }) => (
                <button
                  type="button"
                  class="cfg-pastille"
                  data-matiere={granit.id}
                  data-nom={granit.nom}
                  data-alt={`Stèle du modèle ${altVisuel(product, granit.id)}`}
                  aria-pressed={granit.id === visuel.matiere ? "true" : "false"}
                >
                  <img
                    src={vignette}
                    alt={granit.nom}
                    width="160"
                    height="160"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="cfg-pastille-nom">{granit.nom}</span>
                </button>
              ))
            }
          </div>

          <p class="cfg-aide">
            <a href="/nos-granits/" class="link">Voir toutes nos matières</a>
          </p>
        </section>

        {/* ------------------------------------------------- 2 L inscription */}
        <section class="cfg-etape" aria-labelledby="etape-inscription">
          <h2 class="cfg-etape-titre" id="etape-inscription">
            <span class="cfg-numero mono" aria-hidden="true">2</span> L'inscription
          </h2>
          <p class="cfg-aide">
            Chaque zone peut avoir sa police, sa taille et sa finition.
          </p>

          {/* LES ONGLETS DE ZONES N EXISTENT QU AVEC LE JAVASCRIPT. Sans lui,
              aucune zone ne s ajoute ni ne se supprime : la page garde un seul
              bloc de controles, celui de la zone 1, et des onglets inertes ne
              feraient que tromper. Le script leve `hidden`, pose
              `role="tabpanel"` sur le bloc de controles et montre les onglets
              des zones qui existent. */}
          <div class="cfg-zones" data-zones hidden>
            <div class="cfg-onglets" role="tablist" aria-label="Zones de texte">
              {
                Array.from({ length: ZONES_MAX }, (_, rang) => rang + 1).map((numero) => (
                  <button
                    type="button"
                    class="cfg-onglet"
                    role="tab"
                    id={`cfg-zone-onglet-${numero}`}
                    aria-controls="cfg-zone-panneau"
                    aria-selected={numero === 1 ? "true" : "false"}
                    tabindex={numero === 1 ? 0 : -1}
                    hidden={numero !== 1}
                    data-zone-onglet={numero}
                  >
                    Zone {numero}
                  </button>
                ))
              }
            </div>

            <div class="cfg-zones-actions">
              <button type="button" class="cfg-bouton" data-zone-ajouter>
                + Ajouter une zone
              </button>
              <button type="button" class="cfg-bouton" data-zone-supprimer hidden>
                Supprimer cette zone
              </button>
            </div>
          </div>

          <div id="cfg-zone-panneau" data-zone-panneau>
            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-texte">Texte à graver</label>
              <p class="cfg-aide" id="cfg-texte-aide">
                Le nom, les dates, quelques mots. Passez à la ligne pour séparer les lignes ({
                  ZONE_LIGNES_MAX
                } au plus) ; le texte est centré sur la stèle.
              </p>
              <textarea
                class="cfg-textarea"
                id="cfg-texte"
                name="texte"
                rows={ZONE_LIGNES_MAX}
                maxlength={ZONE_LONGUEUR_MAX}
                aria-describedby="cfg-texte-aide cfg-compteur"
                data-texte></textarea>
              <p class="cfg-compteur mono" id="cfg-compteur">
                <span data-compteur>0</span> / {ZONE_LONGUEUR_MAX} caractères
              </p>
              {/* Le message reste dans la page, vide : un `role="status"` deja
                  la est annonce des qu il se remplit, alors qu un message
                  cree au moment du blocage ne l est pas toujours. */}
              <p class="cfg-aide" role="status" data-zone-lignes></p>
            </div>

            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-police">Style d'écriture</label>
              <select class="cfg-select" id="cfg-police" name="police" data-police>
                {
                  polices.map((police) => (
                    <option value={police.id} selected={police.id === POLICE_DEFAUT}>
                      {police.nom}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-hauteur">Taille des lettres</label>
              <select class="cfg-select" id="cfg-hauteur" name="hauteur" data-hauteur>
                {
                  hauteursLettresMm.map((mm) => (
                    <option value={mm} selected={mm === hauteurDefaut}>
                      {hauteurLabel(mm)}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="cfg-champ">
              <p class="cfg-label" id="cfg-finition-label">Finition des lettres</p>
              <div class="cfg-finitions" role="group" aria-labelledby="cfg-finition-label">
                {
                  finitions.map((finition) => (
                    <button
                      type="button"
                      class="cfg-finition"
                      data-finition={finition.id}
                      data-couleur={finition.couleurApercu}
                      aria-pressed={finition.id === FINITION_APERCU_DEFAUT ? "true" : "false"}
                    >
                      <span
                        class="cfg-finition-teinte"
                        style={`background-color: ${finition.couleurApercu};`}
                        aria-hidden="true"></span>
                      <span>{finition.nom}</span>
                    </button>
                  ))
                }
              </div>
              <p class="cfg-aide" data-finition-aide>
                {finitions.find((finition) => finition.id === FINITION_APERCU_DEFAUT)?.aide}
              </p>
            </div>

            {/* Recentrer n a de sens qu avec le canvas : sans JavaScript, le
                bouton reste cache (regle `.cfg-bouton[hidden]` du bloc de style
                ci-dessous). Il recentre la zone active horizontalement. */}
            <button type="button" class="cfg-bouton" data-recentrer hidden>
              Recentrer le texte
            </button>
          </div>
        </section>

        {/* ------------------------------------------------------ 3 Les motifs */}
        <section class="cfg-etape" aria-labelledby="etape-motifs">
          <h2 class="cfg-etape-titre" id="etape-motifs">
            <span class="cfg-numero mono" aria-hidden="true">3</span> Les motifs
          </h2>
          <p class="cfg-aide">
            Facultatif. Un motif est gravé dans la même finition que les lettres. Choisissez-en un :
            il se pose sur la stèle, et vous le déplacez où vous voulez.
          </p>

          {/* Sans JavaScript, aucune pastille n est allumee et les quatre
              familles restent affichees a la suite, chacune sous son titre : la
              liste des motifs se lit en entier. Le script allume la premiere
              pastille et n affiche plus qu une famille a la fois. */}
          <div class="cfg-familles" role="group" aria-label="Familles de motifs">
            {
              groupesMotifs.map(({ famille }) => (
                <button
                  type="button"
                  class="cfg-famille"
                  data-famille-motifs={famille.id}
                  aria-pressed="false"
                >
                  {famille.nom}
                </button>
              ))
            }
          </div>

          {
            groupesMotifs.map(({ famille, motifs }) => (
              <div class="cfg-groupe" data-groupe-motifs={famille.id}>
                <h3 class="cfg-groupe-titre mono" data-groupe-titre>
                  {famille.nom}
                </h3>

                <div class="cfg-motifs">
                  {motifs.map((motif) => (
                    <button
                      type="button"
                      class="cfg-motif"
                      data-motif={motif.id}
                      data-nom={motif.nom}
                    >
                      <span class="cfg-motif-vue" set:html={svgMotif(motif.id)} />
                      <span class="cfg-motif-nom">{motif.nom}</span>
                    </button>
                  ))}

                  {/* Le sur demande, dans chaque famille : c est la reponse a
                      tout ce que la base ne contient pas (section 5 de
                      docs/MOTIFS-BIBLIOTHEQUE.md). L icone est un crayon
                      dessine a la main, deux traits, aucune police d icones. */}
                  <button
                    type="button"
                    class="cfg-motif cfg-motif-demande"
                    aria-pressed="false"
                    data-motif-demande
                  >
                    <span class="cfg-motif-vue" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        focusable="false"
                      >
                        <path d="M4 20l4.2-1.1L20.2 6.9a1.6 1.6 0 0 0 0-2.3l-1.8-1.8a1.6 1.6 0 0 0-2.3 0L4.1 14.8 3 19l1 1z" />
                        <path d="M14.8 4.6l4.6 4.6" />
                      </svg>
                    </span>
                    <span class="cfg-motif-nom">Un motif à vous</span>
                    <span class="cfg-motif-sous">
                      Décrivez-le ou envoyez une image, nous le dessinons
                    </span>
                  </button>
                </div>
              </div>
            ))
          }

          {/* LE MOTIF SUR DEMANDE. Le bloc n apparait qu une fois le cadre
              pose sur la stele (le script leve `hidden`) : sans cadre, il n y
              a rien a decrire. La description et le fichier vivent dans l etat
              du configurateur ; rien n est envoye ici (l envoi est la passe E,
              et il suivra les regles de `docs/devis-contrat.md`). */}
          <div class="cfg-demande" data-bloc-demande hidden>
            <p class="cfg-label">Votre motif à créer</p>
            <p class="cfg-aide">
              Le cadre en pointillés sur la stèle montre où il sera gravé, et à quelle taille.
            </p>

            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-demande-texte">Décrivez votre idée</label>
              <p class="cfg-aide" id="cfg-demande-aide">
                Par exemple : « une branche de sapin penchée, comme ceux du jardin », ou le dessin
                d'une passion.
              </p>
              <textarea
                class="cfg-textarea"
                id="cfg-demande-texte"
                rows="3"
                maxlength={DESCRIPTION_MAX}
                aria-describedby="cfg-demande-aide cfg-demande-compteur"
                data-demande-description></textarea>
              <p class="cfg-compteur mono" id="cfg-demande-compteur">
                <span data-demande-compteur>0</span> / {DESCRIPTION_MAX} caractères
              </p>
            </div>

            <div class="cfg-champ">
              <label class="cfg-label" for="cfg-demande-fichier">
                Une photo, un dessin, un logo (facultatif)
              </label>
              <input
                class="cfg-fichier"
                id="cfg-demande-fichier"
                type="file"
                accept={FICHIER_EXTENSIONS}
                aria-describedby="cfg-demande-fichier-aide"
                data-demande-fichier
              />
              <p class="cfg-aide" id="cfg-demande-fichier-aide">
                JPEG, PNG, PDF ou SVG, 8 Mo au maximum.
              </p>
              {/* Les deux messages restent dans la page, vides : un `role="alert"`
                  pose au moment de l erreur n est pas toujours annonce, alors
                  qu un conteneur deja la l est des qu il se remplit. La regle
                  `:empty` du bloc de style les cache tant qu ils sont vides. */}
              <p class="cfg-aide cfg-demande-nom" data-demande-fichier-nom></p>
              <p class="cfg-erreur" role="alert" data-demande-fichier-erreur></p>
            </div>

            <p class="cfg-aide">
              Nous vous proposons un dessin avec le devis ; rien n'est gravé sans votre accord.
            </p>

            <button type="button" class="cfg-bouton" data-demande-retirer>Retirer ce motif</button>
          </div>

          {/* Les motifs poses. Les lignes sont ecrites par le script : sans
              JavaScript rien ne se pose, donc la liste reste vide et sa phrase
              d attente suffit. */}
          <div class="cfg-poses">
            <p class="cfg-label" id="cfg-poses-label">Sur votre stèle</p>
            <ul class="cfg-poses-liste" aria-labelledby="cfg-poses-label" data-liste-motifs></ul>
            <p class="cfg-aide" data-motifs-vide>Aucun motif pour l'instant, c'est facultatif.</p>
            <p class="cfg-aide" data-motifs-plein hidden>
              {MAX_MOTIFS} motifs au maximum sur une stèle. Retirez-en un pour en ajouter un autre.
            </p>
          </div>

          <p class="cfg-aide">
            Déplacez le motif sur la stèle ; les coins permettent de le redimensionner.
          </p>
        </section>

        {/* ------------------------------------------------------- 4 Le devis */}
        <section class="cfg-etape" aria-labelledby="etape-devis">
          <h2 class="cfg-etape-titre" id="etape-devis">
            <span class="cfg-numero mono" aria-hidden="true">4</span> Votre devis
          </h2>
          <p class="cfg-prix mono">Prix indicatif : {prix}</p>
          {prixProvisoire && <p class="cfg-aide">{MENTION_PRIX_PROVISOIRE}</p>}
          <p class="cfg-aide">
            La gravure, la pose au cimetière et les démarches sont comprises dans le devis.
          </p>
          <a href="/devis/" class="btn btn-primary cfg-devis">Demander un devis</a>
          <p class="cfg-aide">
            <a href={urlFiche} class="link">Revenir à la fiche {product.name}</a>
          </p>
        </section>
      </div>
    </div>
  </main>

  {/* Tout l habillage de cette page est ICI, en CSS de page, et non en classes
      utilitaires Tailwind : la feuille Tailwind est UNIQUE et partagee par
      toutes les pages du site, donc une classe inedite utilisee ici
      alourdirait les 24 autres pages. Les couleurs sont les jetons existants
      du theme (`src/styles.css`) ; le seul ajout est `--cfg-accent`, un bronze
      mat local a cette page, demande par la direction design des maquettes. Il
      ne porte jamais de petit texte : bordures, pastilles et reperes
      seulement. */}
  <style>
    .cfg {
      --cfg-accent: #8a6a3c;
      padding-bottom: 5rem;
    }

    [hidden] {
      display: none;
    }

    .cfg-fil {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-block: 1.5rem;
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .cfg-fil [aria-current] {
      color: var(--ink);
    }

    .cfg-titre {
      margin-top: 0.75rem;
    }

    .cfg-chapeau {
      margin-top: 1.25rem;
      max-width: 52ch;
    }

    .cfg-grille {
      display: grid;
      gap: 2.5rem;
      align-items: start;
      margin-top: 2.5rem;
      border-top: 1px solid var(--line);
      padding-top: 2rem;
    }

    /* L apercu reste visible pendant la saisie. Sur telephone il se colle sous
       l en-tete, en hauteur reduite : sans cela, la famille tape son texte sans
       voir l effet (adaptation 8 de la direction design). */
    .cfg-colle {
      position: sticky;
      top: 4.5rem;
      z-index: 1;
      background: var(--canvas);
      padding-bottom: 0.75rem;
    }

    .cfg-cadre {
      position: relative;
      overflow: hidden;
      width: 100%;
      margin-inline: auto;
      background: var(--surface);
    }

    /* Sur telephone, l apercu colle en haut ne doit pas manger l ecran pendant
       la saisie : sa hauteur est plafonnee a un tiers du viewport. On borne la
       LARGEUR (hauteur x rapport de la vue), jamais la hauteur : un
       `aspect-ratio` et une hauteur imposee se contrediraient, et le cadrage de
       la stele, calcule en pourcentages de la largeur, serait faux. */
    @media (max-width: 63.999rem) {
      .cfg-cadre {
        max-width: calc(34vh * var(--cfg-ratio));
      }

      /* Pour que le collage fonctionne, le bloc colle doit avoir un parent
         plus haut que lui : sur telephone la grille redevient un simple flux
         et la colonne apercu disparait (display: contents), le parent est
         alors toute la grille, choix compris. */
      .cfg-grille {
        display: block;
      }

      .cfg-apercu-col {
        display: contents;
      }
    }

    @media (min-width: 64rem) {
      .cfg-grille {
        grid-template-columns: 7fr 5fr;
        gap: 3rem;
      }

      .cfg-colle {
        top: 7rem;
      }

      /* Sur grand ecran la colonne apercu s etire sur toute la hauteur de la
         ligne : le bloc colle peut alors suivre les choix en defilant. */
      .cfg-apercu-col {
        align-self: stretch;
      }
    }

    .cfg-statique,
    .cfg-canvas {
      position: absolute;
      inset: 0;
    }

    .cfg-statique img {
      position: absolute;
      top: 0;
      left: 0;
      height: auto;
      max-width: none;
      transform-origin: top left;
    }

    .cfg-legende {
      margin-top: 0.625rem;
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .cfg-legende span {
      color: var(--ink);
    }

    .cfg-mention {
      margin-top: 1rem;
      max-width: 60ch;
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--muted);
    }

    .cfg-choix {
      display: grid;
      gap: 2.5rem;
    }

    .cfg-etape {
      border-top: 1px solid var(--line);
      padding-top: 1.5rem;
    }

    .cfg-etape-titre {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      font-size: 1.375rem;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .cfg-numero {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      flex: none;
      border: 1px solid var(--cfg-accent);
      border-radius: 999px;
      font-size: 0.875rem;
      color: var(--ink);
    }

    .cfg-aide {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--muted);
    }

    .cfg-champ {
      margin-top: 1.5rem;
    }

    .cfg-label {
      display: block;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink);
    }

    .cfg-textarea,
    .cfg-select {
      display: block;
      width: 100%;
      margin-top: 0.625rem;
      padding: 0.75rem 0.875rem;
      min-height: 3rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-size: 1rem;
      color: var(--ink);
    }

    .cfg-textarea {
      line-height: 1.5;
      resize: vertical;
    }

    .cfg-textarea:focus-visible,
    .cfg-select:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 1px;
      border-color: var(--ink);
    }

    .cfg-compteur {
      margin-top: 0.5rem;
      font-size: 0.875rem;
      color: var(--muted);
    }

    /* Vide, une aide ne doit pas laisser sa marge derriere elle : c est le cas
       du message « 4 lignes au plus » tant que rien n est bloque. */
    .cfg-aide:empty {
      display: none;
    }

    /* ------------------------------------------- Les zones de texte (C2) */

    .cfg-zones {
      margin-top: 1.25rem;
    }

    .cfg-onglets {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* 48 px de haut, et jamais la couleur seule : la zone active porte une
       bordure epaisse bronze et un fond teinte. */
    .cfg-onglet {
      min-height: 3rem;
      padding: 0.5rem 1.125rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-size: 0.9375rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-onglet:hover {
      border-color: var(--ink);
    }

    .cfg-onglet:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-onglet[aria-selected="true"] {
      border-width: 2px;
      border-color: var(--cfg-accent);
      background: var(--surface);
      font-weight: 500;
    }

    .cfg-zones-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    /* Les deux boutons sont dans une rangee : la marge haute du bouton seul
       n a plus de sens ici. */
    .cfg-zones-actions .cfg-bouton {
      margin-top: 0;
      font-size: 0.9375rem;
    }

    .cfg-pastilles {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    /* 48 px au moins, et jamais la couleur seule : la matiere choisie porte une
       bordure epaisse et son nom passe en anthracite. */
    .cfg-pastille {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
      width: 4.5rem;
      padding: 0.25rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      cursor: pointer;
    }

    .cfg-pastille img {
      display: block;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 999px;
      object-fit: cover;
    }

    .cfg-pastille-nom {
      font-size: 0.75rem;
      line-height: 1.2;
      text-align: center;
      color: var(--muted);
    }

    .cfg-pastille:hover {
      border-color: var(--ink);
    }

    .cfg-pastille:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-pastille[aria-pressed="true"] {
      border-width: 2px;
      border-color: var(--cfg-accent);
      background: var(--surface);
    }

    .cfg-pastille[aria-pressed="true"] .cfg-pastille-nom {
      color: var(--ink);
      font-weight: 500;
    }

    .cfg-finitions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    .cfg-finition {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-height: 3rem;
      padding: 0.5rem 0.875rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font-size: 1rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-finition-teinte {
      display: block;
      width: 1.25rem;
      height: 1.25rem;
      flex: none;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
    }

    .cfg-finition:hover {
      border-color: var(--ink);
    }

    .cfg-finition:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-finition[aria-pressed="true"] {
      border-width: 2px;
      border-color: var(--cfg-accent);
      background: var(--surface);
      font-weight: 500;
    }

    /* ------------------------------------------------------------- Motifs */

    .cfg-familles {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }

    .cfg-famille {
      min-height: 3rem;
      padding: 0.5rem 1rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: var(--canvas);
      font-size: 0.9375rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-famille:hover {
      border-color: var(--ink);
    }

    .cfg-famille:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-famille[aria-pressed="true"] {
      border-width: 2px;
      border-color: var(--cfg-accent);
      background: var(--surface);
      font-weight: 500;
    }

    .cfg-groupe {
      margin-top: 1.5rem;
    }

    .cfg-groupe-titre {
      font-size: 0.8125rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .cfg-motifs {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr));
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    /* Une carte fait au moins 48 px de haut, et le SVG tient dans un carre au
       fond neutre : le dessin est monochrome en anthracite, donc la couleur
       vient du CSS (`fill="currentColor"` dans le SVG inline). */
    .cfg-motif {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
      min-height: 3rem;
      padding: 0.375rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      cursor: pointer;
    }

    .cfg-motif-vue {
      display: grid;
      place-items: center;
      width: 100%;
      aspect-ratio: 1;
      padding: 0.5rem;
      border-radius: 2px;
      background: var(--surface);
      color: var(--ink);
    }

    .cfg-motif-vue svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    .cfg-motif-nom {
      font-size: 0.8125rem;
      line-height: 1.25;
      text-align: center;
      color: var(--ink);
    }

    .cfg-motif-sous {
      font-size: 0.75rem;
      line-height: 1.3;
      text-align: center;
      color: var(--muted);
    }

    /* La carte du sur demande porte une phrase : elle prend deux colonnes
       plutot que de casser la grille en mots coupes. */
    .cfg-motif-demande {
      grid-column: span 2;
      border-style: dashed;
      border-color: var(--cfg-accent);
    }

    /* Sur deux colonnes, la vue carree deviendrait enorme : on la borne, et le
       crayon reste petit (c est un pictogramme, pas un motif). */
    .cfg-motif-demande .cfg-motif-vue {
      aspect-ratio: auto;
      height: 4.5rem;
    }

    .cfg-motif-demande .cfg-motif-vue svg {
      width: 2.5rem;
      height: 2.5rem;
    }

    .cfg-motif:hover {
      border-color: var(--ink);
    }

    .cfg-motif:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    /* Un cadre « Motif a creer » est pose : la carte le dit (le pointille seul
       ne distingue pas l etat actif de l etat au repos). */
    .cfg-motif[aria-pressed="true"] {
      border-width: 2px;
      border-color: var(--cfg-accent);
      background: var(--surface);
    }

    .cfg-motif[aria-pressed="true"] .cfg-motif-nom {
      font-weight: 500;
    }

    /* ----------------------------------------- Le motif sur demande (C1) */

    .cfg-demande {
      margin-top: 1.5rem;
      padding: 1rem 1rem 1.25rem;
      border: 1px dashed var(--cfg-accent);
      border-radius: 3px;
      background: var(--surface);
    }

    .cfg-demande .cfg-champ:first-of-type {
      margin-top: 1rem;
    }

    .cfg-fichier {
      display: block;
      width: 100%;
      margin-top: 0.625rem;
      padding: 0.75rem 0.875rem;
      min-height: 3rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font: inherit;
      font-size: 1rem;
      color: var(--ink);
    }

    .cfg-fichier:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 1px;
      border-color: var(--ink);
    }

    .cfg-erreur {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.55;
      /* Le meme brun d erreur que /devis/ (6,4:1 sur le fond du site : au-dela
         des 4,5:1 demandes). Le theme n en fait pas un jeton, d ou la valeur. */
      color: #8d3c33;
    }

    /* Vides, ces deux messages ne doivent pas laisser leur marge derriere eux. */
    .cfg-erreur:empty,
    .cfg-demande-nom:empty {
      display: none;
    }

    .cfg-demande-nom {
      color: var(--ink);
    }

    .cfg-poses {
      margin-top: 1.75rem;
    }

    .cfg-poses-liste {
      display: grid;
      gap: 0.625rem;
      margin: 0.75rem 0 0;
      padding: 0;
      list-style: none;
    }

    .cfg-poses-liste:empty {
      display: none;
    }

    :global(.cfg-pose) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      padding: 0.625rem 0.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
    }

    /* Les lignes sont creees par le script, donc hors de la portee des styles
       scopes d Astro : d ou :global(). Le bouton "choisir" est la ligne
       elle-meme, sans habillage de bouton. */
    :global(.cfg-pose-choisir) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      min-height: 3rem;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      text-align: left;
      color: inherit;
      cursor: pointer;
    }

    :global(.cfg-pose-choisir:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    :global(.cfg-pose[aria-current="true"]) {
      border-width: 2px;
      border-color: var(--cfg-accent);
      background: var(--surface);
    }

    :global(.cfg-pose-nom) {
      font-size: 1rem;
      color: var(--ink);
    }

    :global(.cfg-pose-taille) {
      font-size: 0.875rem;
      color: var(--muted);
    }

    :global(.cfg-pose-actions) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-left: auto;
    }

    :global(.cfg-pose-bouton) {
      min-height: 3rem;
      padding: 0.375rem 0.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font-size: 0.875rem;
      color: var(--ink);
      cursor: pointer;
    }

    :global(.cfg-pose-bouton:hover:not(:disabled)) {
      border-color: var(--ink);
    }

    :global(.cfg-pose-bouton:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    :global(.cfg-pose-bouton:disabled) {
      color: var(--muted);
      cursor: default;
    }

    :global(.cfg-pose-bouton[aria-pressed="true"]) {
      border-width: 2px;
      border-color: var(--cfg-accent);
      background: var(--surface);
    }

    .cfg-bouton {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      margin-top: 1.5rem;
      padding: 0.625rem 1.25rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      background: var(--canvas);
      font-size: 1rem;
      color: var(--ink);
      cursor: pointer;
    }

    .cfg-bouton:hover {
      border-color: var(--ink);
    }

    .cfg-bouton:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .cfg-bouton:disabled {
      border-color: var(--line);
      color: var(--muted);
      cursor: default;
    }

    /* `[hidden]` (regle en tete de ce bloc) et `.cfg-bouton` ont la MEME
       specificite : sans cette regle, placee APRES, le `display` du bouton
       gagnerait par l ordre d ecriture et un bouton `hidden` resterait visible.
       A RETENIR : toute classe de ce bloc qui declare `display` doit prevoir
       son `[hidden]`. */
    .cfg-bouton[hidden] {
      display: none;
    }

    .cfg-prix {
      margin-top: 1rem;
      font-size: 1.125rem;
      color: var(--ink);
    }

    .cfg-devis {
      display: flex;
      width: 100%;
      min-height: 3.25rem;
      margin-top: 1.5rem;
    }
  </style>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />

  {/* La configuration du canvas, lue par `src/scripts/configurateur/index.ts`.
      Un bloc de donnees, pas du code : `type="application/json"`. */}
  <script
    is:inline
    type="application/json"
    data-donnees-configurateur
    set:html={JSON.stringify(donneesConfigurateur)}
  />

  {/* L ILOT KONVA. Ce `<script>` est compile et minifie par Astro (contrairement
      a un `is:inline`), et Konva arrive par IMPORT DYNAMIQUE depuis
      `index.ts` : il part dans son propre fichier, demande par cette page
      seulement, apres les polices de gravure. Aucune autre page du site ne le
      telecharge. Si quoi que ce soit echoue, la page reste celle de la passe A :
      l apercu statique n est masque qu une fois le canvas dessine. */}
  <script>
    import { demarre } from "@/scripts/configurateur";

    demarre().catch((erreur) => {
      console.error("Configurateur indisponible, apercu statique conserve :", erreur);
    });
  </script>
</BaseLayout>
