---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MentionVerification from "@/components/MentionVerification.astro";
import BarreRecherche from "@/components/hub/BarreRecherche.astro";
import ListeCimetieres from "@/components/hub/ListeCimetieres.astro";
import ListeCommunes from "@/components/hub/ListeCommunes.astro";
import Repli from "@/components/hub/Repli.astro";
import { pageTitle } from "@/config/site";
import { LOI_CANTONALE, SOURCES } from "@/data/cimetieres-ne";
import {
  CIMETIERES,
  CIMETIERES_URL,
  COMMUNES_NE,
  VERIFIE_LE,
  mentionVerification,
} from "@/data/cimetieres";
import { guideUrl } from "@/data/guides";
import { FAMILLE_LABELS, familleUrl } from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";

/* Hub des pages cimetiere, version 2 (10.11.2026). Deux contenus, les memes
   qu avant : les neuf pages ecrites, et le releve des 24 communes du canton
   (src/data/cimetieres.ts, releve du 28.10.2026).

   CE QUI CHANGE PAR RAPPORT A LA V1
   - Entree compacte : le titre, le chapo et, tout de suite a cote, un champ
     qui filtre les neuf pages ET les vingt-six lignes du releve. Les trente-
     cinq entrees restent dans le HTML servi et visibles sans JavaScript ; la
     recherche ne fait que masquer. Elle ne connait que les noms ecrits dans
     les donnees : aucune geographie ajoutee, aucune carte.
   - Le releve des communes n est plus ecrit DEUX FOIS (un tableau de sept
     colonnes sur ordinateur, vingt-six cartes sur telephone) : un seul
     balisage, vingt-six panneaux depliables natifs, chaque fait une seule
     fois. Voir src/components/hub/ListeCommunes.astro.
   - Les constantes, les questions frequentes et les documents officiels se
     lisent en panneaux depliables, du meme dessin que ceux des neuf fiches.
   - L appel final est une bande sombre collee au pied de page.

   SEO : meme titre, meme description, meme canonique, meme h1, meme FAQPage,
   meme fil d Ariane, memes liens, et l ancre #communes est conservee. Les
   seuls ecarts de texte sont d habillage, listes dans
   docs/UX-HUB-CIMETIERES.md.

   Rien ici qui ne figure pas dans docs/DIMENSIONS-MONUMENTS.md,
   docs/REGLEMENTS-CIMETIERES-NE.md ou docs/CIMETIERES-PRATIQUE.md. */

const origin = Astro.site ?? new URL(Astro.url.origin);

interface Question {
  question: string;
  reponse: string;
}

const questions: Question[] = [
  {
    question: "Quelle est la taille maximale d'une pierre tombale dans le canton de Neuchâtel ?",
    reponse:
      "Il n'y a pas de réponse cantonale : chaque commune fixe ses dimensions. Dans les 24 communes relevées, aucune tombe d'adulte publiée ne dépasse 80 cm de large ni 180 cm de long, et les hauteurs connues vont de 110 cm au Locle à 160 cm à Corcelles-Cormondrèche et à Valangin. La valeur la plus fréquente est 120 cm. À Beauregard, le monument suit des gabarits communaux : stèle de 70 cm de large sur 120 cm de haut au plus.",
  },
  {
    question: "Faut-il une autorisation pour poser un monument funéraire ?",
    reponse:
      "Presque partout, oui. La Ville de Neuchâtel délivre un permis de pose après avoir approuvé les plans (art. 39) ; La Chaux-de-Fonds demande une autorisation écrite et, pour une tombe cinéraire, un plan au 1:10 (art. 54) ; plusieurs communes exigent l'autorisation écrite du Conseil communal. C'est l'entreprise qui dépose la demande, et à Neuchâtel elle répond seule de la conformité du monument (art. 40).",
  },
  {
    question: "Quel délai faut-il attendre avant de poser une pierre tombale ?",
    reponse:
      "De quatre mois à quinze mois selon la commune : quatre mois à Laténa, six mois à La Chaux-de-Fonds, à Boudry et dans plusieurs communes, un an dans les quatre cimetières de la Ville de Neuchâtel, douze mois à Cortaillod, quinze mois au Val-de-Travers. Le Locle et Rochefort attendent que le terrain soit stabilisé. La Chaux-de-Fonds est la seule commune relevée qui interdit la pose en hiver, du 1er novembre au 30 avril.",
  },
  {
    question: "Qui vérifie que le monument respecte les dimensions du cimetière ?",
    reponse:
      "L'entreprise qui pose le monument. À Neuchâtel, un monument non conforme est enlevé à ses frais (art. 40) ; à La Chaux-de-Fonds, il est enlevé après trois mois (art. 60). Nous lisons le règlement du cimetière concerné, nous adaptons le monument aux dimensions autorisées et nous déposons la demande de pose.",
  },
  {
    question: "Les règles sont-elles les mêmes dans toute la Suisse ?",
    reponse:
      "Non. Il n'existe pas de norme fédérale sur la taille d'un monument funéraire. Les cantons légifèrent sur les sépultures et les communes fixent les règles des monuments. Dans le canton de Neuchâtel, la loi sur les sépultures admet les monuments « sous réserve des conditions que pourront déterminer les autorités communales » (art. 9) et fixe la réouverture des fosses à trente ans au moins (art. 6).",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.reponse },
  })),
};

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: "Cimetières", path: CIMETIERES_URL },
  ],
  origin,
);

/** Les constantes du canton (point 2 de docs/DIMENSIONS-MONUMENTS.md). */
const constantes: string[] = [
  "La réouverture des fosses a lieu après trente ans au moins (loi cantonale, art. 6). Des communes vont plus loin : quarante ans à Neuchâtel, soixante ans au Locle et pour le massif de longue durée de La Chaux-de-Fonds.",
  "Le monument est enlevé à la réouverture de la tombe, et la famille dispose d'un délai pour le reprendre : de deux à douze mois selon la commune.",
  "La tombe doit être nivelée avant la pose, et les fondations proportionnées au poids du monument.",
  "La pose se fait selon les indications du jardinier ou du personnel communal.",
  "Le numéro du jalon, ou du piquet, doit rester visible : il est interdit de l'enlever.",
  "La publicité est interdite dans le cimetière et aux abords : aucun nom d'entreprise n'est apposé sur un monument là où le règlement l'exclut.",
  "Un monument non conforme est enlevé après deux ou trois mois, aux frais de l'entreprise qui l'a posé.",
  "Une taxe communale de pose n'existe que dans trois communes : Neuchâtel (CHF 60.- par mètre de pourtour augmenté de la hauteur), La Chaux-de-Fonds (CHF 50.-) et Le Locle (CHF 200.- pour la pose sur le sommier communal).",
];

/* Les nombres annonces sont comptes dans les donnees, jamais ecrits a la main :
   le releve a plus de lignes que de communes (Neuchâtel en occupe trois), et
   nous avons moins de pages que de communes. La phrase du compteur le dit. */
const nombreCommunes = new Set(COMMUNES_NE.map((commune) => commune.commune)).size;
const nombreSources = Object.keys(SOURCES).length;
const compteParDefaut =
  `${CIMETIERES.length} pages de cimetière écrites, et ${COMMUNES_NE.length} lignes de ` +
  `relevé qui couvrent les ${nombreCommunes} communes du canton.`;

const videPages =
  "Nous n'avons pas encore de page pour ce nom. Les règles de la commune " +
  "peuvent se trouver dans les lignes du relevé, juste en dessous.";
const videCommunes =
  "Aucune ligne du relevé ne porte ce nom. Essayez le nom de la commune " +
  "plutôt que celui du village, vérifiez l'orthographe, ou demandez-nous : " +
  "nous lisons le règlement du cimetière concerné avant toute pose.";
---

<BaseLayout
  title={pageTitle("Cimetières du canton de Neuchâtel : tombes et règles de pose")}
  description="Les règles des cimetières neuchâtelois, commune par commune : délai avant la pose, dimensions d'une tombe d'adulte, hauteur, bordure et autorisation."
  footerJoint
>
  <main id="main-content">
    {/* ------------------------------------------------- Entree et recherche */}
    <section class="shell hub-hero">
      <div class="hub-hero-grille">
        <div class="hub-hero-titre" data-entree>
          <span class="hub-hero-trait" aria-hidden="true" data-hero-trait></span>
          <p class="label">Informations</p>
          <h1 class="type-h1 hub-hero-h1">
            Cimetières du canton de Neuchâtel : dimensions des tombes et règles de pose
          </h1>
        </div>

        <div class="hub-hero-outil" data-entree data-entree-decalage="60">
          <BarreRecherche id="recherche-cimetiere" compteParDefaut={compteParDefaut} />
        </div>

        <div class="hub-hero-texte" data-entree data-entree-decalage="120">
          <p class="type-lead">
            Il n'existe aucune règle nationale sur la taille d'un monument funéraire : c'est la commune qui
            décide, parfois cimetière par cimetière. La {LOI_CANTONALE} se borne à admettre les monuments
            « sous réserve des conditions que pourront déterminer les autorités communales » (art. 9) et à
            fixer la réouverture des fosses à trente ans au moins (art. 6).
          </p>
          <p class="type-body hub-hero-note">
            Nous avons relevé les règlements des 24 communes du canton. Voici ce qu'ils autorisent, avec
            l'article et le document officiel pour chaque commune.
          </p>
        </div>

        <div class="hub-hero-mention" data-entree data-entree-decalage="120">
          <MentionVerification texte={mentionVerification(VERIFIE_LE)} />
        </div>
      </div>
    </section>

    {/* --------------------------------------------------- Pages cimetiere */}
    <div class="shell">
      <ListeCimetieres fiches={CIMETIERES} texteVide={videPages}>
        <Fragment slot="note">
          D'autres cimetières du canton auront leur page. En attendant, la liste ci-dessous donne les règles
          relevées pour chaque commune, et nous répondons volontiers par téléphone ou par le devis.
        </Fragment>
      </ListeCimetieres>

      {/* ------------------------------------------------ Releve du canton */}
      <ListeCommunes communes={COMMUNES_NE} fiches={CIMETIERES} texteVide={videCommunes} />

      {/* -------------------------------------------- Constantes du canton */}
      <section class="hub-section" data-entree aria-labelledby="hub-constantes-titre">
        <div class="rule"></div>
        <h2 class="type-h2 hub-section-titre" id="hub-constantes-titre">Les constantes du canton</h2>
        <p class="type-body hub-section-chapo">
          Ce qui revient dans presque tous les règlements relevés, quelle que soit la commune.
        </p>
        <div class="hub-replis">
          <Repli titre={`Les ${constantes.length} constantes relevées`} niveau="h3">
            <ul class="hub-puces">
              {constantes.map((ligne) => <li>{ligne}</li>)}
            </ul>
          </Repli>
          <Repli titre="Une contradiction relevée avec la loi cantonale" niveau="h3">
            <p>
              Deux communes, Cornaux et Cressier, écrivent « vingt ans au moins » pour la réouverture des fosses,
              en contradiction avec la loi cantonale qui en demande trente : nous le faisons confirmer par la
              commune avant toute commande.
            </p>
          </Repli>
        </div>
      </section>

      {/* ------------------------------------------------------------- FAQ */}
      <section class="hub-section" data-entree aria-labelledby="hub-faq-titre">
        <div class="rule"></div>
        <h2 class="type-h2 hub-section-titre" id="hub-faq-titre">Questions fréquentes</h2>
        <div class="hub-replis">
          {
            questions.map((item, index) => (
              <Repli titre={item.question} niveau="h3" ouvert={index === 0}>
                <p>{item.reponse}</p>
              </Repli>
            ))
          }
        </div>
      </section>

      {/* --------------------------------------------- Documents officiels */}
      <section class="hub-section" data-entree aria-labelledby="hub-sources-titre">
        <div class="rule"></div>
        <h2 class="type-h2 hub-section-titre" id="hub-sources-titre">Documents officiels</h2>
        <div class="hub-replis">
          <Repli titre={`Les ${nombreSources} documents consultables en ligne`} niveau="h3">
            <ul class="hub-sources">
              {
                Object.entries(SOURCES).map(([, source]) => (
                  <li>
                    <a href={source.url} class="link link-mono text-muted" rel="noopener">
                      {source.libelle}
                    </a>
                  </li>
                ))
              }
            </ul>
          </Repli>
        </div>
        <p class="type-body hub-section-note">
          Les règlements des autres communes ne sont pas tous en ligne : leur nom et leur date figurent dans
          la liste ci-dessus.
        </p>
      </section>

      {/* --------------------------------------------------- A lire ensuite */}
      <section class="hub-section" data-entree aria-labelledby="hub-suite-titre">
        <div class="rule"></div>
        <h2 class="type-h2 hub-section-titre" id="hub-suite-titre">À lire ensuite</h2>
        <ul class="hub-suite">
          <li>
            <a href={guideUrl("quand-poser-une-pierre-tombale")} class="link type-h3 hub-suite-titre">
              Quand poser une pierre tombale
            </a>
            <p class="type-body hub-suite-texte">
              Le délai commune par commune, les périodes où la pose est interdite, les autorisations et les
              taxes communales.
            </p>
          </li>
          <li>
            <a href={guideUrl("columbarium-cavurne-jardin-du-souvenir")} class="link type-h3 hub-suite-titre">
              Columbarium, cavurne et jardin du souvenir
            </a>
            <p class="type-body hub-suite-texte">
              Ce que recouvre chaque mot, ce que propose chaque commune, les durées et les tarifs officiels.
            </p>
          </li>
        </ul>
      </section>
    </div>

    {/* ------------------------------------------------------------- Appel */}
    <section class="nuit hub-appel" data-entree aria-labelledby="hub-appel-titre">
      <div class="shell hub-appel-grille">
        <div>
          <h2 class="type-h2 hub-appel-titre" id="hub-appel-titre">Votre cimetière, votre monument</h2>
          <p class="type-body hub-appel-texte">
            Donnez-nous la commune, le nom du cimetière et le type de sépulture : nous vérifions le
            règlement, nous réalisons le monument sur mesure aux dimensions autorisées, nous déposons la
            demande de pose et nous établissons un devis gratuit.
          </p>
        </div>
        <div class="hub-appel-actions">
          <a href="/devis/" class="btn btn-primary">Demander un devis</a>
          <a href={familleUrl("monument")} class="btn btn-outline">{FAMILLE_LABELS.monument}</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />
</BaseLayout>

<style>
  /* ------------------------------------------------- Entree et recherche
     Deux colonnes des 64rem : le titre et le texte a gauche, la recherche a
     droite sur toute la hauteur. Sur telephone, la recherche passe JUSTE
     apres le titre : c est la premiere chose a portee de pouce, le chapo se
     lit ensuite. Aucune hauteur forcee, aucun 100vh. */
  .hub-hero {
    padding-top: 2.5rem;
    padding-bottom: 1rem;
  }
  .hub-hero-grille {
    display: grid;
    gap: 2rem;
    grid-template-areas:
      "titre"
      "outil"
      "texte"
      "mention";
  }
  .hub-hero-titre {
    grid-area: titre;
  }
  .hub-hero-outil {
    grid-area: outil;
  }
  .hub-hero-texte {
    grid-area: texte;
  }
  .hub-hero-mention {
    grid-area: mention;
  }
  /* Le seul trace decoratif de la page, comme sur les neuf fiches. */
  .hub-hero-trait {
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: 1.25rem;
    background: var(--accent);
    transform-origin: left center;
  }
  .hub-hero-h1 {
    margin-top: 1rem;
    max-width: 26ch;
  }
  .hub-hero-texte .type-lead {
    max-width: 58ch;
  }
  .hub-hero-note {
    margin-top: 1.25rem;
    max-width: 58ch;
    font-size: 1rem;
  }

  /* ------------------------------------------------- Sections de la suite */
  .hub-section {
    margin-top: 4rem;
  }
  .hub-section-titre {
    margin-top: 2rem;
    max-width: 24ch;
  }
  .hub-section-chapo {
    margin-top: 1.5rem;
    max-width: 62ch;
  }
  .hub-section-note {
    margin-top: 1.75rem;
    max-width: 62ch;
    font-size: 1rem;
  }
  .hub-replis {
    margin-top: 2rem;
  }
  /* Les constantes : une liste a puces dans son panneau. */
  .hub-puces {
    max-width: 70ch;
    list-style: none;
  }
  .hub-puces li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .hub-puces li + li {
    margin-top: 0.875rem;
  }
  .hub-puces li::before {
    content: "";
    position: absolute;
    top: 0.85em;
    left: 0;
    width: 0.75rem;
    height: 1px;
    background: var(--accent);
  }
  .hub-sources {
    list-style: none;
  }
  .hub-sources li + li {
    margin-top: 0.625rem;
  }

  /* --------------------------------------------------------- A lire ensuite */
  .hub-suite {
    margin-top: 2rem;
    display: grid;
    gap: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .hub-suite > li {
    border-bottom: 1px solid var(--line);
    padding-block: 1.75rem;
  }
  .hub-suite-titre {
    font-size: 1.5rem;
  }
  .hub-suite-texte {
    margin-top: 0.75rem;
    max-width: 52ch;
    font-size: 1rem;
  }

  /* ------------------------------------------------------------- Appel */
  .hub-appel {
    margin-top: 4.5rem;
    padding-block: 3.5rem;
  }
  .hub-appel-grille {
    display: grid;
    gap: 2rem;
  }
  .hub-appel-titre {
    max-width: 20ch;
  }
  .hub-appel-texte {
    margin-top: 1.5rem;
    max-width: 52ch;
  }
  .hub-appel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 48rem) {
    .hub-suite {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  @media (min-width: 64rem) {
    .hub-hero {
      padding-top: 4rem;
      padding-bottom: 1.5rem;
    }
    .hub-hero-grille {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        "titre outil"
        "texte mention";
      column-gap: 4rem;
      row-gap: 2.5rem;
      align-items: start;
    }
    .hub-section {
      margin-top: 5.5rem;
    }
    .hub-appel {
      margin-top: 6rem;
      padding-block: 5rem;
    }
    .hub-appel-grille {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
      align-items: end;
    }
    .hub-appel-actions {
      justify-content: flex-end;
    }
  }
</style>

<script is:inline>
  /* Mouvement du hub : l ouverture des panneaux depliables, une seule passe
     d entree par section, et le trace du filet bronze du titre. Autonome,
     aucune dependance, aucun reseau. Meme script que celui des neuf fiches
     (src/components/GuideCimetiere.astro), adapte aux classes du hub.

     Regles tenues : rien n est jamais laisse a l opacite 0 (l animation part
     de 0 et ne remplit pas son etat final, donc une section reste lisible
     meme si le script casse) ; aucune boucle, aucun parallaxe, aucun
     compteur ; les listes filtrees ne sont PAS animees, parce qu on les
     refiltre a chaque frappe. Si la personne demande moins de mouvement,
     tout est instantane. */
  (function () {
    var doux = window.matchMedia("(prefers-reduced-motion: reduce)");
    var courbe = "cubic-bezier(0.25, 1, 0.5, 1)";

    /* ------------------------------------------- Panneaux depliables */
    [].slice.call(document.querySelectorAll("details.hub-repli-anime")).forEach(function (repli) {
      var resume = repli.querySelector("summary");
      var corps = resume ? resume.nextElementSibling : null;
      if (!resume || !corps) return;
      var enCours = null;
      var ouvertVoulu = repli.open;

      function arrete() {
        if (!enCours) return;
        enCours.onfinish = null;
        enCours.oncancel = null;
        enCours.cancel();
        enCours = null;
        corps.style.height = "";
      }

      resume.addEventListener("click", function (evenement) {
        // Le clavier et la reduction du mouvement gardent la bascule native.
        if (doux.matches || evenement.detail === 0 || typeof corps.animate !== "function") {
          if (enCours) {
            arrete();
            repli.open = ouvertVoulu;
          }
          return;
        }
        evenement.preventDefault();
        var etat = enCours ? ouvertVoulu : repli.open;
        var depart = repli.open ? corps.getBoundingClientRect().height : 0;
        arrete();
        ouvertVoulu = !etat;
        repli.open = true;
        var hauteur = corps.scrollHeight;
        var arrivee = ouvertVoulu ? hauteur : 0;
        corps.style.height = depart + "px";
        var animation = corps.animate(
          [
            { height: depart + "px", opacity: etat ? 1 : 0 },
            { height: arrivee + "px", opacity: ouvertVoulu ? 1 : 0 },
          ],
          { duration: 220, easing: courbe },
        );
        enCours = animation;
        animation.onfinish = function () {
          if (enCours !== animation) return;
          repli.open = ouvertVoulu;
          corps.style.height = "";
          enCours = null;
        };
      });
    });

    if (doux.matches) return;

    /* ----------------------------------------- Filet bronze du titre */
    var trait = document.querySelector("[data-hero-trait]");
    if (trait && typeof trait.animate === "function") {
      trait.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
        duration: 420,
        easing: courbe,
      });
    }

    /* ------------------------------------------- Entree des sections */
    if (!("IntersectionObserver" in window)) return;
    var oeil = new IntersectionObserver(
      function (entrees) {
        entrees.forEach(function (entree) {
          if (!entree.isIntersecting) return;
          oeil.unobserve(entree.target);
          var decalage = Number(entree.target.getAttribute("data-entree-decalage") || 0);
          entree.target.animate(
            [
              { opacity: 0, transform: "translateY(12px)" },
              { opacity: 1, transform: "none" },
            ],
            { duration: 340, delay: decalage, easing: courbe, fill: "none" },
          );
        });
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.01 },
    );
    [].slice.call(document.querySelectorAll("[data-entree]")).forEach(function (cible) {
      oeil.observe(cible);
    });
  })();
</script>
