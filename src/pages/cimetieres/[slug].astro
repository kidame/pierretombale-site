---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GuideCimetiere from "@/components/GuideCimetiere.astro";
import { pageTitle } from "@/config/site";
import {
  CIMETIERES,
  CIMETIERES_URL,
  autresCimetieres,
  cimetiereUrl,
  type Cimetiere,
} from "@/data/cimetieres";
import { breadcrumbSchema } from "@/data/seo";

/* Une page par cimetiere. UNE SEULE mise en page pour toutes, celle du guide
   (src/components/GuideCimetiere.astro, direction du 10.11.2026 generalisee le
   meme jour) : tout le contenu vient de src/data/cimetieres.ts (sources :
   docs/DIMENSIONS-MONUMENTS.md, docs/REGLEMENTS-CIMETIERES-NE.md,
   docs/CIMETIERES-PRATIQUE.md).
   Cette page ne calcule que ce qui doit rester identique d une mise en page a
   l autre : adresse, titre, metadonnees, h1 et donnees structurees.
   Une valeur absente n est pas affichee : chaque bloc est conditionnel.
   Deux regles tenues ici : la page dit qu elle est independante de la commune
   (on ne se presente jamais comme l administration), et on n affirme jamais
   qu un modele du catalogue respecte un gabarit : le monument est realise sur
   mesure et nous verifions le reglement avant la pose. */

export function getStaticPaths() {
  return CIMETIERES.map((cimetiere) => ({
    params: { slug: cimetiere.slug },
    props: { cimetiere },
  }));
}

interface Props {
  cimetiere: Cimetiere;
}

/**
 * Espaces insecables dans les guillemets francais : « Neuchatel, Cimetiere »
 * ne doit pas se couper entre le guillemet et le mot sur un ecran etroit.
 * Le remplacement se fait AU RENDU : les donnees de src/data/cimetieres.ts
 * gardent des espaces ordinaires, plus simples a relire et a corriger.
 */
/** L espace insecable U+00A0 : elle ne se coupe pas en fin de ligne. */
const INSECABLE = " ";

function espacesFines<T>(valeur: T): T {
  if (typeof valeur === "string") {
    return valeur.replace(/«[ \t]/g, `«${INSECABLE}`).replace(/[ \t]»/g, `${INSECABLE}»`) as unknown as T;
  }
  if (Array.isArray(valeur)) {
    return valeur.map((element) => espacesFines(element)) as unknown as T;
  }
  if (valeur !== null && typeof valeur === "object") {
    const copie: Record<string, unknown> = {};
    for (const [cle, element] of Object.entries(valeur)) copie[cle] = espacesFines(element);
    return copie as unknown as T;
  }
  return valeur;
}

/* `donnees` sert aux liens (devis, itineraire), `cimetiere` a l affichage. */
const { cimetiere: donnees } = Astro.props;
const cimetiere = espacesFines(donnees);

/* h1 : le nom du cimetiere, complete par la localite quand le nom ne la
   contient pas (ex. « Cimetiere de Beauregard a Neuchatel »), pour que le
   titre principal porte le lieu que les gens tapent dans Google. */
const localitePrincipale = cimetiere.localites[0] ?? cimetiere.commune;
const motsLocalite = `${localitePrincipale} ${cimetiere.commune}`.split(/[\s-]+/).filter((mot) => mot.length >= 5);
const titrePrincipal = motsLocalite.some((mot) => cimetiere.nom.includes(mot))
  ? cimetiere.nom
  : `${cimetiere.nom} à ${localitePrincipale}`;
const origin = Astro.site ?? new URL(Astro.url.origin);
const autres = espacesFines(autresCimetieres(donnees.slug));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: cimetiere.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.reponse },
  })),
};

/* WebPage + about Cemetery : la page parle du cimetiere, elle n est pas la
   page de la commune. Aucune note, aucun avis, aucune coordonnee inventee :
   l adresse postale n est emise que si elle est connue. */
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: cimetiere.titreSeo,
  description: cimetiere.description,
  url: new URL(cimetiereUrl(cimetiere.slug), origin).href,
  about: {
    "@type": "Cemetery",
    name: cimetiere.nom,
    ...(cimetiere.adresse
      ? {
          address: {
            "@type": "PostalAddress",
            streetAddress: cimetiere.adresse,
            addressLocality: cimetiere.localites[0] ?? cimetiere.commune,
            addressRegion: "NE",
            addressCountry: "CH",
          },
        }
      : {}),
  },
};

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: "Cimetières", path: CIMETIERES_URL },
    { name: cimetiere.nom, path: cimetiereUrl(cimetiere.slug) },
  ],
  origin,
);
---

<BaseLayout title={pageTitle(cimetiere.titreSeo)} description={cimetiere.description}>
  <main id="main-content">
    <GuideCimetiere
      cimetiere={cimetiere}
      donnees={donnees}
      titrePrincipal={titrePrincipal}
      autres={autres}
    />
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />
</BaseLayout>
