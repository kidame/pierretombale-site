---
import ProductCard from "@/components/ProductCard.astro";
import ProductImage from "@/components/ProductImage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, titreFiche } from "@/config/site";
import { getCalibration } from "@/data/calibrations";
import { nomGranit, vignetteMatiere } from "@/data/granits";
import {
  FAMILLE_LABELS,
  GAMME_LABELS,
  altVisuel,
  familleUrl,
  imagesDuModele,
  productUrl,
  tronque,
  visuelModele,
  type Product,
} from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";
import { MENTION_PRIX_PROVISOIRE, offreJsonLd, prixAffiche, prixEstProvisoire } from "@/data/tarifs";

/**
 * La fiche d un modele, partagee par les deux familles : chaque page famille
 * n a plus qu a fournir le modele et ses voisins. L adresse de la fiche vient
 * toujours de `productUrl`.
 */
interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(productUrl(product), origin).href;

const granitsPossibles = product.granitsPossibles.includes("tous")
  ? "Tous nos granits"
  : product.granitsPossibles.map((id) => nomGranit(id)).join(", ");

/* Le visuel presente et les matieres dans lesquelles ce modele existe en
   image. La rangee de pastilles ne propose que celles-la : jamais une matiere
   dont le visuel n existe pas. */
const visuel = visuelModele(product);

/* Une matiere sans photo d echantillon n a pas de pastille : elle resterait
   un bouton vide. `src/data/granits.json` et `public/images/matieres` doivent
   donc rester en phase. */
const matieres = imagesDuModele(product)
  .map((granit) => ({ granit, vignette: vignetteMatiere(granit) }))
  .filter((entree): entree is { granit: (typeof entree)["granit"]; vignette: string } =>
    Boolean(entree.vignette),
  );

/* Racine des chemins de visuel de ce modele, pour le petit script de la page :
   il recompose `-320/-640/-1200.webp` au lieu de porter trois chemins par
   pastille dans le HTML. */
const racineVisuel = `/images/modeles/${product.modeleId}/${product.modeleId}`;

/* Le lien vers le configurateur n apparait que si le modele a une calibration
   dans `src/data/calibrations/` : sans elle, la page /personnaliser/<slug>/
   n existe pas (voir `src/data/calibrations.ts`). Deposer un JSON de plus fait
   apparaitre le lien tout seul. */
const estCalibre = getCalibration(product.modeleId) !== undefined;

const specs: Array<[string, string]> = [
  ["Dimensions", product.dimensions],
  ["Famille", FAMILLE_LABELS[product.famille]],
  ["Gamme", GAMME_LABELS[product.gamme]],
  ["Stèle", product.stele ? "Avec stèle" : "Sans stèle"],
  ["Lignes", product.lignes === "droites" ? "Droites" : "Courbes"],
  ...(product.bicolore ? ([["Bicolore", "Oui"]] as Array<[string, string]>) : []),
  ...(product.motifs.length ? ([["Motifs", product.motifs.join(", ")]] as Array<[string, string]>) : []),
  ...(product.options.length
    ? ([["Options", product.options.join(", ")]] as Array<[string, string]>)
    : []),
  ["Granits possibles", granitsPossibles],
];

/* Titre et meta description de la fiche. Le mot que les familles tapent passe
   avant le nom du modele : "pierre tombale" pour un monument funeraire,
   "monument cineraire" pour un cineraire (cf. la regle de vocabulaire dans
   AGENTS.md). Le h1 de la page, lui, reste le nom du modele. */
const nature = product.famille === "cineraire" ? "monument cinéraire" : "pierre tombale";
const titre = titreFiche(product.name, nature);
const metaDescription = tronque(`${product.shortDescription} Prix indicatif et devis gratuit.`, 155);

const prix = prixAffiche(product.slug);
const prixProvisoire = prixEstProvisoire(product.slug);

/* Offre chiffree seulement si le modele a un vrai prix dans
   src/data/tarifs.json : tant que le prix affiche est provisoire, Google ne
   doit rien apprendre de chiffre (le prix depend aussi du cimetiere, de la
   gravure et de la pose). `offreJsonLd` retourne null dans ce cas. */
const offre = offreJsonLd(product.slug);

/* Une seule image dans les donnees structurees : la plus grande largeur du
   visuel presente, en URL absolue (Google n accepte pas de chemin relatif).
   Les autres matieres ne sont pas des produits differents. */
const imageJsonLd = new URL(`${racineVisuel}-${visuel.matiere}-1200.webp`, origin).href;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: imageJsonLd,
  brand: { "@type": "Brand", name: siteConfig.name },
  material: nomGranit(product.granitPresente),
  url,
  ...(offre ? { offers: { ...offre, url } } : {}),
};

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: FAMILLE_LABELS[product.famille], path: familleUrl(product.famille) },
    { name: product.name, path: productUrl(product) },
  ],
  origin,
);
---

<BaseLayout title={titre} description={metaDescription} image={`${racineVisuel}-${visuel.matiere}-1200.webp`}>
  <main id="main-content" class="shell">
    <nav class="mono flex gap-2 py-6 text-[0.6875rem] uppercase tracking-[0.05em] text-muted" aria-label="Fil d'Ariane">
      <a href="/" class="link">Accueil</a>
      <span aria-hidden="true">/</span>
      <a href={familleUrl(product.famille)} class="link">{FAMILLE_LABELS[product.famille]}</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink" aria-current="page">{product.name}</span>
    </nav>

    <div class="grid items-start gap-x-12 gap-y-10 border-t border-line pt-8 lg:grid-cols-12">
      {/* ------------------------------------------------------------ Visuels */}
      <section
        class="lg:col-span-7"
        aria-label={`Visuel de ${product.name}`}
        data-visuel-modele
        data-racine={racineVisuel}
      >
        {/* Le visuel est le plus grand element de la fiche : charge tot
            (`eager`, `fetchpriority="high"`) et jamais en differe. */}
        <div class="overflow-hidden bg-surface">
          <ProductImage
            product={product}
            sizes="(min-width: 1024px) 58vw, 100vw"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            class="aspect-square w-full object-contain"
          />
        </div>

        <p class="mono mt-3 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
          Granit présenté : <span class="text-ink" data-matiere-nom>{visuel.nomMatiere}</span> — image de
          présentation, la teinte se juge sur la pierre
        </p>

        {/* Changer de matiere : de vrais boutons, utiles au clavier. SANS
            JAVASCRIPT la fiche reste complete (le visuel presente est deja la)
            et chaque bouton ne fait rien : c est pourquoi la rangee n est pas
            annoncee comme un choix obligatoire. */}
        {
          matieres.length > 1 && (
            <div class="mt-6" role="group" aria-label={`Voir ${product.name} dans une autre matière`}>
              <p class="label">Voir dans une autre matière</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {matieres.map(({ granit, vignette }) => (
                  <button
                    type="button"
                    class="pastille-matiere"
                    data-matiere={granit.id}
                    data-alt={altVisuel(product, granit.id)}
                    data-nom={granit.nom}
                    aria-pressed={granit.id === visuel.matiere ? "true" : "false"}
                  >
                    <img
                      src={vignette}
                      alt={granit.nom}
                      width="160"
                      height="160"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ))}
              </div>
            </div>
          )
        }
      </section>

      {/* -------------------------------------------------------- Colonne devis */}
      <div class="lg:sticky lg:top-28 lg:col-span-5">
        <p class="label">{FAMILLE_LABELS[product.famille]} · {GAMME_LABELS[product.gamme]}</p>
        <h1 class="type-h2 mt-5">{product.name}</h1>
        <p class="mono mt-5 text-xl">{prix}</p>
        {
          prixProvisoire && (
            <p class="mono mt-2 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
              {MENTION_PRIX_PROVISOIRE}
            </p>
          )
        }
        <p class="mt-3">
          <a href="/prix-pierre-tombale-suisse/" class="link link-mono text-[0.75rem] text-muted">
            Comment est calculé le prix ?
          </a>
        </p>

        <p class="type-body mt-8 max-w-[46ch]">{product.description}</p>

        <dl class="mono mt-10 border-t border-line text-[0.8125rem]">
          {
            specs.map(([term, value]) => (
              <div class="flex justify-between gap-6 border-b border-line py-3">
                <dt class="text-muted">{term}</dt>
                <dd class="text-right">{value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 flex flex-wrap items-stretch gap-3">
          <a href={`/devis/?modele=${product.slug}`} class="btn btn-primary flex-1">Demander un devis</a>
          {
            estCalibre && (
              <a href={`/personnaliser/${product.slug}/`} class="btn btn-outline flex-1">
                Personnaliser ce modèle
              </a>
            )
          }
        </div>

        <p class="mono mt-5 text-[0.6875rem] uppercase leading-relaxed tracking-[0.05em] text-muted">
          Chaque monument est réalisé sur mesure · gravure et pose comprises dans le devis
        </p>
      </div>
    </div>

    {/* ------------------------------------------------------ Autres modeles */}
    <section class="mt-32 md:mt-44">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-t border-line pt-8" data-reveal>
        <h2 class="type-h2 max-w-[16ch]">D'autres modèles à voir</h2>
        <a href={familleUrl(product.famille)} class="link link-mono pb-1.5 text-muted">
          {FAMILLE_LABELS[product.famille]}
        </a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 md:mt-14 md:grid-cols-3">
        {
          related.map((item, index) => (
            <ProductCard product={item} headingLevel="h3" revealDelay={index * 110} />
          ))
        }
      </div>
    </section>
  </main>

  {/* Habillage des pastilles ecrit ici, pas en utilitaires Tailwind : la
      feuille Tailwind est unique et partagee par tout le site, alors que ce
      bloc ne part qu avec les fiches. 48 px au moins, bordure epaisse sur la
      matiere presentee (jamais la couleur seule). */}
  <style>
    .pastille-matiere {
      display: block;
      overflow: hidden;
      width: 3.5rem;
      height: 3.5rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background-color: var(--surface);
      cursor: pointer;
    }

    .pastille-matiere img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .pastille-matiere:hover {
      border-color: var(--ink);
    }

    .pastille-matiere:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 3px;
    }

    .pastille-matiere[aria-pressed="true"] {
      border-width: 3px;
      border-color: var(--ink);
    }
  </style>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />

  {/* Changement de matiere : on remplace src, srcset, alt et le nom affiche.
      Les trois largeurs se recomposent depuis `data-racine`, comme
      `visuelModele` les construit dans src/data/products.ts. */}
  <script is:inline>
    (() => {
      const vue = document.querySelector("[data-visuel-modele]");
      const img = vue && vue.querySelector("img[srcset]");
      const nom = vue && vue.querySelector("[data-matiere-nom]");
      const choix = vue ? vue.querySelectorAll("[data-matiere]") : [];
      if (!img || !choix.length) return;

      choix.forEach((bouton) => {
        bouton.addEventListener("click", () => {
          const base = vue.dataset.racine + "-" + bouton.dataset.matiere;
          img.src = base + "-640.webp";
          img.srcset = base + "-320.webp 320w, " + base + "-640.webp 640w, " + base + "-1200.webp 1200w";
          img.alt = bouton.dataset.alt;
          if (nom) nom.textContent = bouton.dataset.nom;
          choix.forEach((autre) => autre.setAttribute("aria-pressed", String(autre === bouton)));
        });
      });
    })();
  </script>
</BaseLayout>
