---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import ProductImage from "@/components/ProductImage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, titreFiche } from "@/config/site";
import { nomGranit } from "@/data/granits";
import {
  FAMILLE_LABELS,
  GAMME_LABELS,
  familleUrl,
  productUrl,
  productVisuel,
  tronque,
  type Product,
} from "@/data/products";
import { breadcrumbSchema } from "@/data/seo";
import { MENTION_PRIX_PROVISOIRE, offreJsonLd, prixAffiche, prixEstProvisoire } from "@/data/tarifs";

/**
 * La fiche d un modele, partagee par les deux familles : chaque page famille
 * n a plus qu a fournir le modele et ses voisins. L adresse de la fiche vient
 * toujours de `productUrl`.
 */
interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(productUrl(product), origin).href;

const granitsPossibles = product.granitsPossibles.includes("tous")
  ? "Tous nos granits"
  : product.granitsPossibles.map((id) => nomGranit(id)).join(", ");

const specs: Array<[string, string]> = [
  ["Dimensions", product.dimensions],
  ["Famille", FAMILLE_LABELS[product.famille]],
  ["Gamme", GAMME_LABELS[product.gamme]],
  ["Stèle", product.stele ? "Avec stèle" : "Sans stèle"],
  ["Lignes", product.lignes === "droites" ? "Droites" : "Courbes"],
  ...(product.bicolore ? ([["Bicolore", "Oui"]] as Array<[string, string]>) : []),
  ...(product.motifs.length ? ([["Motifs", product.motifs.join(", ")]] as Array<[string, string]>) : []),
  ...(product.options.length
    ? ([["Options", product.options.join(", ")]] as Array<[string, string]>)
    : []),
  ["Granit présenté", nomGranit(product.granitPresente)],
  ["Granits possibles", granitsPossibles],
];

/* Titre et meta description de la fiche. Le mot que les familles tapent passe
   avant le nom du modele : "pierre tombale" pour un monument funeraire,
   "monument cineraire" pour un cineraire (cf. la regle de vocabulaire dans
   AGENTS.md). Le h1 de la page, lui, reste le nom du modele. */
const nature = product.famille === "cineraire" ? "monument cinéraire" : "pierre tombale";
const titre = titreFiche(product.name, nature);
const metaDescription = tronque(`${product.shortDescription} Prix indicatif et devis gratuit.`, 155);

const prix = prixAffiche(product.slug);
const prixProvisoire = prixEstProvisoire(product.slug);

/* Offre chiffree seulement si le modele a un vrai prix dans
   src/data/tarifs.json : tant que le prix affiche est provisoire, Google ne
   doit rien apprendre de chiffre (le prix depend aussi du cimetiere, de la
   gravure et de la pose). `offreJsonLd` retourne null dans ce cas. */
const offre = offreJsonLd(product.slug);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: (product.images.length ? product.images : [productVisuel(product).image]).map(
    (image) => new URL(image.src, origin).href,
  ),
  brand: { "@type": "Brand", name: siteConfig.name },
  material: nomGranit(product.granitPresente),
  url,
  ...(offre ? { offers: { ...offre, url } } : {}),
};

const filAriane = breadcrumbSchema(
  [
    { name: "Accueil", path: "/" },
    { name: FAMILLE_LABELS[product.famille], path: familleUrl(product.famille) },
    { name: product.name, path: productUrl(product) },
  ],
  origin,
);
---

<BaseLayout
  title={titre}
  description={metaDescription}
  image={product.images[0]}
>
  <main id="main-content" class="shell">
    <nav class="mono flex gap-2 py-6 text-[0.6875rem] uppercase tracking-[0.05em] text-muted" aria-label="Fil d'Ariane">
      <a href="/" class="link">Accueil</a>
      <span aria-hidden="true">/</span>
      <a href={familleUrl(product.famille)} class="link">{FAMILLE_LABELS[product.famille]}</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink" aria-current="page">{product.name}</span>
    </nav>

    <div class="grid items-start gap-x-12 gap-y-10 border-t border-line pt-8 lg:grid-cols-12">
      {/* ------------------------------------------------------------ Visuels */}
      <section class="lg:col-span-7" aria-label={`Visuels de ${product.name}`} data-product-gallery>
        <div class="relative overflow-hidden bg-surface">
          {
            product.images.length === 0 ? (
              <ProductImage
                product={product}
                width={1440}
                height={1800}
                loading="eager"
                decoding="sync"
                class="aspect-[4/5] w-full object-contain"
              />
            ) : (
              product.images.map((image, index) => (
                <div class:list={["gallery-panel", index !== 0 && "is-hidden"]} data-gallery-panel={index}>
                  <Image
                    src={image}
                    alt={`${product.name} — vue ${index + 1} sur ${product.images.length}`}
                    width={1440}
                    height={1800}
                    format="webp"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding={index === 0 ? "sync" : "async"}
                    class="aspect-[4/5] w-full object-cover"
                  />
                </div>
              ))
            )
          }
        </div>

        {
          product.images.length === 0 ? (
            <p class="mono mt-3 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
              Visuel à venir — photographies de nos réalisations en préparation
            </p>
          ) : (
            <div class="mt-3 grid grid-cols-3 gap-3" role="group" aria-label="Choisir un visuel">
              {product.images.map((image, index) => (
                <button
                  type="button"
                  class="gallery-thumb overflow-hidden bg-surface"
                  data-gallery-thumb={index}
                  aria-label={`Afficher la vue ${index + 1}`}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <Image
                    src={image}
                    alt=""
                    width={360}
                    height={360}
                    format="webp"
                    loading="lazy"
                    class="aspect-square w-full object-cover"
                  />
                </button>
              ))}
            </div>
          )
        }
      </section>

      {/* -------------------------------------------------------- Colonne devis */}
      <div class="lg:sticky lg:top-28 lg:col-span-5">
        <p class="label">{FAMILLE_LABELS[product.famille]} · {GAMME_LABELS[product.gamme]}</p>
        <h1 class="type-h2 mt-5">{product.name}</h1>
        <p class="mono mt-5 text-xl">{prix}</p>
        {
          prixProvisoire && (
            <p class="mono mt-2 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
              {MENTION_PRIX_PROVISOIRE}
            </p>
          )
        }
        <p class="mt-3">
          <a href="/prix-pierre-tombale-suisse/" class="link link-mono text-[0.75rem] text-muted">
            Comment est calculé le prix ?
          </a>
        </p>

        <p class="type-body mt-8 max-w-[46ch]">{product.description}</p>

        <dl class="mono mt-10 border-t border-line text-[0.8125rem]">
          {
            specs.map(([term, value]) => (
              <div class="flex justify-between gap-6 border-b border-line py-3">
                <dt class="text-muted">{term}</dt>
                <dd class="text-right">{value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 flex flex-wrap items-stretch gap-3">
          <a href={`/devis?modele=${product.slug}`} class="btn btn-primary flex-1">Demander un devis</a>
        </div>

        <p class="mono mt-5 text-[0.6875rem] uppercase leading-relaxed tracking-[0.05em] text-muted">
          Chaque monument est réalisé sur mesure · gravure et pose comprises dans le devis
        </p>
      </div>
    </div>

    {/* ------------------------------------------------------ Autres modeles */}
    <section class="mt-32 md:mt-44">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-t border-line pt-8" data-reveal>
        <h2 class="type-h2 max-w-[16ch]">D'autres modèles à voir</h2>
        <a href={familleUrl(product.famille)} class="link link-mono pb-1.5 text-muted">
          {FAMILLE_LABELS[product.famille]}
        </a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 md:mt-14 md:grid-cols-3">
        {
          related.map((item, index) => (
            <ProductCard product={item} headingLevel="h3" revealDelay={index * 110} />
          ))
        }
      </div>
    </section>
  </main>

  <style>
    .gallery-panel.is-hidden {
      display: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .gallery-panel:not(.is-hidden) {
        animation: panel-in 600ms var(--ease-out-expo) both;
      }

      @keyframes panel-in {
        from {
          opacity: 0;
          transform: scale(1.015);
        }
      }
    }

    .gallery-thumb {
      box-shadow: inset 0 0 0 1px var(--line);
      transition: box-shadow 260ms ease;
    }

    .gallery-thumb:hover {
      box-shadow: inset 0 0 0 1px var(--line-strong);
    }

    .gallery-thumb[aria-pressed="true"] {
      box-shadow: inset 0 0 0 2px var(--accent);
    }
  </style>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(filAriane)} />

  <script is:inline>
    (() => {
      const gallery = document.querySelector("[data-product-gallery]");
      if (!gallery) return;

      const panels = Array.from(gallery.querySelectorAll("[data-gallery-panel]"));
      const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const active = thumb.dataset.galleryThumb;
          panels.forEach((panel) => panel.classList.toggle("is-hidden", panel.dataset.galleryPanel !== active));
          thumbs.forEach((button) => {
            button.setAttribute("aria-pressed", String(button === thumb));
          });
        });
      });
    })();
  </script>
</BaseLayout>
