---
/* Les cotes du reglement, dessinees a l echelle quand elles sont chiffrees.

   Composant reutilisable : il recoit des nombres deja lus dans les lignes du
   reglement (src/data/cimetieres.ts) et n invente rien. Les deux vues sont
   independantes et a la meme echelle (1 cm = --cm) : une fiche peut n avoir
   que la surface (hauteur non publiee), que la hauteur (pas de surface
   publiee), ou aucune des deux. Ce qui n est pas chiffre est ecrit en mots
   avec sa phrase source et son article : la carte n a jamais de trou.

   Chaque vue dit de quelle forme elle parle (tombe, stele, croix, obelisque :
   ce ne sont pas les memes cotes), et les autres formes chiffrees pour un
   adulte sont nommees dans le repli.

   Amelioration progressive. Dans le HTML initial, les vues presentes sont
   visibles l une sous l autre et les boutons portent l attribut [hidden] :
   sans JavaScript, tout est lisible. Le script retire [hidden], pose les
   roles d onglets et n affiche qu une vue a la fois. Avec une seule vue, il
   n y a pas de bouton : un onglet unique serait un faux onglet.

   Fichier en ASCII : les libelles passent par des entites HTML. */

interface Props {
  /** Vue de dessus : la surface au sol, quand le reglement la chiffre. */
  dessus: {
    /** Les deux nombres dans l ordre du reglement, pour le grand chiffre. */
    premierCm: number;
    secondCm: number;
    /** Le dessin : le plus petit en largeur, le plus grand en profondeur. */
    largeurCm: number;
    profondeurCm: number;
    type: string;
    article: string;
  } | null;
  /** Vue de hauteur, quand une forme d adulte est chiffree. */
  hauteur: {
    hauteurCm: number;
    /** Largeur dessinee seulement si le reglement l ecrit en clair. */
    largeurCm: number | null;
    /** La forme mesuree : « Stele, inhumation d adulte », etc. */
    forme: string;
    hauteurTexte: string;
    article: string;
    largeurTexte: string;
  } | null;
  /** Les cotes que le reglement ne chiffre pas : sa phrase et son article. */
  manques?: { intitule: string; texte: string; article: string }[];
  /** Les autres formes chiffrees pour un adulte (croix, obelisque). */
  autresFormes?: { type: string; hauteur: string; article: string }[];
}

const { dessus, hauteur, manques = [], autresFormes = [] } = Astro.props;

const nombreVues = (dessus ? 1 : 0) + (hauteur ? 1 : 0);

/* La largeur du monument : la phrase du reglement quand il la fixe, sinon la
   mention « a confirmer » (le reglement ecrit alors « largeur non fixee »). */
const largeurFixee = hauteur ? !/non fix/i.test(hauteur.largeurTexte) : false;

/* La hauteur source porte parfois deja une parenthese (« 110 cm (130 cm pour
   une croix) ») : l article se met alors apres une virgule, pas dans une
   seconde parenthese. */
const hauteurCitee = hauteur
  ? /\)\s*$/.test(hauteur.hauteurTexte)
    ? `${hauteur.hauteurTexte}, ${hauteur.article}`
    : `${hauteur.hauteurTexte} (${hauteur.article})`
  : "";

/* Les variables d echelle ne sont posees que pour les vues dessinees. */
const echelle = [
  dessus ? `--cm-largeur:${dessus.largeurCm}` : null,
  dessus ? `--cm-profondeur:${dessus.profondeurCm}` : null,
  hauteur ? `--cm-hauteur:${hauteur.hauteurCm}` : null,
  hauteur?.largeurCm ? `--cm-monument:${hauteur.largeurCm}` : null,
]
  .filter((regle): regle is string => regle !== null)
  .join(";");
---

<figure class="schema" data-schema style={echelle}>
  <figcaption class="schema-tete">
    <span class="label">Les cotes du r&#xe8;glement</span>
  </figcaption>

  {
    nombreVues > 1 && (
      <div class="schema-choix" hidden data-schema-choix aria-label="Vue du sch&#xe9;ma">
        <button type="button" class="choix" id="schema-onglet-dessus" data-schema-bouton="dessus">
          Vue de dessus
        </button>
        <button type="button" class="choix" id="schema-onglet-hauteur" data-schema-bouton="hauteur">
          Hauteur
        </button>
      </div>
    )
  }

  {
    nombreVues > 0 && (
      <div class="schema-vues">
        {dessus && (
          <section class="vue" data-schema-vue="dessus" aria-labelledby="schema-titre-dessus">
            <div class="vue-mots">
              <h4 class="vue-titre" id="schema-titre-dessus">
                Vue de dessus
              </h4>
              <p class="vue-chiffre" data-schema-chiffre>
                <span class="mono">{dessus.premierCm}</span>
                <span class="vue-signe" aria-hidden="true">
                  &#xd7;
                </span>
                <span class="sr-only">sur</span>
                <span class="mono">{dessus.secondCm}</span>
                <span class="vue-unite">cm</span>
              </p>
              <p class="vue-legende">
                {dessus.type}, {dessus.article}.
              </p>
            </div>
            <div class="vue-dessin">
              <div class="plan">
                <div class="plan-colonne">
                  <span class="cote" data-schema-cote>
                    {dessus.largeurCm}&#xa0;cm
                  </span>
                  <span class="guide guide-l" data-schema-guide="x" aria-hidden="true" />
                  <div class="plan-forme" data-schema-forme />
                </div>
                <div class="plan-cote">
                  <span class="guide guide-p" data-schema-guide="y" aria-hidden="true" />
                  <span class="cote" data-schema-cote>
                    {dessus.profondeurCm}&#xa0;cm
                  </span>
                </div>
              </div>
            </div>
          </section>
        )}

        {hauteur && (
          <section class="vue" data-schema-vue="hauteur" aria-labelledby="schema-titre-hauteur">
            <div class="vue-mots">
              <h4 class="vue-titre" id="schema-titre-hauteur">
                Hauteur
              </h4>
              <p class="vue-chiffre" data-schema-chiffre>
                <span class="mono">{hauteur.hauteurCm}</span>
                <span class="vue-unite">cm</span>
              </p>
              <p class="vue-legende">
                {hauteur.forme}&#xa0;: {hauteurCitee}.{" "}
                {largeurFixee ? (
                  <span>{hauteur.largeurTexte}.</span>
                ) : (
                  <span>Largeur&#xa0;: &#xe0; confirmer aupr&#xe8;s de la commune.</span>
                )}
              </p>
            </div>
            <div class="vue-dessin">
              <div class="elevation">
                <span class="cote" data-schema-cote>
                  {hauteur.hauteurCm}&#xa0;cm
                </span>
                <span class="guide guide-h" data-schema-guide="y" aria-hidden="true" />
                <div class={hauteur.largeurCm ? "elevation-boite elevation-boite-cotee" : "elevation-boite"}>
                  <div class="elevation-enveloppe" data-schema-forme>
                    <span class="elevation-largeur">
                      {hauteur.largeurCm ? `${hauteur.largeurCm} cm` : "\u00e0 confirmer"}
                    </span>
                  </div>
                  <span class="elevation-sol" aria-hidden="true" />
                </div>
              </div>
            </div>
          </section>
        )}
      </div>
    )
  }

  {/* Ce que le reglement ne chiffre pas : la cote reste lue, avec la phrase
      du reglement et son article. Aucun dessin n est invente pour elle. */}
  {
    manques.length > 0 && (
      <dl class={nombreVues > 0 ? "manques manques-suite" : "manques"}>
        {manques.map((manque) => (
          <div class="manque">
            <dt>{manque.intitule}</dt>
            <dd class="manque-valeur">{manque.texte}</dd>
            <dd class="manque-precision">{manque.article}.</dd>
          </div>
        ))}
      </dl>
    )
  }

  {/* Les phrases de contexte sont repliees : le dessin et sa legende tiennent
      alors dans un ecran de telephone. Rien n est retire du HTML, et la
      classe repli-anime fait reutiliser le script d ouverture de la page. */}
  <details class="schema-detail repli-anime">
    <summary class="schema-resume">
      <span class="schema-resume-titre">Comprendre ces dimensions</span>
      <span class="schema-marque" aria-hidden="true">
        <span class="schema-marque-barre"></span>
        <span class="schema-marque-barre schema-marque-barre-v"></span>
      </span>
    </summary>
    <div class="schema-detail-corps">
      <p class="schema-notes">
        {
          dessus && (
            <Fragment>
              Vue de dessus&#xa0;: {dessus.type}, {dessus.article}.{" "}
            </Fragment>
          )
        }
        {
          hauteur && (
            <Fragment>
              Hauteur&#xa0;: {hauteur.forme}, {hauteurCitee},{" "}
              {hauteur.largeurTexte.charAt(0).toLowerCase() + hauteur.largeurTexte.slice(1)}.{" "}
            </Fragment>
          )
        }
        {nombreVues > 1 && <Fragment>Les deux vues sont &#xe0; la m&#xea;me &#xe9;chelle.</Fragment>}
        {
          nombreVues === 0 && (
            <Fragment>
              Le r&#xe8;glement de cette commune ne chiffre pas ces cotes&#xa0;: rien n'est dessin&#xe9;
              ici, les phrases ci-dessus sont celles du r&#xe8;glement.
            </Fragment>
          )
        }
      </p>
      {
        autresFormes.length > 0 && (
          <Fragment>
            <p class="schema-notes schema-notes-suite">
              Autres formes chiffr&#xe9;es pour un adulte, &#xe0; ne pas confondre avec la
              pr&#xe9;c&#xe9;dente&#xa0;:
            </p>
            <ul class="schema-formes">
              {autresFormes.map((forme) => (
                <li>
                  {forme.type}&#xa0;:{" "}
                  {/\)\s*$/.test(forme.hauteur)
                    ? `${forme.hauteur}, ${forme.article}.`
                    : `${forme.hauteur} (${forme.article}).`}
                </li>
              ))}
            </ul>
          </Fragment>
        )
      }
      <p class="schema-avertissement">
        {
          nombreVues > 0
            ? "Dessin des cotes du r\u00e8glement, pour se rep\u00e9rer. Ce n'est pas un mod\u00e8le du catalogue, et aucun monument n'est annonc\u00e9 conforme sans v\u00e9rification du r\u00e8glement."
            : "Cotes du r\u00e8glement, pour se rep\u00e9rer. Aucun monument n'est annonc\u00e9 conforme sans v\u00e9rification du r\u00e8glement."
        }
      </p>
    </div>
  </details>
</figure>

<style>
  /* 1 cm = --cm. Les deux vues partagent la meme valeur : les dessins sont
     comparables, et une correction de donnee corrige le dessin. */
  .schema {
    --cm: 0.082rem;
    margin-top: 1.25rem;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    padding: 1rem 1.125rem;
  }
  @media (min-width: 48rem) {
    .schema {
      --cm: 0.1rem;
      padding: 1.75rem 2rem;
    }
  }

  .schema-tete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--line);
  }

  /* -------------------------------------------------- Selection des vues */
  .schema-choix {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .schema-choix[hidden] {
    display: none;
  }
  .choix {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.2;
    cursor: pointer;
    transition:
      color 200ms var(--ease-out-quart),
      border-color 200ms var(--ease-out-quart),
      background-color 200ms var(--ease-out-quart);
  }
  .choix[aria-selected="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--canvas);
  }
  .choix:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .choix:not([aria-selected="true"]):hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }
  .choix:active {
    transform: translateY(1px);
  }

  /* ------------------------------------------------------------- Une vue */
  .schema-vues {
    display: grid;
    gap: 2rem;
  }
  .vue {
    display: grid;
    gap: 1.25rem;
    padding-top: 1.25rem;
  }
  .vue[hidden] {
    display: none;
  }
  .vue + .vue {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 34rem) {
    .vue {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 2.5rem;
    }
  }

  .vue-titre {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* Le grand repere chiffre : c est lui qu on retient. */
  .vue-chiffre {
    margin-top: 0.5rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--ink);
    font-size: clamp(2.5rem, 9vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .vue-signe {
    font-size: 0.42em;
    color: var(--accent);
  }
  .vue-unite {
    font-size: 0.3em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vue-legende {
    margin-top: 0.75rem;
    max-width: 42ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ------------------------------------------------------- Le petit plan */
  .vue-dessin {
    display: flex;
    justify-content: flex-start;
  }
  .cote {
    font-size: 0.8125rem;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
  }
  .guide {
    display: block;
    background: var(--accent);
  }

  .plan {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
  }
  .plan-colonne {
    display: grid;
    gap: 0.4rem;
    width: calc(var(--cm-largeur) * var(--cm));
  }
  .plan-colonne .cote {
    text-align: center;
  }
  .guide-l {
    width: 100%;
    height: 1px;
    transform-origin: left center;
  }
  .plan-forme {
    height: calc(var(--cm-profondeur) * var(--cm));
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
  }
  .plan-cote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: calc(var(--cm-profondeur) * var(--cm));
  }
  .guide-p {
    width: 1px;
    height: 100%;
    transform-origin: center top;
  }

  .elevation {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.125rem;
  }
  .guide-h {
    width: 1px;
    height: calc(var(--cm-hauteur) * var(--cm));
    transform-origin: center bottom;
  }
  .elevation-boite {
    position: relative;
    width: 6.5rem;
    height: calc(var(--cm-hauteur) * var(--cm));
  }
  /* Largeur fixee par le reglement : elle est dessinee a la meme echelle que
     la hauteur, et non plus en largeur indicative. */
  .elevation-boite-cotee {
    width: calc(var(--cm-monument) * var(--cm));
    min-width: 3.5rem;
  }
  .elevation-boite-cotee .elevation-enveloppe {
    border-style: solid;
  }
  .elevation-enveloppe {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0.5rem;
    border: 1px dashed var(--line-strong);
    border-bottom: 0;
    border-top: 1px solid var(--accent);
  }
  .elevation-largeur {
    font-size: 0.8125rem;
    text-align: center;
    color: var(--muted);
  }
  .elevation-sol {
    position: absolute;
    left: -1rem;
    right: -1rem;
    bottom: 0;
    display: block;
    border-top: 2px solid var(--line-strong);
  }

  /* ------------------------------- Les cotes que le reglement ne chiffre pas
     Meme carte, meme hierarchie : un intitule, la valeur en serif, la phrase
     du reglement et son article. Sans dessin, la carte reste pleine. */
  .manques {
    display: grid;
    gap: 1.25rem;
    padding-top: 1.25rem;
  }
  .manques-suite {
    margin-top: 0.25rem;
    border-top: 1px solid var(--line);
  }
  .manque dt {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .manque-valeur {
    margin-top: 0.4rem;
    max-width: 46ch;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--ink);
  }
  @media (min-width: 48rem) {
    .manque-valeur {
      font-size: 1.3125rem;
    }
  }
  .manque-precision {
    margin-top: 0.5rem;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ------------------------------------- Le repli de mise en contexte */
  .schema-detail {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .schema-resume {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 0 0.625rem;
    cursor: pointer;
    list-style: none;
  }
  .schema-resume::-webkit-details-marker {
    display: none;
  }
  .schema-resume:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .schema-resume-titre {
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--ink);
    transition: color 200ms var(--ease-out-quart);
  }
  .schema-marque {
    position: relative;
    flex: none;
    display: block;
    width: 0.875rem;
    height: 0.875rem;
  }
  .schema-marque-barre {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    margin-top: -0.5px;
    background: var(--accent);
    transition: transform 220ms var(--ease-out-quart);
  }
  .schema-marque-barre-v {
    transform: rotate(90deg);
  }
  .schema-detail[open] .schema-marque-barre-v {
    transform: rotate(90deg) scaleX(0);
  }
  @media (hover: hover) and (pointer: fine) {
    .schema-resume:hover .schema-resume-titre {
      color: var(--accent);
    }
  }
  /* Le script mesure cette enveloppe : elle doit couper ce qui depasse. */
  .schema-detail-corps {
    overflow: hidden;
    padding-bottom: 1.25rem;
  }

  .schema-notes {
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .schema-notes-suite {
    margin-top: 0.75rem;
  }
  .schema-formes {
    margin-top: 0.5rem;
    max-width: 62ch;
    display: grid;
    gap: 0.375rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .schema-formes li {
    position: relative;
    padding-left: 1.25rem;
  }
  .schema-formes li::before {
    content: "";
    position: absolute;
    top: 0.8em;
    left: 0;
    width: 0.75rem;
    height: 1px;
    background: var(--accent);
  }
  .schema-avertissement {
    margin-top: 0.75rem;
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .choix,
    .schema-marque-barre,
    .schema-resume-titre {
      transition: none;
    }
    .choix:active {
      transform: none;
    }
  }
</style>

<script is:inline>
  /* Deux onglets pour les deux vues, et la mise en evidence des cotes.
     Autonome : aucune dependance, rien a charger. Sans ce script, les deux
     vues restent affichees et les boutons restent [hidden]. */
  (function () {
    var figure = document.querySelector("[data-schema]");
    if (!figure) return;
    var groupe = figure.querySelector("[data-schema-choix]");
    var boutons = [].slice.call(figure.querySelectorAll("[data-schema-bouton]"));
    var vues = [].slice.call(figure.querySelectorAll("[data-schema-vue]"));
    /* Une seule vue (ou aucune) : pas d onglets du tout, un onglet unique
       serait un faux onglet. La mise en evidence a l entree reste. */
    var onglets = Boolean(groupe) && vues.length > 1 && boutons.length === vues.length;

    var doux = window.matchMedia("(prefers-reduced-motion: reduce)");
    var courbe = "cubic-bezier(0.25, 1, 0.5, 1)";

    /* Les roles n existent que si le script tourne : un lecteur d ecran sans
       JavaScript voit deux sections normales, pas des onglets sans pilote. */
    if (onglets) {
      groupe.removeAttribute("hidden");
      groupe.setAttribute("role", "tablist");
      boutons.forEach(function (bouton, index) {
        var vue = vues[index];
        bouton.setAttribute("role", "tab");
        bouton.setAttribute("aria-controls", "schema-vue-" + bouton.getAttribute("data-schema-bouton"));
        vue.id = "schema-vue-" + vue.getAttribute("data-schema-vue");
        vue.setAttribute("role", "tabpanel");
        vue.setAttribute("aria-labelledby", bouton.id);
        vue.setAttribute("tabindex", "0");
      });
    }

    function evidence(vue) {
      if (doux.matches) return;
      var pas = 0;
      var chiffre = vue.querySelector("[data-schema-chiffre]");
      if (chiffre) {
        chiffre.animate(
          [
            { opacity: 0, transform: "translateY(10px)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 320, easing: courbe },
        );
      }
      vue.querySelectorAll("[data-schema-guide]").forEach(function (guide) {
        var axe = guide.getAttribute("data-schema-guide") === "x" ? "scaleX" : "scaleY";
        guide.animate([{ transform: axe + "(0)" }, { transform: axe + "(1)" }], {
          duration: 300,
          delay: 60 + pas,
          easing: courbe,
        });
        pas += 60;
      });
      vue.querySelectorAll("[data-schema-cote]").forEach(function (cote, index) {
        cote.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 260,
          delay: 140 + index * 60,
          easing: "linear",
        });
      });
      var forme = vue.querySelector("[data-schema-forme]");
      if (forme) {
        forme.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 280, delay: 80, easing: courbe });
      }
    }

    function montre(index, deplaceFocus) {
      if (!onglets) return;
      boutons.forEach(function (bouton, i) {
        var choisi = i === index;
        bouton.setAttribute("aria-selected", choisi ? "true" : "false");
        bouton.tabIndex = choisi ? 0 : -1;
        if (choisi) vues[i].removeAttribute("hidden");
        else vues[i].setAttribute("hidden", "");
      });
      if (deplaceFocus) boutons[index].focus();
      evidence(vues[index]);
    }

    if (onglets) boutons.forEach(function (bouton, index) {
      bouton.addEventListener("click", function () {
        montre(index, false);
      });
      bouton.addEventListener("keydown", function (evenement) {
        var suivant = -1;
        if (evenement.key === "ArrowRight" || evenement.key === "ArrowDown") {
          suivant = (index + 1) % boutons.length;
        } else if (evenement.key === "ArrowLeft" || evenement.key === "ArrowUp") {
          suivant = (index - 1 + boutons.length) % boutons.length;
        } else if (evenement.key === "Home") suivant = 0;
        else if (evenement.key === "End") suivant = boutons.length - 1;
        if (suivant < 0) return;
        evenement.preventDefault();
        montre(suivant, true);
      });
    });

    /* Premiere mise en evidence quand le schema entre dans l ecran, une fois. */
    montre(0, false);
    if (!doux.matches && vues.length > 0 && "IntersectionObserver" in window) {
      var oeil = new IntersectionObserver(
        function (entrees) {
          entrees.forEach(function (entree) {
            if (!entree.isIntersecting) return;
            oeil.unobserve(entree.target);
            var visible = figure.querySelector("[data-schema-vue]:not([hidden])");
            if (visible) evidence(visible);
          });
        },
        { threshold: 0.25 },
      );
      oeil.observe(figure);
    }
  })();
</script>
