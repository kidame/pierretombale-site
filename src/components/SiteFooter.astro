---
import { entreprise, renseigne } from "@/config/entreprise";
import { siteConfig } from "@/config/site";

const year = new Date().getFullYear();

const columns = siteConfig.footerColumns;

/* Les coordonnées viennent de src/config/entreprise.ts et sont toutes à `null`
   au départ : on n'affiche que celles qui existent, et le bloc entier
   disparaît tant qu'on n'en connaît aucune. Jamais de faux numéro ni de lien
   mort dans le pied de page. */
const lignesContact = [
  renseigne(entreprise.telephone)
    ? { label: entreprise.telephone, href: `tel:${entreprise.telephone.replace(/\s+/g, "")}` }
    : null,
  renseigne(entreprise.email) ? { label: entreprise.email, href: `mailto:${entreprise.email}` } : null,
].filter((ligne): ligne is { label: string; href: string } => ligne !== null);

const adresse = [
  entreprise.rue,
  [entreprise.npa, entreprise.localite].filter(renseigne).join(" "),
  entreprise.canton,
].filter(renseigne);
---

<footer id="studio" class="mt-24 border-t border-line md:mt-36">
  {/* ------------------------------------------------------------ Newsletter */}
  <section class="shell border-b border-line py-16 md:py-24" aria-labelledby="newsletter-heading">
    <div class="mx-auto max-w-[34rem] text-center" data-reveal>
      <h2 id="newsletter-heading" class="type-h2">New pieces, one email at a time</h2>

      <form class="mx-auto mt-9 max-w-[24rem]" data-newsletter-form novalidate>
        <label class="sr-only" for="newsletter-email">Email address</label>
        <div class="newsletter-field">
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="email@example.com"
          />
        </div>
        <button type="submit" class="btn btn-primary mt-5 w-full" data-newsletter-button>Notify me</button>
        <p class="mono mt-4 min-h-[1rem] text-[0.6875rem] text-accent" data-newsletter-status role="status"></p>
      </form>
    </div>
  </section>

  {/* ----------------------------------------------------------------- Links */}
  <div class="shell pt-16">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-5">
        <p class="text-[0.9375rem] font-semibold uppercase tracking-[-0.01em]">{siteConfig.name}</p>
        <p class="type-body mt-4 max-w-[34ch] text-[0.9375rem]">{siteConfig.footerBlurb}</p>

        {
          (lignesContact.length > 0 || adresse.length > 0) && (
            <address class="mt-5 space-y-1 text-[0.9375rem] not-italic text-muted">
              {adresse.length > 0 && <p>{adresse.join(", ")}</p>}
              {lignesContact.map((ligne) => (
                <p>
                  <a href={ligne.href} class="link">
                    {ligne.label}
                  </a>
                </p>
              ))}
            </address>
          )
        }
      </div>

      {
        columns.map((column) => (
          <nav class="md:col-span-2 md:last:col-span-3" aria-label={column.heading}>
            <h2 class="label">{column.heading}</h2>
            <ul class="mt-5 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="link text-[0.9375rem] text-muted">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-20 border-t border-line py-8">
      <p class="mono text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
        © {year} {siteConfig.name} — all pieces made to order
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-newsletter-form]");
    if (!form) return;

    const button = form.querySelector("[data-newsletter-button]");
    const status = form.querySelector("[data-newsletter-status]");

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        status.textContent = "Please enter a valid email address.";
        form.reportValidity();
        return;
      }

      button.disabled = true;
      button.textContent = "Saving";
      window.setTimeout(() => {
        form.reset();
        button.disabled = false;
        button.textContent = "Notify me";
        status.textContent = "You're on the list. We'll be in touch.";
      }, 450);
    });
  })();
</script>
