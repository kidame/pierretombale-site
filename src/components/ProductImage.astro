---
import { visuelModele, type Product } from "@/data/products";

/**
 * Le visuel d un modele, dans une matiere (par defaut celle que la fiche
 * presente). Une seule balise <img> : les trois largeurs sont deja derivees
 * dans public/images/modeles, donc rien ne passe par `astro:assets` et le
 * build ne reencode aucune image.
 *
 * Les images sont CARREES. La classe passee par la page decide du cadrage
 * (`aspect-square object-contain` montre le monument entier) ; `width` et
 * `height` restent les dimensions reelles, pour que le navigateur reserve la
 * place avant le telechargement.
 *
 * `sizes` est la largeur que l image occupera : par defaut la moitie de la
 * fenetre a partir de 768 px, toute la fenetre en dessous. Une page qui pose
 * l image dans une colonne plus etroite doit le dire, sinon le navigateur
 * telecharge trop grand.
 */
interface Props {
  product: Product;
  /** Matiere montree. Defaut : `granitPresente` de la fiche. */
  matiere?: string;
  sizes?: string;
  class?: string;
  loading?: "eager" | "lazy";
  decoding?: "sync" | "async";
  /** "high" pour le visuel principal d une fiche (il est son plus grand element). */
  fetchpriority?: "high" | "low" | "auto";
  /** Remplace le texte alternatif genere (image decorative : passer ""). */
  alt?: string;
}

const {
  product,
  matiere,
  sizes = "(min-width: 768px) 50vw, 100vw",
  class: className,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  alt,
} = Astro.props;

const visuel = visuelModele(product, matiere);
---

<img
  src={visuel.src}
  srcset={visuel.srcset}
  sizes={sizes}
  width={visuel.width}
  height={visuel.height}
  alt={alt ?? visuel.alt}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  class={className}
/>
