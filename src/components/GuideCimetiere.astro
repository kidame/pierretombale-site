---
import MentionVerification from "@/components/MentionVerification.astro";
import NavBesoins from "@/components/guide/NavBesoins.astro";
import OngletsPossibilites from "@/components/guide/OngletsPossibilites.astro";
import SchemaDimensions from "@/components/guide/SchemaDimensions.astro";
import { LOI_CANTONALE, SOURCES } from "@/data/cimetieres-ne";
import {
  CIMETIERES_URL,
  PHRASE_SUR_MESURE,
  cimetiereUrl,
  devisUrl,
  itineraireUrl,
  mentionVerification,
  telUrl,
  type Cimetiere,
} from "@/data/cimetieres";
import { guideUrl } from "@/data/guides";
import { FAMILLE_LABELS, familleUrl } from "@/data/products";

/* Guide d un cimetiere, version 2 (10.11.2026, generalise aux neuf fiches le
   meme jour) : hero compose et compact, navigation par besoins avec etat
   actif, composant de dimensions, panneaux depliables animes, onglets des
   possibilites, une passe de mouvement a l entree des sections. C est la
   SEULE mise en page des pages cimetiere (src/pages/cimetieres/[slug].astro).

   Les neuf fiches ne publient pas les memes choses : chaque bloc est
   conditionnel, et rien n est dessine qui ne soit chiffre dans le reglement.
   Ce qui n est pas chiffre est ecrit en mots, avec sa phrase source et son
   article. Voir docs/UX-CIMETIERES-GENERALISATION.md pour le detail fiche
   par fiche.

   AUCUNE DONNEE ICI. Tout vient de src/data/cimetieres.ts, comme la mise en
   page d origine : chaque fait, chaque tarif, chaque source est celui de la
   fiche. Les nombres du schema sont relus dans les lignes du reglement, pour
   qu une correction de donnee corrige aussi le dessin.

   Trois composants portent les morceaux interactifs, chacun avec son style et
   son script autonome (src/components/guide/) : NavBesoins, SchemaDimensions,
   OngletsPossibilites. Tous les scripts sont is:inline et sans dependance :
   l export HTML autonome de la page garde ses comportements.

   Ce fichier est ecrit en ASCII : les libelles d interface nouveaux passent
   par des entites HTML (&#xe9;, &#xe8;, ...) ou par des echappements \uXXXX.
   Le texte des familles vient des donnees et garde ses accents. */

interface Props {
  /** Fiche affichee, espaces insecables deja posees par la page. */
  cimetiere: Cimetiere;
  /** Meme fiche, valeurs brutes : seules les fonctions d URL l utilisent. */
  donnees: Cimetiere;
  /** Le h1 exact, calcule par la page. */
  titrePrincipal: string;
  /** Les autres fiches, pour le maillage de fin de page. */
  autres: Cimetiere[];
}

const { cimetiere, donnees, titrePrincipal, autres } = Astro.props;

const aAcces = (cimetiere.acces?.length ?? 0) > 0;
const aProjets = (cimetiere.projets?.length ?? 0) > 0;
const aHistoire = (cimetiere.histoire?.length ?? 0) > 0;
const aEntretien = (cimetiere.entretien?.length ?? 0) > 0;

/* Une fiche sans adresse de cimetiere ne promet pas d itineraire : le lien
   d itineraire est une recherche sur le nom du cimetiere, elle n a de sens
   que si la fiche publie une adresse. Le Landeron, Le Locle et Val-de-Travers
   n en publient pas ; a leur place, le panneau nomme les localites
   desservies, qui sont dans les donnees. */
const aAdresse = Boolean(cimetiere.adresse);

/* Plusieurs cimetieres sous un seul reglement (Val-de-Travers) : les phrases
   d interface se mettent au pluriel. Le h1, le titre SEO et les textes des
   donnees ne sont pas touches. */
const pluriel = /^Cimeti[\u00e8e]res\b/.test(cimetiere.nom);

/* Navigation par besoins : les ancres historiques, des libelles qui disent ce
   que la personne cherche. Une entree n apparait que si sa section existe. */
const BESOINS = [
  { id: "infos-pratiques", titre: "Acc\u00e8s et contact", present: true },
  { id: "sur-place", titre: "Sur place", present: cimetiere.equipements.length > 0 },
  { id: "poser-un-monument", titre: "Pr\u00e9parer un monument", present: true },
  {
    id: "cendres",
    /* Trois communes ne publient aucun tarif : la navigation ne promet alors
       pas de tarifs (Le Landeron, Boudry, Cortaillod). */
    titre: cimetiere.tarifs ? "Urnes et tarifs" : "Urnes et cendres",
    present: cimetiere.cineraire.length > 0,
  },
  { id: "duree", titre: "Dur\u00e9e et entretien", present: true },
  { id: "questions", titre: "Questions", present: true },
].filter((besoin) => besoin.present);

/* Le bouton d appel dit de qui est le numero : c est le service communal de
   la fiche, jamais le notre. Le libelle suit le nom du service des donnees
   sans le rebaptiser : un office reste un office, un controle des habitants
   garde son nom, et le cimetiere de La Chaux-de-Fonds n est pas une
   administration. Le nom complet du service suit le bouton. */
const SERVICES = [
  { test: /office/i, libelle: "Appeler l'office" },
  { test: /administration/i, libelle: "Appeler l'administration" },
  { test: /contr\u00f4le des habitants/i, libelle: "Appeler le contr\u00f4le des habitants" },
  { test: /cimeti/i, libelle: "Appeler le cimeti\u00e8re" },
];
const libelleAppel =
  SERVICES.find((service) => service.test.test(cimetiere.contact.service))?.libelle ??
  "Appeler le guichet communal";

/* ------------------------------------------- Les cotes du reglement
   Le schema ne dessine QUE ce que le reglement chiffre explicitement, et il
   dit toujours de quelle forme il parle : une tombe, une stele et une croix
   n ont pas les memes cotes. Les deux vues sont independantes :
   - surface et hauteur chiffrees : les deux vues (Beauregard, Peseux,
     Corcelles-Cormondreche, Cortaillod) ;
   - surface seule, hauteur non publiee : la vue de dessus, et la hauteur
     ecrite en mots (Le Landeron, Boudry, Val-de-Travers) ;
   - hauteur seule, pas de surface publiee : la vue de hauteur (Le Locle) ;
   - rien de chiffre : aucun dessin, les deux cotes en mots avec leur
     article (La Chaux-de-Fonds, dont le reglement renvoie aux plans de
     l administration).
   Une correction dans src/data/cimetieres.ts corrige donc aussi le dessin. */

/** Types de sepulture qui ne sont pas celle d un adulte. */
const SANS_ADULTE = /(cr[\u00e9e]mation|incin[\u00e9e]ration|cin[\u00e9e]raire)/i;
const pourAdulte = (type: string) =>
  !SANS_ADULTE.test(type) && (!/enfant/i.test(type) || /adulte/i.test(type));

/* Vue de dessus : la surface au sol d une tombe d adulte. La fosse de
   La Chaux-de-Fonds (200 x 80 cm, art. 21, publiee « pour memoire ») est une
   fosse creusee, pas l emprise d un monument : elle est exclue. */
const ligneSurface = cimetiere.regles.tombes.find(
  (tombe) =>
    /(surface de la tombe|tombe d'adulte)/i.test(tombe.type) &&
    pourAdulte(tombe.type) &&
    !/(fosse|m[\u00e9e]moire)/i.test(tombe.type) &&
    /\d+\s*[x\u00d7]\s*\d+/.test(tombe.dimensions),
);
const mesuresSurface = ligneSurface?.dimensions.match(/(\d+)\s*[x\u00d7]\s*(\d+)/);
const vueDessus =
  ligneSurface && mesuresSurface
    ? {
        /* Le grand chiffre garde l ordre du reglement (« 180 x 80 cm ») ; le
           dessin, lui, met le plus petit nombre en largeur, comme une tombe
           se presente quand on se tient a son pied. Pour Corcelles (70 x 130)
           les deux coincident : le dessin valide ne change pas. */
        premierCm: Number(mesuresSurface[1]),
        secondCm: Number(mesuresSurface[2]),
        largeurCm: Math.min(Number(mesuresSurface[1]), Number(mesuresSurface[2])),
        profondeurCm: Math.max(Number(mesuresSurface[1]), Number(mesuresSurface[2])),
        type: ligneSurface.type,
        article: ligneSurface.article,
      }
    : null;

/* Vue de hauteur : la premiere forme d adulte dont la hauteur est chiffree.
   Les autres formes chiffrees (croix, obelisque) sont nommees sous le dessin :
   a Beauregard la stele monte a 120 cm et la croix a 140 cm, ce n est pas la
   meme cote. Les hauteurs d enfant et d incineration restent dans le tableau. */
const lignesHauteur = cimetiere.regles.tombes.filter(
  (tombe) => tombe.hauteurMax && /\d/.test(tombe.hauteurMax) && pourAdulte(tombe.type),
);
const ligneHauteur = lignesHauteur[0];
const mesureHauteur = ligneHauteur?.hauteurMax?.match(/(\d+)/);
/* Largeur dessinee seulement si le reglement l ecrit en clair (« 70 cm de
   large ») ; sinon le dessin dit « a confirmer » et garde la phrase source. */
const mesureLargeur = ligneHauteur?.dimensions.match(/(\d+)\s*cm de large/i);
const vueHauteur =
  ligneHauteur && mesureHauteur
    ? {
        hauteurCm: Number(mesureHauteur[1]),
        largeurCm: mesureLargeur ? Number(mesureLargeur[1]) : null,
        forme: ligneHauteur.type,
        hauteurTexte: ligneHauteur.hauteurMax as string,
        article: ligneHauteur.article,
        largeurTexte: ligneHauteur.dimensions,
      }
    : null;
const autresFormes = lignesHauteur.slice(1).map((tombe) => ({
  type: tombe.type,
  hauteur: tombe.hauteurMax as string,
  article: tombe.article,
}));

/* Ce que le reglement ne chiffre pas reste ecrit, avec sa phrase source et
   son article : une cote absente se lit, elle ne se devine pas. */
const ligneHauteurMots = cimetiere.regles.tombes.find(
  (tombe) => /hauteur/i.test(tombe.type) && !/\d+\s*[x\u00d7]\s*\d+/.test(tombe.dimensions),
);
const ligneMonumentMots = cimetiere.regles.tombes.find(
  (tombe) => /monument/i.test(tombe.type) && !/\d/.test(tombe.dimensions),
);
/* La carte ne repete pas les valeurs des reperes (elles sont en clair juste a
   cote quand le schema ne les dessine pas) : elle porte la phrase du
   reglement qui explique pourquoi la cote n est pas chiffree. */
const manques: { intitule: string; texte: string; article: string }[] = [];
if (!vueDessus && ligneMonumentMots) {
  manques.push({
    intitule: "Dimensions du monument",
    texte: ligneMonumentMots.dimensions,
    article: ligneMonumentMots.article,
  });
}
if (!vueHauteur && ligneHauteurMots) {
  manques.push({
    intitule: "Hauteur du monument",
    texte: ligneHauteurMots.dimensions,
    article: ligneHauteurMots.article,
  });
}

/* Les trois reperes du monument, contextualises par la ligne de reglement
   d ou vient le chiffre. Aucun texte nouveau : le delai est la phrase du
   reglement, les deux autres portent le type de sepulture et son article. */
const reperes = [
  {
    intitule: "D\u00e9lai avant la pose",
    valeur: cimetiere.chiffres.delai,
    precision: cimetiere.regles.delaiPose,
    /* Le delai reste toujours en clair : c est le seul des trois qui decide
       d une date. */
    dessine: false,
  },
  {
    /* L intitule suit la valeur : Le Locle publie la largeur d une stele, pas
       la surface d une tombe. Une stele n est pas une tombe. */
    intitule: /^st[\u00e8e]le/i.test(cimetiere.chiffres.tombeAdulte)
      ? "St\u00e8le d'adulte"
      : /^monument/i.test(cimetiere.chiffres.tombeAdulte)
        ? "Monument d'adulte"
        : "Tombe d'adulte",
    valeur: cimetiere.chiffres.tombeAdulte,
    precision: ligneSurface ? `${ligneSurface.type}, ${ligneSurface.article}.` : undefined,
    dessine: Boolean(vueDessus),
  },
  {
    intitule: "Hauteur maximale",
    valeur: cimetiere.chiffres.hauteurMax,
    precision: ligneHauteur
      ? `${ligneHauteur.type}, ${ligneHauteur.article}. ${ligneHauteur.dimensions}.`
      : undefined,
    dessine: Boolean(vueHauteur),
  },
];
/* Un repere ne passe dans le repli que si le schema dessine deja son chiffre
   en grand : l ecrire deux fois en gros le dedoublait. Sinon il reste en
   clair, pour qu une cote essentielle ne soit jamais cachee : une hauteur non
   publiee (Le Landeron, Boudry) se lit tout de suite. Les valeurs et les
   precisions sont gardees mot pour mot dans les deux cas. */
const reperesClairs = reperes.filter((repere) => !repere.dessine);
const reperesReplies = reperes.filter((repere) => repere.dessine);

/* Les titres des deux replis du reglement ne nomment que ce qu ils
   contiennent : Boudry et Cortaillod ne publient pas d autorisation,
   Le Landeron et Cortaillod ne publient pas de regle de materiaux. */
function enumere(mots: string[]): string {
  const titre = mots.length > 1 ? `${mots.slice(0, -1).join(", ")} et ${mots[mots.length - 1]}` : mots[0];
  return titre.charAt(0).toUpperCase() + titre.slice(1);
}
const titreAutorisation = enumere(
  [
    cimetiere.regles.autorisation ? "autorisation" : null,
    "bordure",
    cimetiere.regles.taxePose ? "taxe de pose" : null,
  ].filter((mot): mot is string => mot !== null),
);
const titreMateriaux = enumere(
  [
    cimetiere.regles.materiaux ? "mat\u00e9riaux" : null,
    cimetiere.regles.obligations.length > 0 ? "obligations de l'entreprise" : null,
  ].filter((mot): mot is string => mot !== null),
);

/* Les cendres, rangees par possibilite. Une ligne qui ne parle que d une
   possibilite va dans son groupe. Une ligne qui en concerne PLUSIEURS (une
   urne dans une tombe « ou » dans une niche) n est pas rangee de force dans
   la premiere reconnue : elle va dans un groupe qui le dit. Ce que personne
   ne reconnait est garde a la fin. Rien n est retire, rien n est reecrit. */
const POSSIBILITES = [
  { titre: "Au columbarium", test: /columbarium|niche|mur cin[\u00e9e]raire/i },
  { titre: "Au jardin du souvenir", test: /jardin du souvenir/i },
  { titre: "Dans une tombe", test: /tombe/i },
];
const groupesCendres: { titre: string; lignes: string[] }[] = [];
{
  const groupes = POSSIBILITES.map((possibilite) => ({ titre: possibilite.titre, lignes: [] as string[] }));
  const plusieurs: string[] = [];
  const reste: string[] = [];
  for (const ligne of cimetiere.cineraire) {
    const trouves = POSSIBILITES.map((possibilite, index) => (possibilite.test.test(ligne) ? index : -1)).filter(
      (index) => index >= 0,
    );
    if (trouves.length === 1) groupes[trouves[0]].lignes.push(ligne);
    else if (trouves.length > 1) plusieurs.push(ligne);
    else reste.push(ligne);
  }
  for (const groupe of groupes) {
    if (groupe.lignes.length === 0) continue;
    /* Le mot de la commune : Le Locle parle de mur cineraire, pas de
       columbarium. On suit ses lignes plutot que le mot generique. */
    if (groupe.titre === "Au columbarium" && !groupe.lignes.some((ligne) => /columbarium/i.test(ligne))) {
      groupe.titre = groupe.lignes.some((ligne) => /mur cin[\u00e9e]raire/i.test(ligne))
        ? "Au mur cin\u00e9raire"
        : "Dans une niche";
    }
    groupesCendres.push(groupe);
  }
  if (plusieurs.length > 0) groupesCendres.push({ titre: "Plusieurs possibilit\u00e9s", lignes: plusieurs });
  if (reste.length > 0) groupesCendres.push({ titre: "\u00c0 savoir aussi", lignes: reste });
}

---

<div class="guide">
  {/* ------------------------------------------------------------ Hero */}
  <section class="shell guide-hero" aria-labelledby="titre-cimetiere">
    <span class="hero-voile" aria-hidden="true"></span>

    <div class="hero-titre" data-entree data-entree-decalage="0">
      <nav class="fil" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={CIMETIERES_URL}>Cimeti&#xe8;res</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{cimetiere.nom}</span>
      </nav>
      <p class="label hero-commune">
        <span class="hero-trait" data-hero-trait aria-hidden="true"></span>
        {cimetiere.commune}
      </p>
      <h1 class="type-h1 hero-h1" id="titre-cimetiere">{titrePrincipal}</h1>
    </div>

    <p class="type-lead hero-chapo" data-entree data-entree-decalage="120">{cimetiere.chapo}</p>

    <aside
      class="panneau nuit"
      id="infos-pratiques"
      aria-labelledby="panneau-titre"
      data-entree
      data-entree-decalage="60"
    >
      <p class="label panneau-titre" id="panneau-titre">Infos pratiques</p>

      {/* L itineraire n est propose que si la fiche publie une adresse : sans
          adresse, le lien serait une recherche sur un nom qui couvre
          plusieurs villages. Le premier bouton present porte l action
          principale. */}
      {
        (aAdresse || cimetiere.contact.telephone) && (
          <div class="panneau-actions">
            <div class="panneau-boutons">
              {aAdresse && (
                <a href={itineraireUrl(donnees)} class="btn btn-primary" rel="noopener nofollow">
                  Itin&#xe9;raire
                </a>
              )}
              {cimetiere.contact.telephone && (
                <a
                  href={telUrl(donnees.contact.telephone as string)}
                  class={aAdresse ? "btn btn-outline" : "btn btn-primary"}
                >
                  {libelleAppel}
                  <span class="sr-only"> : {cimetiere.contact.service}</span>
                </a>
              )}
            </div>
            {cimetiere.contact.telephone && <p class="panneau-legende">{cimetiere.contact.service}</p>}
          </div>
        )
      }

      <dl class="panneau-infos">
        {
          cimetiere.adresse ? (
            <div>
              <dt>Adresse</dt>
              <dd>{cimetiere.adresse}</dd>
            </div>
          ) : (
            /* Pas d adresse publiee : on dit ce que la fiche sait, les
               localites desservies. Val-de-Travers en compte six. */
            <div>
              <dt>Localit&#xe9;s desservies</dt>
              <dd>{cimetiere.localites.join(", ")}</dd>
            </div>
          )
        }
        {
          cimetiere.horaires && (
            <div>
              <dt>Horaires du cimeti&#xe8;re</dt>
              <dd>{cimetiere.horaires}</dd>
            </div>
          )
        }
      </dl>

      <details class="panneau-admin repli-anime">
        <summary class="admin-summary">
          <span>Acc&#xe8;s et coordonn&#xe9;es du guichet</span>
          <span class="marque" aria-hidden="true">
            <span class="marque-barre"></span>
            <span class="marque-barre marque-barre-v"></span>
          </span>
        </summary>
        <div class="repli-corps admin-corps">
          {
            aAcces && (
              <ul class="admin-acces">
                {cimetiere.acces?.map((ligne) => <li>{ligne}</li>)}
              </ul>
            )
          }
          <p class="admin-service">
            {
              cimetiere.contact.url ? (
                <a href={cimetiere.contact.url} class="link" rel="noopener">
                  {cimetiere.contact.service}
                </a>
              ) : (
                <span>{cimetiere.contact.service}</span>
              )
            }
          </p>
          <ul class="admin-lignes">
            {cimetiere.contact.adresse && <li>{cimetiere.contact.adresse}</li>}
            {
              cimetiere.contact.telephone && (
                <li>
                  <a href={telUrl(donnees.contact.telephone as string)} class="link">
                    {cimetiere.contact.telephone}
                  </a>
                </li>
              )
            }
            {cimetiere.contact.telephoneSecondaire && <li>{cimetiere.contact.telephoneSecondaire}</li>}
            {
              cimetiere.contact.email && (
                <li>
                  <a href={`mailto:${cimetiere.contact.email}`} class="link">
                    {cimetiere.contact.email}
                  </a>
                </li>
              )
            }
            {cimetiere.contact.horaires && <li>{cimetiere.contact.horaires}</li>}
          </ul>
          <p class="admin-note">Les demandes de concession et de permis de pose sont trait&#xe9;es par ce service communal.</p>
        </div>
      </details>
    </aside>
  </section>

  {/* ------------------------------------------- Rail de navigation + flux */}
  <div class="shell guide-corps">
    <NavBesoins besoins={BESOINS} />

    <div class="guide-flux">
      {/* ---------------------------------------------------- Sur place */}
      {
        cimetiere.equipements.length > 0 && (
          <section class="bloc" id="sur-place" aria-labelledby="titre-sur-place" data-entree>
            <p class="label">Venir</p>
            <h2 class="type-h2 bloc-titre" id="titre-sur-place">
              Sur place
            </h2>
            <ul class={cimetiere.equipements.length >= 4 ? "faits faits-colonnes" : "faits"}>
              {cimetiere.equipements.map((ligne) => (
                <li>{ligne}</li>
              ))}
            </ul>

            {aProjets && (
              <aside class="encadre">
                <h3 class="encadre-titre">Ce qui change bient&#xf4;t</h3>
                {cimetiere.projets?.map((ligne) => <p>{ligne}</p>)}
              </aside>
            )}

            {aHistoire && (
              <details class="repli repli-anime">
                <summary>
                  <span class="repli-titre">Histoire et patrimoine</span>
                  <span class="marque" aria-hidden="true">
                    <span class="marque-barre" />
                    <span class="marque-barre marque-barre-v" />
                  </span>
                </summary>
                <div class="repli-corps">
                  {cimetiere.histoire?.map((ligne) => <p>{ligne}</p>)}
                </div>
              </details>
            )}
          </section>
        )
      }

      {/* -------------------------------------------- Poser un monument */}
      <section class="bloc" id="poser-un-monument" aria-labelledby="titre-monument" data-entree>
        <p class="label">Pr&#xe9;parer un monument</p>
        <h2 class="type-h2 bloc-titre" id="titre-monument">Poser un monument</h2>

        {/* Sous-section 1 : les cotes. */}
        <div class="sous-bloc">
          <h3 class="sous-titre type-h3">Les cotes &#xe0; retenir</h3>
          <div class="monument-haut">
            <div class="reperes">
              <dl class="repere-cle">
                {
                  reperesClairs.map((repere) => (
                    <div class="repere-cle-ligne">
                      <dt>{repere.intitule}</dt>
                      <dd class="repere-valeur">{repere.valeur}</dd>
                    </div>
                  ))
                }
              </dl>
              <details class="repli repli-anime reperes-repli">
                <summary>
                  <span class="repli-titre">Les pr&#xe9;cisions du r&#xe8;glement</span>
                  <span class="marque" aria-hidden="true">
                    <span class="marque-barre" />
                    <span class="marque-barre marque-barre-v" />
                  </span>
                </summary>
                <div class="repli-corps">
                  {reperes[0].precision && <p>{reperes[0].precision}</p>}
                  <dl class="reperes-liste">
                    {reperesReplies.map((repere) => (
                      <div class="repere-ligne">
                        <dt>{repere.intitule}</dt>
                        <dd class="repere-valeur-petite">{repere.valeur}</dd>
                        {repere.precision && <dd class="repere-precision">{repere.precision}</dd>}
                      </div>
                    ))}
                  </dl>
                </div>
              </details>
              {/* Sous-section 2 : le reglement, en replis ranges l un sous l autre.
                  Seule la periode d interdiction reste en clair : c est la seule
                  regle qui peut deplacer une date. Les autres phrases sont dans le
                  HTML, a l interieur de replis nommes. */}
              <div class="sous-bloc">
                <h3 class="sous-titre type-h3">Ce que demande le r&#xe8;glement</h3>
                {
                  cimetiere.regles.periodeInterdite && (
                    <div class="prose">
                      <p>
                        <strong>P&#xe9;riode o&#xf9; la pose est interdite.</strong>{" "}
                        {cimetiere.regles.periodeInterdite}
                      </p>
                    </div>
                  )
                }
                <div class="replis">
                  <details class="repli repli-anime">
                    <summary>
                      <span class="repli-titre">{titreAutorisation}</span>
                      <span class="marque" aria-hidden="true">
                        <span class="marque-barre" />
                        <span class="marque-barre marque-barre-v" />
                      </span>
                    </summary>
                    <div class="repli-corps">
                      {cimetiere.regles.autorisation && (
                        <p>
                          <strong>Autorisation.</strong> {cimetiere.regles.autorisation}
                        </p>
                      )}
                      <p>
                        <strong>Bordure et entourage.</strong> {cimetiere.regles.bordure}
                      </p>
                      {cimetiere.regles.taxePose && (
                        <p>
                          <strong>Taxe communale de pose.</strong> {cimetiere.regles.taxePose}
                        </p>
                      )}
                    </div>
                  </details>
                  {
                    (cimetiere.regles.materiaux || cimetiere.regles.obligations.length > 0) && (
                      <details class="repli repli-anime">
                        <summary>
                          <span class="repli-titre">{titreMateriaux}</span>
                          <span class="marque" aria-hidden="true">
                            <span class="marque-barre" />
                            <span class="marque-barre marque-barre-v" />
                          </span>
                        </summary>
                        <div class="repli-corps">
                          {cimetiere.regles.materiaux && (
                            <p>
                              <strong>Mat&#xe9;riaux.</strong> {cimetiere.regles.materiaux}
                            </p>
                          )}
                          {cimetiere.regles.obligations.length > 0 && (
                            <>
                              <h4 class="repli-sous-titre">Ce que le r&#xe8;glement impose en plus</h4>
                              <ul class="faits">
                                {cimetiere.regles.obligations.map((ligne) => (
                                  <li>{ligne}</li>
                                ))}
                              </ul>
                            </>
                          )}
                        </div>
                      </details>
                    )
                  }

                  <details class="repli repli-anime">
                    <summary>
                      <span class="repli-titre" id="titre-dimensions">
                        Tableau complet des dimensions autoris&#xe9;es
                      </span>
                      <span class="marque" aria-hidden="true">
                        <span class="marque-barre" />
                        <span class="marque-barre marque-barre-v" />
                      </span>
                    </summary>
                    <div class="repli-corps repli-large">
                      <p class="indice">
                        Tableau complet&#xa0;: sur t&#xe9;l&#xe9;phone, il se fait d&#xe9;filer
                        lat&#xe9;ralement.
                      </p>
                      <div class="tableau" role="region" aria-labelledby="titre-dimensions" tabindex="0">
                        <table class="tableau-grille">
                          <caption>
                            Dimensions et hauteurs autoris&#xe9;es par type de s&#xe9;pulture, avec
                            l'article du r&#xe8;glement.
                          </caption>
                          <thead>
                            <tr>
                              <th scope="col">Type</th>
                              <th scope="col">Dimensions</th>
                              <th scope="col">Hauteur maximale</th>
                              <th scope="col">Article</th>
                            </tr>
                          </thead>
                          <tbody>
                            {
                              cimetiere.regles.tombes.map((tombe) => (
                                <tr>
                                  <th scope="row">{tombe.type}</th>
                                  <td>{tombe.dimensions}</td>
                                  <td>{tombe.hauteurMax ?? "Non publi\u00e9e"}</td>
                                  <td>{tombe.article}</td>
                                </tr>
                              ))
                            }
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </details>
                </div>
              </div>
            </div>
            <SchemaDimensions
              dessus={vueDessus}
              hauteur={vueHauteur}
              manques={manques}
              autresFormes={autresFormes}
            />
          </div>
        </div>


      </section>

      {/* ------------------------------------------- Appel commercial */}
      <section class="bloc projet nuit" aria-labelledby="titre-projet" data-entree>
        <p class="label">Votre projet</p>
        <h2 class="type-h2 bloc-titre" id="titre-projet">
          {pluriel ? "Votre projet dans ces cimeti\u00e8res" : "Votre projet dans ce cimeti\u00e8re"}
        </h2>
        <p class="projet-texte">
          Dites-nous le type de s&#xe9;pulture et, si vous le connaissez, le num&#xe9;ro de la
          tombe. Nous v&#xe9;rifions le r&#xe8;glement, nous adaptons le monument aux dimensions
          autoris&#xe9;es, nous d&#xe9;posons la demande de pose et nous &#xe9;tablissons un devis
          gratuit.
        </p>
        <p class="projet-texte">{PHRASE_SUR_MESURE}</p>
        <div class="projet-actions">
          <a href={devisUrl(donnees)} class="btn btn-primary">Demander un devis</a>
          <a href={familleUrl("monument")} class="btn btn-outline">{FAMILLE_LABELS.monument}</a>
        </div>
        <p class="projet-note">
          Page d'information ind&#xe9;pendante, r&#xe9;dig&#xe9;e par PierreTombale.ch. Pour les
          d&#xe9;marches officielles&#xa0;:{" "}
          {
            cimetiere.contact.url ? (
              <a href={cimetiere.contact.url} class="link" rel="noopener">
                {cimetiere.contact.service}
              </a>
            ) : (
              <span>{cimetiere.contact.service}</span>
            )
          }. Informations v&#xe9;rifi&#xe9;es le {cimetiere.verifieLe}&#xa0;:{" "}
          <a href="#sources" class="link">voir les documents officiels</a>.
        </p>
      </section>

      {/* ------------------------------------ Urnes et jardin du souvenir */}
      {
        cimetiere.cineraire.length > 0 && (
          <section class="bloc" id="cendres" aria-labelledby="titre-cendres" data-entree>
            <p class="label">{cimetiere.tarifs ? "Urnes et tarifs" : "Urnes et cendres"}</p>
            <h2 class="type-h2 bloc-titre" id="titre-cendres">
              Urnes, columbarium et jardin du souvenir
            </h2>

            <OngletsPossibilites groupes={groupesCendres} />

            {cimetiere.tarifs && (
              <div class="sous-bloc">
                <h3 class="sous-titre type-h3">Tarifs officiels de la commune</h3>
                <p class="prose-note">
                  Ce sont des taxes communales, pas des prix de monument. Source&#xa0;:{" "}
                  {cimetiere.tarifs.date}.
                </p>
                <div class="replis">
                  <details class="repli repli-anime">
                    <summary>
                      <span class="repli-titre" id="titre-tarifs">
                        Tableau des taxes communales
                      </span>
                      <span class="marque" aria-hidden="true">
                        <span class="marque-barre" />
                        <span class="marque-barre marque-barre-v" />
                      </span>
                    </summary>
                    <div class="repli-corps repli-large">
                      <p class="indice">
                        Tableau complet&#xa0;: sur t&#xe9;l&#xe9;phone, il se fait d&#xe9;filer
                        lat&#xe9;ralement.
                      </p>
                      <div class="tableau" role="region" aria-labelledby="titre-tarifs" tabindex="0">
                        <table class="tableau-grille">
                          <caption>
                            Taxes communales par prestation, pour une personne domicili&#xe9;e dans
                            la commune et pour une personne de l'ext&#xe9;rieur.
                          </caption>
                          <thead>
                            <tr>
                              <th scope="col">Prestation</th>
                              <th scope="col">Domicili&#xe9;</th>
                              <th scope="col">Ext&#xe9;rieur</th>
                            </tr>
                          </thead>
                          <tbody>
                            {cimetiere.tarifs.lignes.map((ligne) => (
                              <tr>
                                <th scope="row">{ligne.prestation}</th>
                                <td>{ligne.domicilie}</td>
                                <td>{ligne.exterieur ?? "Non publi\u00e9"}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                      {cimetiere.tarifs.note && <p class="prose-note">{cimetiere.tarifs.note}</p>}
                      <p class="prose-note">
                        {cimetiere.tarifs.source ? (
                          <a href={SOURCES[cimetiere.tarifs.source].url} class="link" rel="noopener">
                            {SOURCES[cimetiere.tarifs.source].libelle}
                          </a>
                        ) : (
                          <span>{cimetiere.tarifs.sourceLibelle}</span>
                        )}
                      </p>
                    </div>
                  </details>
                </div>
              </div>
            )}
          </section>
        )
      }

      {/* ------------------------------------------ Duree et entretien */}
      <section class="bloc" id="duree" aria-labelledby="titre-duree" data-entree>
        <p class="label">Dur&#xe9;e et entretien</p>
        <h2 class="type-h2 bloc-titre" id="titre-duree">
          Dur&#xe9;e de la tombe et reprise du monument
        </h2>
        <ul class="faits">
          {cimetiere.duree.map((ligne) => <li>{ligne}</li>)}
        </ul>

        {
          aEntretien && (
            <div class="sous-bloc">
              <h3 class="sous-titre type-h3">Entretien</h3>
              <ul class="faits">
                {cimetiere.entretien?.map((ligne) => <li>{ligne}</li>)}
              </ul>
            </div>
          )
        }
      </section>

      {/* ------------------------------------------------------- Questions */}
      <section class="bloc" id="questions" aria-labelledby="titre-questions" data-entree>
        <p class="label">Questions</p>
        <h2 class="type-h2 bloc-titre" id="titre-questions">
          Questions fr&#xe9;quentes&#xa0;: {cimetiere.nom}
        </h2>
        <div class="faq replis">
          {
            cimetiere.faq.map((item, index) => (
              <details class="repli repli-anime" open={index === 0}>
                <summary>
                  <span class="repli-titre">{item.question}</span>
                  <span class="marque" aria-hidden="true">
                    <span class="marque-barre" />
                    <span class="marque-barre marque-barre-v" />
                  </span>
                </summary>
                <div class="repli-corps">
                  <p>{item.reponse}</p>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      {/* ------------------------------------------- Documents officiels */}
      <section class="bloc" id="sources" aria-labelledby="titre-sources" data-entree>
        <p class="label">Sources</p>
        <h2 class="type-h2 bloc-titre" id="titre-sources">Documents officiels</h2>
        <p class="prose-note">
          Les textes d'o&#xf9; viennent les r&#xe8;gles de cette page. La {LOI_CANTONALE} laisse
          les monuments aux conditions fix&#xe9;es par la commune (art.&#xa0;9).
        </p>
        <ul class="sources-liste">
          {
            cimetiere.sources.map((id) => (
              <li>
                <a href={SOURCES[id].url} class="link" rel="noopener">
                  {SOURCES[id].libelle}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="sources-mention">
          <MentionVerification texte={mentionVerification(cimetiere.verifieLe)} />
        </div>
      </section>
    </div>
  </div>

  {/* ------------------------------------------------- Autres cimetieres */}
  <section class="shell guide-ailleurs" aria-labelledby="titre-ailleurs" data-entree>
    <h2 class="type-h2" id="titre-ailleurs">Autres cimeti&#xe8;res</h2>
    <div class="replis ailleurs-replis">
      <details class="repli repli-anime">
        <summary>
          <span class="repli-titre">
            Les {autres.length} autres cimeti&#xe8;res de la liste
          </span>
          <span class="marque" aria-hidden="true">
            <span class="marque-barre" />
            <span class="marque-barre marque-barre-v" />
          </span>
        </summary>
        <div class="repli-corps repli-large">
          <ul class="ailleurs-liste">
            {
              autres.map((autre) => (
                <li>
                  <a href={cimetiereUrl(autre.slug)} class="link ailleurs-lien">
                    {autre.nom}
                  </a>
                  <p>
                    {autre.commune} &#xb7; d&#xe9;lai de pose&#xa0;:{" "}
                    {autre.chiffres.delai.toLowerCase()}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>

    <ul class="ailleurs-liste ailleurs-parcours">
      <li>
        <a href={CIMETIERES_URL} class="link ailleurs-lien">Tous les cimeti&#xe8;res du canton</a>
        <p>Le tableau des 24 communes&#xa0;: d&#xe9;lai, dimensions, hauteur et bordure.</p>
      </li>
      <li>
        <a href={guideUrl("quand-poser-une-pierre-tombale")} class="link ailleurs-lien">
          Quand poser une pierre tombale
        </a>
        <p>Les d&#xe9;lais, les autorisations et les taxes communales, commune par commune.</p>
      </li>
      <li>
        <a href={guideUrl("columbarium-cavurne-jardin-du-souvenir")} class="link ailleurs-lien">
          Columbarium, cavurne et jardin du souvenir
        </a>
        <p>Ce que recouvre chaque mot, les dur&#xe9;es, le nombre d'urnes et les tarifs officiels.</p>
      </li>
    </ul>
  </section>
</div>

<style>
  /* Une seule feuille, portee par le composant (les trois composants de
     src/components/guide/ portent la leur). Rien ici ne code une couleur :
     tout passe par les jetons de src/styles.css (ivoire, anthracite, bronze).
     Corps a 17 px, lignes sous 75 caracteres, cibles tactiles 44 px au moins. */

  .guide {
    --rail: 13.5rem;
  }

  /* ---------------------------------------------------------------- Hero
     Trois morceaux : le titre, le panneau pratique compact, le chapo. Sur
     telephone le panneau remonte juste sous le titre, et ses deux actions
     sont en tete du panneau : l adresse, les horaires, l itineraire et
     l appel tiennent dans le premier ecran de 390 x 844. */
  .guide-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  /* Voile bronze : une teinte, aucune animation, aucune image. */
  .hero-voile {
    position: absolute;
    inset: -1rem 0 auto;
    height: 22rem;
    background: radial-gradient(
      70% 100% at 18% 0%,
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  .hero-titre,
  .hero-chapo,
  .panneau {
    position: relative;
  }
  /* Ordre a l ecran sur telephone : titre, panneau pratique, chapo. */
  .hero-titre {
    order: 1;
  }
  .panneau {
    order: 2;
  }
  .hero-chapo {
    order: 3;
  }
  .fil {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .fil a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .hero-commune {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  /* Le seul trace decoratif de la page : un filet bronze qui se dessine une
     fois au chargement, a cote de la commune. */
  .hero-trait {
    display: block;
    width: 2.5rem;
    height: 1px;
    flex: none;
    background: var(--accent);
    transform-origin: left center;
  }
  .hero-h1 {
    margin-top: 0.625rem;
    max-width: 22ch;
  }
  .hero-chapo {
    max-width: 58ch;
  }

  @media (min-width: 64rem) {
    .guide-hero {
      grid-template-areas:
        "titre panneau"
        "chapo panneau";
      grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.8fr);
      grid-template-rows: auto 1fr;
      align-items: start;
      column-gap: 4rem;
      row-gap: 1.5rem;
      padding-top: 1.75rem;
      padding-bottom: 2.5rem;
    }
    .hero-titre,
    .hero-chapo,
    .panneau {
      order: 0;
    }
    .hero-titre {
      grid-area: titre;
    }
    .hero-chapo {
      grid-area: chapo;
      align-self: start;
    }
    .panneau {
      grid-area: panneau;
    }
  }

  /* --------------------------------------- Panneau pratique, compact */
  .panneau {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1px solid var(--line-strong);
    padding: 1.25rem;
  }
  @media (min-width: 48rem) {
    .panneau {
      padding: 1.5rem 1.625rem;
    }
  }
  .panneau-titre {
    color: var(--muted);
  }
  .panneau-boutons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .panneau-boutons .btn {
    flex: 1 1 8rem;
  }
  .panneau-legende {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Les deux informations qu on cherche en arrivant, en deux lignes serrees. */
  .panneau-infos {
    display: grid;
    gap: 0.875rem;
    border-top: 1px solid var(--line);
    padding-top: 1.125rem;
  }
  .panneau-infos dt {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .panneau-infos dd {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    max-width: 44ch;
  }

  .panneau-admin {
    border-top: 1px solid var(--line);
  }
  .admin-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding-top: 0.75rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .admin-summary::-webkit-details-marker {
    display: none;
  }
  .admin-summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  .admin-corps {
    padding-bottom: 0.25rem;
  }
  .admin-acces {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.4rem;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .admin-service {
    margin-top: 0.875rem;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .admin-lignes {
    margin-top: 0.625rem;
    display: grid;
    gap: 0.4rem;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .admin-note {
    margin-top: 0.875rem;
    max-width: 44ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .admin-lignes a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
  }
  .panneau a:focus-visible {
    outline-offset: 4px;
  }
  #infos-pratiques {
    scroll-margin-top: calc(4.5rem + 4rem);
  }
  @media (min-width: 64rem) {
    #infos-pratiques {
      scroll-margin-top: 1.5rem;
    }
  }

  /* --------------------------------------------- Rail et colonne de texte */
  /* Sous 1024 px, mise en page en bloc : la barre de navigation collee a
     besoin d un conteneur aussi haut que la page, ce qu une rangee de grille
     ne lui donnerait pas. A partir de 1024 px, deux colonnes et le rail
     colle dans la sienne (align-items: start). */
  .guide-corps {
    padding-bottom: 2.5rem;
  }
  .guide-flux {
    min-width: 0;
    max-width: 64rem;
  }
  @media (min-width: 64rem) {
    .guide-corps {
      display: grid;
      grid-template-columns: var(--rail) minmax(0, 1fr);
      column-gap: 4.5rem;
      align-items: start;
      padding-bottom: 4rem;
    }
  }

  /* ---------------------------------------------------------- Sections */
  /* L ancre tombe sous l en-tete colle (72 px) et sous la barre de
     navigation (environ 56 px). */
  .bloc {
    scroll-margin-top: calc(4.5rem + 4rem);
  }
  .bloc + .bloc {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2.5rem;
  }
  .guide-flux > .bloc:first-child {
    margin-top: 1.75rem;
  }
  .bloc-titre {
    margin-top: 0.625rem;
    max-width: 24ch;
  }
  @media (min-width: 64rem) {
    .bloc {
      scroll-margin-top: 1.5rem;
    }
    .guide-flux > .bloc:first-child {
      margin-top: 0;
    }
  }

  /* Une section longue se lit en sous-sections visibles. */
  .sous-bloc {
    margin-top: 2.25rem;
  }
  .sous-titre {
    max-width: 26ch;
  }
  .sous-titre::after {
    content: "";
    display: block;
    width: 2rem;
    height: 1px;
    margin-top: 0.75rem;
    background: var(--accent);
  }

  /* Listes de faits : un filet bronze en guise de puce, jamais de petit texte
     en bronze. Les equipements passent sur deux colonnes sur grand ecran. */
  .faits {
    margin-top: 1.25rem;
    max-width: 70ch;
    list-style: none;
  }
  .faits li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .faits li + li {
    margin-top: 0.875rem;
  }
  .faits li::before {
    content: "";
    position: absolute;
    top: 0.85em;
    left: 0;
