      </li>
      <li>
        <a href={guideUrl("columbarium-cavurne-jardin-du-souvenir")} class="link ailleurs-lien">
          Columbarium, cavurne et jardin du souvenir
        </a>
        <p>Ce que recouvre chaque mot, les dur&#xe9;es, le nombre d'urnes et les tarifs officiels.</p>
      </li>
    </ul>
  </section>
</div>

<style>
  /* Une seule feuille, portee par le composant. Rien ici ne code une couleur :
     tout passe par les jetons de src/styles.css (ivoire, anthracite, bronze).
     Corps a 17 px, lignes sous 75 caracteres, cibles tactiles 44 px au moins. */

  .guide {
    --rail: 13.5rem;
  }

  /* ---------------------------------------------------------------- Hero
     Trois morceaux : le titre, le chapo, le panneau pratique. Sur telephone
     le panneau remonte juste sous le titre, et ses boutons passent en tete du
     panneau : les deux actions utiles sont a portee de pouce. */
  .guide-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-top: 1.75rem;
    padding-bottom: 2.5rem;
  }
  /* Ordre a l ecran sur telephone : titre, panneau pratique, chapo. Les deux
     actions sont ainsi dans le premier ecran, sous le h1. */
  .hero-titre {
    order: 1;
  }
  .panneau {
    order: 2;
  }
  .hero-chapo {
    order: 3;
  }
  .fil {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .fil a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .fil a:hover {
    color: var(--ink);
  }
  .hero-commune {
    margin-top: 1.5rem;
  }
  .hero-h1 {
    margin-top: 0.75rem;
    max-width: 22ch;
  }
  .hero-chapo {
    max-width: 58ch;
  }

  @media (min-width: 64rem) {
    .guide-hero {
      grid-template-areas:
        "titre panneau"
        "chapo panneau";
      grid-template-columns: minmax(0, 1.3fr) minmax(21rem, 0.85fr);
      grid-template-rows: auto 1fr;
      /* Le panneau occupe les deux rangees : la seconde prend le reste de la
         hauteur, sinon le chapo descendrait au milieu du vide. */
      grid-template-rows: auto 1fr;
      align-items: start;
      column-gap: 4.5rem;
      row-gap: 1.75rem;
      padding-top: 2.75rem;
      padding-bottom: 3.5rem;
    }
    .hero-titre,
    .hero-chapo,
    .panneau {
      order: 0;
    }
    .hero-titre {
      grid-area: titre;
    }
    .hero-chapo {
      grid-area: chapo;
      align-self: start;
    }
    .panneau {
      grid-area: panneau;
    }
  }

  /* ------------------------------------------------- Panneau pratique */
  .panneau {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border: 1px solid var(--line-strong);
    padding: 1.5rem 1.25rem;
  }
  @media (min-width: 48rem) {
    .panneau {
      padding: 2rem;
    }
  }

  /* Ordre a l ecran sur telephone : titre, boutons, informations, guichet.
     Dans le HTML les informations precedent les boutons (lecture lineaire). */
  .panneau-titre {
    order: 1;
  }
  .panneau-actions {
    order: 2;
  }
  .panneau-infos {
    order: 3;
  }
  .panneau-admin {
    order: 4;
  }
  @media (min-width: 64rem) {
    .panneau-titre,
    .panneau-actions,
    .panneau-infos,
    .panneau-admin {
      order: 0;
    }
  }

  .panneau-infos {
    display: grid;
    gap: 1.125rem;
  }
  .panneau-infos dt {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .panneau-infos dd {
    margin-top: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 44ch;
  }

  .panneau-boutons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .panneau-boutons .btn {
    flex: 1 1 11rem;
  }
  .panneau-legende {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .panneau-admin {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .admin-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-size: 1rem;
    line-height: 1.4;
  }
  .admin-summary::-webkit-details-marker { display: none; }
  .admin-summary::after { content: "+"; font-size: 1.5rem; }
  .panneau-admin[open] > .admin-summary::after { content: "-"; }
  .admin-summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  #infos-pratiques { scroll-margin-top: 1.5rem; }

  .admin-service {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .admin-lignes {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.5rem;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .admin-note {
    margin-top: 1rem;
    max-width: 44ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .admin-lignes a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
  }
  .panneau a:focus-visible {
    outline-offset: 4px;
  }

  /* --------------------------------------------- Rail et colonne de texte */
  /* minmax(0, 1fr) et min-width: 0 : sans eux, la largeur minimale des
     tableaux pousserait la colonne au-dela de l ecran du telephone. */
  .guide-corps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .guide-rail,
  .guide-flux {
    min-width: 0;
  }
  /* La colonne de texte garde une largeur de lecture meme sur tres grand
     ecran : les tableaux ne s etirent pas sur 1100 px. */
  .guide-flux {
    max-width: 64rem;
  }
  @media (min-width: 64rem) {
    .guide-corps {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      column-gap: 4.5rem;
      align-items: start;
      padding-bottom: 4.5rem;
    }
  }

  .guide-rail {
    border: 1px solid var(--line);
    padding: 1rem 1.25rem;
  }
  .guide-rail ul {
    margin-top: 0.5rem;
    display: grid;
    list-style: none;
  }
  .guide-rail a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.0625rem;
    color: var(--ink);
    text-decoration: none;
  }
  .guide-rail li:last-child a {
    border-bottom: 0;
  }
  .guide-rail a:hover {
    color: var(--accent);
  }
  @media (min-width: 64rem) {
    .guide-rail {
      position: sticky;
      top: 2.5rem;
      border: 0;
      border-top: 1px solid var(--line-strong);
      padding: 1rem 0 0;
    }
  }

  /* ---------------------------------------------------------- Sections */
  .bloc {
    scroll-margin-top: 5.5rem;
  }
  .bloc + .bloc {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }
  .bloc-titre {
    margin-top: 0.75rem;
    max-width: 24ch;
  }
  @media (min-width: 64rem) {
    .bloc {
      scroll-margin-top: 1.5rem;
    }
  }

  .sous-titre {
    margin-top: 2.75rem;
    max-width: 26ch;
  }

  /* Listes de faits : un filet bronze en guise de puce, jamais de petit texte
     en bronze. Les equipements passent sur deux colonnes sur grand ecran. */
  .faits {
    margin-top: 1.5rem;
    max-width: 70ch;
    list-style: none;
  }
  .faits li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .faits li + li {
    margin-top: 1rem;
  }
  .faits li::before {
    content: "";
    position: absolute;
    top: 0.85em;
    left: 0;
    width: 0.75rem;
    height: 1px;
    background: var(--accent);
  }
  @media (min-width: 64rem) {
    .faits-colonnes {
      max-width: none;
      columns: 2;
      column-gap: 3.5rem;
    }
    .faits-colonnes li {
      break-inside: avoid;
    }
    .faits-colonnes li + li {
      margin-top: 0;
    }
    .faits-colonnes li:not(:first-child) {
      margin-top: 1rem;
    }
  }

  .prose {
    margin-top: 1.75rem;
    max-width: 68ch;
  }
  .prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .prose p + p {
    margin-top: 1.25rem;
  }
  .prose strong {
    color: var(--ink);
    font-weight: 500;
  }
  .prose-note {
    margin-top: 1rem;
    max-width: 66ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .encadre {
    margin-top: 2.5rem;
    max-width: 68ch;
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    padding: 1.25rem 1.5rem;
  }
  .encadre-titre {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--ink);
  }
  .encadre p {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }

  /* ------------------------------------------------- Replis natifs */
  .repli {
    margin-top: 2rem;
    max-width: 72ch;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .repli + .repli {
    margin-top: 0;
    border-top: 0;
  }
  .repli > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding: 0.875rem 0;
    cursor: pointer;
    list-style: none;
  }
  .repli > summary::-webkit-details-marker {
    display: none;
  }
  .repli > summary::after {
    content: "+";
    flex: none;
    font-size: 1.375rem;
    line-height: 1;
    color: var(--accent);
  }
  .repli[open] > summary::after {
    content: "\2212";
  }
  .repli-titre {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .repli > summary:hover .repli-titre {
    color: var(--accent);
  }
  .repli > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .repli-corps {
    padding-bottom: 1.5rem;
    max-width: 68ch;
  }
  .repli-corps p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .repli-corps p + p {
    margin-top: 1rem;
  }
  .repli-corps .faits {
    margin-top: 1.25rem;
  }
  .repli-sous-titre {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .repli-corps strong {
    color: var(--ink);
    font-weight: 500;
  }

  /* ----------------------------------- Reperes et schema du monument */
  .monument-haut {
    margin-top: 1.75rem;
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 64rem) {
    .monument-haut {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 3.5rem;
      align-items: start;
    }
  }

  .reperes {
    display: grid;
    gap: 1.5rem;
    max-width: 48ch;
  }
  .repere {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .repere dt {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .repere-valeur {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--ink);
  }
  .repere-precision {
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Schema : deux vues dessinees avec des filets, a la meme echelle
     (--cm = la taille d un centimetre). Les cotes viennent des donnees via
     --cm-largeur, --cm-profondeur et --cm-hauteur, posees sur la figure. */
  .schema {
    --cm: 0.082rem;
    border: 1px solid var(--line);
    padding: 1.25rem;
  }
  @media (min-width: 48rem) {
    .schema {
      --cm: 0.1rem;
      padding: 1.5rem 1.75rem;
    }
  }
  /* Les deux vues : titres alignes en haut, dessins poses sur la meme ligne
     de sol en bas (margin-top: auto). */
  .schema-vues {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    align-items: stretch;
  }
  .vue {
    display: flex;
    flex-direction: column;
  }
  .plan,
  .elevation {
    margin-top: auto;
  }
  .vue-titre {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cote {
    font-size: 0.8125rem;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
  }

  .plan {
    position: relative;
    padding-top: 1rem;
    padding-right: 3.5rem;
  }
  .cote-largeur {
    display: block;
    width: calc(var(--cm-largeur) * var(--cm));
    padding-bottom: 0.35rem;
    text-align: center;
    border-bottom: 1px solid var(--accent);
  }
  .plan-forme {
    width: calc(var(--cm-largeur) * var(--cm));
    height: calc(var(--cm-profondeur) * var(--cm));
    margin-top: 0.35rem;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .cote-profondeur {
    position: absolute;
    top: calc(1.75rem + 0.35rem);
    left: calc(var(--cm-largeur) * var(--cm) + 0.5rem);
    height: calc(var(--cm-profondeur) * var(--cm));
    display: flex;
    align-items: center;
    padding-left: 0.5rem;
    border-left: 1px solid var(--accent);
  }

  .elevation {
    position: relative;
    padding-top: 1rem;
    padding-left: 4rem;
  }
  .cote-hauteur {
    position: absolute;
    left: 0;
    bottom: 0.5rem;
    height: calc(var(--cm-hauteur) * var(--cm));
    display: flex;
    align-items: center;
    padding-left: 0.5rem;
    border-left: 1px solid var(--accent);
  }
  .elevation-enveloppe {
    width: 6.5rem;
    height: calc(var(--cm-hauteur) * var(--cm));
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0.5rem;
    border: 1px dashed var(--line-strong);
    border-bottom: 0;
    border-top: 1px solid var(--accent);
  }
  .elevation-largeur {
    font-size: 0.8125rem;
    text-align: center;
    color: var(--muted);
  }
  .elevation-sol {
    width: calc(6.5rem + 2.5rem);
    margin-left: -1.25rem;
    border-top: 2px solid var(--line-strong);
  }

  .schema-notes {
    margin-top: 1.5rem;
    max-width: 56ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .schema-avertissement {
    margin-top: 0.75rem;
    max-width: 56ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ------------------------------------------------------------ Tableaux */
  .indice {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  @media (min-width: 48rem) {
    .indice {
      display: none;
    }
  }
  .tableau {
    margin-top: 1.25rem;
    overflow-x: auto;
  }
  .tableau:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* Le tableau porte une classe plutot qu un selecteur d element nu : le nom
     d element seul, ecrit ici, ferait naitre l utilitaire Tailwind homonyme
     dans le CSS partage du site, dont l empreinte changerait pour les 75
     pages. Meme raison pour ne pas l ecrire dans ce commentaire. */
  .tableau-grille {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    text-align: left;
  }
  .tableau-grille caption {
    caption-side: top;
    max-width: 66ch;
    padding-bottom: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    text-align: left;
  }
  /* Le tableau est plus large que l ecran du telephone : sa legende reste
     collee a gauche et se replie sur la largeur visible. */
  @media (max-width: 47.99rem) {
    .tableau-grille caption {
      position: sticky;
      left: 0;
      width: calc(100vw - 3rem);
    }
  }
  .tableau-grille th,
  .tableau-grille td {
    padding: 1rem 1.5rem 1rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
    line-height: 1.55;
    vertical-align: top;
  }
  .tableau-grille thead th {
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tableau-grille tbody th {
    max-width: 26ch;
    font-weight: 400;
    color: var(--ink);
  }
  .tableau-grille tbody td {
    color: var(--muted);
  }

  /* ----------------------------------------- Appel commercial (sombre) */
  .projet {
    padding: 2rem 1.5rem;
  }
  .bloc + .projet {
    border-top: 0;
    padding-top: 2rem;
  }
  @media (min-width: 48rem) {
    .projet {
      padding: 2.5rem;
    }
    .bloc + .projet {
      padding-top: 2.5rem;
    }
  }
  .projet-texte {
    margin-top: 1.25rem;
    max-width: 60ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .projet-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .projet-note {
    margin-top: 1.5rem;
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .projet a:focus-visible {
    outline-offset: 4px;
  }

  /* --------------------------------------------- Cendres : possibilites */
  .possibilites {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 60rem) {
    .possibilites {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 3.5rem;
    }
    .possibilite:first-child {
      grid-column: 1 / -1;
    }
    .possibilite:first-child .faits {
      columns: 2;
      column-gap: 3.5rem;
      max-width: none;
    }
    .possibilite:first-child .faits li + li {
      margin-top: 0;
    }
    .possibilite:first-child .faits li:not(:first-child) {
      margin-top: 1rem;
    }
  }
  .possibilite {
    border-top: 1px solid var(--line-strong);
    padding-top: 1.25rem;
  }
  .possibilite-titre {
    font-family: var(--font-serif);
