---
import MentionVerification from "@/components/MentionVerification.astro";
import { LOI_CANTONALE, SOURCES } from "@/data/cimetieres-ne";
import {
  CIMETIERES_URL,
  PHRASE_SUR_MESURE,
  cimetiereUrl,
  devisUrl,
  itineraireUrl,
  mentionVerification,
  telUrl,
  type Cimetiere,
} from "@/data/cimetieres";
import { guideUrl } from "@/data/guides";
import { FAMILLE_LABELS, familleUrl } from "@/data/products";

/* Guide d un cimetiere : la composition validee le 10.11.2026 (hero
   asymetrique, panneau pratique, navigation par besoins, schema d echelle,
   replis natifs). Pilote sur une seule page, voir
   src/pages/cimetieres/[slug].astro ; les autres pages gardent la mise en
   page d origine.

   AUCUNE DONNEE ICI. Tout vient de src/data/cimetieres.ts, comme la mise en
   page d origine : chaque fait, chaque tarif, chaque source est celui de la
   fiche. Les nombres du schema sont relus dans les lignes du reglement, pour
   qu une correction de donnee corrige aussi le dessin.

   Ce fichier est ecrit en ASCII : les libelles d interface nouveaux passent
   par des entites HTML (&#xe9;, &#xe8;, ...) ou par des echappements \uXXXX.
   Le texte des familles vient des donnees et garde ses accents. */

interface Props {
  /** Fiche affichee, espaces insecables deja posees par la page. */
  cimetiere: Cimetiere;
  /** Meme fiche, valeurs brutes : seules les fonctions d URL l utilisent. */
  donnees: Cimetiere;
  /** Le h1 exact, calcule par la page. */
  titrePrincipal: string;
  /** Les autres fiches, pour le maillage de fin de page. */
  autres: Cimetiere[];
}

const { cimetiere, donnees, titrePrincipal, autres } = Astro.props;

const aAcces = (cimetiere.acces?.length ?? 0) > 0;
const aProjets = (cimetiere.projets?.length ?? 0) > 0;
const aHistoire = (cimetiere.histoire?.length ?? 0) > 0;
const aEntretien = (cimetiere.entretien?.length ?? 0) > 0;

/* Navigation par besoins : les ancres historiques, des libelles qui disent ce
   que la personne cherche. Une entree n apparait que si sa section existe. */
const BESOINS = [
  { id: "infos-pratiques", titre: "Acc\u00e8s et contact", present: true },
  { id: "sur-place", titre: "Sur place", present: cimetiere.equipements.length > 0 },
  { id: "poser-un-monument", titre: "Pr\u00e9parer un monument", present: true },
  { id: "cendres", titre: "Urnes et tarifs", present: cimetiere.cineraire.length > 0 },
  { id: "duree", titre: "Dur\u00e9e et entretien", present: true },
  { id: "questions", titre: "Questions", present: true },
].filter((besoin) => besoin.present);

/* Le bouton d appel dit de qui est le numero : c est le guichet communal,
   jamais le notre. Le libelle suit le nom du service des donnees. */
const libelleAppel = /office/i.test(cimetiere.contact.service)
  ? "Appeler l'office"
  : "Appeler l'administration";

/* Le schema d echelle lit ses nombres dans le tableau des dimensions : la
   surface de la tombe d adulte et la hauteur du monument d adulte. Si une
   fiche ne publie pas ces deux lignes, le schema n est pas dessine. */
const ligneSurface = cimetiere.regles.tombes.find(
  (tombe) => /surface/i.test(tombe.type) && !/cr\u00e9mation/i.test(tombe.type),
);
const ligneAdulte = cimetiere.regles.tombes.find((tombe) => /adulte/i.test(tombe.type));
const mesuresSurface = ligneSurface?.dimensions.match(/(\d+)\s*[x\u00d7]\s*(\d+)/);
const mesureHauteur = ligneAdulte?.hauteurMax?.match(/(\d+)/);
const schema =
  ligneSurface && ligneAdulte && mesuresSurface && mesureHauteur
    ? {
        largeurCm: Number(mesuresSurface[1]),
        profondeurCm: Number(mesuresSurface[2]),
        hauteurCm: Number(mesureHauteur[1]),
        surfaceType: ligneSurface.type,
        surfaceArticle: ligneSurface.article,
        hauteurTexte: ligneAdulte.hauteurMax as string,
        hauteurArticle: ligneAdulte.article,
        largeurTexte: ligneAdulte.dimensions,
      }
    : null;

/* Les trois reperes du monument, contextualises par la ligne de reglement
   d ou vient le chiffre. Aucun texte nouveau : le delai est la phrase du
   reglement, les deux autres portent le type de sepulture et son article. */
const reperes = [
  {
    intitule: "D\u00e9lai avant la pose",
    valeur: cimetiere.chiffres.delai,
    precision: cimetiere.regles.delaiPose,
  },
  {
    intitule: "Tombe d'adulte",
    valeur: cimetiere.chiffres.tombeAdulte,
    precision: ligneSurface ? `${ligneSurface.type}, ${ligneSurface.article}.` : undefined,
  },
  {
    intitule: "Hauteur maximale",
    valeur: cimetiere.chiffres.hauteurMax,
    precision: ligneAdulte
      ? `${ligneAdulte.type}, ${ligneAdulte.article}. ${ligneAdulte.dimensions}.`
      : undefined,
  },
];

/* Les cendres, rangees par possibilite. Chaque ligne de la fiche tombe dans
   le premier groupe qui la reconnait, dans l ordre ci-dessous ; ce qui n est
   reconnu par aucun groupe est garde a la fin. Rien n est retire. */
const POSSIBILITES = [
  { titre: "Au columbarium", test: /columbarium|niche/i },
  { titre: "Au jardin du souvenir", test: /jardin du souvenir/i },
  { titre: "Dans une tombe", test: /tombe/i },
];
const groupesCendres: { titre: string; lignes: string[] }[] = [];
{
  const groupes = POSSIBILITES.map((possibilite) => ({ titre: possibilite.titre, lignes: [] as string[] }));
  const reste: string[] = [];
  for (const ligne of cimetiere.cineraire) {
    const index = POSSIBILITES.findIndex((possibilite) => possibilite.test.test(ligne));
    if (index === -1) reste.push(ligne);
    else groupes[index].lignes.push(ligne);
  }
  for (const groupe of groupes) if (groupe.lignes.length > 0) groupesCendres.push(groupe);
  if (reste.length > 0) groupesCendres.push({ titre: "\u00c0 savoir aussi", lignes: reste });
}
---

<div class="guide">
  {/* ------------------------------------------------------------ Hero */}
  <section class="shell guide-hero" aria-labelledby="titre-cimetiere">
    <div class="hero-titre">
      <nav class="fil" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={CIMETIERES_URL}>Cimeti&#xe8;res</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{cimetiere.nom}</span>
      </nav>
      <p class="label hero-commune">{cimetiere.commune}</p>
      <h1 class="type-h1 hero-h1" id="titre-cimetiere">{titrePrincipal}</h1>
    </div>

    <p class="type-lead hero-chapo">{cimetiere.chapo}</p>

    <aside class="panneau nuit" id="infos-pratiques" aria-labelledby="panneau-titre">
      <p class="label panneau-titre" id="panneau-titre">Infos pratiques</p>

      <dl class="panneau-infos">
        {
          cimetiere.adresse && (
            <div>
              <dt>Adresse</dt>
              <dd>{cimetiere.adresse}</dd>
            </div>
          )
        }
        {
          cimetiere.horaires && (
            <div>
              <dt>Horaires du cimeti&#xe8;re</dt>
              <dd>{cimetiere.horaires}</dd>
            </div>
          )
        }
        {
          aAcces && (
            <div>
              <dt>Acc&#xe8;s</dt>
              <dd>
                {cimetiere.acces?.map((ligne) => (
                  <span>{ligne}</span>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

      <div class="panneau-actions">
        <div class="panneau-boutons">
          <a href={itineraireUrl(donnees)} class="btn btn-primary" rel="noopener nofollow">
            Itin&#xe9;raire
          </a>
          {
            cimetiere.contact.telephone && (
              <a href={telUrl(donnees.contact.telephone as string)} class="btn btn-outline">
                {libelleAppel}
                <span class="sr-only"> : {cimetiere.contact.service}</span>
              </a>
            )
          }
        </div>
        {
          cimetiere.contact.telephone && (
            <p class="panneau-legende">
              {cimetiere.contact.service}
            </p>
          )
        }
      </div>

      <details class="panneau-admin">
        <summary class="admin-summary">Coordonn&#xe9;es du guichet</summary>
        <p class="admin-service">
          {
            cimetiere.contact.url ? (
              <a href={cimetiere.contact.url} class="link" rel="noopener">
                {cimetiere.contact.service}
              </a>
            ) : (
              <span>{cimetiere.contact.service}</span>
            )
          }
        </p>
        <ul class="admin-lignes">
          {cimetiere.contact.adresse && <li>{cimetiere.contact.adresse}</li>}
          {
            cimetiere.contact.telephone && (
              <li>
                <a href={telUrl(donnees.contact.telephone as string)} class="link">
                  {cimetiere.contact.telephone}
                </a>
              </li>
            )
          }
          {cimetiere.contact.telephoneSecondaire && <li>{cimetiere.contact.telephoneSecondaire}</li>}
          {
            cimetiere.contact.email && (
              <li>
                <a href={`mailto:${cimetiere.contact.email}`} class="link">
                  {cimetiere.contact.email}
                </a>
              </li>
            )
          }
          {cimetiere.contact.horaires && <li>{cimetiere.contact.horaires}</li>}
        </ul>
        <p class="admin-note">Les demandes de concession et de permis de pose sont trait&#xe9;es par ce service communal.</p>
      </details>
    </aside>
  </section>

  {/* ------------------------------------------- Rail de navigation + flux */}
  <div class="shell guide-corps">
    <nav class="guide-rail" aria-labelledby="rail-titre">
      <p class="label" id="rail-titre">Que cherchez-vous&#xa0;?</p>
      <ul>
        {
          BESOINS.map((besoin) => (
            <li>
              <a href={`#${besoin.id}`}>{besoin.titre}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="guide-flux">
      {/* ---------------------------------------------------- Sur place */}
      {
        cimetiere.equipements.length > 0 && (
          <section class="bloc" id="sur-place" aria-labelledby="titre-sur-place">
            <p class="label">Venir</p>
            <h2 class="type-h2 bloc-titre" id="titre-sur-place">
              Sur place
            </h2>
            <ul class="faits faits-colonnes">
              {cimetiere.equipements.map((ligne) => (
                <li>{ligne}</li>
              ))}
            </ul>

            {aProjets && (
              <aside class="encadre">
                <h3 class="encadre-titre">Ce qui change bient&#xf4;t</h3>
                {cimetiere.projets?.map((ligne) => <p>{ligne}</p>)}
              </aside>
            )}

            {aHistoire && (
              <details class="repli">
                <summary>
                  <span class="repli-titre">Histoire et patrimoine</span>
                </summary>
                <div class="repli-corps">
                  {cimetiere.histoire?.map((ligne) => <p>{ligne}</p>)}
                </div>
              </details>
            )}
          </section>
        )
      }

      {/* -------------------------------------------- Poser un monument */}
      <section class="bloc" id="poser-un-monument" aria-labelledby="titre-monument">
        <p class="label">Pr&#xe9;parer un monument</p>
        <h2 class="type-h2 bloc-titre" id="titre-monument">Poser un monument</h2>

        <div class="monument-haut">
          <dl class="reperes">
            {
              reperes.map((repere) => (
                <div class="repere">
                  <dt>{repere.intitule}</dt>
                  <dd class="repere-valeur">{repere.valeur}</dd>
                  {repere.precision && <dd class="repere-precision">{repere.precision}</dd>}
                </div>
              ))
            }
          </dl>

          {
            schema && (
              <figure
                class="schema"
                style={`--cm-largeur:${schema.largeurCm};--cm-profondeur:${schema.profondeurCm};--cm-hauteur:${schema.hauteurCm}`}
              >
                <figcaption class="label">Rep&#xe8;re d'&#xe9;chelle</figcaption>
                <div class="schema-vues">
                  <div class="vue">
                    <p class="vue-titre">Vue de dessus</p>
                    <div class="plan">
                      <span class="cote cote-largeur">{schema.largeurCm}&#xa0;cm</span>
                      <div class="plan-forme" />
                      <span class="cote cote-profondeur">{schema.profondeurCm}&#xa0;cm</span>
                    </div>
                  </div>
                  <div class="vue">
                    <p class="vue-titre">Vue en &#xe9;l&#xe9;vation</p>
                    <div class="elevation">
                      <span class="cote cote-hauteur">{schema.hauteurCm}&#xa0;cm</span>
                      <div class="elevation-enveloppe">
                        <span class="elevation-largeur">&#xe0; confirmer</span>
                      </div>
                      <div class="elevation-sol" />
                    </div>
                  </div>
                </div>
                <p class="schema-notes">
                  Vue de dessus : {schema.surfaceType}, {schema.surfaceArticle}. Vue en
                  &#xe9;l&#xe9;vation : {schema.hauteurTexte} ({schema.hauteurArticle}),{" "}
                  {schema.largeurTexte.toLowerCase()}. Les deux vues sont &#xe0; la m&#xea;me
                  &#xe9;chelle.
                </p>
                <p class="schema-avertissement">
                  Dessin des cotes du r&#xe8;glement, pour se rep&#xe9;rer. Ce n'est pas un
                  mod&#xe8;le du catalogue, et aucun monument n'est annonc&#xe9; conforme sans
                  v&#xe9;rification du r&#xe8;glement.
                </p>
              </figure>
            )
          }
        </div>

        <h3 class="type-h3 sous-titre">Ce que demande le r&#xe8;glement</h3>
        <div class="prose">
          {
            cimetiere.regles.periodeInterdite && (
              <p>
                <strong>P&#xe9;riode o&#xf9; la pose est interdite.</strong>{" "}
                {cimetiere.regles.periodeInterdite}
              </p>
            )
          }
          {
            cimetiere.regles.autorisation && (
              <p>
                <strong>Autorisation.</strong> {cimetiere.regles.autorisation}
              </p>
            )
          }
          <p>
            <strong>Bordure et entourage.</strong> {cimetiere.regles.bordure}
          </p>
          {
            cimetiere.regles.taxePose && (
              <p>
                <strong>Taxe communale de pose.</strong> {cimetiere.regles.taxePose}
              </p>
            )
          }
        </div>

        {
          (cimetiere.regles.materiaux || cimetiere.regles.obligations.length > 0) && (
            <details class="repli">
              <summary>
                <span class="repli-titre">Mat&#xe9;riaux et obligations de l'entreprise</span>
              </summary>
              <div class="repli-corps">
                {cimetiere.regles.materiaux && (
                  <p>
                    <strong>Mat&#xe9;riaux.</strong> {cimetiere.regles.materiaux}
                  </p>
                )}
                {cimetiere.regles.obligations.length > 0 && (
                  <>
                    <h4 class="repli-sous-titre">Ce que le r&#xe8;glement impose en plus</h4>
                    <ul class="faits">
                      {cimetiere.regles.obligations.map((ligne) => (
                        <li>{ligne}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </details>
          )
        }

        <h3 class="type-h3 sous-titre" id="titre-dimensions">Dimensions autoris&#xe9;es</h3>
        <p class="indice">
          Tableau complet&#xa0;: sur t&#xe9;l&#xe9;phone, il se fait d&#xe9;filer
          lat&#xe9;ralement.
        </p>
        <div class="tableau" role="region" aria-labelledby="titre-dimensions" tabindex="0">
          <table class="tableau-grille">
            <caption>
              Dimensions et hauteurs autoris&#xe9;es par type de s&#xe9;pulture, avec l'article du
              r&#xe8;glement.
            </caption>
            <thead>
              <tr>
                <th scope="col">Type</th>
                <th scope="col">Dimensions</th>
                <th scope="col">Hauteur maximale</th>
                <th scope="col">Article</th>
              </tr>
            </thead>
            <tbody>
              {
                cimetiere.regles.tombes.map((tombe) => (
                  <tr>
                    <th scope="row">{tombe.type}</th>
                    <td>{tombe.dimensions}</td>
                    <td>{tombe.hauteurMax ?? "Non publi\u00e9e"}</td>
                    <td>{tombe.article}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      {/* ------------------------------------------- Appel commercial */}
      <section class="bloc projet nuit" aria-labelledby="titre-projet">
        <p class="label">Votre projet</p>
        <h2 class="type-h2 bloc-titre" id="titre-projet">Votre projet dans ce cimeti&#xe8;re</h2>
        <p class="projet-texte">
          Dites-nous le type de s&#xe9;pulture et, si vous le connaissez, le num&#xe9;ro de la
          tombe. Nous v&#xe9;rifions le r&#xe8;glement, nous adaptons le monument aux dimensions
          autoris&#xe9;es, nous d&#xe9;posons la demande de pose et nous &#xe9;tablissons un devis
          gratuit.
        </p>
        <p class="projet-texte">{PHRASE_SUR_MESURE}</p>
        <div class="projet-actions">
          <a href={devisUrl(donnees)} class="btn btn-primary">Demander un devis</a>
          <a href={familleUrl("monument")} class="btn btn-outline">{FAMILLE_LABELS.monument}</a>
        </div>
        <p class="projet-note">
          Page d'information ind&#xe9;pendante, r&#xe9;dig&#xe9;e par PierreTombale.ch. Pour les
          d&#xe9;marches officielles&#xa0;:{" "}
          {
            cimetiere.contact.url ? (
              <a href={cimetiere.contact.url} class="link" rel="noopener">
                {cimetiere.contact.service}
              </a>
            ) : (
              <span>{cimetiere.contact.service}</span>
            )
          }. Informations v&#xe9;rifi&#xe9;es le {cimetiere.verifieLe}&#xa0;:{" "}
          <a href="#sources" class="link">voir les documents officiels</a>.
        </p>
      </section>

      {/* ------------------------------------ Urnes et jardin du souvenir */}
      {
        cimetiere.cineraire.length > 0 && (
          <section class="bloc" id="cendres" aria-labelledby="titre-cendres">
            <p class="label">Urnes et tarifs</p>
            <h2 class="type-h2 bloc-titre" id="titre-cendres">
              Urnes, columbarium et jardin du souvenir
            </h2>

            <div class="possibilites">
              {groupesCendres.map((groupe) => (
                <article class="possibilite">
                  <h3 class="possibilite-titre">{groupe.titre}</h3>
                  <ul class="faits">
                    {groupe.lignes.map((ligne) => (
                      <li>{ligne}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>

            {cimetiere.tarifs && (
              <>
                <h3 class="type-h3 sous-titre" id="titre-tarifs">
                  Tarifs officiels de la commune
                </h3>
                <p class="prose-note">
                  Ce sont des taxes communales, pas des prix de monument. Source&#xa0;:{" "}
                  {cimetiere.tarifs.date}.
                </p>
                <p class="indice">
                  Tableau complet&#xa0;: sur t&#xe9;l&#xe9;phone, il se fait d&#xe9;filer
                  lat&#xe9;ralement.
                </p>
                <div class="tableau" role="region" aria-labelledby="titre-tarifs" tabindex="0">
                  <table class="tableau-grille">
                    <caption>
                      Taxes communales par prestation, pour une personne domicili&#xe9;e dans la
                      commune et pour une personne de l'ext&#xe9;rieur.
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Prestation</th>
                        <th scope="col">Domicili&#xe9;</th>
                        <th scope="col">Ext&#xe9;rieur</th>
                      </tr>
                    </thead>
                    <tbody>
                      {cimetiere.tarifs.lignes.map((ligne) => (
                        <tr>
                          <th scope="row">{ligne.prestation}</th>
                          <td>{ligne.domicilie}</td>
                          <td>{ligne.exterieur ?? "Non publi\u00e9"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {cimetiere.tarifs.note && <p class="prose-note">{cimetiere.tarifs.note}</p>}
                <p class="prose-note">
                  {cimetiere.tarifs.source ? (
                    <a href={SOURCES[cimetiere.tarifs.source].url} class="link" rel="noopener">
                      {SOURCES[cimetiere.tarifs.source].libelle}
                    </a>
                  ) : (
                    <span>{cimetiere.tarifs.sourceLibelle}</span>
                  )}
                </p>
              </>
            )}
          </section>
        )
      }

      {/* ------------------------------------------ Duree et entretien */}
      <section class="bloc" id="duree" aria-labelledby="titre-duree">
        <p class="label">Dur&#xe9;e et entretien</p>
        <h2 class="type-h2 bloc-titre" id="titre-duree">
          Dur&#xe9;e de la tombe et reprise du monument
        </h2>
        <ul class="faits">
          {cimetiere.duree.map((ligne) => <li>{ligne}</li>)}
        </ul>

        {
          aEntretien && (
            <>
              <h3 class="type-h3 sous-titre">Entretien</h3>
              <ul class="faits">
                {cimetiere.entretien?.map((ligne) => <li>{ligne}</li>)}
              </ul>
            </>
          )
        }
      </section>

      {/* ------------------------------------------------------- Questions */}
      <section class="bloc" id="questions" aria-labelledby="titre-questions">
        <p class="label">Questions</p>
        <h2 class="type-h2 bloc-titre" id="titre-questions">
          Questions fr&#xe9;quentes&#xa0;: {cimetiere.nom}
        </h2>
        <div class="faq">
          {
            cimetiere.faq.map((item, index) => (
              <details class="repli" open={index === 0}>
                <summary>
                  <span class="repli-titre">{item.question}</span>
                </summary>
                <div class="repli-corps">
                  <p>{item.reponse}</p>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      {/* ------------------------------------------- Documents officiels */}
      <section class="bloc" id="sources" aria-labelledby="titre-sources">
        <p class="label">Sources</p>
        <h2 class="type-h2 bloc-titre" id="titre-sources">Documents officiels</h2>
        <p class="prose-note">
          Les textes d'o&#xf9; viennent les r&#xe8;gles de cette page. La {LOI_CANTONALE} laisse
          les monuments aux conditions fix&#xe9;es par la commune (art.&#xa0;9).
        </p>
        <ul class="sources-liste">
          {
            cimetiere.sources.map((id) => (
              <li>
                <a href={SOURCES[id].url} class="link" rel="noopener">
                  {SOURCES[id].libelle}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="sources-mention">
