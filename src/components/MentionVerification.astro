---
/* Mention obligatoire en tete de chaque guide et de chaque page cimetiere : la
   date de verification des reglements et ce que nous faisons avant une pose.
   Sans prop, c est le texte des guides (src/data/guides.ts) : il reste ainsi
   identique d un guide a l autre. Les pages cimetiere passent leur propre
   texte, construit par `mentionVerification()` dans src/data/cimetieres.ts,
   parce qu elles ont leur propre date de relecture. */
import { MENTION_VERIFICATION } from "@/data/guides";

interface Props {
  /** Texte a afficher, quand ce n est pas celui des guides. */
  texte?: string;
}

const { texte = MENTION_VERIFICATION } = Astro.props;
---

<p class="mention-verification type-body">{texte}</p>

<style>
  .mention-verification {
    max-width: 62ch;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
