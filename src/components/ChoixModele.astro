---
import ProductImage from "@/components/ProductImage.astro";
import { FAMILLE_LABELS, FAMILLES, getProducts } from "@/data/products";
import { prixAffiche } from "@/data/tarifs";

/**
 * Le choix du modele dans le formulaire de devis : une grille de cartes a
 * regarder, pas une liste deroulante. Une famille en deuil reconnait une forme
 * bien plus vite qu un nom de modele.
 *
 * Ce sont de VRAIS boutons radio `name="modele"`, seulement habilles : le
 * bouton reste utilisable au clavier et sans JavaScript, et le champ envoye ne
 * change pas (le `slug` d une fiche, ou vide ; voir `docs/devis-contrat.md`).
 * Les cartes portent `data-famille` : c est par la que les onglets de famille
 * de la page filtrent la grille, EN JAVASCRIPT SEULEMENT. Sans JavaScript,
 * toutes les cartes restent la, groupees par famille sous un sous-titre.
 *
 * Les vignettes viennent de `productVisuel` (premiere image de la fiche, sinon
 * silhouette provisoire) : un nouveau modele ou une nouvelle image apparait ici
 * sans toucher au formulaire.
 */
interface Props {
  /** Modele deja choisi : le `slug` d une fiche, ou vide pour « conseillez-moi ». */
  modeleInitial?: string;
}

const { modeleInitial = "" } = Astro.props;

const products = await getProducts();

/* Un slug inconnu vaut "pas de choix" : la carte « conseillez-moi » reste
   cochee plutot que d afficher un modele qui n existe pas. */
const familleInitiale = products.find((product) => product.slug === modeleInitial)?.famille;
const aucunModele = familleInitiale === undefined;

const groupes = FAMILLES.map((famille) => ({
  famille,
  label: FAMILLE_LABELS[famille],
  modeles: products.filter((product) => product.famille === famille),
}));
---

<div class="choix-grille" data-choix-modele>
  {
    groupes.map((groupe) => (
      <Fragment>
        {/* Sous-titre utile sans JavaScript : il groupe la grille par famille.
            Avec JavaScript, l onglet choisi le remplace et le script le cache. */}
        <p class="choix-titre type-body" data-choix-titre>
          {groupe.label}
        </p>

        {/* La carte « conseillez-moi » vient en premier, et c est le choix par
            defaut : ne pas savoir est une reponse acceptable. */}
        <label class="carte-modele carte-conseil" data-famille={groupe.famille}>
          <input
            type="radio"
            name="modele"
            value=""
            checked={aucunModele && groupe.famille === FAMILLES[0]}
          />
          <span class="carte-coche" aria-hidden="true">Choisi</span>
          <span class="carte-nom">Je ne sais pas encore, conseillez-moi</span>
          <span class="carte-desc type-body">
            Nous vous proposons des modèles selon vos souhaits et le cimetière.
          </span>
        </label>

        {groupe.modeles.map((modele) => (
          <label class="carte-modele" data-famille={groupe.famille}>
            <input
              type="radio"
              name="modele"
              value={modele.slug}
              checked={modele.slug === modeleInitial}
            />
            <ProductImage
              product={modele}
              width={480}
              height={600}
              loading="lazy"
              alt=""
              class="aspect-[4/5] w-full object-cover"
            />
            <span class="carte-coche" aria-hidden="true">Choisi</span>
            <span class="carte-nom">{modele.name}</span>
            <span class="carte-desc type-body">{modele.shortDescription}</span>
            <span class="carte-prix type-body">{prixAffiche(modele.slug)}</span>
          </label>
        ))}
      </Fragment>
    ))
  }
</div>

{/* Habillage ecrit en CSS et non en utilitaires Tailwind : la feuille Tailwind
    est unique et partagee par les 23 pages, donc une classe inedite utilisee
    ici alourdirait aussi l accueil et les fiches. Ce bloc, lui, ne part
    qu avec la page qui pose ce composant. */}
<style>
  .choix-grille {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .choix-titre {
    grid-column: 1 / -1;
    margin: 1.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .choix-titre:first-child {
    margin-top: 0;
  }

  /* Une carte entiere est la zone a toucher : bien au-dela des 44 px. Le bouton
     radio est masque a l oeil mais TOUJOURS LA, donc utilisable au clavier et
     annonce par les lecteurs d ecran (jamais `display: none`). */
  .carte-modele {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    border: 1px solid var(--line-strong);
    background-color: var(--canvas);
    cursor: pointer;
  }
  .carte-modele input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* L etat coche ne se joue pas sur la couleur seule : bordure epaisse ET le
     mot « Choisi ». Le padding compense l epaississement pour que la grille ne
     bouge pas au clic. */
  .carte-modele:has(input:checked) {
    padding: calc(0.5rem - 2px);
    border-width: 3px;
    border-color: var(--ink);
  }
  .carte-modele:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .carte-coche {
    display: none;
  }
  .carte-modele:has(input:checked) .carte-coche {
    display: block;
    align-self: flex-start;
    margin-top: 0.5rem;
    background-color: var(--ink);
    padding: 0.125rem 0.5rem;
    color: var(--canvas);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .carte-nom {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .carte-desc {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .carte-prix {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Pas de vignette sur la carte « conseillez-moi » : son texte prend la place
     de l image, centre sur la hauteur de ses voisines. */
  .carte-conseil {
    justify-content: center;
    min-height: 11rem;
    text-align: center;
  }
  .carte-conseil:has(input:checked) .carte-coche {
    align-self: center;
  }

  /* `hidden` doit l emporter sur le `display: flex` ci-dessus : c est ainsi que
     les onglets de famille cachent les cartes des autres familles. */
  .carte-modele[hidden],
  .choix-titre[hidden] {
    display: none;
  }

  @media (min-width: 40rem) {
    .choix-grille {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
