---
/* Les neuf pages cimetiere ecrites, en tete du hub /cimetieres/.
   Titre, chapo et les trois reperes de la fiche, rien de plus : tout vient de
   `CIMETIERES` dans src/data/cimetieres.ts.

   Les neuf liens sont dans le HTML servi et visibles sans JavaScript. La
   recherche du hero ne fait que masquer ceux qui ne correspondent pas ; elle
   n en charge aucun.

   Mots cherchables : nom du cimetiere, nom court, commune responsable et
   localites desservies, tels qu ils figurent dans les donnees. Aucune
   geographie ajoutee ici : une localite absente des donnees n est pas
   cherchable, et c est voulu.

   Comme src/pages/cimetieres/index.astro, ce fichier ecrit ses libelles avec
   leurs accents (les commentaires et les commits restent en ASCII). */

import { cimetiereUrl, type Cimetiere } from "@/data/cimetieres";

interface Props {
  fiches: Cimetiere[];
  /** Phrase affichee quand la recherche ne trouve aucune de nos pages. */
  texteVide: string;
}

const { fiches, texteVide } = Astro.props;

/** Les mots sur lesquels une fiche repond, tous venus des donnees. */
function mots(fiche: Cimetiere): string {
  return [fiche.nom, fiche.nomCourt, fiche.commune, ...fiche.localites].join(" ");
}
---

<section class="hub-bloc" data-entree aria-labelledby="hub-pages-titre">
  <div class="rule"></div>
  <h2 class="type-h2 hub-bloc-titre" id="hub-pages-titre">Nos pages par cimetière</h2>
  <ul
    class="hub-fiches"
    data-recherche-groupe
    data-libelle-un="page de cimetière"
    data-libelle-plus="pages de cimetière"
    data-libelle-zero="aucune page de cimetière"
  >
    {
      fiches.map((fiche) => (
        <li class="hub-fiche" data-recherche-item data-mots={mots(fiche)}>
          <h3 class="type-h3 hub-fiche-titre">
            <a href={cimetiereUrl(fiche.slug)} class="link">
              {fiche.nom}
            </a>
          </h3>
          <div class="hub-fiche-corps">
            <p class="hub-fiche-chapo">{fiche.chapo}</p>
            <dl class="hub-fiche-reperes">
              <div>
                <dt>Délai de pose</dt>
                <dd>{fiche.chiffres.delai}</dd>
              </div>
              <div>
                <dt>Tombe d'adulte</dt>
                <dd>{fiche.chiffres.tombeAdulte}</dd>
              </div>
              <div>
                <dt>Hauteur maximale</dt>
                <dd>{fiche.chiffres.hauteurMax}</dd>
              </div>
            </dl>
          </div>
        </li>
      ))
    }
    <li class="hub-vide" hidden data-recherche-vide>
      <p>{texteVide}</p>
      <button class="chip" type="button" data-recherche-vider>Effacer la recherche</button>
    </li>
  </ul>
  <p class="type-body hub-bloc-note">
    <slot name="note" />
  </p>
</section>

<style>
  .hub-bloc {
    margin-top: 4rem;
  }
  .hub-bloc-titre {
    margin-top: 2rem;
    max-width: 24ch;
  }
  .hub-bloc-note {
    margin-top: 1.75rem;
    max-width: 58ch;
    font-size: 1rem;
  }
  .hub-fiches {
    margin-top: 2rem;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .hub-fiche {
    display: grid;
    gap: 0.75rem 2rem;
    border-bottom: 1px solid var(--line);
    padding-block: 1.75rem;
  }
  .hub-fiche[hidden] {
    display: none;
  }
  .hub-fiche-titre {
    max-width: 26ch;
    font-size: 1.5rem;
  }
  .hub-fiche-chapo {
    max-width: 58ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  /* Les trois reperes : intitule au-dessus, valeur dessous, filet bronze en
     guise de puce. Trois colonnes des que la place existe. */
  .hub-fiche-reperes {
    margin-top: 1.125rem;
    display: grid;
    gap: 0.875rem 2rem;
  }
  .hub-fiche-reperes > div {
    position: relative;
    padding-left: 1.5rem;
  }
  .hub-fiche-reperes > div::before {
    content: "";
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 0.75rem;
    height: 1px;
    background: var(--accent);
  }
  .hub-fiche-reperes dt {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hub-fiche-reperes dd {
    margin-top: 0.3rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .hub-vide {
    padding-block: 2rem;
  }
  .hub-vide[hidden] {
    display: none;
  }
  .hub-vide p {
    max-width: 58ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .hub-vide .chip {
    margin-top: 1.125rem;
  }
  @media (min-width: 48rem) {
    .hub-fiche-reperes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .hub-bloc {
      margin-top: 5.5rem;
    }
    .hub-fiche {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      padding-block: 2.25rem;
    }
    .hub-fiche-titre {
      margin-top: 0.125rem;
    }
  }
</style>
