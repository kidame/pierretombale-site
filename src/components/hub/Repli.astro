---
/* Panneau depliable du hub /cimetieres/. Meme dessin que les replis des neuf
   fiches (src/components/GuideCimetiere.astro) : un filet en haut, un marqueur
   dessine en deux traits bronze dont la barre verticale disparait a
   l ouverture, et le contenu dans une enveloppe que le script de la page
   mesure pour animer la hauteur (220 ms).

   C est un `<details>` natif : sans JavaScript il s ouvre quand meme, et tout
   son contenu est dans le HTML servi. Rien n est charge au clic.

   La feuille est `is:global` et non scoped, pour une raison : ce composant
   recoit son corps par `<slot>`, et un style scoped ne s applique pas a du
   contenu venu du parent. Toutes les classes sont prefixees `hub-repli-` :
   aucune ne peut toucher le reste du site. Astro n emet cette feuille qu une
   fois, meme avec vingt-six instances.

   Fichier en ASCII : les libelles passent par les donnees ou par le parent. */

interface Props {
  /** Texte du resume, toujours visible et toujours dans le HTML. */
  titre: string;
  /** Precision du titre, dans le resume : elle distingue deux homonymes. */
  sousTitre?: string;
  /** Deuxieme ligne du resume : une valeur a comparer d un repli a l autre. */
  valeur?: string;
  /** Intitule de cette valeur, en petites capitales. */
  valeurLibelle?: string;
  /** Ouvert dans le HTML initial. */
  ouvert?: boolean;
  /** Le corps porte un tableau ou une liste large : pas de largeur de lecture. */
  large?: boolean;
  /** Niveau du titre du resume, quand la section en a besoin. */
  niveau?: "h3" | "h4" | "span";
  /**
   * Mots cherchables (contrat de src/components/hub/BarreRecherche.astro).
   * Fourni, le repli devient filtrable par la recherche du hub ; absent, il
   * reste toujours visible.
   */
  mots?: string;
}

const {
  titre,
  sousTitre,
  valeur,
  valeurLibelle,
  ouvert = false,
  large = false,
  niveau = "span",
  mots,
} = Astro.props;

const Titre = niveau;
---

<details
  class="hub-repli hub-repli-anime"
  open={ouvert}
  data-recherche-item={mots === undefined ? undefined : ""}
  data-mots={mots}
>
  <summary>
    <span class="hub-repli-texte">
      <span class="hub-repli-nom">
        <Titre class="hub-repli-titre">{titre}</Titre>
        {sousTitre && <span class="hub-repli-sous">{sousTitre}</span>}
      </span>
      {
        valeur && (
          <span class="hub-repli-valeur">
            {valeurLibelle && <span class="hub-repli-valeur-libelle">{valeurLibelle}</span>}
            <span class="hub-repli-valeur-texte">{valeur}</span>
          </span>
        )
      }
    </span>
    <span class="hub-repli-marque" aria-hidden="true">
      <span class="hub-repli-barre"></span>
      <span class="hub-repli-barre hub-repli-barre-v"></span>
    </span>
  </summary>
  <div class:list={["hub-repli-corps", large && "hub-repli-large"]}>
    <slot />
  </div>
</details>

<style is:global>
  .hub-repli {
    border-top: 1px solid var(--line);
  }
  .hub-repli[hidden] {
    display: none;
  }
  .hub-repli:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .hub-repli > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3rem;
    padding: 0.875rem 0;
    cursor: pointer;
    list-style: none;
  }
  .hub-repli > summary::-webkit-details-marker {
    display: none;
  }
  .hub-repli > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .hub-repli-texte {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.5rem;
    min-width: 0;
  }
  /* Nom et precision : sur une ligne quand la place existe, l un sous
     l autre sinon. La precision distingue deux lignes homonymes (trois
     communes s appellent Neuchatel). */
  .hub-repli-nom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.75rem;
    min-width: 0;
  }
  .hub-repli-sous {
    font-size: 1rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .hub-repli-titre {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 400;
    color: var(--ink);
  }
  /* La valeur a comparer : lisible sans ouvrir le repli. */
  .hub-repli-valeur {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .hub-repli-valeur-libelle {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hub-repli-valeur-texte {
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .hub-repli-marque {
    position: relative;
    flex: none;
    display: block;
    width: 0.875rem;
    height: 0.875rem;
  }
  .hub-repli-barre {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    margin-top: -0.5px;
    background: var(--accent);
    transition: transform 220ms var(--ease-out-quart);
  }
  .hub-repli-barre-v {
    transform: rotate(90deg);
  }
  .hub-repli[open] > summary .hub-repli-barre-v {
    transform: rotate(90deg) scaleX(0);
  }
  /* Enveloppe mesuree par le script de la page. */
  .hub-repli-corps {
    overflow: hidden;
  }
  .hub-repli-corps > :first-child {
    margin-top: 0;
  }
  .hub-repli-corps > :last-child {
    margin-bottom: 1.5rem;
  }
  .hub-repli-corps p {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .hub-repli-corps p + p {
    margin-top: 1rem;
  }
  .hub-repli-corps strong {
    color: var(--ink);
    font-weight: 500;
  }
  /* Des que la place existe, la valeur a comparer se range dans une colonne
     fixe : vingt-six delais alignes se comparent d un coup d oeil, sans
     tableau et sans repeter les donnees. */
  @media (min-width: 48rem) {
    .hub-repli-texte {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 12rem;
      align-items: baseline;
      column-gap: 2rem;
      width: 100%;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .hub-repli > summary:hover .hub-repli-titre {
      color: var(--accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hub-repli-barre {
      transition: none;
    }
  }
</style>
