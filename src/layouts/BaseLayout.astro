---
import "../styles.css";
import archivoLatin from "@/assets/fonts/archivo-latin-wght-normal.woff2?url";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";

interface Props {
  /** Le <title> complet de la page. Doit etre unique par adresse. */
  title?: string;
  /** Meta description, reprise aussi par les reseaux. A garder sous 160 signes. */
  description?: string;
  /** Visuel de partage : un asset importe, ou un chemin absolu depuis la racine. */
  image?: ImageMetadata | string;
  /** Sort la page des index de recherche (devis, 404, apercus). */
  noindex?: boolean;
  /**
   * Valeur brute de `<meta name="robots">`, quand « noindex,nofollow » ne
   * convient pas. Le configurateur utilise « noindex,follow » : la page est
   * trop mince pour etre indexee, mais ses liens doivent etre suivis.
   */
  robots?: string;
  /**
   * Adresse canonique a declarer, si ce n est pas celle de la page. Chemin
   * absolu depuis la racine. Sert aux pages minces qui renvoient vers une page
   * de reference (le configurateur renvoie vers la fiche du modele).
   */
  canonical?: string;
  includeHeader?: boolean;
  includeFooter?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.description,
  image,
  noindex = false,
  robots,
  canonical,
  includeHeader = true,
  includeFooter = true,
} = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, origin);
const robotsContent = robots ?? (noindex ? "noindex,nofollow" : null);

// Visuel de partage : celui de la page s il existe (photo de fiche), sinon la
// carte par defaut siteConfig.socialImage (public/og-image.png, 1200x630, nom
// provisoire : a regenerer quand le nom definitif sera choisi).
const social =
  image === undefined
    ? { src: siteConfig.socialImage, width: 1200, height: 630, alt: siteConfig.name }
    : typeof image === "string"
      ? { src: image, width: undefined, height: undefined, alt: undefined }
      : { src: image.src, width: image.width, height: image.height, alt: undefined };

const ogImage = social ? new URL(social.src, origin).href : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {robotsContent && <meta name="robots" content={robotsContent} />}

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {social?.width && <meta property="og:image:width" content={String(social.width)} />}
    {social?.height && <meta property="og:image:height" content={String(social.height)} />}
    {social?.alt && <meta property="og:image:alt" content={social.alt} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {social?.alt && <meta name="twitter:image:alt" content={social.alt} />}

    <script is:inline>
      // On active l animation au defilement avant le premier rendu, pour qu un
      // element a devoiler ne soit jamais visible une fraction de seconde.
      // Sans ce drapeau, chaque cible [data-reveal] s affiche telle quelle.
      if (
        window.matchMedia("(prefers-reduced-motion: reduce)").matches === false &&
        "IntersectionObserver" in window
      ) {
        document.documentElement.dataset.motion = "on";
      }
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]"
    >
      Aller au contenu
    </a>
    {includeHeader && <SiteHeader currentPath={Astro.url.pathname} />}
    <slot />
    {includeFooter && <SiteFooter />}

    <script is:inline>
      // Devoilement au defilement. Chaque cible cesse d etre observee des
      // qu elle est apparue : l observateur ne coute plus rien ensuite.
      (() => {
        if (document.documentElement.dataset.motion !== "on") return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0 },
        );

        const observeAll = () => {
          document.querySelectorAll("[data-reveal]:not(.is-in)").forEach((node) => observer.observe(node));
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", observeAll);
        } else {
          observeAll();
        }
      })();
    </script>
  </body>
</html>
