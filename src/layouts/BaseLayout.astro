---
import "../styles.css";
import archivoLatin from "@/assets/fonts/archivo-latin-wght-normal.woff2?url";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";

interface Props {
  /** Full <title> for the page. Should be unique per route. */
  title?: string;
  /** Meta description and social description. Keep under ~160 characters. */
  description?: string;
  /** Social share image. Accepts an imported asset or an absolute-from-root path. */
  image?: ImageMetadata | string;
  /** Excludes the page from search indexes (devis, 404, previews). */
  noindex?: boolean;
  includeHeader?: boolean;
  includeFooter?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.description,
  image,
  noindex = false,
  includeHeader = true,
  includeFooter = true,
} = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, origin);

// Pages that supply their own artwork win; everything else falls back to the
// designed share card in public/. Dimensions are emitted either way so social
// previews reserve the right space instead of reflowing.
const social =
  image === undefined
    ? siteConfig.socialImage
    : typeof image === "string"
      ? { src: image, width: undefined, height: undefined, alt: undefined }
      : { src: image.src, width: image.width, height: image.height, alt: undefined };

const ogImage = new URL(social.src, origin).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImage} />
    {social.width && <meta property="og:image:width" content={String(social.width)} />}
    {social.height && <meta property="og:image:height" content={String(social.height)} />}
    {social.alt && <meta property="og:image:alt" content={social.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {social.alt && <meta name="twitter:image:alt" content={social.alt} />}

    <script is:inline>
      // Opt in to scroll motion before first paint, so revealed elements are
      // never briefly visible. Without this flag every [data-reveal] target
      // renders in its final state.
      if (
        window.matchMedia("(prefers-reduced-motion: reduce)").matches === false &&
        "IntersectionObserver" in window
      ) {
        document.documentElement.dataset.motion = "on";
      }
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]"
    >
      Aller au contenu
    </a>
    {includeHeader && <SiteHeader currentPath={Astro.url.pathname} />}
    <slot />
    {includeFooter && <SiteFooter />}

    <script is:inline>
      // Scroll reveals. Each target unobserves itself after firing once, so the
      // observer costs nothing after the first pass down the page.
      (() => {
        if (document.documentElement.dataset.motion !== "on") return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0 },
        );

        const observeAll = () => {
          document.querySelectorAll("[data-reveal]:not(.is-in)").forEach((node) => observer.observe(node));
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", observeAll);
        } else {
          observeAll();
        }
      })();
    </script>
  </body>
</html>
